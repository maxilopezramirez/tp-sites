---
import "@tp/ui/tokens.css";

const isProd = import.meta.env.PROD;
const link = (slug: string, devPort: number) =>
  isProd ? `/tp-sites/${slug}/` : `http://localhost:${devPort}/`;

const sites = [
  {
    href: link("business", 4321),
    eyebrow: "business.ticketplus.com",
    title: "Business",
    body: "Operación full · productoras que delegan en Ticketplus",
    accent: "var(--tp-ink)",
  },
  {
    href: link("platform", 4322),
    eyebrow: "platform.ticketplus.com",
    title: "Platform",
    body: "Whitelabel · opera tu ticketera con la infraestructura TP",
    accent: "var(--tp-yellow)",
  },
  {
    href: link("investors", 4323),
    eyebrow: "investors.ticketplus.com",
    title: "Investors",
    body: "Tracción, métricas y tesis · espacio para inversores",
    accent: "var(--tp-red)",
  },
];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tp-sites · revisión</title>
  </head>
  <body>
    <main>
      <header>
        <p class="eyebrow">tp-sites</p>
        <h1>Tres sitios. Una revisión.</h1>
        <p class="lead">Elegí cuál entrar. Cada uno tiene su propia identidad y su carpeta <code>docs/</code> para ir poblando contenido.</p>
      </header>

      <ul class="grid">
        {sites.map((s) => (
          <li>
            <a href={s.href} class="card" style={`--accent:${s.accent}`}>
              <span class="eyebrow">{s.eyebrow}</span>
              <h2>{s.title}</h2>
              <p>{s.body}</p>
              <span class="cta">Entrar →</span>
            </a>
          </li>
        ))}
      </ul>

      <footer>
        <span>Dev local · Astro 5 · pnpm workspace</span>
      </footer>
    </main>

    <style>
      main {
        max-width: 1080px;
        margin: 0 auto;
        padding: 80px 24px 40px;
      }
      .eyebrow {
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--tp-muted);
        margin: 0 0 8px;
      }
      h1 {
        font-size: clamp(36px, 5vw, 56px);
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0 0 16px;
      }
      .lead {
        font-size: 17px;
        color: var(--tp-muted);
        max-width: 620px;
        margin: 0 0 56px;
      }
      .grid {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 18px;
      }
      .card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 28px 24px 22px;
        border-radius: 18px;
        border: 1px solid var(--tp-border);
        background: var(--tp-paper);
        color: var(--tp-ink);
        text-decoration: none;
        position: relative;
        transition: transform 140ms ease, box-shadow 140ms ease, border-color 140ms ease;
        min-height: 200px;
      }
      .card::before {
        content: "";
        position: absolute;
        inset: 0 0 auto 0;
        height: 4px;
        background: var(--accent);
        border-radius: 18px 18px 0 0;
      }
      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        border-color: var(--accent);
      }
      .card h2 {
        margin: 0;
        font-size: 28px;
        letter-spacing: -0.01em;
      }
      .card p {
        margin: 0;
        color: var(--tp-muted);
        font-size: 14px;
        line-height: 1.5;
        flex: 1;
      }
      .cta {
        font-size: 13px;
        font-weight: 600;
        margin-top: 8px;
      }
      footer {
        margin-top: 80px;
        padding-top: 24px;
        border-top: 1px solid var(--tp-border);
        font-size: 12px;
        color: var(--tp-muted);
      }
    </style>
  </body>
</html>
