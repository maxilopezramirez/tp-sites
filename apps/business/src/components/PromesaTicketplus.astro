---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  eyebrow = "Promesa Ticketplus",
  title,
  body,
  ctaLabel = "Conocer plan con soporte presencial →",
  ctaHref = "#contacto",
} = Astro.props;
---

<section class="tp-promise">
  <div class="tp-promise__glow" aria-hidden="true" />
  <div class="container">
    <div class="tp-promise__inner">
      <span class="tp-promise__eyebrow">{eyebrow}</span>
      <h2 class="tp-promise__title">{title}</h2>
      <p class="tp-promise__body" set:html={body} />
      <div class="tp-promise__ctas">
        <a href={ctaHref} class="btn btn--ghost">{ctaLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .tp-promise {
    position: relative; isolation: isolate;
    background: radial-gradient(ellipse at 50% 0%, #1f1408 0%, #0a0a0a 60%) #0a0a0a;
    color: #fff;
    padding: 120px 0;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .tp-promise__glow {
    position: absolute; top: -10%; left: 50%; transform: translateX(-50%);
    width: 900px; height: 600px; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse, rgba(255,171,36,0.18) 0%, rgba(255,19,19,0.06) 40%, transparent 70%);
    filter: blur(50px);
  }
  .tp-promise .container { position: relative; z-index: 1; }
  .tp-promise__inner { text-align: center; max-width: 820px; margin: 0 auto; }
  .tp-promise__eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-secondary);
    padding: 6px 14px;
    border: 1px solid rgba(255,171,36,0.4);
    border-radius: 999px;
    background: rgba(255,171,36,0.08);
    margin-bottom: 24px;
  }
  .tp-promise__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.12;
    margin: 0 0 22px; color: #fff;
  }
  .tp-promise__body {
    font-family: var(--font-body);
    font-size: 1.05rem; line-height: 1.7;
    color: rgba(255,255,255,0.78);
    margin: 0 auto 36px; max-width: 720px;
  }
  .tp-promise__body strong { color: #fff; font-weight: 700; }
  .tp-promise__ctas {
    display: flex; gap: 14px; justify-content: center; flex-wrap: wrap;
  }
</style>
