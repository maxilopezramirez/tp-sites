---
/*
  CasoFifa — caso de éxito Copa Mundial Sub-20 FIFA Chile 2025.
  Sección dark con badge + título + stats (3 cifras) + video + CTA.
  Reutilizable en home, deportes, festivales y otros donde haga sentido.
*/

interface Props {
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  ctaHref = "#contacto",
  ctaLabel = "Agenda una demo",
} = Astro.props;
---

<section class="tp-fifa__section" id="fifa">
  <div class="tp-fifa__noise" />
  <div class="tp-fifa__glow" />
  <div class="container">
    <div class="tp-fifa__header">
      <span class="tp-fifa__badge">Caso de éxito</span>
      <h2 class="tp-fifa__title">
        Copa Mundial Sub-20 de la <span class="tp-fifa__title-accent">FIFA Chile 2025</span>™
      </h2>
      <p class="tp-fifa__context">Ticketplus fue seleccionado como plataforma oficial de ticketing.</p>
    </div>
    <div class="tp-fifa__stats">
      <div class="tp-fifa__stat-card">
        <div class="tp-fifa__stat-value">+600.000</div>
        <div class="tp-fifa__stat-label">asistentes en todo el evento</div>
      </div>
      <div class="tp-fifa__stat-card">
        <div class="tp-fifa__stat-value">4</div>
        <div class="tp-fifa__stat-label">estadios</div>
      </div>
      <div class="tp-fifa__stat-card">
        <div class="tp-fifa__stat-value">52</div>
        <div class="tp-fifa__stat-label">partidos organizados</div>
      </div>
    </div>
    <div class="tp-fifa__video-wrap">
      <video
        src="https://documents-assets.s3.sa-east-1.amazonaws.com/video-tp.mp4"
        autoplay controls loop muted playsinline
        class="tp-fifa__video"
      >
        Tu navegador no soporta video HTML5.
      </video>
    </div>
    <div class="tp-fifa__cta">
      <a href={ctaHref} class="tp-fifa__cta-btn">
        {ctaLabel}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .tp-fifa__section {
    position: relative;
    isolation: isolate;
    background: radial-gradient(ellipse at 50% 0%, #1a0c0c 0%, #050505 60%) #050505;
    color: #fff;
    padding: 140px 0 120px;
    overflow: hidden;
    border-top: 1px solid var(--color-border);
  }
  .tp-fifa__noise {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    opacity: 0.06; mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .tp-fifa__glow {
    position: absolute; top: -20%; left: 50%; transform: translateX(-50%);
    width: 1100px; height: 700px; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse, rgba(255,19,19,0.18) 0%, rgba(255,171,36,0.08) 40%, rgba(255,19,19,0) 70%);
    filter: blur(40px);
  }
  .tp-fifa__section .container { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .tp-fifa__header { text-align: center; max-width: 820px; margin: 0 auto 64px; }
  .tp-fifa__badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--color-secondary);
    padding: 6px 14px;
    border: 1px solid rgba(255,171,36,0.4);
    border-radius: 999px;
    background: rgba(255,171,36,0.08);
    margin-bottom: 24px;
  }
  .tp-fifa__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: #fff;
    margin: 0 0 18px;
  }
  .tp-fifa__title-accent {
    background: var(--gradient-brand-text);
    -webkit-background-clip: text; background-clip: text;
    color: transparent;
  }
  .tp-fifa__context {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: rgba(255,255,255,0.65);
    margin: 0;
  }
  .tp-fifa__stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; max-width: 920px; margin: 0 auto 64px;
  }
  .tp-fifa__stat-card {
    background: linear-gradient(180deg, rgba(255,255,255,0.04) 0%, rgba(255,255,255,0.01) 100%);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    padding: 32px 24px;
    text-align: center;
    backdrop-filter: blur(8px);
  }
  .tp-fifa__stat-value {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #fff;
    line-height: 1;
    margin-bottom: 10px;
  }
  .tp-fifa__stat-label {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.4;
  }
  .tp-fifa__video-wrap {
    max-width: 1000px; margin: 0 auto 56px;
    border-radius: 20px; overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    box-shadow: 0 30px 80px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,19,19,0.12);
    background: #000;
  }
  .tp-fifa__video { display: block; width: 100%; height: auto; }
  .tp-fifa__cta { text-align: center; }
  .tp-fifa__cta-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 32px;
    background: var(--gradient-brand);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.95rem; font-weight: 700;
    letter-spacing: -0.01em;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .tp-fifa__cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255,19,19,0.35);
  }

  @media (max-width:768px) {
    .tp-fifa__stats { grid-template-columns: 1fr; gap: 12px; }
    .tp-fifa__section { padding: 100px 0 80px; }
  }
</style>
