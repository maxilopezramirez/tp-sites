---
// Formulario de contacto: lado izquierdo con copy + checklist, lado derecho con form.
const checklist = ["Sin contrato de permanencia obligatoria","Setup completo en pocas semanas","Account manager dedicado pre-evento","Marketing Booster + marketplace incluidos","Operación en terreno el día del evento","Liquidación automática 48-72h post-evento"];
const inputs = [["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Empresa o productora","text","Nombre de tu empresa"]];
---
<section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
  <div class="container">
    <div class="form-grid-tp">
      <div>
        <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu evento</p>
        <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu evento específico.</h2>
        <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">No una tabla de precios genérica. Te respondemos en menos de 24 horas hábiles, sin compromiso.</p>
        <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
          {checklist.map(item => (
            <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
          ))}
        </ul>
      </div>
      <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
        <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Agendar demo personalizada</h3>
        <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
        {inputs.map(([label,type,placeholder]) => (
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
            <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
          </div>
        ))}
        <div style="margin-bottom:14px;">
          <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de evento</label>
          <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
            <option>Festival / Concierto</option>
            <option>Teatro / Sala</option>
            <option>Estadio / Deporte</option>
            <option>Feria / Conferencia</option>
            <option>Familiar / Parque</option>
            <option>Otro</option>
          </select>
        </div>
        <div style="margin-bottom:20px;">
          <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tamaño estimado</label>
          <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
            <option>Menos de 1.000 tickets</option>
            <option>1.000 – 10.000 tickets</option>
            <option>10.000 – 50.000 tickets</option>
            <option>50.000 – 100.000 tickets</option>
            <option>Más de 100.000 tickets</option>
          </select>
        </div>
        <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Agendar demo →</button>
      </div>
    </div>
  </div>
</section>
