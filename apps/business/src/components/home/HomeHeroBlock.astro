---
// Hero principal de la home: eyebrow + título + lead + CTAs + imagen.
---
<header class="biz-hero">
  <div class="container">
    <div class="biz-hero__content">
      <p class="biz-hero__eyebrow">Full Operation · Servicios para productores</p>
      <h1 class="biz-hero__title">La operación completa de tu evento, en una sola plataforma.</h1>
      <p class="biz-hero__lead">Activas solo las capacidades que tu evento necesita — y cuando creces, no migras.</p>
      <div class="biz-hero__ctas">
        <a href="#contacto" class="btn btn--primary">Agendar demo →</a>
        <a href="#vende" class="btn btn--ghost">Ver capacidades</a>
      </div>
    </div>
    <div class="biz-hero__visual">
      <img src={`${import.meta.env.BASE_URL}/scenes/hero-devices-v2.png`} alt="App Ticketplus en tablet y smartphone con dashboards de ventas y validación" class="biz-hero__devices" />
    </div>
  </div>
</header>
