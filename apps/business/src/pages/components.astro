---
// Preview de los componentes de la home — cada parte como componente aislado.
// Cambios al copy de la home se hacen en src/components/home/*.astro
import Site from "../layouts/Site.astro";
import HomeHeroBlock from "../components/home/HomeHeroBlock.astro";
import HomeLogosCloud from "../components/home/HomeLogosCloud.astro";
import HomeServicesOverview from "../components/home/HomeServicesOverview.astro";
import HomePillarsScenes from "../components/home/HomePillarsScenes.astro";
import HomeEquipoBlock from "../components/home/HomeEquipoBlock.astro";
import HomeFifaCase from "../components/home/HomeFifaCase.astro";
import HomeExtendedSpotlight from "../components/home/HomeExtendedSpotlight.astro";
import HomeIndustriesGrid from "../components/home/HomeIndustriesGrid.astro";
import HomePaymentsBlock from "../components/home/HomePaymentsBlock.astro";
import HomeContactForm from "../components/home/HomeContactForm.astro";
import HomeFaqSection from "../components/home/HomeFaqSection.astro";
import HomeFinalCta from "../components/home/HomeFinalCta.astro";

const componentList = [
  { name: "HomeHeroBlock",        file: "src/components/home/HomeHeroBlock.astro",        Component: HomeHeroBlock },
  { name: "HomeLogosCloud",       file: "src/components/home/HomeLogosCloud.astro",       Component: HomeLogosCloud },
  { name: "HomeServicesOverview", file: "src/components/home/HomeServicesOverview.astro", Component: HomeServicesOverview },
  { name: "HomePillarsScenes",    file: "src/components/home/HomePillarsScenes.astro",    Component: HomePillarsScenes },
  { name: "HomeEquipoBlock",      file: "src/components/home/HomeEquipoBlock.astro",      Component: HomeEquipoBlock },
  { name: "HomeFifaCase",         file: "src/components/home/HomeFifaCase.astro",         Component: HomeFifaCase },
  { name: "HomeExtendedSpotlight",file: "src/components/home/HomeExtendedSpotlight.astro",Component: HomeExtendedSpotlight },
  { name: "HomeIndustriesGrid",   file: "src/components/home/HomeIndustriesGrid.astro",   Component: HomeIndustriesGrid },
  { name: "HomePaymentsBlock",    file: "src/components/home/HomePaymentsBlock.astro",    Component: HomePaymentsBlock },
  { name: "HomeContactForm",      file: "src/components/home/HomeContactForm.astro",      Component: HomeContactForm },
  { name: "HomeFaqSection",       file: "src/components/home/HomeFaqSection.astro",       Component: HomeFaqSection },
  { name: "HomeFinalCta",         file: "src/components/home/HomeFinalCta.astro",         Component: HomeFinalCta },
];
---
<Site title="Components preview · Home Ticketplus Business">

  <!-- Sticky TOC -->
  <nav class="cmp-toc" aria-label="Índice de componentes">
    <div class="cmp-toc__inner">
      <span class="cmp-toc__title">Componentes de la home</span>
      <div class="cmp-toc__links">
        {componentList.map(c => (
          <a class="cmp-toc__link" href={`#${c.name}`}>{c.name}</a>
        ))}
      </div>
    </div>
  </nav>

  {componentList.map(({ name, file, Component }) => (
    <div class="cmp-wrap" id={name}>
      <div class="cmp-label">
        <span class="cmp-label__pill">{name}</span>
        <span class="cmp-label__path">{file}</span>
      </div>
      <Component />
    </div>
  ))}

</Site>

<style>
  /* Sticky TOC + labels para el preview de componentes */
  .cmp-toc {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #0a0a0a;
    border-bottom: 1px solid rgba(255,255,255,0.10);
    color: #fff;
    backdrop-filter: blur(8px);
  }
  .cmp-toc__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 14px 32px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cmp-toc__title {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-secondary);
    flex-shrink: 0;
  }
  .cmp-toc__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cmp-toc__link {
    font-family: var(--font-body);
    font-size: 12px;
    color: rgba(255,255,255,0.65);
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.10);
    transition: background .15s, color .15s;
  }
  .cmp-toc__link:hover {
    background: rgba(255,171,36,0.12);
    color: #fff;
    border-color: rgba(255,171,36,0.4);
  }

  .cmp-wrap {
    position: relative;
    border-top: 4px dashed rgba(255,171,36,0.45);
  }
  .cmp-wrap:first-of-type { border-top: none; }
  .cmp-label {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(10,10,10,0.92);
    color: #fff;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255,171,36,0.4);
    backdrop-filter: blur(8px);
    box-shadow: 0 6px 18px rgba(0,0,0,0.18);
  }
  .cmp-label__pill {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--color-secondary);
  }
  .cmp-label__path {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 10.5px;
    color: rgba(255,255,255,0.55);
  }
  @media (max-width: 768px) {
    .cmp-label__path { display: none; }
  }
</style>

<style is:global>
  /* ─────────────────────────────────────────────────────────
     CSS global copiado desde index.astro para que los
     componentes home/* rendericen idénticos al original.
  ──────────────────────────────────────────────────────────*/

  /* ── Biz Hero ─────────────────────────────────────────── */
  .biz-hero {
    background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505;
    color: #fff;
    padding: 120px 0;
    position: relative;
  }
  .biz-hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .biz-hero__visual { display: flex; justify-content: center; align-items: center; }
  .biz-hero__devices {
    width: 100%; max-width: 620px; height: auto; display: block;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.45));
  }
  .biz-hero__eyebrow {
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
    margin: 0 0 20px;
  }
  .biz-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    font-weight: 900; letter-spacing: -0.03em; line-height: 1.05;
    color: #fff; margin: 0 0 24px; max-width: 820px;
  }
  .biz-hero__lead {
    font-family: var(--font-body);
    font-size: 1.1rem; color: rgba(255,255,255,0.70);
    line-height: 1.65; max-width: 560px; margin: 0 0 36px;
  }
  .biz-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── Scenes (pilares) ──────────────────────────────────── */
  .biz-scene { padding: 120px 0; position: relative; overflow: hidden; }
  .biz-scene--light { background: #fff; }
  .biz-scene--dark { background: #0a0a0a; color: #fff; }
  .biz-scene--p0 { background: #fff; }
  .biz-scene--p1 { background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505; color: #fff; }
  .biz-scene--p2 { background: linear-gradient(180deg, #fff 0%, #fafafa 100%); }
  .biz-scene--p3 { background: radial-gradient(ellipse at 30% 70%, #1a1209 0%, #050505 60%) #050505; color: #fff; }
  .biz-scene--p4 { background: linear-gradient(180deg, #fafafa 0%, #fff 100%); }

  .biz-scene__header { max-width: 760px; margin-bottom: 64px; }
  .biz-scene__eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 18px;
  }
  .biz-scene--light .biz-scene__eyebrow { color: var(--color-primary); }
  .biz-scene__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.06;
    margin: 0 0 20px;
  }
  .biz-scene--dark .biz-scene__title { color: #fff; }
  .biz-scene__lead {
    font-family: var(--font-body);
    font-size: 1.1rem; line-height: 1.6; margin: 0; max-width: 620px;
  }
  .biz-scene--light .biz-scene__lead { color: var(--color-text-muted); }
  .biz-scene--dark .biz-scene__lead { color: rgba(255,255,255,0.72); }

  .biz-scene__hero {
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: 64px; align-items: center; margin-bottom: 72px;
  }
  .biz-scene__hero.is-reverse { grid-template-columns: 0.85fr 1.15fr; }
  .biz-scene__hero.is-reverse .scene-stage { order: 2; }
  .biz-scene__hero.is-reverse .biz-scene__caption { order: 1; }
  .biz-scene__hero + .biz-scene__hero,
  .biz-scene__hero + .biz-scene__grid,
  .biz-scene__grid + .biz-scene__hero { margin-top: 88px; }
  .biz-scene__grid + .biz-scene__grid { margin-top: 28px; }

  .biz-scene__stores { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
  .biz-scene__stores .store-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    background: #000; color: #fff;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .biz-scene--light .biz-scene__stores .store-btn { background: #000; color: #fff; border-color: #000; }
  .biz-scene__stores .store-btn--wsp,
  .biz-scene--light .biz-scene__stores .store-btn--wsp { background: #25D366; color: #fff; border-color: #25D366; }
  .biz-scene__stores .store-btn:hover { transform: translateY(-1px); border-color: var(--color-secondary); }
  .biz-scene__stores .store-btn--wsp:hover { border-color: #1da851; box-shadow: 0 6px 18px rgba(37,211,102,0.35); }
  .biz-scene__stores .store-icon { width: 22px; height: 22px; flex-shrink: 0; }
  .biz-scene__stores .store-text { display: flex; flex-direction: column; line-height: 1.1; }
  .biz-scene__stores .store-label { font-family: var(--font-body); font-size: 9px; opacity: 0.75; letter-spacing: 0.04em; text-transform: uppercase; }
  .biz-scene__stores .store-name { font-family: var(--font-heading); font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }

  .biz-scene__caption-tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
    background: rgba(255,171,36,0.10);
    border: 1px solid rgba(255,171,36,0.28);
    padding: 5px 11px; border-radius: 999px;
    margin-bottom: 18px;
  }
  .biz-scene--dark .biz-scene__caption-tag { background: rgba(255,171,36,0.14); border-color: rgba(255,171,36,0.36); }
  .biz-scene__caption-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800; letter-spacing: -0.02em; line-height: 1.15;
    margin: 0 0 14px;
  }
  .biz-scene__caption-body {
    font-family: var(--font-body);
    font-size: 1rem; line-height: 1.65; margin: 0 0 18px;
  }
  .biz-scene--light .biz-scene__caption-body { color: var(--color-text-muted); }
  .biz-scene--dark .biz-scene__caption-body { color: rgba(255,255,255,0.72); }

  .biz-scene__badge {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.7rem; font-weight: 800;
    color: var(--color-secondary);
    background: rgba(255,171,36,0.12);
    border: 1px solid rgba(255,171,36,0.30);
    border-radius: 4px;
    padding: 4px 10px;
    letter-spacing: 0.06em; text-transform: uppercase;
    margin-top: 4px;
  }
  .biz-scene--dark .biz-scene__badge { background: rgba(255,171,36,0.15); border-color: rgba(255,171,36,0.40); }

  .scene-stage {
    position: relative; border-radius: 16px; overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.18);
    aspect-ratio: 4/3.1;
    background: #f3f3f3;
    border: 1px solid rgba(10,10,10,0.06);
  }
  .biz-scene--dark .scene-stage {
    background: #141414;
    border-color: rgba(255,255,255,0.08);
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }
  .scene-stage--scanner { aspect-ratio: 4/3.4; background: linear-gradient(160deg, #1a1a1a 0%, #0a0a0a 100%); }
  .scene-stage--showpage { background: linear-gradient(180deg, #f8f7f5 0%, #ecebe7 100%); }
  .scene-stage--analytics { background: linear-gradient(180deg, #fbfbfb 0%, #efefef 100%); }
  .scene-stage--code { background: linear-gradient(160deg, #0d1b1f 0%, #050a0c 100%); }
  .scene-stage--loyalty { background: linear-gradient(160deg, #fff5e8 0%, #ffe0d4 100%); }
  .scene-stage--venue { background: linear-gradient(160deg, #fff7ec 0%, #ffe6d4 100%); }
  .scene-stage--booster { background: linear-gradient(160deg, #1f1408 0%, #0a0a0a 100%); }

  .biz-scene__grid {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px;
  }
  .scene-card {
    grid-column: span 2;
    background: #fff;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px; overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .2s, box-shadow .2s, border-color .2s;
  }
  .biz-scene--dark .scene-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
  .scene-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(0,0,0,0.08); border-color: rgba(10,10,10,0.18); }
  .biz-scene--dark .scene-card:hover { border-color: rgba(255,255,255,0.18); box-shadow: 0 14px 36px rgba(0,0,0,0.5); }
  .biz-scene__grid--2 .scene-card { grid-column: span 3; }
  .biz-scene__grid--3 .scene-card { grid-column: span 2; }
  .biz-scene__grid--4 .scene-card { grid-column: span 3; }

  .scene-card__stage {
    aspect-ratio: 16/9; position: relative;
    background: linear-gradient(135deg, rgba(255,19,19,0.10) 0%, rgba(255,171,36,0.10) 100%);
    overflow: hidden;
  }
  .scene-card__stage::before, .scene-card__stage::after {
    content: ''; position: absolute; border-radius: 50%; filter: blur(20px); opacity: 0.55;
  }
  .scene-card__stage::before {
    width: 60%; height: 80%; top: -10%; left: -10%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }
  .scene-card__stage::after {
    width: 50%; height: 60%; bottom: -10%; right: -10%;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }
  .biz-scene--dark .scene-card__stage {
    background: linear-gradient(135deg, rgba(255,19,19,0.18) 0%, rgba(255,171,36,0.18) 100%);
  }
  .scene-card__stage--p0-0 { background: linear-gradient(135deg, #fff1e0 0%, #ffe0d4 100%); }
  .scene-card__stage--p0-1 { background: linear-gradient(135deg, #fde6e6 0%, #ffd7b8 100%); }
  .scene-card__stage--p0-2 { background: linear-gradient(135deg, #fff5cc 0%, #ffd7b8 100%); }
  .scene-card__stage--p1-0,
  .scene-card__stage--p1-1,
  .scene-card__stage--p1-2,
  .scene-card__stage--p1-3 { background: #343434; }
  .scene-card__stage--p2-0 { background: linear-gradient(135deg, #fff 0%, #fff3c4 100%); }
  .scene-card__stage--p2-1 { background: linear-gradient(135deg, #fff0e8 0%, #fde6e6 100%); }
  .scene-card__stage--p2-2 { background: linear-gradient(135deg, #ffeede 0%, #fff5cc 100%); }
  .scene-card__stage--p2-3 { background: linear-gradient(135deg, #fde6e6 0%, #ffe2d0 100%); }
  .scene-card__stage--p3-0,
  .scene-card__stage--p3-1,
  .scene-card__stage--p3-2 { background: linear-gradient(135deg, #142020 0%, #0a0a0a 100%); }
  .scene-card__stage--p4-0 { background: linear-gradient(135deg, #fff1e0 0%, #ffd7b8 100%); }
  .scene-card__stage--p4-1 { background: linear-gradient(135deg, #fde6e6 0%, #fff5cc 100%); }
  .scene-card__stage--p4-2 { background: linear-gradient(135deg, #fff5cc 0%, #ffe0d4 100%); }
  .scene-card__stage--p4-3 { background: linear-gradient(135deg, #fff1e0 0%, #fde6e6 100%); }

  .scene-card__chip {
    position: absolute; z-index: 2; top: 14px; left: 14px;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 800;
    letter-spacing: 0.08em;
    background: #fff; color: var(--color-text-primary);
    padding: 5px 10px; border-radius: 999px;
    border: 1px solid rgba(10,10,10,0.08);
  }
  .biz-scene--dark .scene-card__chip { background: rgba(20,20,20,0.85); color: #fff; border-color: rgba(255,255,255,0.12); }
  .scene-card__body { padding: 24px 24px 28px; display: flex; flex-direction: column; gap: 8px; }
  .scene-card__title {
    font-family: var(--font-heading);
    font-size: 1.1rem; font-weight: 800;
    letter-spacing: -0.02em; margin: 0; line-height: 1.25;
  }
  .biz-scene--dark .scene-card__title { color: #fff; }
  .scene-card__text { font-family: var(--font-body); font-size: 0.9rem; line-height: 1.6; margin: 0; }
  .biz-scene--light .scene-card__text { color: var(--color-text-muted); }
  .biz-scene--dark .scene-card__text { color: rgba(255,255,255,0.7); }

  @media (max-width: 1024px) {
    .biz-hero .container { grid-template-columns: 1fr; gap: 48px; }
    .biz-scene__hero { grid-template-columns: 1fr; gap: 32px; }
    .biz-scene__hero.is-reverse { grid-template-columns: 1fr; }
    .biz-scene__hero.is-reverse .scene-stage { order: initial; }
    .biz-scene__hero.is-reverse .biz-scene__caption { order: initial; }
    .biz-scene__grid,
    .biz-scene__grid--3,
    .biz-scene__grid--4 { grid-template-columns: repeat(2, 1fr); }
    .scene-card,
    .biz-scene__grid--3 .scene-card,
    .biz-scene__grid--4 .scene-card { grid-column: span 1; }
  }
  @media (max-width: 768px) {
    .biz-scene { padding: 80px 0; }
    .biz-scene__grid,
    .biz-scene__grid--3,
    .biz-scene__grid--4 { grid-template-columns: 1fr; }
  }

  /* Logos cloud */
  .logos-cloud { background:#0a0a0a; padding:60px 0; border-top:1px solid rgba(255,255,255,0.06); }
  .logos-cloud__label { font-family:var(--font-heading); font-size:11px; color:rgba(255,255,255,0.38); letter-spacing:0.14em; text-transform:uppercase; font-weight:600; text-align:center; margin-bottom:32px; }
  .logos-cloud__grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:16px; }
  .logo-tile-dark { aspect-ratio:3/1.2; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.10); border-radius:8px; display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,0.60); font-size:0.82rem; font-weight:700; font-family:var(--font-heading); }

  .tp-grid-4 { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; }
  .form-grid-tp { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }

  /* Spotlights */
  .spotlight { padding: 100px 0; border-top: 1px solid var(--color-border); }
  .spotlight--light { background: #fafafa; }
  .spotlight--dark { background: #0a0a0a; color: #fff; }
  .spotlight .container { text-align: center; }
  .spotlight__title, .spotlight__body { max-width: 880px; margin-left: auto; margin-right: auto; }
  .spotlight__eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 999px;
    margin-bottom: 22px;
    background: rgba(255,255,255,0.16); color: #fff;
  }
  .spotlight--light .spotlight__eyebrow { background: rgba(255,19,19,0.10); color: var(--color-primary); }
  .spotlight--dark .spotlight__eyebrow { background: rgba(255,171,36,0.14); color: var(--color-secondary); }
  .spotlight__title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.15;
    margin: 0 0 22px;
    max-width: 880px; margin-left: auto; margin-right: auto;
  }
  .spotlight--dark .spotlight__title { color: #fff; }
  .spotlight__body {
    font-family: var(--font-body); font-size: 1.05rem; line-height: 1.65;
    margin: 0 auto; max-width: 720px;
  }
  .spotlight--light .spotlight__body { color: var(--color-text-muted); }
  .spotlight--dark .spotlight__body { color: rgba(255,255,255,0.72); }
  .spotlight__cards {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 56px; text-align: left;
  }
  @media (max-width: 768px) { .spotlight__cards { grid-template-columns: 1fr; } }
  .spotlight-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 14px;
    padding: 24px 24px 28px;
    display: flex; flex-direction: column; gap: 10px;
    transition: transform .2s, border-color .2s, background .2s;
  }
  .spotlight-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,171,36,0.40);
    background: rgba(255,255,255,0.06);
  }
  .spotlight--light .spotlight-card { background: #fff; border-color: rgba(10,10,10,0.10); }
