---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";

// 3 fases del data journey: Visibilidad / Atribución / Acción
const fases = [
  {
    n: "01", tag: "FASE 01 · VISIBILIDAD", dark: false, id: "visibilidad",
    title: "Buscas ver lo que pasa mientras pasa.",
    lead: "Encuentras dashboard mobile-first + ventas por minuto + ocupación al segundo. Real-time real, no \"actualizado cada 15 minutos\". El productor mira el dashboard desde el celular durante el drop.",
    features: [
      { n: "01", title: "Modern dashboard mobile-first", body: "Diseño 2025, customizable por rol — CEO ve revenue, jefe ops ve ocupación, KAM ve ROAS.", badge: "Mobile-first 2025" },
      { n: "02", title: "Ventas en tiempo real durante el drop", body: "Latencia <5s, alertas configurables, sector más vendido, ticket promedio.", badge: "<5s latencia" },
      { n: "03", title: "Ocupación y aforo por zona en vivo", body: "Velocidad de ingreso por puerta, picos de flujo, alertas de aforo crítico.", badge: null },
    ],
  },
  {
    n: "02", tag: "FASE 02 · ATRIBUCIÓN", dark: true, id: "atribucion",
    title: "Buscas saber de qué canal vino cada venta.",
    lead: "Encuentras atribución end-to-end + funnel + geo. La señal que tu equipo de marketing necesita.",
    features: [
      { n: "01", title: "Funnel de conversión", body: "Visita → carrito → checkout → pago → ticket. Tasa de abandono por etapa, dónde se cae la gente.", badge: null },
      { n: "02", title: "Geographic insights de compradores", body: "Mapa de calor, distancia al venue, decide geo-targeting del próximo evento.", badge: null },
      { n: "03", title: "Modelos de atribución configurables", body: "Last-click, first-click o data-driven con ROAS por campaña + CAC por canal.", badge: null },
    ],
  },
  {
    n: "03", tag: "FASE 03 · ACCIÓN", dark: false, id: "accion",
    title: "Buscas que el reporte se convierta en decisión.",
    lead: "Encuentras export multi-formato + reportes específicos por vertical. El reporte que nadie usa es ruido. Exportable, integrable y específico por línea de negocio.",
    features: [
      { n: "01", title: "Reportes de membresía y socios", body: "ARPU, LTV, churn, edad promedio, motivo de baja por tier.", badge: null },
      { n: "02", title: "Stock unificado y reportería multicanal", body: "Boletería física + POS venue + web + app sobre un solo conteo.", badge: "Único — un solo conteo" },
      { n: "03", title: "Export multi-formato — CSV / XLSX / API", body: "Conector nativo a BigQuery + Snowflake, API pública con OAuth.", badge: null },
      { n: "04", title: "Reportes post-evento en 24h customizados por vertical", body: "Festivales por stage, teatros por función, clubes por categoría socio.", badge: "Customizado por vertical" },
    ],
  },
];

const overview = [
  { tag: "01 · Visibilidad", title: "Ver lo que pasa, mientras pasa. Real-time desde el celular, ocupación al segundo.", href: "#visibilidad" },
  { tag: "02 · Atribución", title: "Saber de qué canal vino cada venta. GA4 + SEMrush nativo, sin pixels duplicados.", href: "#atribucion" },
  { tag: "03 · Acción", title: "Convertir reporte en decisión. Export multi-formato, API, reportes customizados por vertical.", href: "#accion" },
];

const demoOptions = [
  { icon: "📊", label: "Ventas en tiempo real" },
  { icon: "🎯", label: "Atribución por canal" },
  { icon: "🏟️", label: "Ocupación y aforo en vivo" },
  { icon: "🔄", label: "Reportes de membresía" },
  { icon: "📤", label: "Export a mi BI / data warehouse" },
];

const whyCards = [
  { icon: "⚡", title: "Real-time a escala big data", body: "Ventas por minuto incluso con +50K tickets/hora. Latencia <5s." },
  { icon: "🧠", title: "Atribución nativa, no addon", body: "GA4 y SEMrush conectados al pixel propio de TP." },
  { icon: "📤", title: "Export sin fricción", body: "CSV, XLSX, JSON, API pública. La data es tuya." },
  { icon: "🎯", title: "Reporte que se usa", body: "Post-evento en 24h con recomendaciones específicas." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "Ventas por minuto durante el lanzamiento + ocupación por stage + atribución end-to-end.", href: "/servicios/festivales" },
  { icon: "🎭", label: "Teatros", body: "Penetración de abono por función + ARPU por categoría de abonado + funnel de conversión.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Deportes", body: "Ingresos por categoría de socio + churn mensual + atribución partido a partido.", href: "/servicios/deportes" },
  { icon: "🎵", label: "Espectáculos", body: "ROAS por canal pre-lanzamiento + live entry rate + geo de compradores internacionales.", href: "/servicios/espectaculo" },
  { icon: "💼", label: "Congresos", body: "Engagement por sesión + ROI por sponsor + funnel de registro por categoría.", href: "/servicios/conferencias" },
  { icon: "🎡", label: "Centros familiares", body: "Ocupación por horario + churn de membresía + LTV por familia.", href: "/servicios/familiar" },
  { icon: "🎪", label: "Ferias", body: "Tráfico por stand + leads por expositor + atribución del registro pre-evento.", href: "/servicios/ferias" },
];

const checklist = [
  "Demo con un evento de tu industria — no demo genérica",
  "Acceso a sandbox para tu equipo durante 7 días",
  "Export y conector a tu BI / data warehouse",
  "API documentada con OAuth — cero permanencia obligatoria",
  "Reportes post-evento customizados por vertical",
  "Atribución multi-canal nativa GA4 + SEMrush",
];

const faqs = [
  { q: "¿Qué tan real-time es \"real-time\"?", a: "Latencia <5s para ventas y <30s para validaciones de ingreso. Sin \"actualizado cada 15 minutos\" — ventas por minuto incluso durante drops de 50K tickets/hora." },
  { q: "¿Tienen conector a mi BI (Looker / PowerBI / Metabase / Tableau)?", a: "Sí. Conectores nativos a BigQuery, Snowflake, Looker, PowerBI, Metabase y Tableau. API pública con OAuth para integraciones custom. <strong>Cero lock-in</strong> — la data es tuya." },
  { q: "¿En qué se diferencia su atribución vs GA4 puro?", a: "GA4 te dice qué sesión convirtió, pero no qué transacción. Nuestro pixel propio enriquece GA4 con datos de pasarela (revenue real, refunds, no-show). Resultado: atribución end-to-end con menor pérdida vs ITP / cookies bloqueadas. Sin doble disparo, sin UTMs rotos." },
  { q: "¿Qué pasa con la data histórica si migro de otra plataforma?", a: "Migración asistida. Importamos tu base histórica de ventas, compradores y abonados con etiquetado para series temporales. Operás con histórico desde el día 1, no desde cero." },
  { q: "¿Los reportes post-evento son customizados por tipo de evento?", a: "Sí. Plantillas pre-armadas por vertical: festivales por stage / día, teatros por función / obra, clubes por categoría de socio, congresos por sesión / sponsor. Customizables según necesidad." },
];
---
<Site title="Servicios Ticketplus · Data Analytics — Reportería real-time desde el celular">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Data Analytics · Reportería real-time</p>
        <h1 class="biz-hero__title">La tecnología que te dice lo que pasa, mientras pasa.</h1>
        <p class="biz-hero__lead">Real-time desde tu celular, atribución multi-canal nativa, integración con GA4 y SEMrush, stock unificado online + box-office y tasa de ingreso en vivo. Si el dato llega tarde, ya no sirve.</p>
        <div class="biz-hero__ctas">
          <a href="#demo" class="btn btn--primary">Ver el dashboard en vivo →</a>
          <a href="#visibilidad" class="btn btn--ghost">Ver módulos</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <div class="biz-hero__placeholder" aria-hidden="true">
          <div class="biz-hero__placeholder-glow"></div>
          <div class="biz-hero__placeholder-grid">
            <div class="ph-tile ph-tile--big">
              <span class="ph-label">Ventas hoy</span>
              <span class="ph-value">48.213</span>
              <span class="ph-delta">+12% vs ayer</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Latencia</span>
              <span class="ph-value">3.2s</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Aforo</span>
              <span class="ph-value">87%</span>
            </div>
            <div class="ph-tile ph-tile--wide">
              <span class="ph-label">Ventas / minuto</span>
              <div class="ph-bars">
                <span style="height:22%"></span>
                <span style="height:48%"></span>
                <span style="height:34%"></span>
                <span style="height:72%"></span>
                <span style="height:56%"></span>
                <span style="height:88%"></span>
                <span style="height:64%"></span>
                <span style="height:92%"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- DEMO SUB-BLOCK (único de esta página) -->
  <section class="demo-block" id="demo">
    <div class="demo-block__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="demo-block__head">
        <span class="demo-block__eyebrow">Demo del dashboard en 24h</span>
        <h2 class="demo-block__title">Te mostramos cómo se ve con un evento real de tu rubro.</h2>
        <p class="demo-block__sub">¿Qué necesitas ver primero?</p>
      </div>
      <div class="demo-block__grid">
        {demoOptions.map(opt => (
          <a class="demo-chip" href="#contacto">
            <span class="demo-chip__icon">{opt.icon}</span>
            <span class="demo-chip__label">{opt.label}</span>
          </a>
        ))}
      </div>
      <div class="demo-block__cta">
        <a href="#contacto" class="btn btn--primary">Quiero la demo →</a>
      </div>
    </div>
  </section>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productores que operan con dashboards Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","FIFA U-20 🇨🇱","Teatro UC 🇨🇱","AFA 🇦🇷","Ñam Festival 🇨🇱","Audax Italiano 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE / TESIS (excepción mantenida del wireframe) -->
  <section class="bridge">
    <div class="container">
      <span class="bridge__eyebrow">12 años operando data analytics en LATAM</span>
      <h2 class="bridge__title">Decisiones con dato, no con intuición.</h2>
      <p class="bridge__sub">El dato existe. La pregunta es si te llega a tiempo, si confías en él y si sabes qué hacer con él.</p>
    </div>
  </section>

  <!-- OVERVIEW DE LAS 3 FASES -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu data vive en 3 fases.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Cada una resuelve un problema distinto.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver fase →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FASE 01 · VISIBILIDAD -->
  {(() => {
    const p = fases[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #1 · Live entry rate -->
  <section class="spotlight spotlight--brand" id="live-entry">
    <div class="container">
      <span class="spotlight__eyebrow">Único · Feature diferenciador puro</span>
      <h2 class="spotlight__title">Buscas saber el no-show mientras pasa, no después. Encuentras live entry rate: tickets validados vs vendidos en tiempo real.</h2>
      <p class="spotlight__body">No-show rate en vivo. Sirve para liberar entradas de cortesía no usadas durante el evento, ajustar staff en puertas y prevenir cuellos de botella. Welcu y Passline solo muestran no-show post-evento — Ticketplus lo muestra mientras pasa.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">No-show en vivo</h4>
          <p class="spotlight-card__text">Tickets validados vs vendidos al segundo. Sabés en cada momento cuánta gente ya entró y cuánta cortesía no se está usando.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Liberar cortesías rescatables</h4>
          <p class="spotlight-card__text">Cortesías no usadas se pueden liberar durante el evento. Ajustás staff en puertas y prevenís cuellos de botella en accesos críticos.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">vs Welcu/Passline post-evento</h4>
          <p class="spotlight-card__text">Las otras ticketeras te muestran el no-show al día siguiente. Ticketplus te lo muestra mientras el evento todavía está corriendo.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FASE 02 · ATRIBUCIÓN -->
  {(() => {
    const p = fases[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #2 · Atribución nativa GA4 + SEMrush -->
  <section class="spotlight spotlight--dark" id="atribucion-nativa">
    <div class="container">
      <span class="spotlight__eyebrow">End-to-end nativo · vs Eventbrite / Welcu</span>
      <h2 class="spotlight__title">Buscas saber de qué canal vino cada ticket — no cada sesión. Encuentras pixel propio que enriquece GA4 con datos de pasarela.</h2>
      <p class="spotlight__body">GA4 te dice qué sesión convirtió, no qué transacción. El pixel propio de Ticketplus enriquece GA4 con datos de pasarela (revenue real, refunds, no-show). Reportes cruzados con menor pérdida vs ITP / cookies bloqueadas. Sin doble disparo, sin UTMs rotos, sin "el pixel está caído otra vez". Modelos last-click, first-click o data-driven configurables.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Pixel propio enriquece GA4</h4>
          <p class="spotlight-card__text">No es un addon ni un plugin de terceros. Pixel propio de Ticketplus que conecta con GA4 + SEMrush nativamente. Sin doble disparo, sin UTMs rotos.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Revenue real + refunds + no-show</h4>
          <p class="spotlight-card__text">Datos de pasarela en la atribución: revenue confirmado, refunds, no-show. Sabés qué canal trae compradores reales — no solo sesiones.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">vs ITP / cookies bloqueadas</h4>
          <p class="spotlight-card__text">Menor pérdida de atribución vs ITP de Safari y cookies bloqueadas. End-to-end del click al ticket vendido, no del click a la sesión.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FASE 03 · ACCIÓN -->
  {(() => {
    const p = fases[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}
  <!-- PROMESA TICKETPLUS -->
  <PromesaTicketplus
    title="El día del drop, el dashboard no se cae."
    body="Mientras se venden 50K tickets en 35 minutos, el productor mira ventas por minuto, sector más vendido y conversión en tiempo real, desde su celular. <strong>Sin lag, sin &quot;actualizando&quot;, sin esperar al reporte del lunes.</strong>"
    ctaLabel="Ver soporte presencial →"
    ctaHref="/servicios/trust-service"
  />

  <!-- POR QUÉ TICKETPLUS DATA -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus Data</span>
        <h2 class="why-tp__title">Dashboards que sirven el lunes Y durante el drop.</h2>
        <p class="why-tp__lead">La diferencia no es la cantidad de gráficos. Es que la data llega a tiempo, se confía en ella y se puede exportar.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Pedir demo del dashboard →</a>
      </div>
    </div>
  </section>

  <!-- CASOS POR INDUSTRIA -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Casos por industria</span>
        <h2 class="verticals__title">Data analytics por tipo de evento.</h2>
        <p class="why-tp__lead">La capability se aplica a cada vertical con sus particularidades y KPIs específicos.</p>
      </div>
      <div class="verticals__grid verticals__grid--rich">
        {industries.map((v) => (
          <a class="verticals__card verticals__card--link" href={v.href}>
            <div class="verticals__icon">{v.icon}</div>
            <div class="verticals__text">
              <h3 class="verticals__label">{v.label}</h3>
              <p class="verticals__body">{v.body}</p>
            </div>
            <span class="verticals__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu reportería</p>
          <h2 class="section__title">Buscas ver el dashboard antes de comprarlo. Encuentras una demo con un evento real similar al tuyo.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Demo del dashboard en menos de 24 horas. Sin slides genéricos.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Pedir demo del dashboard</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Empresa / Productora","text","Nombre de tu productora"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
