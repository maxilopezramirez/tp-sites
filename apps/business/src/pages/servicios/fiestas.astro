---
import Site from "../../layouts/Site.astro";
import AmplificaSection from "../../components/AmplificaSection.astro";
import EquipoSection from "../../components/EquipoSection.astro";
import AppManagerHero from "../../components/AppManagerHero.astro";

// 3 momentos temporales (en vez de los 5 pilares verbo de Full Op)
const moments = [
  {
    n: "01", tag: "LA PREVENTA", dark: false, id: "preventa",
    title: "Buscas vender entradas anticipadas.",
    lead: "Encuentras las herramientas para que tu curva no dependa del impulso de última hora. 70% del revenue puede llegar en preventa.",
    heroCount: 1,
    features: [
      { n: "01", title: "Cortesías masivas", body: "Invitaciones bulk con tracking de aperturas, conversión y comportamiento por lista.", badge: null, captionTag: "Cortesías" },
      { n: "02", title: "Pre-inscripciones", body: "Lista de espera con aprobación individual o preventa exclusiva con aprobación masiva. Solo los aprobados compran.", badge: null, newGroup: true },
      { n: "03", title: "Creación de vendedores y referidos", body: "Las ventas de cada referido o embajador queda separada y disponible en tiempo real, así puedes potenciar las ventas de tu evento de manera ordenada y efectiva.", badge: null },
      { n: "04", title: "Tipos de ticket y combos", body: "Early bird, general, VIP, mesas — el flujo que tu fiesta necesite. Bundles con consumo y cortesías masivas.", badge: null },
      { n: "05", title: "Carta de consumibles", body: "Vende alimentos y bebidas integrados al checkout. Ventas complementarias que aumentan el ticket promedio y la rentabilidad de la fiesta.", badge: null },
    ],
  },
  {
    n: "02", tag: "LA NOCHE", dark: true, id: "noche",
    title: "Buscas que la fila avance y la barra no colapse.",
    lead: "Encuentras el venue operado entero. Tenemos todo bajo control mientras tú estás ocupándote del evento.",
    heroCount: 2,
    features: [
      { n: "01", title: "Validación offline en puerta", body: "App iOS + Android con validación QR <2s incluso bajo tierra. Modo offline con auto-sync y detección instantánea de duplicados.", badge: "Único — funciona bajo tierra", captionTag: "Validación QR" },
      { n: "02", title: "POS y tótems de autoatención", body: "POS para barras y mesas, tótems self-service con cashless NFC. Stock unificado con tu venta online — cero desincronización.", badge: null, captionTag: "Stock unificado" },
      { n: "03", title: "Blacklists y control de aforo en vivo", body: "Lista negra de fans problemáticos por sector. Aforo en vivo desde dashboard — sabes el ocupancy real en cada minuto.", badge: null, newGroup: true },
      { n: "04", title: "Dashboard en vivo desde el celular", body: "Revenue, validaciones, entrada por puerta y stock de barra en tu celular. Sin abrir el laptop.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL DÍA SIGUIENTE", dark: false, id: "dia-siguiente",
    title: "Buscas saber cómo te fue.",
    lead: "Encuentras la data lista para decidir la próxima fiesta. La próxima fiesta empieza el lunes después del evento.",
    heroCount: 0,
    features: [
      { n: "01", title: "Atribución por canal de venta", body: "Stories, DJs, influencers, paid media — sabes qué canal trajo cada ticket. Para decidir el media buy de la próxima fiesta.", badge: null },
      { n: "02", title: "Base de datos lista para la próxima preventa", body: "Todos los compradores segmentados por tipo de ticket, ciudad, hora de compra. Listos para email/SMS antes del próximo drop.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · Preventa", title: "Convoca a tu público antes de abrir puertas.", href: "#preventa" },
  { tag: "02 · La noche", title: "Validación, POS y tótems en sala.", href: "#noche" },
  { tag: "03 · Día siguiente", title: "Data para la próxima edición.", href: "#dia-siguiente" },
];

const whyCards = [
  // Life ring / staff support
  { iconPath: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4.9 4.9l4.3 4.3M14.8 14.8l4.3 4.3M19.1 4.9l-4.3 4.3M9.2 14.8l-4.3 4.3", title: "Staff en terreno", body: "Operador Ticketplus en sala manejando puerta, validación, POS y tótems." },
  // Trending up / marketing
  { iconPath: "M3 17l6-6 4 4 8-8M14 7h7v7", title: "Marketing Booster incluido", body: "Campañas operadas por nosotros sin costo extra. ROAS medido por evento." },
  // Database / users growing
  { iconPath: "M4 6c0-1.7 3.6-3 8-3s8 1.3 8 3v12c0 1.7-3.6 3-8 3s-8-1.3-8-3V6zM4 6c0 1.7 3.6 3 8 3s8-1.3 8-3M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3", title: "Tu base de datos crece con cada fiesta", body: "La próxima preventa arranca con público segmentado, no desde cero." },
  // Phone / single contact
  { iconPath: "M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92z", title: "Un solo responsable", body: "Un punto único de contacto antes, durante y después." },
];

const checklist = [
  "Sin contratos de permanencia",
  "POS y tótems según necesidad del venue",
  "Marketing Booster gestionado incluido",
  "Onboarding completo en 1-2 semanas",
  "Staff Ticketplus en sala el día del evento",
  "Liquidación automática 48-72h post-evento",
];

const faqs = [
  { q: "¿Aguanta el last-minute (40-60% en últimas 48h)?", a: "Sí. Infraestructura auto-escalable probada en drops de 320K tickets/día. La capacidad del servidor no es el cuello de botella; sí lo son los medios de pago, por eso integramos múltiples gateways." },
  { q: "¿Cómo evito tickets falsos o duplicados?", a: "QR único por ticket, detección instantánea de duplicados en la app de validación, blacklist por fan. Si alguien intenta entrar con un QR ya validado, la app lo marca al instante." },
  { q: "¿Sirven tótems para aforo chico?", a: "Honestamente, en fiestas con menos de 500 personas suele no compensar el costo. Recomendamos POS móvil + QR. Tótems brillan cuando el flujo en barras supera 50 ventas/hora simultáneas." },
  { q: "¿Puedo lanzar preventa solo para mi WhatsApp?", a: "Sí. Promo codes únicos o preventa exclusiva con aprobación masiva. Solo quienes tienen el código compran en esa ventana — el resto espera la apertura general." },
];
---
<Site title="Servicios Ticketplus · Fiestas — Operación completa para tu próxima fiesta">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Fiestas</p>
        <h1 class="biz-hero__title">La plataforma de venta para tu próxima fiesta.</h1>
        <p class="biz-hero__lead">Validación en puerta en 2 segundos, POS y tótems de autoatención, promo codes flash y staff Ticketplus en sala.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar mi fiesta →</a>
          <a href="#preventa" class="btn btn--ghost">Ver capacidades</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/verticals/vertical-fiestas.jpg`} alt="Productora operando una fiesta nocturna con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras que operan sus fiestas con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Productora Eclipse 🇨🇱","Open Cl 🇨🇱","Nocturna 🇨🇱","Subground 🇨🇱","Resaca Crew 🇨🇱","Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW · 3 momentos de la fiesta -->
  <section class="fiesta-overview">
    <div class="container">
      <header class="fiesta-overview__header">
        <h2 class="fiesta-overview__title">Una plataforma. Toda la noche.</h2>
        <p class="fiesta-overview__lead">Tu fiesta vive tres momentos: la preventa, la noche y el día siguiente.</p>
      </header>
      <div class="fiesta-overview__grid">
        <article class="fiesta-overview__card">
          <span class="fiesta-overview__card-tag">01 · PREVENTA</span>
          <h3 class="fiesta-overview__card-title">Convoca a tu público antes de abrir puertas</h3>
          <p class="fiesta-overview__card-body">Pre-inscripciones para filtrar a tu público y proteger tu nicho, preventas exclusivas para tu base fidelizada y promo codes flash para inflar la curva sin quemar margen.</p>
          <a class="fiesta-overview__card-link" href="#preventa">
            Ver preventa
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
        <article class="fiesta-overview__card">
          <span class="fiesta-overview__card-tag">02 · LA NOCHE</span>
          <h3 class="fiesta-overview__card-title">Validación rápida + POS y tótems de autoatención</h3>
          <p class="fiesta-overview__card-body">Filas que avanzan en segundos, barras y mesas que cobran con POS integrado, tótems self-service y blacklists que se aplican en vivo.</p>
          <a class="fiesta-overview__card-link" href="#noche">
            Ver la noche
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
        <article class="fiesta-overview__card">
          <span class="fiesta-overview__card-tag">03 · DÍA SIGUIENTE</span>
          <h3 class="fiesta-overview__card-title">Data para la próxima edición</h3>
          <p class="fiesta-overview__card-body">Ventas por canal, mejor hora de lanzamiento, cuánto consumió cada asistente en la barra. La data que decide tu próximo evento.</p>
          <a class="fiesta-overview__card-link" href="#post-evento">
            Ver post-evento
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.33 8h9.34M8.67 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · LA PREVENTA -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <AmplificaSection />

  <!-- CTA bridge (entre Preventa y La noche) -->
  <section class="spotlight spotlight--brand" id="cta-mid">
    <div class="container">
      <h2 class="spotlight__title">Tu fiesta. Tu noche. Operación probada.</h2>
      <p class="spotlight__body">Cotización en menos de 24 horas hábiles. Sin compromiso.</p>
      <a href="#contacto" class="cta-bridge-btn">Cotizar mi fiesta →</a>
    </div>
  </section>

  <!-- MOMENTO 02 · LA NOCHE -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const stageKind = "scanner";
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              const stage = g.heroIdx === 0 ? "scanner" : "venue";
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class={`scene-stage scene-stage--${stage}`} aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 03 · EL DÍA SIGUIENTE -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <AppManagerHero />

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <EquipoSection />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibes cuando contratas Ticketplus para tu fiesta.</h2>
        <p class="why-tp__lead">No vendemos software de tickets. Operamos tu fiesta end-to-end con un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={w.iconPath} />
              </svg>
            </div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar mi fiesta →</a>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu próxima fiesta</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu fiesta, aforo y tipo de público.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles. Sin compromiso.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar mi fiesta</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Productora / colectivo","text","Nombre de tu marca"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de fiesta</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Open</option>
              <option>Techno</option>
              <option>Electrónica</option>
              <option>Reggaeton</option>
              <option>Eventos privados</option>
              <option>Otro</option>
            </select>
          </div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Aforo esperado</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Menos de 500</option>
              <option>500 – 1.500</option>
              <option>1.500 – 3.000</option>
              <option>3.000 – 5.000</option>
              <option>Más de 5.000</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar mi fiesta →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
