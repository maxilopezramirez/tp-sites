---
import Site from "../../layouts/Site.astro";
import EquipoSection from "../../components/EquipoSection.astro";
import AmplificaSection from "../../components/AmplificaSection.astro";

// 4 momentos operativos del centro familiar
const moments = [
  {
    n: "01", tag: "MARKETING & CONVOCATORIA", dark: false, id: "marketing",
    title: "Buscas llenar la función.",
    lead: "Encuentras campañas operadas + promo codes + emails segmentados. Para llenar cada horario, no solo el del estreno.",
    heroCount: 1,
    features: [
      { n: "01", title: "Gestión de horarios y temporadas recurrentes", body: "Configura tu calendario completo en una vista única: días de operación, múltiples funciones por día, temporada alta y baja, fines de semana extendidos. Cada horario con su cupo, su pricing y sus reglas — sin reconfigurar evento a evento.", badge: null, captionTag: "Calendario recurrente" },
      { n: "02", title: "Promo codes por función y por canal", body: "Códigos únicos por horario, sponsor o medio. Atribución end-to-end al ticket vendido.", badge: null, newGroup: true },
      { n: "03", title: "Email automático a tu base con segmentación familiar", body: "Segmentación por edades de hijos, frecuencia, función preferida. Templates listos.", badge: null },
      { n: "04", title: "Bundles familiares y add-ons", body: "Combo entrada + popcorn + foto + meet&greet en un solo checkout. Aumenta ticket promedio.", badge: null },
    ],
  },
  {
    n: "02", tag: "AFORO & HORARIOS", dark: true, id: "aforo",
    title: "Buscas no pasarte de cupo.",
    lead: "Encuentras smart time slot management en tiempo real. \"El show de las 4 está vendido pero el de las 6 está al 30%\". Lo sabes en tiempo real.",
    heroCount: 0,
    features: [
      { n: "01", title: "Aforo en tiempo real por sector", body: "Inflables, show, área de comida — aforo independiente por zona. Dashboard en vivo.", badge: null, captionTag: "Aforo en vivo" },
      { n: "02", title: "Validación rápida y multi-acceso", body: "App QR <2s con detección de re-entrada y anti-doble ingreso entre horarios.", badge: null },
      { n: "03", title: "Reprogramación de horarios sin caos", body: "Lluvia, técnico, artista enfermo → migración automática de tickets al próximo horario disponible con notificación al cliente.", badge: null },
    ],
  },
  {
    n: "03", tag: "OPERACIÓN MULTI-CANAL", dark: false, id: "operacion",
    title: "Buscas operar todos los canales — taquilla, online y autoservicio — sin descuadres.",
    lead: "Encuentras un solo inventario en todos los canales. Cuatro herramientas para que el inventario no se descuadre nunca.",
    heroCount: 0,
    features: [
      { n: "01", title: "POS para boletería con inventario unificado", body: "POS web/Android para boletería física. Mismo stock que sitio web y tótem en tiempo real.", badge: null },
      { n: "02", title: "e-commerce con bundles y envío a domicilio", body: "Productos físicos y bundles ticket+merch. Couriers integrados, retiro en venue como opción.", badge: null },
      { n: "03", title: "Dashboard unificado por canal", body: "Web, boletería, tótem, e-commerce — ventas y stock por canal en una sola vista en vivo.", badge: null },
    ],
  },
  {
    n: "04", tag: "FIDELIZACIÓN", dark: true, id: "fidelizacion",
    title: "Buscas que la familia vuelva.",
    lead: "Encuentras pases anuales, cumpleaños y CRM segmentado. La familia que va una vez es cliente. La que tiene pase anual es fan.",
    heroCount: 0,
    features: [
      { n: "01", title: "Pase anual y abonos de temporada con credencial QR", body: "Credencial física y virtual con QR ligado al estado del socio. Control de acceso en puerta en tiempo real.", badge: null },
      { n: "02", title: "CRM con histórico por familia", body: "Visitas, shows preferidos, edades de los niños, frecuencia. Segmentación lista para próximas campañas.", badge: "Data histórica disponible" },
    ],
  },
];

const overview = [
  { tag: "Marketing & convocatoria", title: "Llena cada función, no solo el estreno.", href: "#marketing" },
  { tag: "Aforo & horarios", title: "Configuración de días y horarios para eventos recurrentes.", href: "#aforo" },
  { tag: "Operación multi-canal", title: "POS + tótem + e-commerce con un único inventario.", href: "#operacion" },
  { tag: "Fidelización", title: "Pases anuales y membresías para la familia que vuelve.", href: "#fidelizacion" },
];

const whyCards = [
  { icon: "🎟️", title: "Multi-canal real", body: "Sitio + boletería + tótem + e-commerce con el mismo inventario." },
  { icon: "⏰", title: "Cupos por horario", body: "Si se llena, se cierra solo. Cero gente afuera." },
  { icon: "🔄", title: "Membresías recurrentes", body: "OneClick para pases anuales y bonos." },
  { icon: "💰", title: "Sin costos ocultos", body: "Tótem, software y soporte incluidos en el cargo por servicio." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques familiares" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Migración de base de clientes",
  "Tótems configurables sin licencia extra",
  "Capacitación a equipo de boletería",
  "Onboarding completo en 3-4 semanas",
  "Membresías OneClick incluidas",
  "Soporte 24/7 con account manager dedicado",
];

const faqs = [
  { q: "¿Cómo evito sobreventa con 4-5 funciones al día?", a: "Cupos por horario con auto-cierre. Cada horario tiene capacidad propia; cuando se llena, se bloquea automáticamente en todos los canales (web, POS, tótem). Cero overbooking entre funciones." },
  { q: "¿Puedo cobrar el pase anual sin tener que pasar la tarjeta cada mes?", a: "Sí — OneClick recurrente. Cliente paga una vez, la tarjeta queda guardada, las siguientes cuotas se cobran solas. Con período de gracia + perdonazo manual si una tarjeta falla." },
  { q: "¿El tótem realmente reduce filas o es solo marketing?", a: "Reduce fila 60-70% según data de centros operando con Ticketplus. La razón: cada tótem opera 4-6 transacciones por minuto con pago de tarjeta integrado. Un cajero promedio hace 2-3. El upsell automático (combo helado, parking) aumenta el ticket promedio entre 18-25%." },
  { q: "¿Cómo manejo cancelación masiva por lluvia sin colapsar?", a: "Migración automática: con un click reprogramás el horario y todos los compradores reciben notificación con su nuevo ticket. Si quieren reembolso, lo solicitan desde un link. Cero atención manual." },
  { q: "¿Puedo reservar cumpleaños y eventos privados desde la misma plataforma?", a: "Sí. Configurás paquetes (animador, decoración, comida, salón) con disponibilidad por día y hora. La familia elige y paga online, queda confirmado al instante en tu calendario interno." },
];
---
<Site title="Servicios Ticketplus · Centros familiares — Operación continua para tu parque, circo o show">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Centros familiares</p>
        <h1 class="biz-hero__title">La tecnología que opera tu centro familiar, función tras función, todos los días.</h1>
        <p class="biz-hero__lead">Cupos por horario con auto-cierre, tótem autoservicio que reduce fila 60-70%, membresías con OneClick y multi-canal sobre un único inventario.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi centro →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}verticals/vertical-familiar.jpg`} alt="Centro familiar operando con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Centros familiares que operan con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Parque Aventura 🇨🇱","Circo Estelar 🇨🇱","Feria Kids 🇨🇱","Mundo Mágico 🇨🇱","Show Infantil Tour 🇨🇱","Parque Familia 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 4 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu centro opera todos los días.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Cuatro ejes operativos. Las herramientas se activan según los necesites.</p>
      </div>
      <div class="biz-promises__grid biz-promises__grid--4">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · MARKETING & CONVOCATORIA -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 02 · AFORO & HORARIOS -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 03 · OPERACIÓN MULTI-CANAL -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 04 · FIDELIZACIÓN -->
  {(() => {
    const p = moments[3];
    const pi = 3;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <AmplificaSection />

  <EquipoSection />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu centro familiar al cambiarse.</h2>
        <p class="why-tp__lead">Operamos tu centro full op con un solo responsable: web + POS + tótem + soporte.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi centro →</a>
      </div>
    </div>
  </section>


  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu centro</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu tipo de centro y volumen diario.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar para mi centro</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Centro / show","text","Nombre de tu centro o show"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de operación</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Parque temático</option>
              <option>Circo</option>
              <option>Feria kids</option>
              <option>Show infantil itinerante</option>
              <option>Otro</option>
            </select>
          </div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Horarios diarios</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>1-2 funciones/día</option>
              <option>3-4 funciones/día</option>
              <option>5-6 funciones/día</option>
              <option>+6 funciones/día</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar para mi centro →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:var(--gradient-brand); color:#fff; text-align:center; padding:120px 24px;">
    <div class="container">
