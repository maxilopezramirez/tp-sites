---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";

// 3 MODOS paralelos de venta en venue (POS / Tótem / Cashless) — NO son secuenciales, se combinan
const modes = [
  {
    n: "01", tag: "POS · CAJERO ATENDIDO", dark: false, id: "pos",
    title: "Buscas cobrar en tus barras sin caer cuando se cae internet.",
    lead: "Encuentras software de cajeros + modo offline + stock unificado. Software de cajeros para barras, food courts y boletería. Múltiples ubicaciones desde un panel central.",
    heroCount: 0,
    features: [
      { n: "01", title: "Software de cajeros + tablet cashier", body: "Efectivo, cheque, tarjeta, Transbank POS, Integrated POS, contactless + QR. Múltiples métodos en el mismo flujo.", badge: null },
      { n: "02", title: "Multi-ubicación desde panel central", body: "Inventario en tiempo real, alertas de restock, cierre automático, reportes por ubicación.", badge: null },
      { n: "03", title: "Stock unificado online + box office", body: "Sin sobreventa, F&B menu integrado, per-attendee consumption.", badge: "Mismo inventario online + venue" },
    ],
  },
  {
    n: "02", tag: "TÓTEM · AUTOSERVICIO", dark: true, id: "totem",
    title: "Buscas reducir filas y liberar staff.",
    lead: "Encuentras tótems self-service con upselling automático. Tótem 360º con compra táctil, pickup por QR, pagos integrados y branding completo. Sumas capacidad sin sumar staff.",
    heroCount: 0,
    features: [
      { n: "01", title: "Compra táctil sin box-office humano", body: "Touch-screen, pickup por QR o código, control 360º de consumibles.", badge: null },
      { n: "02", title: "Pagos integrados en pantalla", body: "Crédito, débito, digital, Apple Pay + Google Pay express, sin redirect.", badge: null },
      { n: "03", title: "Upselling en pantalla", body: "Smart Showcase, cross-sell automático ticket + bebida, merch + experiencia.", badge: "+18-25% ticket promedio" },
      { n: "04", title: "Branding propio + impresión de credencial", body: "Impresión personalizada de credenciales en el tótem para conferencias y eventos pro.", badge: null },
    ],
  },
  {
    n: "03", tag: "CASHLESS · APP CON ONECLICK", dark: false, id: "cashless",
    title: "Buscas que el fan pague en cualquier barra sin volver a digitar.",
    lead: "Encuentras app Cashless con OneClick + tracking por asistente. El fan paga con un click — el dato vuelve a ti.",
    heroCount: 0,
    features: [
      { n: "01", title: "Datos de consumo por asistente", body: "La data alimenta próxima preventa + retargeting de Booster + reportes por sector.", badge: null },
      { n: "02", title: "Control de consumo por asistente", body: "Per-attendee consumption control, cross-benefits con store y ticketing.", badge: null },
      { n: "03", title: "Cross-benefits con store y ticketing", body: "Abonado/socio con descuento automático en barras, puntos Wallet acumulables, Smart Promotions.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · POS", title: "Cajero atendido en barras, food courts y boletería.", href: "#pos" },
  { tag: "02 · Tótem", title: "Self-service que reduce filas y libera staff.", href: "#totem" },
  { tag: "03 · Cashless", title: "App con tarjeta OneClick. El fan enrola una vez, paga en todo el venue.", href: "#cashless" },
];

const whyCards = [
  { icon: "⚡", title: "Modo offline real", body: "El cajero no se detiene porque el WiFi del venue es malo." },
  { icon: "💳", title: "OneClick en Cashless", body: "El fan paga sin recargar, sin saldos, sin devoluciones." },
  { icon: "🔌", title: "Hardware compatible", body: "Verifone, Transbank POS, tablets existentes." },
  { icon: "📊", title: "Stock unificado", body: "Online + box office sobre el mismo inventario. Cierre automático." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "App Cashless con OneClick, food courts multi-punto, tótems pickup masivo.", href: "/servicios/festivales" },
  { icon: "🏟️", label: "Estadios / Arenas", body: "POS por sector, cashless socio, boletería integrada.", href: "/servicios/espectaculo" },
  { icon: "🎡", label: "Centros familiares", body: "Tótem entrada + POS atracciones + cashless familiar.", href: "/servicios/familiar" },
  { icon: "🎭", label: "Teatros", body: "Boletería box office unificada con venta online, F&B foyer.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Clubes deportivos", body: "Cashless socio con descuentos automáticos, POS sectores fan.", href: "/servicios/deportes" },
  { icon: "💼", label: "Congresos", body: "Tótem acreditación + impresión de credencial + control consumo.", href: "/servicios/conferencias" },
];

const checklist = [
  "Compatible con tu hardware existente",
  "Modo offline real — el cajero no se detiene",
  "Stock unificado online + box office",
  "Branding completo (colores, logos, flujos)",
  "Activación modular (solo POS / solo tótem / solo cashless o combinados)",
  "Cierre de caja automático al fin del evento",
];

const faqs = [
  { q: "¿El POS funciona sin internet?", a: "Sí, offline real. La venta sigue cobrando si se cae el WiFi del venue. Auto-sync al reconectar — sin pérdida de transacciones, inventario reconciliado automáticamente. <strong>Diferenciador clave vs ticketeras con \"modo degradado\".</strong>" },
  { q: "¿Tengo que comprar hardware Ticketplus o sirve el que ya tengo?", a: "El que ya tienes. Compatible con Verifone, Transbank POS, tablets existentes (iPad, Android). Hacemos audit de tu hardware antes del onboarding — no tirás nada." },
  { q: "¿El Cashless con OneClick funciona si se cae internet?", a: "El cobro funciona offline — la transacción queda guardada y se procesa al reconectar. La recarga inicial o el enrolamiento de tarjeta sí requieren conexión (es un paso único). En la práctica, el fan enrola desde su casa o conectando al WiFi del venue al llegar; después usa Cashless toda la noche sin necesidad de internet en cada compra." },
  { q: "¿Puedo activar solo POS, solo tótem o solo cashless?", a: "Sí — activación modular. Eliges los modos que tu venue necesita y se combinan según convenga (por ejemplo: POS en barras principales + tótem en barras secundarias + cashless para socios VIP). Cada modo se factura por uso, sin licencia mínima." },
  { q: "¿Cómo se reconcilia el cierre de caja cuando combino los 3 modos?", a: "Cierre automático al final del evento. Todas las transacciones (POS, tótem, cashless, offline pendientes de sync) consolidadas en un solo reporte. Reconciliación con stock real, alertas de discrepancias, exportable a Excel/CSV/SII." },
];
---
<Site title="Servicios Ticketplus · POS y Tótem — Venta en venue con modo offline real y OneClick">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">POS y Tótem · Venta en venue</p>
        <h1 class="biz-hero__title">Punto de venta y tótem de autoservicio — para optimizar la venta en tu evento.</h1>
        <p class="biz-hero__lead">POS atendido en barras y boleterías, tótems self-service que reducen filas, app Cashless con tarjeta OneClick. Modo offline real en todos. Hardware compatible con Verifone, Transbank POS y tablets existentes.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar POS y Tótem →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <div class="biz-hero__placeholder" aria-hidden="true">
          <div class="biz-hero__placeholder-glow"></div>
        </div>
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Venues que operan su venta con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","Lollapalooza 🇨🇱","Ñam Festival 🇨🇱","Estadio Nacional 🇨🇱","Fantasilandia 🇨🇱","Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MODOS (paralelos, NO secuenciales) -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tres maneras de cobrar en tu venue.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Eliges las que tu operación necesita — pueden combinarse.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MODO 01 · POS — CAJERO ATENDIDO -->
  {(() => {
    const p = modes[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">MODO {p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #1 · Modo offline real -->
  <section class="spotlight spotlight--brand" id="offline">
    <div class="container">
      <span class="spotlight__eyebrow">Diferenciador clave</span>
      <h2 class="spotlight__title">Buscas que el cajero no se detenga porque el WiFi del venue es malo. Encuentras modo offline real con auto-sync.</h2>
      <p class="spotlight__body">Si se cae internet en una barra, la venta sigue. Auto-sync al reconectar — sin pérdida de transacciones. Inventario reconciliado automáticamente. El cajero no se detiene porque el WiFi del venue es malo.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Venta sigue sin internet</h4>
          <p class="spotlight-card__text">La transacción se procesa local en el POS o tablet cashier. El fan paga, la impresora ticketea, el inventario se descuenta. Sin ventana de "vuelve en 5 minutos".</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Auto-sync al reconectar</h4>
          <p class="spotlight-card__text">Cuando el WiFi vuelve, todas las transacciones offline se sincronizan en background. Cero intervención del cajero. Cero pérdida de transacciones.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Inventario reconciliado automáticamente</h4>
          <p class="spotlight-card__text">El stock unificado se actualiza con las transacciones offline al reconectar. Alertas de discrepancias para que el responsable de barra audite si es necesario.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MODO 02 · TÓTEM — AUTOSERVICIO -->
  {(() => {
    const p = modes[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">MODO {p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MODO 03 · CASHLESS — APP CON ONECLICK -->
  {(() => {
    const p = modes[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">MODO {p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #2 · App Cashless con tarjeta OneClick -->
  <section class="spotlight spotlight--dark" id="oneclick">
    <div class="container">
      <span class="spotlight__eyebrow">Único en CL · Sin saldos prepago</span>
      <h2 class="spotlight__title">Buscas que el fan no haga fila para recargar saldo. Encuentras OneClick — enrola la tarjeta una vez, paga en todo el venue.</h2>
      <p class="spotlight__body">El fan descarga la app, enrola su tarjeta una vez (OneClick Webpay, MercadoPago o equivalente) y queda listo para pagar en cualquier barra, food court o tótem del venue sin volver a digitar. Sin manejo de saldos prepago, sin devoluciones a procesar al final del festival. Cada compra queda atada al perfil del fan — data lista para loyalty + Booster del próximo evento.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Enrolamiento OneClick único</h4>
          <p class="spotlight-card__text">El fan enrola su tarjeta una vez con OneClick Webpay, MercadoPago o equivalente. Después paga con un tap en cualquier punto del venue, sin volver a digitar.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Sin saldos prepago</h4>
          <p class="spotlight-card__text">No hay recargas, no hay devoluciones a procesar post-evento. El fan paga lo que consume — ni un peso más, ni un peso atrapado en saldo no usado.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Tracking per-attendee</h4>
          <p class="spotlight-card__text">Cada compra queda atada al perfil del fan. Data lista para loyalty, retargeting de Booster en próximo evento, y reportes de consumo por sector.</p>
        </article>
      </div>
    </div>
  </section>
  <!-- PROMESA TICKETPLUS -->
  <PromesaTicketplus
    title="La barra no se detiene."
    body="Festival sábado 23h, 5.000 personas en barra principal, internet del venue cayó. El POS sigue cobrando offline. El tótem sigue vendiendo. El cashless sigue procesando. Al reconectar, todo se reconcilia automáticamente. <strong>Eso es Ticketplus.</strong>"
    ctaLabel="Conocer Trust & service →"
    ctaHref="/servicios/trust-service"
  />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus POS y Tótem</span>
        <h2 class="why-tp__title">Lo que recibe tu venue al elegir Ticketplus para la venta en sitio.</h2>
        <p class="why-tp__lead">POS + Tótem + Cashless + stock unificado en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar POS y Tótem →</a>
      </div>
    </div>
  </section>

  <!-- CASOS DE USO POR INDUSTRIA (cross-link a verticales) -->
  <section class="industries">
    <div class="container">
      <div class="industries__header">
        <span class="industries__eyebrow">Casos de uso</span>
        <h2 class="industries__title">Venta en venue por industria.</h2>
      </div>
      <div class="industries__grid">
        {industries.map((v) => (
          <a class="industries__card" href={v.href}>
            <div class="industries__icon">{v.icon}</div>
            <h3 class="industries__label">{v.label}</h3>
            <p class="industries__body">{v.body}</p>
            <span class="industries__link">Ver vertical →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu venue</p>
          <h2 class="section__title">Buscas cotizar POS, Tótem o Cashless. Encuentras un plan según puntos de venta, aforo y operación esperada.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar POS y Tótem</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Venue / Recinto","text","Nombre del venue"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Puntos de venta esperados</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>1-3</option>
              <option>4-10</option>
              <option>10-30</option>
              <option>+30</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar POS y Tótem →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:var(--gradient-brand); color:#fff; text-align:center; padding:120px 24px;">
    <div class="container">
      <h2 style="font-family:var(--font-heading); font-size:clamp(2rem,4vw,3rem); font-weight:800; letter-spacing:-0.03em; margin:0 0 14px; line-height:1.1;">Tu venue. Tu operación. Tu tecnología.</h2>
      <p style="font-family:var(--font-body); font-size:1.1rem; opacity:0.92; margin:0 0 36px;">Cotización en menos de 24 horas hábiles. Sin compromiso.</p>
      <a href="#contacto" style="display:inline-block; background:#fff; color:var(--color-text-primary); padding:16px 40px; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:1rem; text-decoration:none;">Cotizar POS y Tótem →</a>
    </div>
  </section>
</Site>

<style>
  /* ── Biz Hero ─────────────────────────────────────────── */
  .biz-hero {
    background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505;
