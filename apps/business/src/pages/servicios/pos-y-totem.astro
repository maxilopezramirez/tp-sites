---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";

// 3 bloques paralelos del sistema POS y Tótem (Tótem / POS / Stock & Compliance)
const modes = [
  {
    n: "01", tag: "TÓTEM AUTOSERVICIO", dark: false, id: "totem",
    title: "Buscas reducir filas y liberar staff.",
    lead: "Tótems con mapa interactivo para venta de tickets, catálogo cashless para compra de menú y QR impreso en el momento, sin cajero, sin papel.",
    heroCount: 0,
    features: [
      { n: "01", title: "Tótem compra con mapa interactivo", body: "Compra de tickets directo desde el tótem con el mapa interactivo del venue. Selecciona butaca, función y sector. Mismo flujo que online, sin cajero.", badge: null },
      { n: "02", title: "Tótem cashless con catálogo", body: "Carga de saldo cashless y compra de menú directo en pantalla. Pago integrado con tarjeta de crédito, débito o GetNet sin pasar por barra.", badge: null },
      { n: "03", title: "Impresión de QR para validación de entrada", body: "Tras la compra, el tótem imprime el QR físico. Validable con la app Ticketplus en puerta en menos de 200 ms.", badge: null },
      { n: "04", title: "Impresión de QR para cashless", body: "Mismo QR sirve para cobrar consumos en barras y food courts. Anclado al saldo del comprador: un solo medio para entrada y consumo.", badge: "1 QR · entrada + cashless" },
    ],
  },
  {
    n: "02", tag: "POS ATENDIDO", dark: true, id: "pos",
    title: "POS con todas las capacidades del sistema.",
    lead: "Software de cajero y boletería con mapa interactivo, funciones de ticketing, descuentos de clubes de fidelización y cobro con tarjeta + propina. Mismo stock que el tótem y el online.",
    heroCount: 0,
    features: [
      { n: "01", title: "POS compra con mapa interactivo", body: "El cajero opera con el mapa del venue igual que el web. Selecciona butaca, función, sector. Reasigna y reimprime entradas en segundos.", badge: null },
      { n: "02", title: "Funciones de ticketing y descuentos", body: "Cortesías, reasignación, promo codes, cross-sell y descuentos de clubes de fidelización aplicados al checkout desde el POS.", badge: null },
      { n: "03", title: "Medios de pago integrados", body: "Tarjeta de crédito, débito, GetNet, propina configurable. Cobro presencial integrado sin abrir otro sistema ni redirect.", badge: null },
      { n: "04", title: "Cashless y ticketing en el mismo POS", body: "Carga de saldo cashless o venta de tickets desde la misma pantalla. Un solo flujo, un solo inventario, un solo cierre de caja.", badge: "Cashless + ticketing unificado" },
    ],
  },
  {
    n: "03", tag: "STOCK UNIFICADO Y COMPLIANCE", dark: false, id: "stock",
    title: "Un inventario, todos los canales, boleta electrónica.",
    lead: "Inventario unificado entre tótem, POS, web y app cashless. Catálogo de F&B, tickets y productos en un solo panel. Boleta o factura electrónica al SII al cerrar la venta.",
    heroCount: 0,
    features: [
      { n: "01", title: "Inventario unificado cashless + carta + ticketing", body: "Catálogo de F&B, tickets de evento y stock de productos sobre la misma base. Cero descalce entre canales: venta en tótem, POS, web o app del comprador descontando del mismo stock.", badge: "Stock real-time multi-canal" },
      { n: "02", title: "Control de catálogo y stock", body: "Edita productos, ajusta precios y vigencias desde un solo panel. Cambios en vivo en tótems, POS y app del comprador, sin re-deploy ni re-carga.", badge: null },
      { n: "03", title: "Clubes de fidelización con descuentos automáticos", body: "El POS y el tótem reconocen socios y abonados al checkout. Aplican el descuento automático sin intervención manual del cajero ni código manual del comprador.", badge: null },
      { n: "04", title: "Boleta electrónica", body: "Emite boletas, facturas y otros documentos electrónicos directo desde tu POS y tótem o desde tu portal de cliente. Sincronizados automáticamente con el SII.", badge: "SII integrado" },
    ],
  },
];

const overview = [
  { tag: "01 · Tótem", title: "Compra autoservicio de tickets y cashless con QR en el momento.", href: "#totem" },
  { tag: "02 · POS", title: "Cajero atendido con mapa, descuentos y cobro integrado.", href: "#pos" },
  { tag: "03 · Stock y compliance", title: "Inventario unificado entre canales + boleta electrónica SII.", href: "#stock" },
];

const whyCards = [
  { icon: "🎟️", title: "Tickets + cashless en un QR", body: "El mismo QR sirve para validar entrada y cobrar consumo en barra." },
  { icon: "📊", title: "Stock unificado", body: "Tótem, POS, web y app cashless sobre el mismo inventario." },
  { icon: "💳", title: "Cobro integrado", body: "Tarjeta de crédito, débito, GetNet y propina configurable." },
  { icon: "🧾", title: "Boleta electrónica SII", body: "DTE automático al cerrar la venta, sin sistema externo." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "App Cashless con OneClick, food courts multi-punto, tótems pickup masivo.", href: "/servicios/festivales" },
  { icon: "🏟️", label: "Estadios / Arenas", body: "POS por sector, cashless socio, boletería integrada.", href: "/servicios/espectaculo" },
  { icon: "🎡", label: "Centros familiares", body: "Tótem entrada + POS atracciones + cashless familiar.", href: "/servicios/familiar" },
  { icon: "🎭", label: "Teatros", body: "Boletería box office unificada con venta online, F&B foyer.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Clubes deportivos", body: "Cashless socio con descuentos automáticos, POS sectores fan.", href: "/servicios/deportes" },
  { icon: "💼", label: "Congresos", body: "Tótem acreditación + impresión de credencial + control consumo.", href: "/servicios/conferencias" },
];

const checklist = [
  "Tótem y POS con mapa interactivo del venue",
  "Inventario unificado cashless + carta + ticketing",
  "Medios de pago: crédito, débito, GetNet, propina",
  "Clubes de fidelización con descuentos automáticos",
  "Impresión de QR para entrada + cashless con un mismo medio",
  "Boleta electrónica integrada con el SII",
];

const faqs = [
  { q: "¿El mismo QR sirve para entrada y para cashless?", a: "Sí. Cuando el comprador imprime el ticket desde el tótem o lo recibe en su app, el mismo QR queda anclado a su saldo de cashless. Lo usa para entrar al evento y para pagar consumos en barras y food courts, sin pulsera adicional, sin recargas presenciales." },
  { q: "¿Qué medios de pago aceptan el POS y el tótem?", a: "Tarjeta de crédito, débito, GetNet integrado, contactless y propina configurable. Cobro presencial sin abrir otro sistema ni redirect. Compatible con Verifone, Transbank POS y tablets existentes." },
  { q: "¿Cómo funciona el stock unificado?", a: "Catálogo de F&B, tickets y productos sobre la misma base. Tótem, POS, web y app cashless descuentan del mismo stock en tiempo real. Cambios de precio o vigencia hechos desde el panel se reflejan en vivo en todos los canales." },
  { q: "¿La boleta electrónica se emite automáticamente?", a: "Sí. Al cerrar la venta en el POS o el tótem se emite el DTE (boleta o factura) y se sincroniza con el SII automáticamente. También podés emitir documentos desde tu portal de cliente. Sin sistema externo, sin reconciliación manual." },
  { q: "¿Cómo reconozco a un socio del club al checkout?", a: "El POS y el tótem identifican al socio por su QR, email o cédula al checkout. Si tiene un descuento de club o un beneficio activo, se aplica automáticamente. Cero código manual, cero intervención del cajero." },
];
---
<Site title="Servicios Ticketplus · POS y Tótem · Mapa interactivo, cashless, ticketing y boleta electrónica">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · POS y Tótem</p>
        <h1 class="biz-hero__title">POS y tótem con cashless, ticketing y boleta electrónica en una sola plataforma.</h1>
        <p class="biz-hero__lead">Tótems con mapa interactivo para venta autoservicio, POS atendido con descuentos de club y medios de pago integrados, inventario unificado entre cashless, carta y ticketing, y boleta electrónica al SII en cada venta.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar POS y Tótem →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <div class="biz-hero__placeholder" aria-hidden="true">
          <div class="biz-hero__placeholder-glow"></div>
        </div>
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Venues que operan su venta con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","Lollapalooza 🇨🇱","Ñam Festival 🇨🇱","Estadio Nacional 🇨🇱","Fantasilandia 🇨🇱","Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MODOS (paralelos, NO secuenciales) -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">El sistema POS y Tótem completo.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Tres bloques de capacidades que se activan juntos o por separado.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MODO 01 · POS — CAJERO ATENDIDO -->
  {(() => {
    const p = modes[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MODO 02 · TÓTEM — AUTOSERVICIO -->
  {(() => {
    const p = modes[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MODO 03 · CASHLESS — APP CON ONECLICK -->
  {(() => {
    const p = modes[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}


  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus POS y Tótem</span>
        <h2 class="why-tp__title">Lo que recibe tu venue al elegir Ticketplus para la venta en sitio.</h2>
        <p class="why-tp__lead">POS + Tótem + Cashless + stock unificado en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar POS y Tótem →</a>
      </div>
    </div>
  </section>

  <!-- CASOS DE USO POR INDUSTRIA (cross-link a verticales) -->
  <section class="industries">
    <div class="container">
      <div class="industries__header">
        <span class="industries__eyebrow">Casos de uso</span>
        <h2 class="industries__title">Venta en venue por industria.</h2>
      </div>
      <div class="industries__grid">
        {industries.map((v) => (
          <a class="industries__card" href={v.href}>
            <div class="industries__icon">{v.icon}</div>
            <h3 class="industries__label">{v.label}</h3>
            <p class="industries__body">{v.body}</p>
            <span class="industries__link">Ver vertical →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu venue</p>
          <h2 class="section__title">Buscas cotizar POS, Tótem o Cashless. Encuentras un plan según puntos de venta, aforo y operación esperada.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar POS y Tótem</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Venue / Recinto","text","Nombre del venue"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Puntos de venta esperados</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>1-3</option>
              <option>4-10</option>
              <option>10-30</option>
              <option>+30</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar POS y Tótem →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:var(--gradient-brand); color:#fff; text-align:center; padding:120px 24px;">
    <div class="container">
      <h2 style="font-family:var(--font-heading); font-size:clamp(2rem,4vw,3rem); font-weight:800; letter-spacing:-0.03em; margin:0 0 14px; line-height:1.1;">Tu venue. Tu operación. Tu tecnología.</h2>
      <p style="font-family:var(--font-body); font-size:1.1rem; opacity:0.92; margin:0 0 36px;">Cotización en menos de 24 horas hábiles. Sin compromiso.</p>
      <a href="#contacto" style="display:inline-block; background:#fff; color:var(--color-text-primary); padding:16px 40px; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:1rem; text-decoration:none;">Cotizar POS y Tótem →</a>
    </div>
  </section>
</Site>

<style>
  /* ── Biz Hero ─────────────────────────────────────────── */
  .biz-hero {
    background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505;
    color: #fff;
    padding: 120px 0;
    position: relative;
  }
  .biz-hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .biz-hero__visual { display: flex; justify-content: center; align-items: center; }
  .biz-hero__placeholder {
    width: 100%;
    max-width: 620px;
    aspect-ratio: 4/3.1;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255,19,19,0.18) 0%, rgba(255,171,36,0.20) 100%),
      linear-gradient(160deg, #1f1408 0%, #0a0a0a 100%);
    border: 1px solid rgba(255,171,36,0.18);
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }
  .biz-hero__placeholder-glow {
    position: absolute; inset: 0;
    background:
      radial-gradient(circle at 22% 28%, rgba(255,19,19,0.45) 0%, transparent 45%),
      radial-gradient(circle at 78% 75%, rgba(255,171,36,0.45) 0%, transparent 45%);
    filter: blur(30px);
  }
  .biz-hero__eyebrow {
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
    margin: 0 0 20px;
  }
  .biz-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    font-weight: 900; letter-spacing: -0.03em; line-height: 1.05;
    color: #fff; margin: 0 0 24px; max-width: 820px;
  }
  .biz-hero__lead {
    font-family: var(--font-body); font-size: 1.1rem;
    color: rgba(255,255,255,0.70); line-height: 1.65;
    max-width: 560px; margin: 0 0 36px;
  }
  .biz-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── Promise cards (TOC 3 modos) ─────────────────────── */
  .biz-promises { background: #fff; padding: 80px 0 20px; }
  .biz-promises__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }
  .promise-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 36px 32px;
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column; gap: 14px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .promise-card:hover {
    transform: translateY(-3px);
