---
import Site from "../../layouts/Site.astro";
import AmplificaSection from "../../components/AmplificaSection.astro";
import EquipoSection from "../../components/EquipoSection.astro";

// 3 momentos del ciclo del show (anuncio / noche del show / día siguiente)
const moments = [
  {
    n: "01", tag: "EL ANUNCIO", dark: false, id: "anuncio",
    title: "Buscas vender sin complicaciones.",
    lead: "Encuentras cola virtual, war room y preventas multi-tier. Vendemos cientos de miles de entradas al año con las funcionalidades más completas del mercado, listas para soportar el pico de demanda de cualquier show.",
    heroCount: 1,
    features: [
      { n: "01", title: "Mapa de localidades del venue", body: "Cada venue con butaca, fila, sector y vista desde el asiento. Reutilizable show a show.", badge: "vs Eventbrite mapa básico", captionTag: "Mapa de localidades" },
      { n: "02", title: "Cola alta demanda", body: "Cola virtual, anti-bot, war room con ingenieros TP el día del lanzamiento. La demanda explota y el sitio aguanta.", badge: null, newGroup: true },
      { n: "03", title: "Multi-moneda CLP + USD para internacionales", body: "Tickets a un artista internacional con precio en USD que se cobra en CLP al tipo de cambio del día (o en USD directo si el cliente lo paga así). Liquidación al artista en USD vía Stripe Connect. Sin tener que abrir cuenta en banco extranjero. Compliance Banco Central Chile.", badge: "Stripe Connect a cuenta extranjera" },
    ],
  },
  {
    n: "02", tag: "LA NOCHE DEL SHOW", dark: true, id: "noche",
    title: "El día del show, cada validación y cada venta corre sin fricción.",
    lead: "Encuentras el venue operado con staff TP en sala. Fila en puerta, validación trabada o butaca duplicada son problemas que no pueden pasar con artista internacional.",
    heroCount: 0,
    features: [
      { n: "01", title: "Validación rápida con respaldo offline", body: "App QR <2s con modo offline, sync al reconectar, multi-acceso coordinado entre puertas.", badge: null },
      { n: "02", title: "Staff Ticketplus el día del evento", body: "Operadores TP capacitados manejando puerta, validación y boletería de última hora.", badge: "vs Welcu/Passline solo software" },
      { n: "03", title: "Cortesías para prensa, sponsors y backstage", body: "Credenciales con QR + foto + categoría, pulseras VIP físicas, tracking en vivo de quién accedió a qué área.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL DÍA SIGUIENTE", dark: false, id: "dia-siguiente",
    title: "Buscas cerrar el show y abrir el próximo.",
    lead: "Tu base de compradores queda lista para la próxima gira.",
    heroCount: 0,
    features: [
      { n: "01", title: "Base de datos para la próxima gira", body: "Tus datos: histórico de compradores con perfil demográfico, ciudad y comportamiento de compra. Exportable, segmentable y listo para activar en la próxima ronda de venta.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · El anuncio", title: "Sitio preparado para el lanzamiento, sea mediano o masivo.", href: "#anuncio" },
  { tag: "02 · La noche del show", title: "Mapa de localidades, validación rápida y staff TP en sala.", href: "#noche" },
  { tag: "03 · El día siguiente", title: "Cierre del evento con consolidación de ventas, atribución por canal y data lista para el próximo show.", href: "#dia-siguiente" },
];

const whyCards = [
  // Lightning bolt (drops sin caídas)
  { iconPath: "M13 2L3 14h7l-1 8 10-12h-7l1-8z", title: "Lanzamientos sin caídas", body: "+320K tickets vendidos en un día sin un solo error." },
  // Dollar sign with circle (multi-moneda)
  { iconPath: "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6", title: "Multi-moneda CLP+USD", body: "Artista internacional con tarifa en USD. Cobro en CLP, liquidación en USD." },
  // Life ring (Staff en terreno)
  { iconPath: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM4.9 4.9l4.3 4.3M14.8 14.8l4.3 4.3M19.1 4.9l-4.3 4.3M9.2 14.8l-4.3 4.3", title: "Staff en terreno", body: "Operadores TP en sala el día del show." },
  // Trending up (Booster)
  { iconPath: "M3 17l6-6 4 4 8-8M14 7h7v7", title: "Booster incluido", body: "Campañas Meta + Google operadas por nosotros sin costo extra." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Alta demanda con war room incluido",
  "Multi-moneda CLP + USD nativo",
  "Booster gestionado en el cargo por servicio",
  "Onboarding completo en 1-3 semanas",
  "Staff Ticketplus en sala el día del show",
  "Liquidación al artista 48-72h post-evento",
];

const faqs = [
  { q: "¿80.000 personas en 5 minutos — el sitio aguanta?", a: "Sí. Probado en +320K tickets vendidos en un solo día. Infraestructura dedicada por evento, simulación de carga 72h antes del lanzamiento, war room con ingenieros TP durante el drop. SLA con penalidades económicas — no es promesa, es contrato." },
  { q: "¿Cuándo y cómo va el staff Ticketplus en el venue?", a: "Día del show, operadores TP en sala manejando puerta, validación y boletería de última hora. Coordinación previa con tu equipo de producción. Cantidad de staff según aforo y complejidad del venue." },
  { q: "¿Puedo correr preventas multi-tier (fan club + banco + Visa + general)?", a: "Sí. Cada segmento con su ventana, su código y su atribución. Reglas claras de prioridad: fan club abre primero, después banco, después Visa, después general. Cada uno ve solo lo que le corresponde." },
  { q: "¿Qué pasa si el artista cancela y hay que devolver masivamente?", a: "Reembolso masivo automático: con un click activamos el flujo de devolución, todos los compradores reciben notificación y el reembolso se procesa en 7-10 días hábiles. Reportes de seguimiento para la productora y el management del artista." },
];
---
<Site title="Servicios Ticketplus · Espectáculos en vivo — Tecnología para tu show de la preventa al aplauso final">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Espectáculos en vivo</p>
        <h1 class="biz-hero__title">La tecnología que opera tu show, desde el anuncio hasta el último ticket validado.</h1>
        <p class="biz-hero__lead">Para recitales, conciertos, stand-up, danza, ópera y shows internacionales. Alta demanda con war room, mapa de localidades, multi-moneda CLP+USD y staff TP en sala.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi show →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/verticals/vertical-espectaculo.jpg`} alt="Show en vivo operado con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras de espectáculos que confían en Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","DG Medios 🇨🇱","Lotus 🇨🇱","T4F 🇨🇱","Bizarro 🇨🇱","Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu show vive tres momentos.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las herramientas se activan según lo necesites.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · EL ANUNCIO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 02 · LA NOCHE DEL SHOW -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}
  <!-- MOMENTO 03 · EL DÍA SIGUIENTE -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <div class="biz-scene__rows">
            {p.features.map((f, fi) => (
              <article class={`scene-row ${fi % 2 === 1 ? 'scene-row--reverse' : ''}`}>
                <div class={`scene-row__stage scene-card__stage--p${pi}-${fi}`} aria-hidden="true">
                  <span class="scene-card__chip">{f.n}</span>
                </div>
                <div class="scene-row__body">
                  <h4 class="scene-row__title">{f.title}</h4>
                  <p class="scene-row__text">{f.body}</p>
                  {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <AmplificaSection />

  <EquipoSection />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu productora al elegir Ticketplus.</h2>
        <p class="why-tp__lead">No vendemos software. Operamos tu show end-to-end con un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={w.iconPath} />
              </svg>
            </div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi show →</a>
      </div>
    </div>
  </section>


  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu próximo show</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu show, venue, artista y volumen esperado.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar para mi show</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Productora","text","Nombre de tu productora"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de show</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Recital</option>
              <option>Concierto</option>
              <option>Stand-up</option>
              <option>Danza</option>
              <option>Ópera</option>
              <option>Show internacional</option>
              <option>Otro</option>
            </select>
          </div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Aforo esperado</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>&lt;1.000</option>
              <option>1.000 – 3.000</option>
              <option>3.000 – 7.000</option>
              <option>7.000 – 15.000</option>
              <option>+15.000</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar para mi show →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:var(--gradient-brand); color:#fff; text-align:center; padding:120px 24px;">
    <div class="container">
      <h2 style="font-family:var(--font-heading); font-size:clamp(2rem,4vw,3rem); font-weight:800; letter-spacing:-0.03em; margin:0 0 14px; line-height:1.1;">Tu show. Tu venue. Operación probada.</h2>
      <p style="font-family:var(--font-body); font-size:1.1rem; opacity:0.92; margin:0 0 36px;">Cotización en menos de 24 horas hábiles. Sin compromiso.</p>
      <a href="#contacto" style="display:inline-block; background:#fff; color:var(--color-text-primary); padding:16px 40px; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:1rem; text-decoration:none;">Cotizar para mi show →</a>
    </div>
  </section>
</Site>

<style>
  /* ── Biz Hero ─────────────────────────────────────────── */
  .biz-hero {
    background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505;
    color: #fff;
    padding: 120px 0;
    position: relative;
  }
  .biz-hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .biz-hero__visual { display: flex; justify-content: center; align-items: center; }
  .biz-hero__devices {
    width: 100%;
    max-width: 620px;
    height: auto;
    display: block;
    border-radius: 16px;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.45));
  }
  .biz-hero__eyebrow {
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
    margin: 0 0 20px;
  }
  .biz-hero__title {
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    font-weight: 900; letter-spacing: -0.03em; line-height: 1.05;
    color: #fff; margin: 0 0 24px; max-width: 820px;
  }
  .biz-hero__lead {
    font-family: var(--font-body); font-size: 1.1rem;
    color: rgba(255,255,255,0.70); line-height: 1.65;
    max-width: 560px; margin: 0 0 36px;
  }
  .biz-hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  /* ── Promise cards (TOC 3 momentos) ─────────────────────── */
  .biz-promises { background: #fff; padding: 80px 0 20px; }
  .biz-promises__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }
  .promise-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 36px 32px;
    text-decoration: none; color: inherit;
    display: flex; flex-direction: column; gap: 14px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .promise-card:hover {
    transform: translateY(-3px);
    border-color: rgba(10,10,10,0.18);
    box-shadow: 0 12px 28px rgba(0,0,0,0.06);
  }
  .promise-card__num {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 0.7rem; font-weight: 800;
    color: var(--color-primary);
    background: rgba(255,19,19,0.08);
    padding: 5px 12px; border-radius: 999px;
    letter-spacing: 0.14em;
  }
  .promise-card__title {
    font-family: var(--font-heading);
    font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; margin: 0;
  }
  .promise-card__link {
    font-family: var(--font-heading); font-size: 0.85rem; font-weight: 700;
    color: var(--color-primary); margin-top: auto;
  }

  /* ── Scenes ────────────────────────────────────────────── */
  .biz-scene { padding: 120px 0; position: relative; overflow: hidden; }
  .biz-scene--light { background: #fff; }
  .biz-scene--dark { background: #0a0a0a; color: #fff; }
  .biz-scene--p0 { background: #fff; }
  .biz-scene--p1 { background: radial-gradient(ellipse at 70% 20%, #1a0c0c 0%, #050505 60%) #050505; color: #fff; }
  .biz-scene--p2 { background: linear-gradient(180deg, #fff 0%, #fafafa 100%); }

  .biz-scene__header { max-width: 760px; margin-bottom: 64px; }
  .biz-scene__eyebrow {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-secondary); margin-bottom: 18px;
  }
  .biz-scene--light .biz-scene__eyebrow { color: var(--color-primary); }
  .biz-scene__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.6vw, 3rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.06; margin: 0 0 20px;
  }
  .biz-scene--dark .biz-scene__title { color: #fff; }
  .biz-scene__lead {
    font-family: var(--font-body); font-size: 1.1rem;
    line-height: 1.6; margin: 0; max-width: 620px;
  }
  .biz-scene--light .biz-scene__lead { color: var(--color-text-muted); }
  .biz-scene--dark .biz-scene__lead { color: rgba(255,255,255,0.72); }

  /* hero composition */
  .biz-scene__hero {
    display: grid; grid-template-columns: 1.15fr 0.85fr;
    gap: 64px; align-items: center; margin-bottom: 72px;
  }
  .biz-scene__hero.is-reverse { grid-template-columns: 0.85fr 1.15fr; }
  .biz-scene__hero.is-reverse .scene-stage { order: 2; }
  .biz-scene__hero.is-reverse .biz-scene__caption { order: 1; }
  .biz-scene__hero + .biz-scene__hero,
  .biz-scene__hero + .biz-scene__grid,
  .biz-scene__grid + .biz-scene__hero { margin-top: 88px; }
  .biz-scene__grid + .biz-scene__grid { margin-top: 28px; }

  .biz-scene__caption-tag {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
    background: rgba(255,171,36,0.10);
    border: 1px solid rgba(255,171,36,0.28);
    padding: 5px 11px; border-radius: 999px; margin-bottom: 18px;
  }
  .biz-scene--dark .biz-scene__caption-tag { background: rgba(255,171,36,0.14); border-color: rgba(255,171,36,0.36); }
  .biz-scene__caption-title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 14px;
  }
  .biz-scene__caption-body {
    font-family: var(--font-body); font-size: 1rem;
    line-height: 1.65; margin: 0 0 18px;
  }
  .biz-scene--light .biz-scene__caption-body { color: var(--color-text-muted); }
  .biz-scene--dark .biz-scene__caption-body { color: rgba(255,255,255,0.72); }

  .biz-scene__badge {
    display: inline-block; font-family: var(--font-heading);
    font-size: 0.7rem; font-weight: 800;
    color: var(--color-secondary);
    background: rgba(255,171,36,0.12);
    border: 1px solid rgba(255,171,36,0.30);
    border-radius: 4px; padding: 4px 10px;
    letter-spacing: 0.06em; text-transform: uppercase; margin-top: 4px;
  }
  .biz-scene--dark .biz-scene__badge { background: rgba(255,171,36,0.15); border-color: rgba(255,171,36,0.40); }

  /* ── Stage (hero mock containers) ──────────────────────── */
  .scene-stage {
    position: relative; border-radius: 16px; overflow: hidden;
    box-shadow: 0 30px 80px rgba(0,0,0,0.18);
    aspect-ratio: 4/3.1;
    background: #f3f3f3;
    border: 1px solid rgba(10,10,10,0.06);
  }
  .biz-scene--dark .scene-stage {
    background: #141414;
    border-color: rgba(255,255,255,0.08);
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
  }
  .scene-stage--showpage { background: linear-gradient(180deg, #f8f7f5 0%, #ecebe7 100%); }
  .scene-stage--venue { background: linear-gradient(160deg, #1f1408 0%, #0a0a0a 100%); }

  /* ── Scene rows (alternating, 1 col [image] + text) ─────── */
  .biz-scene__rows { display: flex; flex-direction: column; gap: 48px; }
  .scene-row {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .scene-row--reverse .scene-row__stage { order: 2; }
  .scene-row--reverse .scene-row__body  { order: 1; }
  .scene-row__stage {
    aspect-ratio: 16/10;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(10,10,10,0.08);
    box-shadow: 0 18px 50px rgba(0,0,0,0.08);
  }
  .biz-scene--dark .scene-row__stage {
    border-color: rgba(255,255,255,0.08);
    box-shadow: 0 18px 50px rgba(0,0,0,0.45);
  }
  .scene-row__stage::before,
  .scene-row__stage::after {
    content: ''; position: absolute;
    border-radius: 50%; filter: blur(28px); opacity: 0.5;
  }
  .scene-row__stage::before {
    width: 55%; height: 75%; top: -8%; left: -8%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }
  .scene-row__stage::after {
    width: 45%; height: 55%; bottom: -8%; right: -8%;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }
  .scene-row__body { display: flex; flex-direction: column; gap: 14px; max-width: 520px; }
  .scene-row--reverse .scene-row__body { margin-left: auto; }
  .scene-row__title {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.2;
    margin: 0;
  }
  .biz-scene--dark .scene-row__title { color: #fff; }
  .scene-row__text {
    font-family: var(--font-body);
    font-size: 1.0625rem; line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
  }
  .biz-scene--dark .scene-row__text { color: rgba(255,255,255,0.7); }
  @media (max-width: 768px) {
    .scene-row { grid-template-columns: 1fr; gap: 24px; }
    .scene-row--reverse .scene-row__stage { order: initial; }
    .scene-row--reverse .scene-row__body { order: initial; margin-left: 0; }
  }

  /* ── Supporting scenes grid (scene-cards) ──────────────── */
  .biz-scene__grid {
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 20px;
  }
  .scene-card {
    grid-column: span 2;
    background: #fff;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px; overflow: hidden;
    display: flex; flex-direction: column;
    transition: transform .2s, box-shadow .2s, border-color .2s;
  }
  .biz-scene--dark .scene-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
  .scene-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(0,0,0,0.08); border-color: rgba(10,10,10,0.18); }
  .biz-scene--dark .scene-card:hover { border-color: rgba(255,255,255,0.18); box-shadow: 0 14px 36px rgba(0,0,0,0.5); }
  .biz-scene__grid--2 .scene-card { grid-column: span 3; }
  .biz-scene__grid--3 .scene-card { grid-column: span 2; }
  .biz-scene__grid--4 .scene-card { grid-column: span 3; }

  .scene-card__stage {
    aspect-ratio: 16/9;
    position: relative;
    background: linear-gradient(135deg, rgba(255,19,19,0.10) 0%, rgba(255,171,36,0.10) 100%);
    overflow: hidden;
  }
  .scene-card__stage::before,
  .scene-card__stage::after {
    content: ''; position: absolute; border-radius: 50%;
    filter: blur(20px); opacity: 0.55;
  }
  .scene-card__stage::before {
    width: 60%; height: 80%; top: -10%; left: -10%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }
  .scene-card__stage::after {
    width: 50%; height: 60%; bottom: -10%; right: -10%;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }
  .biz-scene--dark .scene-card__stage {
    background: linear-gradient(135deg, rgba(255,19,19,0.18) 0%, rgba(255,171,36,0.18) 100%);
  }
  /* tints por momento */
  .scene-card__stage--p0-0 { background: linear-gradient(135deg, #fff1e0 0%, #ffd7b8 100%); }
  .scene-card__stage--p0-1 { background: linear-gradient(135deg, #fde6e6 0%, #fff5cc 100%); }
  .scene-card__stage--p0-10 { background: linear-gradient(135deg, #fff5cc 0%, #ffe0d4 100%); }
  .scene-card__stage--p1-0,
  .scene-card__stage--p1-1,
  .scene-card__stage--p1-2,
  .scene-card__stage--p1-10,
  .scene-card__stage--p1-11,
  .scene-card__stage--p1-12 { background: linear-gradient(135deg, #2a1414 0%, #0c0c0c 100%); }
  .scene-card__stage--p2-0 { background: linear-gradient(135deg, #fff 0%, #fff3c4 100%); }
  .scene-card__stage--p2-1 { background: linear-gradient(135deg, #fff0e8 0%, #fde6e6 100%); }
  .scene-card__stage--p2-2 { background: linear-gradient(135deg, #fde6e6 0%, #fff5cc 100%); }
  .scene-card__stage--p2-3 { background: linear-gradient(135deg, #fff5cc 0%, #ffe0d4 100%); }

  .scene-card__chip {
    position: absolute; z-index: 2;
    top: 14px; left: 14px;
    font-family: var(--font-heading);
    font-size: 11px; font-weight: 800; letter-spacing: 0.08em;
    background: #fff; color: var(--color-text-primary);
    padding: 5px 10px; border-radius: 999px;
    border: 1px solid rgba(10,10,10,0.08);
  }
  .biz-scene--dark .scene-card__chip { background: rgba(20,20,20,0.85); color: #fff; border-color: rgba(255,255,255,0.12); }

  .scene-card__body { padding: 24px 24px 28px; display: flex; flex-direction: column; gap: 8px; }
  .scene-card__title {
    font-family: var(--font-heading);
    font-size: 1.1rem; font-weight: 800; letter-spacing: -0.02em;
    margin: 0; line-height: 1.25;
  }
  .biz-scene--dark .scene-card__title { color: #fff; }
  .scene-card__text {
    font-family: var(--font-body); font-size: 0.9rem; line-height: 1.6; margin: 0;
  }
  .biz-scene--light .scene-card__text { color: var(--color-text-muted); }
  .biz-scene--dark .scene-card__text { color: rgba(255,255,255,0.7); }

  /* ── Logos cloud ───────────────────────────────────────── */
  .logos-cloud { background:#0a0a0a; padding:60px 0; border-top:1px solid rgba(255,255,255,0.06); }
  .logos-cloud__label { font-family:var(--font-heading); font-size:11px; color:rgba(255,255,255,0.38); letter-spacing:0.14em; text-transform:uppercase; font-weight:600; text-align:center; margin-bottom:32px; }
  .logos-cloud__grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:16px; }
  .logo-tile-dark { aspect-ratio:3/1.2; background:rgba(255,255,255,0.04); border:1px solid rgba(255,255,255,0.10); border-radius:8px; display:flex; align-items:center; justify-content:center; color:rgba(255,255,255,0.60); font-size:0.82rem; font-weight:700; font-family:var(--font-heading); }

  /* ── Spotlight ─────────────────────────────────────────── */
  .spotlight { padding: 100px 0; border-top: 1px solid var(--color-border); }
  .spotlight--brand { background: var(--gradient-brand); color: #fff; border-top: none; }
  .spotlight--dark {
    background: radial-gradient(ellipse at 50% 30%, #1a0c0c 0%, #050505 60%) #050505;
    color: #fff; border-top: none;
  }
  .spotlight .container { text-align: center; }
  .spotlight__eyebrow {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 5px 14px; border-radius: 999px;
    margin-bottom: 22px;
    background: rgba(255,255,255,0.16); color: #fff;
  }
  .spotlight--dark .spotlight__eyebrow {
    background: rgba(255,171,36,0.14);
    border: 1px solid rgba(255,171,36,0.36);
    color: var(--color-secondary);
  }
  .spotlight__title {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 800; letter-spacing: -0.025em; line-height: 1.15;
    margin: 0 auto 22px; max-width: 880px; color: #fff;
  }
  .spotlight__body {
    font-family: var(--font-body); font-size: 1.05rem;
    line-height: 1.65; margin: 0 auto; max-width: 720px;
    color: rgba(255,255,255,0.94);
  }
  .spotlight--dark .spotlight__body { color: rgba(255,255,255,0.78); }
  .spotlight__cards {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 18px; margin-top: 56px; text-align: left;
  }
  .spotlight-card {
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.22);
    border-radius: 14px; padding: 24px 24px 28px;
    display: flex; flex-direction: column; gap: 10px;
    transition: transform .2s, border-color .2s, background .2s;
  }
  .spotlight--dark .spotlight-card {
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.10);
  }
  .spotlight-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,0.4);
    background: rgba(255,255,255,0.20);
  }
  .spotlight--dark .spotlight-card:hover {
    border-color: rgba(255,171,36,0.40);
    background: rgba(255,255,255,0.07);
  }
  .spotlight-card__title {
    font-family: var(--font-heading);
    font-size: 1.05rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.25;
    margin: 0; color: #fff;
  }
  .spotlight-card__text {
    font-family: var(--font-body); font-size: 0.88rem;
    line-height: 1.55; margin: 0; color: rgba(255,255,255,0.92);
  }
  .spotlight--dark .spotlight-card__text { color: rgba(255,255,255,0.72); }
  @media (max-width: 768px) { .spotlight__cards { grid-template-columns: 1fr; } }
  /* ── Por qué Ticketplus ────────────────────────────────── */
  .why-tp {
    background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
    padding: 120px 0; border-top: 1px solid var(--color-border);
  }
  .why-tp__header { max-width: 760px; margin: 0 auto 56px; text-align: center; }
  .why-tp__eyebrow {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-secondary); margin-bottom: 18px;
  }
  .why-tp__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    margin: 0 0 16px; color: #0a0a0a;
  }
  .why-tp__lead {
    font-family: var(--font-body); font-size: 1.05rem;
    color: var(--color-text-muted); margin: 0; line-height: 1.55;
  }
  .why-tp__grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 20px; margin-bottom: 48px;
  }
  .why-tp__card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px 26px;
    display: flex; flex-direction: column; gap: 12px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .why-tp__card:hover {
    transform: translateY(-3px);
    border-color: rgba(10,10,10,0.18);
    box-shadow: 0 12px 28px rgba(0,0,0,0.06);
  }
  .why-tp__icon {
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(255,19,19,0.08), rgba(255,171,36,0.10));
    border: 1px solid rgba(255,171,36,0.24);
    border-radius: 12px;
    color: var(--color-secondary);
  }
  .why-tp__icon svg { width: 24px; height: 24px; }
  .why-tp__card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.25; margin: 0;
  }
  .why-tp__card-body {
    font-family: var(--font-body); font-size: 0.9rem;
    color: var(--color-text-muted); line-height: 1.55; margin: 0;
  }
  .why-tp__cta { text-align: center; }

  /* ── Verticales ────────────────────────────────────────── */
  .verticals {
    background: #fff;
    padding: 120px 0;
    border-top: 1px solid var(--color-border);
  }
  .verticals__header { max-width: 760px; margin: 0 auto 56px; text-align: center; }
  .verticals__eyebrow {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--color-primary); margin-bottom: 18px;
  }
  .verticals__title {
    font-family: var(--font-heading);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    margin: 0 0 16px; color: #0a0a0a;
  }
  .verticals__grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;
  }
  .verticals__card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 28px 26px;
    display: flex; align-items: center; gap: 16px;
    transition: transform .2s, border-color .2s, box-shadow .2s;
  }
  .verticals__card:hover {
    transform: translateY(-3px);
    border-color: rgba(10,10,10,0.18);
    box-shadow: 0 12px 28px rgba(0,0,0,0.06);
  }
  .verticals__icon {
    font-size: 28px; line-height: 1;
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, rgba(255,19,19,0.08), rgba(255,171,36,0.10));
    border-radius: 12px;
    flex-shrink: 0;
  }
  .verticals__label {
    font-family: var(--font-heading);
    font-size: 1rem; font-weight: 800;
    letter-spacing: -0.02em; line-height: 1.25; margin: 0;
    color: var(--color-text-primary);
  }

  /* ── Form grid ─────────────────────────────────────────── */
  .form-grid-tp { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }
  .section__eyebrow {
    display: inline-block; font-family: var(--font-heading);
    font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    margin-bottom: 18px;
  }
  .section__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    margin: 0 0 16px;
  }
  .section__lead {
    font-family: var(--font-body); font-size: 1.05rem; line-height: 1.6; margin: 0;
  }

  /* ── FAQ ──────────────────────────────────────────────── */
  .faq-item { border-bottom: 1px solid var(--color-border); padding: 22px 0; }
  .faq-item__head {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
    gap: 16px;
    font-family: var(--font-heading);
    font-size: 1.05rem; font-weight: 700; letter-spacing: -0.01em;
    color: var(--color-text-primary);
  }
  .faq-item__head::-webkit-details-marker { display: none; }
  .faq-item__head::marker { display: none; content: ''; }
  .faq-item__head .chev {
    font-family: var(--font-heading);
    font-size: 1.6rem; font-weight: 400;
    color: var(--color-secondary);
    transition: transform .2s ease; line-height: 1;
  }
  .faq-item[open] .faq-item__head .chev { transform: rotate(45deg); }
  .faq-item__body { padding-top: 14px; }
  .faq-item__body p {
    font-family: var(--font-body); font-size: 0.95rem;
    color: var(--color-text-muted); line-height: 1.65; margin: 0;
