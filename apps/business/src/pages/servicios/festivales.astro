---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";
import EquipoSection from "../../components/EquipoSection.astro";

// 4 momentos festival + ferias unificados (lanzamiento / operación / expositores / día después)
const moments = [
  {
    n: "01", tag: "EL LANZAMIENTO", dark: false, id: "lanzamiento",
    title: "Buscas vender el lanzamiento sin caídas.",
    lead: "Encuentras war room, cola virtual y simulación de carga. Probado en lanzamientos masivos con +320K tickets vendidos en un solo día sin un error.",
    features: [
      { n: "01", title: "Multi-checkout, multi-día, multi-stage", body: "Carrito persistente, abonos full pass + day pass, add-ons, bundles, promo codes por sponsor. Todo en un mismo flujo.", badge: null },
      { n: "02", title: "Marketing Booster gestionado", body: "Meta, Google, TikTok con atribución end-to-end. ROAS por evento, retargeting de carritos. Incluido en el cargo por servicio.", badge: "Incluido en el cargo" },
      { n: "03", title: "Showpage con tu identidad de festival", body: "Página de venta con tus colores, tipografía y assets de marca dentro del checkout Ticketplus. Mantenés tu identidad sin abrir un dominio aparte.", badge: null },
    ],
  },
  {
    n: "02", tag: "LA OPERACIÓN", dark: true, id: "operacion",
    title: "Buscas operar el festival en terreno.",
    lead: "Encuentras validación offline, POS y tótems en barras, acreditación profesional con credenciales en segundos, control multi-puerta con sync y staff Ticketplus en sala.",
    features: [
      { n: "01", title: "Validación offline confirmada", body: "App QR con modo offline real (no \"degradado\"). Sync automática al reconectar, detección instantánea de duplicados.", badge: "vs Welcu/Passline/TicketSpice" },
      { n: "02", title: "POS y tótem autoatención", body: "Barras, food courts, merch stands con modo offline, sync automática, inventario en tiempo real entre canales.", badge: null },
      { n: "03", title: "Acreditación pro con credenciales en segundos", body: "Impresora térmica integrada: credencial con foto + nombre + empresa + cargo + categoría en menos de 5 segundos. Cordón por color según categoría (prensa, artista, sponsor, expositor). Cero fila el día uno.", badge: "vs Eventbrite check-in básico" },
      { n: "04", title: "Anillos de validación multi-puerta", body: "Hasta 8 puertas operando en paralelo con sync en tiempo real entre anillos de validación. Anti-doble ingreso, modo offline con auto-sync al reconectar: cada puerta sabe instantáneamente qué QR ya entró por otra.", badge: "Anillos multi-puerta sincronizados" },
    ],
  },
  {
    n: "03", tag: "EXPOSITORES Y STANDS", dark: false, id: "expositores",
    title: "Buscas que cada stand opere como negocio propio.",
    lead: "Encuentras exhibitor management con login propio por stand, lead capture y reportes de tráfico que justifican la renovación del sponsor para la próxima edición.",
    features: [
      { n: "01", title: "Exhibitor management · panel propio por stand", body: "Cada expositor tiene login propio: configura su stock, asigna a sus promotores, ve sus propias ventas separadas. Multiple team types (press, stand staff, setup) con stock per-type y permisos delegados. Pre-acreditación independiente, sin Excel al organizador.", badge: "Único por stand" },
      { n: "02", title: "Lead capture por expositor", body: "Escaneo de credencial del visitante → nombre + empresa + email + intereses → CRM del expositor. Cada conversación queda registrada como lead calificado para follow-up post-evento.", badge: null },
      { n: "03", title: "Reportes de tráfico por stand para sponsors", body: "Visitantes únicos, tiempo en stand, leads capturados, perfil demográfico del tráfico. ROI medible por stand: el sponsor recibe el documento que justifica renovar el próximo año a mayor precio.", badge: "ROI medible por stand" },
    ],
  },
  {
    n: "04", tag: "EL DÍA DESPUÉS", dark: true, id: "dia-despues",
    title: "Buscas saber qué pasó y planificar el próximo.",
    lead: "Encuentras atribución multi-canal, liquidaciones en 48-72h y reportes listos para programar el próximo festival.",
    features: [
      { n: "01", title: "Atribución multi-canal end-to-end", body: "Orgánico, Meta, Google, TikTok, referido, promo de sponsor → ROAS por campaña, integración GA4 + SEMrush.", badge: null },
      { n: "02", title: "Dashboards real-time desde tu celular", body: "Ventas por minuto durante el lanzamiento, ocupación por sector, velocidad de ingreso por acceso.", badge: null },
      { n: "03", title: "Liquidaciones automáticas en 48-72h", body: "Stripe Connect con split, SII Chile, CLP o USD, reembolsos parciales con auditoría.", badge: null },
      { n: "04", title: "Soporte 24/7 con account manager dedicado", body: "Mismo equipo que operó el festival, disponible para post-mortem y planificación del próximo.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · El lanzamiento", title: "Cola virtual + war room + simulación de carga + SLA con penalidades.", href: "#lanzamiento" },
  { tag: "02 · La operación", title: "Validación offline + multi-puerta con sync + POS y tótem + credenciales en segundos.", href: "#operacion" },
  { tag: "03 · Expositores y stands", title: "Panel propio por stand + lead capture + reportes ROI por sponsor.", href: "#expositores" },
  { tag: "04 · El día después", title: "Atribución multi-canal + liquidación 48-72h + reporte para el próximo evento.", href: "#dia-despues" },
];

const fifaStats = [
  { value: "+600K", label: "asistentes", sub: "movidos en el torneo" },
  { value: "+320K", label: "tickets", sub: "vendidos en el día peak" },
  { value: "0", label: "caídas", sub: "de plataforma" },
  { value: "4", label: "sedes", sub: "operadas simultáneamente" },
];

const whyCards = [
  { icon: "⚡", title: "Infraestructura anti-caídas", body: "+320K tickets en un día. Cero caídas." },
  { icon: "🛟", title: "Staff en terreno multi-día", body: "Personal TP operando contigo. Rotación coordinada multi-día." },
  { icon: "📡", title: "Validación offline real", body: "Sin internet en el predio, la fila igual avanza." },
  { icon: "💰", title: "Sin costos ocultos", body: "Tecnología, staff multi-día, war room, soporte, Booster gestionado." },
];

const tiposFestival = [
  { icon: "🎸", title: "Música", body: "Lollapalooza-tier, multi-stage, multi-día, POS + tótem." },
  { icon: "🍷", title: "Gastronómicos", body: "Vouchers de degustación, POS distribuido, tótem en kioscos." },
  { icon: "🎪", title: "Ferias masivas", body: "Aforo por horario, acreditación expositores, reportes de tráfico para sponsors." },
  { icon: "🍺", title: "Cerveza / craft", body: "POS + tótem por stand, vouchers integrados, reportes por cervecero." },
  { icon: "🎬", title: "Cine / cultura", body: "Funciones por sala, abonos festival completo, pre-inscripciones prensa." },
  { icon: "🏟️", title: "Deportivo masivo", body: "Lanzamientos de alta demanda, anti-bot, acreditación atletas, multi-sede." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Simulación de carga pre-lanzamiento incluida",
  "Staff Ticketplus en terreno todos los días del festival",
  "War room con ingenieros asignados",
  "Migración acompañada desde tu plataforma actual",
  "Onboarding completo en 4-6 semanas (más rápido si el lanzamiento está cerca)",
  "Booster gestionado incluido en el cargo",
];

const faqs = [
  { q: "¿Y si el sitio se cae el día del lanzamiento?", a: "No se cae. Probado en +320K tickets vendidos en un día con cero caídas. La razón: infraestructura dedicada por evento, war room con ingenieros TP durante el drop, simulación de carga 72h antes. Y si algo pasara, hay SLA contractual con penalidades económicas, no soporte L1 genérico. Es contrato, no promesa." },
  { q: "¿La validación realmente funciona sin WiFi en el predio?", a: "Sí, offline real, no \"modo degradado\". Cada PDA tiene la base de tickets sincronizada al día del evento; valida localmente y syncea cuando recupera red. La fila avanza igual." },
  { q: "¿Cómo manejan multi-stage y multi-día con un solo carrito?", a: "Carrito persistente entre sesiones. El asistente puede agregar abono full pass + day pass + add-ons + merch + bundles de sponsor y cerrar todo en un solo checkout. Rotación de staff TP coordinada para no fundir al equipo al día 3." },
  { q: "¿Vale la pena POS + tótem en barras y food?", a: "Adopción típica medida en festivales operando con Ticketplus: 70%+ de las transacciones en barras pasan por tótem al día 2. Reduce fila 60-70% y aumenta ticket promedio 18-25% por upselling automático. Para festivales <5K personas el costo no compensa: recomendamos POS móvil." },
  { q: "¿Tienen equipo presencial el día del festival?", a: "Sí. Staff Ticketplus capacitado en puerta, en POS, monitoreando dashboard. Briefing pre-evento con tu producción 24h antes. Líder de operación en sala con autoridad para resolver, no \"te paso con el siguiente nivel\". Cantidad de staff según aforo, número de puertas y duración." },
  { q: "¿Cuánto cuesta? ¿Tienen licencias o mínimos?", a: "Cargo por servicio sobre cada ticket vendido. Sin licencia, sin mínimos, sin contratos de permanencia. El porcentaje se define según volumen, tipo de festival y módulos activados (POS, tótem, multi-país, Booster). Cotización personalizada en menos de 24h hábiles." },
  { q: "¿Puedo lanzar en 8 semanas si recién contrato ahora?", a: "Sí. Onboarding acelerado para lanzamientos en menos de 60 días. War room contigo desde el día 1 de la contratación, migración paralela si vienes de otra plataforma. La condición: tu equipo de marketing y producción tiene que estar disponible para reuniones semanales durante el sprint." },
];
---
<Site title="Servicios Ticketplus · Festivales y Ferias · Lanzamientos, operación multi-día y exhibitor management">

  <!-- HERO con proof points -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Festivales y Ferias</p>
        <h1 class="biz-hero__title">La tecnología que opera tu festival o feria, del lanzamiento al cierre.</h1>
        <p class="biz-hero__lead">Cola virtual con war room para el lanzamiento, validación offline multi-puerta, POS y tótem en barras, exhibitor management con panel propio por stand y reportes ROI por sponsor. La infraestructura para festivales masivos y ferias B2B/gastronómicas/cerveza en una sola plataforma.</p>

        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar mi festival en 24h →</a>
          <a href="#caso-fifa" class="hero-cta-ghost">Ver caso de escala ↓</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/verticals/vertical-festivales.jpg`} alt="Festival masivo operado con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Festivales y eventos masivos que operan con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","Lollapalooza 🇨🇱","Ñam Festival 🇨🇱","Festival Internacional Viña 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
      <div class="industry-cases industry-cases--single">
        <article class="industry-case">
          <div class="industry-case__video-wrap">
            <video src={`${import.meta.env.BASE_URL}/videos/comiccon.mp4`} autoplay loop muted playsinline class="industry-case__video"></video>
          </div>
          <div class="industry-case__caption">
            <span class="industry-case__chip">Cultura pop</span>
            <h3 class="industry-case__title">ComicCon · Evento masivo de la cultura pop</h3>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · EL LANZAMIENTO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <div class={`biz-scene__grid biz-scene__grid--${p.features.length}`}>
            {p.features.map((f, fi) => (
              <article class="scene-card">
                <div class={`scene-card__stage scene-card__stage--p${pi}-${fi}`} aria-hidden="true">
                  <span class="scene-card__chip">{f.n}</span>
                </div>
                <div class="scene-card__body">
                  <h4 class="scene-card__title">{f.title}</h4>
                  <p class="scene-card__text">{f.body}</p>
                  {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 02 · LA OPERACIÓN -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <div class={`biz-scene__grid biz-scene__grid--${p.features.length}`}>
            {p.features.map((f, fi) => (
              <article class="scene-card">
                <div class={`scene-card__stage scene-card__stage--p${pi}-${fi}`} aria-hidden="true">
                  <span class="scene-card__chip">{f.n}</span>
                </div>
                <div class="scene-card__body">
                  <h4 class="scene-card__title">{f.title}</h4>
                  <p class="scene-card__text">{f.body}</p>
                  {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 03 · EXPOSITORES Y STANDS -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <div class={`biz-scene__grid biz-scene__grid--${p.features.length}`}>
            {p.features.map((f, fi) => (
              <article class="scene-card">
                <div class={`scene-card__stage scene-card__stage--p${pi}-${fi}`} aria-hidden="true">
                  <span class="scene-card__chip">{f.n}</span>
                </div>
                <div class="scene-card__body">
                  <h4 class="scene-card__title">{f.title}</h4>
                  <p class="scene-card__text">{f.body}</p>
                  {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 04 · EL DÍA DESPUÉS -->
  {(() => {
    const p = moments[3];
    const pi = 3;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <div class={`biz-scene__grid biz-scene__grid--${p.features.length}`}>
            {p.features.map((f, fi) => (
              <article class="scene-card">
                <div class={`scene-card__stage scene-card__stage--p${pi}-${fi}`} aria-hidden="true">
                  <span class="scene-card__chip">{f.n}</span>
                </div>
                <div class="scene-card__body">
                  <h4 class="scene-card__title">{f.title}</h4>
                  <p class="scene-card__text">{f.body}</p>
                  {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
  })()}

  <!-- PROMESA TICKETPLUS -->
  <PromesaTicketplus
    title="El día del festival no estás solo."
    body="Viernes 19:00, puertas en 1 hora. Acceso 3 reporta lectores caídos. Llamas. Nuestro líder de operación en sala ya está caminando hacia ahí. <strong>Eso es Ticketplus.</strong>"
    ctaLabel="Conocer plan con staff multi-día →"
  />

  <!-- CUENTA CON EL EQUIPO -->
  <EquipoSection />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus para festivales</span>
        <h2 class="why-tp__title">Una sola plataforma, un solo responsable, escala probada.</h2>
        <p class="why-tp__lead">No vendemos software. Operamos tu festival end-to-end con la infraestructura que tu próximo lanzamiento necesita.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar mi festival en 24h →</a>
      </div>
    </div>
  </section>

  <!-- TIPOS DE FESTIVAL -->
  <section class="tipos-festival">
    <div class="container">
      <div class="tipos-festival__header">
        <span class="tipos-festival__eyebrow">Tipos de festival</span>
        <h2 class="tipos-festival__title">Cada tipo de festival tiene su propio playbook.</h2>
      </div>
      <div class="tipos-festival__grid">
        {tiposFestival.map((t) => (
          <article class="tipo-card">
            <div class="tipo-card__icon">{t.icon}</div>
            <h3 class="tipo-card__title">{t.title}</h3>
            <p class="tipo-card__body">{t.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu festival</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan específico para tu formato, volumen esperado y fecha de lanzamiento.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Si tu lanzamiento es en menos de 60 días, márcalo en el formulario: entramos al war room contigo desde el día 1.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar mi festival</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Productora / Festival","text","Nombre de tu productora o festival"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de festival</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Música</option>
              <option>Gastronómico</option>
              <option>Cerveza craft</option>
              <option>Cultural</option>
              <option>Deportivo masivo</option>
              <option>Otro</option>
            </select>
          </div>
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Asistentes esperados</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>5K-15K</option>
              <option>15-50K</option>
              <option>50-150K</option>
              <option>+150K</option>
            </select>
          </div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Fecha estimada del lanzamiento</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>En menos de 60 días</option>
              <option>2-3 meses</option>
              <option>3-6 meses</option>
              <option>+6 meses</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar mi festival →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
