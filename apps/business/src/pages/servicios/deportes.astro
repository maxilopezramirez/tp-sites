---
import Site from "../../layouts/Site.astro";
import EquipoSection from "../../components/EquipoSection.astro";
import CasoFifa from "../../components/CasoFifa.astro";

// 4 momentos operativos del club deportivo (calendario 365 días)
const moments = [
  {
    n: "01", tag: "VENTA DE ENTRADAS + EVENTOS ESPECIALES", dark: false, id: "entradas",
    title: "Buscas vender el partido.",
    lead: "Encuentras un mapa que reutilizas partido a partido y aguanta el día del clásico. El día del clásico tu sitio aguanta, la prensa entra sin Excel y la fila avanza sin frenos.",
    heroCount: 0,
    features: [
      { n: "01", title: "Mapa interactivo del estadio", body: "Sectores, bloqueos visitante, palcos VIP, sector pacífico. Configurable partido a partido sin tocar código.", badge: "Reutilizable partido a partido" },
      { n: "02", title: "Alta demanda controlada para clásicos, finales e internacionales", body: "Virtual queue + anti-bot + ventana por segmento (socio → abonado → general). Probado en eventos masivos de +320K tickets/día.", badge: null },
      { n: "03", title: "Abonos de temporada con renovación prioritaria", body: "Pasaporte digital para todos los partidos del año. Mismo asiento o butaca libre según política del club. Renovación anticipada para el abonado actual antes de la venta general — cero pérdida de fans históricos.", badge: "Ingreso recurrente" },
      { n: "04", title: "e-commerce + merchandising oficial del club", body: "Tienda oficial integrada al ticketing: camisetas, merch, productos del club con stock unificado. Cross-sell automático ticket + merch en el mismo checkout, retiro en estadio o despacho a domicilio.", badge: "Stock + checkout unificado" },
    ],
  },
  {
    n: "02", tag: "VALIDACIÓN DEPORTIVA", dark: true, id: "validacion",
    title: "Buscas que el día del partido la fila avance.",
    lead: "Encuentras validación 100% orientada al deporte: QR offline en estadio, carnet de identidad cruzado con el ticket y listas blancas/negras por sector.",
    heroCount: 0,
    features: [
      { n: "01", title: "App Validación QR offline", body: "App iOS + Android con validación QR <200ms incluso con miles de asistentes. Modo offline con auto-sync y detección instantánea de duplicados.", badge: "+320K asistentes sin caídas", captionTag: "Validación QR" },
      { n: "02", title: "Validación por carnet de identidad", body: "Lectura de cédula en puerta cruzada con el ticket comprado. Asocia identidad al asiento, evita reventa fraudulenta y cumple normativa de eventos deportivos.", badge: null },
      { n: "03", title: "Listas blancas y negras por sector", body: "Whitelist de socios con prioridad de acceso, blacklist de hinchas problemáticos por sector. Reglas por partido o por temporada — validación en tiempo real al escanear.", badge: null },
      { n: "04", title: "QR dinámico en app móvil", body: "El ticket vive dentro de la app del hincha con QR que rota cada pocos segundos. Imposible de screenshotear, imposible de reenviar por WhatsApp. Cero reventa por captura, cero fraude por duplicado.", badge: "Anti-screenshot · Anti-share", captionTag: "QR dinámico" },
    ],
  },
  {
    n: "03", tag: "ABONOS DE TEMPORADA", dark: false, id: "abonos",
    title: "Buscas el ingreso predecible del año.",
    lead: "Encuentras abonos con butaca asignada y renovación con prioridad. Abono = ingreso recurrente + ocupación asegurada + fan engagement real.",
    heroCount: 0,
    features: [
      { n: "01", title: "Abono temporada con butaca asignada", body: "Pasaporte digital para todos los partidos. Mismo asiento todo el año o butaca libre según política del club.", badge: "Pasaporte digital" },
      { n: "02", title: "Renovación anticipada con prioridad para abonado actual", body: "Ventana exclusiva para que el abonado renueve su butaca antes de que abra la venta general. Cero pérdida de fans históricos.", badge: null },
      { n: "03", title: "Bundle socio + abono con descuento", body: "Reconoce estado de socio automáticamente. El socio activo paga su cuota + abono al precio combinado, sin doble checkout.", badge: null },
      { n: "04", title: "Credenciales digitales e impresas para socios", body: "Credencial digital con QR en Apple Wallet + Google Wallet y credencial física impresa con foto del socio. Mismo ID vinculado al estado de cuenta — validación en puerta en tiempo real.", badge: "Wallet + impresa" },
    ],
  },
  {
    n: "04", tag: "DÍA DEL PARTIDO", dark: true, id: "dia-partido",
    title: "Buscas que el día del partido funcione.",
    lead: "Encuentras la operación en estadio entera. PDAs, torniquetes, validación, cashless, cortesías y aforo en vivo coordinados.",
    heroCount: 0,
    features: [
      { n: "01", title: "Cashless en consumos durante el partido", body: "Pulsera o credencial con saldo prepagado. Cero efectivo en gradas, cero filas en kioscos.", badge: null },
      { n: "02", title: "Cortesías masivas", body: "Prensa, sponsors, autoridades. Lista nominativa con QR único, tracking de quién accedió y cuándo.", badge: null },
      { n: "03", title: "Aforo en vivo por sector", body: "Sabes ocupación de cada sector en tiempo real desde el dashboard.", badge: null },
    ],
  },
  {
    n: "05", tag: "MERCHANDISING", dark: false, id: "merchandising",
    title: "Buscas vender más allá del ticket.",
    lead: "Encuentras tienda oficial integrada al ticketing. Misma plataforma, mismo carrito, mismo responsable.",
    heroCount: 0,
    features: [
      { n: "01", title: "Tienda oficial integrada", body: "Catálogo de productos del club, stock y bodega, cross-sell de tickets + merch en el mismo checkout, retiro en estadio o despacho.", badge: "Stock + checkout unificado" },
    ],
  },
];

const overview = [
  { tag: "01 · SOCIOS", title: "Cobro recurrente automático adaptado a tu club: mensual, trimestral o anual con tarjeta guardada, membresías por categoría y beneficios diferenciados.", href: "#socios" },
  { tag: "02 · ENTRADAS", title: "Venta partido a partido con mapa interactivo del estadio, precio por zona, ventana de venta por segmento (socios, abonados, público) y aforo en vivo.", href: "#entradas" },
  { tag: "03 · ABONOS", title: "Temporada completa con butaca asignada, renovación automática año a año, prioridad de abonados y bundle socio + abono con descuento.", href: "#abonos" },
  { tag: "04 · EVENTOS ESPECIALES", title: "Clásicos, finales e internacionales con cola de espera, anti-bot, ventana de venta por segmento y aforo dinámico.", href: "#eventos-especiales" },
  { tag: "05 · DÍA DEL PARTIDO", title: "On Site en estadio con PDAs, torniquetes, POS de consumo, acreditación de prensa con foto, cortesías masivas y aforo en vivo.", href: "#dia-partido" },
  { tag: "06 · MERCHANDISING", title: "Tienda oficial integrada con catálogo del club, stock y bodega, cross-sell tickets + merch en un mismo checkout y retiro o despacho.", href: "#merchandising" },
];

const whyCards = [
  { icon: "💳", title: "Cobro recurrente adaptado a tu club", body: "Frecuencias mensual / trimestral / anual con tarjeta guardada." },
  { icon: "🗺️", title: "Mapa interactivo y validación rápida", body: "Mapa configurable por partido + PDAs / torniquetes existentes." },
  { icon: "📅", title: "Acompañamiento los 365 días", body: "Account manager dedicado que conoce tu calendario." },
  { icon: "⚽", title: "Multi-disciplina probada", body: "Fútbol, básquetbol, tenis, padel, voley." },
];

const casosReales = [
  { icon: "🏆", title: "Mundial Sub-20 FIFA Chile 2025", body: "Adjudicado por tecnología. 4 estadios, 52 partidos, +600K asistentes." },
  { icon: "⚽", title: "AFA Eliminatorias Qatar", body: "+320K tickets vendidos en un solo día sin caídas. 99.9% uptime durante el drop." },
  { icon: "🎾", title: "Multi-disciplina", body: "Fútbol primera, ligas de básquetbol, federaciones de tenis, padel, voley." },
];

const checklist = [
  "Migración de base de socios con histórico",
  "Mapa interactivo del recinto modelado sin costo",
  "Capacitación al equipo (boletería, prensa, tienda)",
  "Onboarding completo en 4-6 semanas",
  "Account manager dedicado todo el año",
  "Compatible con tu hardware actual (torniquetes, PDAs, scanners)",
];

const faqs = [
  { q: "¿Puedo operar varias disciplinas en distintos recintos con la misma plataforma?", a: "Sí. Configurás múltiples recintos (canchas, gimnasios, courts) y disciplinas (fútbol, básquet, tenis, padel) bajo un único panel. Cada uno con su mapa, su pricing y su staff." },
  { q: "¿Qué frecuencias de cobro de cuotas soporta?", a: "Mensual, trimestral, semestral y anual. Cada socio elige al inscribirse; podés mezclar dentro del mismo club (ej. socio activo mensual + socio empresa anual)." },
  { q: "¿Tengo que pagar extra para modelar mi recinto?", a: "No. El modelado del recinto (mapa interactivo con sectores, butacas, palcos) está incluido en el onboarding. Reutilizable partido a partido sin costo adicional." },
  { q: "¿Es compatible con los torniquetes y PDAs que ya tengo?", a: "Sí. Trabajamos con Boon Edam, Gunnebo, scanners Bluetooth y la mayoría de hardware del mercado. Antes del onboarding hacemos un audit de tu infra existente — no tirás nada." },
  { q: "¿Cómo migran la base histórica de socios y abonados?", a: "Migración asistida. Importamos socios, histórico de pagos, abonos vigentes y butacas asignadas desde tu sistema actual. Operamos en paralelo durante la transición para no interrumpir cobros." },
  { q: "¿Cómo acompañan en eventos grandes tipo clásico o final?", a: "Account manager + war room remoto durante el drop. WhatsApp directo con respuesta menor a 2h. En clásicos premium podemos enviar staff Ticketplus on-site al estadio." },
  { q: "¿Qué pasa si un partido se suspende por lluvia o seguridad?", a: "Reprogramación automática con notificación a todos los compradores. Si quieren reembolso, lo solicitan desde un link. Si se reprograma, el ticket original es válido para la nueva fecha. Cero atención manual." },
];
---
<Site title="Servicios Ticketplus · Clubes y federaciones deportivas — Operación 365 días al año">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Clubes deportivos</p>
        <h1 class="biz-hero__title">La tecnología para operar toda tu organización: socios, entradas, abonos y merchandising.</h1>
        <p class="biz-hero__lead">Cobro recurrente de cuotas, ticketing partido a partido, abonos de temporada, eventos especiales, día del partido y tienda oficial. Todo en el mismo sistema, con un solo responsable.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi club →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/verticals/vertical-deportes.jpg`} alt="Club deportivo operando con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Clubes que confían en Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Audax Italiano 🇨🇱","U. Católica 🇨🇱","Stade Français 🇨🇱","COBS 🇨🇱","Federación Tenis 🇨🇱","Federación Padel 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 4 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu club opera todo el año.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Cuatro ejes operativos. Las herramientas se activan según los necesites.</p>
      </div>
      <div class="biz-promises__grid biz-promises__grid--4">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · CUOTAS DE SOCIO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 02 · VENTA DE ENTRADAS + EVENTOS ESPECIALES -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 03 · ABONOS DE TEMPORADA -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 04 · DÍA DEL PARTIDO -->
  {(() => {
    const p = moments[3];
    const pi = 3;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <EquipoSection />

  <CasoFifa />

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu club al usar Ticketplus.</h2>
        <p class="why-tp__lead">Cuotas socio + ticketing partido a partido + abonos temporada en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi club →</a>
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu organización deportiva</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu disciplina, base de socios y volumen de eventos.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar para mi club</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@club.com"],["Club o federación","text","Nombre de tu club o federación"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Disciplina</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>Fútbol</option>
              <option>Básquetbol</option>
              <option>Tenis</option>
              <option>Padel</option>
              <option>Voley</option>
              <option>Rugby</option>
              <option>Hockey</option>
              <option>Otra</option>
            </select>
          </div>
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Base de socios actual</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>&lt;500</option>
              <option>500-2000</option>
              <option>2000-5000</option>
              <option>5000-15000</option>
              <option>+15000</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar para mi club →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- FINAL CTA -->
