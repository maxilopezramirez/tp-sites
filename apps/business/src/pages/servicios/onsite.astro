---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";

// 3 momentos del día E: Preparar / Operar / Cerrar
const moments = [
  {
    n: "01", tag: "PREPARAR EL VENUE", dark: false, id: "preparar",
    title: "Buscas llegar al venue con todo cargado.",
    lead: "Encuentras manager app + acreditación pre-evento + hardware listo. El día E empieza el día anterior.",
    heroCount: 1,
    features: [
      { n: "01", title: "Manager app — tu centro de control", body: "Dashboard mobile con ventas + box office en vivo, briefing pre-evento 30min un día antes del evento.", badge: "App iOS + Android", captionTag: "Centro de control mobile" },
      { n: "02", title: "Acreditación pro con credenciales en segundos", body: "QR + foto + cordón por categoría. Pre-acreditación por expositor sin Excel a la productora.", badge: null, newGroup: true },
      { n: "03", title: "Staff en terreno y validación de identidad", body: "Cédula nacional + pase sanitario opcional. Rotación de staff multi-día para no fundir al equipo al día 3.", badge: null },
    ],
  },
  {
    n: "02", tag: "OPERAR LA PUERTA", dark: true, id: "operar",
    title: "Buscas que la fila avance pase lo que pase.",
    lead: "Encuentras validación <200ms + offline + escaneo alta velocidad. La fila igual avanza — pase lo que pase.",
    heroCount: 1,
    features: [
      { n: "01", title: "Validación digital segura <200ms", body: "App Validación Ticket, modos List y Scan, streaming access para puertas múltiples.", badge: "<200ms latencia", captionTag: "Latencia <200ms" },
      { n: "02", title: "Escaneo de alta velocidad para drops masivos", body: "Probado en eventos de +320K asistentes (AFA Eliminatorias). Multi-device coordinado, sin colisión entre puertas.", badge: "+320K asistentes", newGroup: true },
      { n: "03", title: "Anillo de validación + blacklist + integraciones", body: "Multi-acceso coordinado entre puertas. Blacklist por fan en sectores específicos. Integración con torniquetes (Ski Data, Boon Edam, Gunnebo) vía Device API.", badge: null },
    ],
  },
  {
    n: "03", tag: "CERRAR EL DÍA E", dark: false, id: "cerrar",
    title: "Buscas saber qué pasó esta noche en tu pantalla, no en tu cabeza.",
    lead: "Encuentras estadísticas al segundo + box office + reporte en 24h. Lo que pasó esta noche — en tu pantalla, no en tu cabeza.",
    heroCount: 0,
    features: [
      { n: "01", title: "Estadísticas de ingreso en vivo — al segundo", body: "Aforo por zona, alertas al límite, panel compartible con producción, seguridad y autoridades.", badge: "Tiempo real" },
      { n: "02", title: "Box office integrado con stock unificado", body: "Online + presencial sobre el mismo inventario. F&B con control de consumibles.", badge: null },
      { n: "03", title: "Visitor feedback automático", body: "NPS post-evento, comparativa histórica, captura de pain points para mejorar el próximo evento.", badge: null },
      { n: "04", title: "Reporte post-evento en 24h", body: "Entradas, sales per channel, incidents y recomendaciones — entregado en menos de 24 horas tras el cierre de puertas.", badge: "Único en LATAM" },
    ],
  },
];

const overview = [
  { tag: "01 · Preparar", title: "Manager app + acreditación pre-evento + base local sincronizada + hardware listo.", href: "#preparar" },
  { tag: "02 · Operar", title: "Validación <200ms + modo offline real + escaneo de alta velocidad + anillo anti-doble ingreso.", href: "#operar" },
  { tag: "03 · Cerrar", title: "Estadísticas al segundo + box office integrado + reporte post-evento en 24h.", href: "#cerrar" },
];

const whyCards = [
  { icon: "⚡", title: "Validación <200ms", body: "Escaneo probado en eventos de +320K asistentes." },
  { icon: "📡", title: "Modo offline real", body: "Sin internet en la puerta, la fila igual avanza." },
  { icon: "🔌", title: "Hardware compatible", body: "Zebra, Honeywell, Verifone, torniquetes existentes." },
  { icon: "🛟", title: "Staff en sala", body: "Operadores Ticketplus manejando ingreso, POS, acreditación." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "Multi-stage, multi-puerta, rotación crew, POS + tótem.", href: "/servicios/festivales" },
  { icon: "🎭", label: "Teatros", body: "Validación rápida butaca, boletería híbrida.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Deportivos", body: "Acreditación prensa, sector segregado, blacklist hooligan.", href: "/servicios/deportes" },
  { icon: "💼", label: "Congresos / Corporativos", body: "Acreditación pro con foto, networking app, ROI por sponsor.", href: "/servicios/conferencias" },
  { icon: "🎡", label: "Centros familiares", body: "Aforo por horario, validación rápida flujo continuo.", href: "/servicios/familiar" },
  { icon: "🏟️", label: "Recintos / Arenas", body: "Anillo de validación, integración con torniquetes y tótems Verifone existentes.", href: "/servicios/espectaculo" },
];

const checklist = [
  "Validación <200ms probada",
  "Modo offline confirmado (diferenciador vs competidores)",
  "Hardware compatible (no reemplazas lo que tienes)",
  "Staff Ticketplus en sala opcional",
  "Briefing pre-evento 30min un día antes",
  "Reporte post-evento en 24h",
];

const faqs = [
  { q: "¿La validación realmente funciona sin internet?", a: "Sí, offline real — no \"modo degradado\". La base de tickets se sincroniza en el dispositivo antes del evento; cada PDA valida localmente y syncea al reconectar. Multi-acceso coordinado entre puertas con prevención automática de doble ingreso. Probado en festivales con cero cobertura 4G en zonas del predio." },
  { q: "¿Tengo que comprar hardware nuevo o sirve el que ya tengo?", a: "El que ya tienes. Trabajamos con scanners Bluetooth estándar (Zebra DS2278, Honeywell Voyager) en perfil HID — sin drivers especiales. POS Verifone existentes, tótems pre-instalados, torniquetes con Device API (Ski Data, Boon Edam, Gunnebo). Hacemos audit de tu hardware antes del onboarding — no tiras nada." },
  { q: "¿Cuándo y cómo va el equipo Ticketplus al venue?", a: "Briefing pre-evento 30min un día antes con tu producción. Día del evento, staff TP capacitado en puerta, en POS, monitoreando dashboard. Líder de operación en sala con autoridad para resolver — no \"te paso con el siguiente nivel\". Cantidad de staff según aforo, número de puertas y duración." },
  { q: "¿Veo el aforo en tiempo real durante el evento?", a: "Sí. Dashboard mobile con aforo por zona, alertas al límite, ventas por minuto y velocidad de ingreso por acceso. Compartible con producción, seguridad y autoridades vía link de solo lectura." },
  { q: "¿Cuándo llega el reporte post-evento?", a: "En menos de 24 horas tras el cierre de puertas. Entradas validadas vs vendidas, sales per channel, incidents (validaciones rechazadas, intentos de doble ingreso), recomendaciones para el próximo evento. Único en LATAM con este SLA." },
];
---
<Site title="Servicios Ticketplus · On site — Operación del día del evento, con o sin internet">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">On site · Operación día del evento</p>
        <h1 class="biz-hero__title">La tecnología que opera tu venue.</h1>
        <p class="biz-hero__lead">Validación digital y offline, scanning de alta velocidad, manager app, box office integrado y staff Ticketplus en sala. Probado en eventos de +320.000 asistentes.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar operación on-site →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/scenes/hero-devices-v2.png`} alt="Devices de operación on-site Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Eventos que probaron nuestra operación on-site.</p>
      <div class="logos-cloud__grid">
        {["FIFA U-20 🇨🇱","AFA 🇦🇷","Movistar Arena 🇨🇱","Lollapalooza 🇨🇱","Ñam Festival 🇨🇱","Teatro Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>


  <!-- MOMENTO 01 · PREPARAR EL VENUE -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #1 · Hardware compatible -->
  <section class="spotlight spotlight--brand" id="hardware">
    <div class="container">
      <span class="spotlight__eyebrow">Diferencial técnico · No reemplazas inversión previa</span>
      <h2 class="spotlight__title">Buscas validar con el hardware que ya invertiste. Encuentras compatibilidad con Zebra, Honeywell, Verifone y torniquetes existentes.</h2>
      <p class="spotlight__body">Scanners Bluetooth estándar (Zebra DS2278, Honeywell Voyager) con perfil HID — sin drivers especiales. Smartphone como scanner sin hardware adicional. Compatible con tu POS Verifone y tótems pre-instalados. Integración con torniquetes y sistemas de acceso de terceros (Ski Data y similares) vía Device API.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Scanners Bluetooth HID</h4>
          <p class="spotlight-card__text">Zebra DS2278, Honeywell Voyager y modelos equivalentes en perfil HID. Sin drivers, sin SDK propietario, sin lock-in de hardware.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Smartphone como scanner</h4>
          <p class="spotlight-card__text">App iOS + Android valida QR con la cámara del dispositivo. Cero hardware adicional para puertas secundarias o eventos pequeños.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Torniquetes con Device API</h4>
          <p class="spotlight-card__text">Integración con Ski Data, Boon Edam, Gunnebo y sistemas existentes. Convivencia con POS Verifone y tótems ya instalados.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 02 · OPERAR LA PUERTA -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #2 · Validación offline real -->
  <section class="spotlight spotlight--dark" id="offline">
    <div class="container">
      <span class="spotlight__eyebrow">Único · vs Welcu / Passline / TicketSpice</span>
      <h2 class="spotlight__title">Buscas validar sin internet en la puerta. Encuentras modo offline real, no "modo degradado".</h2>
      <p class="spotlight__body">Base de datos local sincronizada antes del evento + auto-sync al reconectar. Modo offline en todos los devices (iOS + Android). Multi-acceso coordinado con prevención automática de doble ingreso entre puertas. Ideal venues subterráneos, recintos industriales o outdoor con cobertura irregular. Probado en festivales con cero cobertura 4G en zonas del predio.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Base local pre-sincronizada</h4>
          <p class="spotlight-card__text">Todo el inventario de tickets baja al dispositivo antes del evento. Cada PDA valida localmente sin depender de cobertura.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Auto-sync al reconectar</h4>
          <p class="spotlight-card__text">Validaciones offline se suben en segundo plano al reaparecer la red. Sin acción del staff, sin riesgo de inconsistencia.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Multi-acceso coordinado offline</h4>
          <p class="spotlight-card__text">Prevención de doble ingreso entre puertas, incluso operando sin red entre dispositivos. Anillo de validación robusto.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 03 · CERRAR EL DÍA E -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}
  <!-- PROMESA TICKETPLUS -->
  <PromesaTicketplus
    title="El día del evento no estás solo."
    body="Operadores Ticketplus en sala manejando ingreso, POS, acreditación y monitoreo. Briefing pre-evento 30min un día antes. WhatsApp directo pre-asignado 72h antes. Account manager dedicado. <strong>Eso es Ticketplus.</strong>"
    ctaLabel="Conocer Trust & service →"
    ctaHref="/servicios/trust-service"
  />

  <!-- POR QUÉ TICKETPLUS ON-SITE -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus On-site</span>
        <h2 class="why-tp__title">Lo que recibe tu venue al elegir Ticketplus para el día del evento.</h2>
        <p class="why-tp__lead">Validación + staff + hardware compatible + reporte en una sola operación.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar operación on-site →</a>
      </div>
    </div>
  </section>

  <!-- OPERACIÓN POR INDUSTRIA (cross-link inverso a verticales) -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Operación por industria</span>
        <h2 class="verticals__title">El playbook on-site cambia según el evento.</h2>
        <p class="why-tp__lead">La capability on-site se aplica a cada vertical con sus particularidades.</p>
      </div>
      <div class="verticals__grid verticals__grid--rich">
        {industries.map((v) => (
          <a class="verticals__card verticals__card--link" href={v.href}>
            <div class="verticals__icon">{v.icon}</div>
            <div class="verticals__text">
              <h3 class="verticals__label">{v.label}</h3>
              <p class="verticals__body">{v.body}</p>
            </div>
            <span class="verticals__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos del día de tu evento</p>
          <h2 class="section__title">Buscas cotizar tu operación on-site. Encuentras un plan según volumen, tipo de venue y complejidad de ingreso.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar operación on-site</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Empresa / Productora","text","Nombre de tu productora"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Aforo esperado</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>&lt;2.000</option>
              <option>2.000 - 10.000</option>
              <option>10.000 - 50.000</option>
