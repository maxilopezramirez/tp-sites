  <!-- PROMESA TICKETPLUS -->
  <PromesaTicketplus
    title="Tu negocio no termina cuando termina el evento."
    body="La membresía del socio se cobra sola el mes que viene. El streaming sigue vendiendo replays 30 días post-show. La tienda factura merch toda la temporada. El expositor descubre tu próxima feria desde el reporte de tráfico del actual. <strong>Eso es Ticketplus.</strong>"
    ctaLabel="Conocer Trust & service →"
    ctaHref="/servicios/trust-service"
  />

  <!-- POR QUÉ TICKETPLUS 360 -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus 360</span>
        <h2 class="why-tp__title">Lo que recibe tu negocio al activar el ecosistema 360.</h2>
        <p class="why-tp__lead">Membresías + Streaming + Tienda + Expositores + Netlink en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
