---
import Site from "../../layouts/Site.astro";
import PromesaTicketplus from "../../components/PromesaTicketplus.astro";

// 5 MÓDULOS PARALELOS del ecosistema Gestión 360
const modulos = [
  {
    n: "01", tag: "MÓDULO 01 · MEMBRESÍAS Y SUSCRIPCIONES", dark: false, id: "membresias",
    title: "Buscas un negocio de socios con cobro automático.",
    lead: "Encuentras 8 capacidades del módulo más granular del ecosistema.",
    footer: { href: "/servicios/familiar", text: "También destacado en /servicios/familiar →" },
    features: [
      { n: "01", title: "Cobro recurrente flexible", body: "OneClick recurrente: el medio de pago del socio queda tokenizado y se debita el día del mes que definas. Sin reingresar tarjeta, sin gestión manual.", badge: "OneClick recurrente" },
      { n: "02", title: "Medios de pago amplios", body: "Tarjeta de crédito, débito, transferencia, billeteras digitales. Cada socio elige el medio que prefiere y lo cambia desde su portal.", badge: null },
      { n: "03", title: "Gestión de morosidad sin fricción", body: "Reintentos automáticos de pagos rechazados, recordatorios por email/SMS, suspensión escalonada y reactivación al regularizar. Sin operación manual.", badge: null },
      { n: "04", title: "Planes por niveles y beneficios", body: "Bronce, Plata, Oro, VIP — cada nivel con su precio, sus beneficios y sus reglas. Migración entre niveles automática o asistida.", badge: null },
      { n: "05", title: "Credencial QR + control de acceso", body: "Cada socio recibe su credencial QR vinculada al estado del pago. Si está al día entra, si está suspendido el lector lo detecta.", badge: null },
      { n: "06", title: "Asociación a butaca o ubicación", body: "El plan puede atar al socio a una butaca específica (palco, fila, sector). El abono de temporada sabe cuál es su lugar.", badge: null },
      { n: "07", title: "Portal de miembro autoservicio", body: "El socio gestiona su perfil, descarga su credencial, ve su historial de pagos, cambia su medio de pago y descarga comprobantes — sin escribirle a soporte.", badge: null },
      { n: "08", title: "Reglas de inscripción", body: "Define ventanas de inscripción, cupos máximos, requisitos previos, descuentos por antigüedad o por familia. El motor de reglas lo aplica solo.", badge: null },
    ],
  },
  {
    n: "02", tag: "MÓDULO 02 · STREAMING / OTT", dark: true, id: "streaming",
    title: "Buscas tu propio canal OTT con SVOD + TVOD.",
    lead: "Encuentras streaming en vivo + on-demand con tu marca + protección anti-piratería.",
    footer: null,
    features: [
      { n: "01", title: "Canal OTT con tu marca", body: "Whitelabel completo: tu logo, tu paleta, tu dominio. El fan ve tu marca, no la de Ticketplus. SVOD por suscripción + TVOD por evento.", badge: "Whitelabel completo" },
      { n: "02", title: "Vivo + On Demand + integraciones", body: "Transmisión en vivo de eventos, biblioteca on-demand de replays, integraciones con encoders y CDNs profesionales (multi-bitrate, multi-CDN).", badge: null },
      { n: "03", title: "Protección anti-piratería", body: "DRM, watermarking dinámico por usuario, restricción geográfica, detección de cuentas compartidas. El stream se cae al pirata, no a tu fan.", badge: null },
      { n: "04", title: "Engagement durante la transmisión", body: "Chat moderado, polls en vivo, reacciones, llamadas a la acción overlay. El fan no solo mira — interactúa.", badge: null },
      { n: "05", title: "Ticket híbrido presencial + virtual", body: "Un solo show, dos productos: ticket presencial y ticket virtual con link de stream protegido por QR. Replay incluido 30-90 días post-evento.", badge: "Híbrido nativo" },
    ],
  },
  {
    n: "03", tag: "MÓDULO 03 · TIENDA / E-COMMERCE", dark: false, id: "tienda",
    title: "Buscas vender más que entradas.",
    lead: "Encuentras bundles ticket + merch en un checkout, fulfillment integrado e inventario sync con POS.",
    footer: null,
    features: [
      { n: "01", title: "Marketplace multi-equipo", body: "Cada equipo, club o productora con su tienda dentro del marketplace TP. Branding propio, catálogo propio, liquidación propia.", badge: null },
      { n: "02", title: "Bundles ticket + merch en un solo checkout", body: "El fan compra entrada + camiseta + bufanda en un solo flujo, con un solo pago. Sin saltar entre sitios, sin reingresar tarjeta.", badge: "Single checkout" },
      { n: "03", title: "Catálogo físicos/digitales/variantes", body: "Productos físicos (merch, indumentaria), digitales (replays, e-books), con variantes de talla, color, edición. Stock por variante, no por SKU madre.", badge: null },
      { n: "04", title: "Fulfillment + couriers", body: "Integración nativa con couriers locales y regionales. Etiquetas, tracking, notificaciones automáticas al comprador. El productor no embala — la operación está estandarizada.", badge: null },
      { n: "05", title: "Retiro en venue + sync con POS", body: "El fan compra online y retira en venue el día del show. El POS del venue conoce su compra al escanear su entrada. Inventario unificado online + presencial.", badge: null },
    ],
  },
  {
    n: "04", tag: "MÓDULO 04 · EXPOSITORES / GESTIÓN DE EXPOS", dark: true, id: "expositores",
    title: "Buscas que cada expositor gestione su propio stock.",
    lead: "Encuentras pre-acreditación sin Excel + reportes de tráfico para sponsors.",
    footer: { href: "/servicios/ferias", text: "También destacado en /servicios/ferias →" },
    features: [
      { n: "01", title: "Perfil de expositor con stock propio", body: "Cada expositor entra a su panel, sube su catálogo, gestiona su stock de invitaciones y acreditaciones. La feria no opera lo de cada uno — cada uno opera lo suyo.", badge: null },
      { n: "02", title: "Tipos de equipos con stock por tipo", body: "Definí tipos de acreditación (staff, prensa, invitado VIP, comprador, expositor) con su propio cupo y permisos de acceso por sector.", badge: null },
      { n: "03", title: "Pre-acreditación sin Excel", body: "El expositor sube su lista de invitados desde el panel — no por mail con planilla. Cada invitado recibe su QR automáticamente.", badge: "Sin Excel" },
      { n: "04", title: "Acreditación en tiempo real", body: "El día del evento, los lectores muestran tráfico en vivo: cuántos entraron, por sector, por tipo de acreditación. El expositor lo ve desde su panel.", badge: null },
      { n: "05", title: "Reportes de tráfico para sponsors", body: "Cada sponsor recibe su reporte de tráfico al stand, cantidad de leads escaneados, tiempo promedio en sector. El ROI del sponsor deja de ser narrativo.", badge: null },
    ],
  },
  {
    n: "05", tag: "MÓDULO 05 · NETLINK", dark: false, id: "netlink",
    title: "Buscas que el congreso o feria sea plataforma de negocios.",
    lead: "Encuentras una app nativa de networking 1-a-1 integrada con ticketing.",
    footer: { href: "/servicios/ferias", text: "También destacado en /servicios/ferias y /servicios/conferencias →" },
    features: [
      { n: "01", title: "Pool de asistentes navegable", body: "Cada asistente arma su perfil profesional (empresa, cargo, intereses). El resto del pool es navegable y filtrable — el fan deja de ser anónimo.", badge: null },
      { n: "02", title: "Chat 1-a-1 + agendamiento", body: "Reuniones agendadas dentro de la app, slots de tiempo, salas asignadas, recordatorios. La feria se convierte en una plataforma de meetings.", badge: "Meetings agendados" },
      { n: "03", title: "Lead capture + notificaciones push", body: "Escaneo de leads en stand, intercambio de tarjetas digital, notificaciones push para reuniones y novedades de los expositores que el asistente sigue.", badge: null },
      { n: "04", title: "Galería + repositorio de descargas", body: "Cada expositor sube fotos, fichas técnicas, brochures y videos. El asistente descarga lo que le interesa sin pedirlo por mail después.", badge: null },
      { n: "05", title: "Branding + EXTERNALS + control de acceso", body: "Branding completo del evento. Integraciones con sistemas externos (CRM, plataformas de congresos). Control de acceso a la app por tipo de ticket.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · Membresías", title: "Cobros recurrentes con OneClick, planes por niveles, credencial QR vinculada al estado.", href: "#membresias" },
  { tag: "02 · Streaming", title: "Canal con tu marca, SVOD + TVOD, anti-piratería, ticket híbrido presencial + virtual.", href: "#streaming" },
  { tag: "03 · Tienda", title: "Bundles ticket + merch en un checkout, fulfillment integrado, inventario unificado con POS.", href: "#tienda" },
  { tag: "04 · Expositores", title: "Stock propio del expositor, pre-acreditación sin Excel, reportes de tráfico ROI.", href: "#expositores" },
  { tag: "05 · Netlink", title: "App nativa de networking 1-a-1, lead capture, agendamiento de reuniones.", href: "#netlink" },
];

const whyCards = [
  { icon: "🔄", title: "Cobros recurrentes con OneClick", body: "Tokenización del medio de pago, débitos automáticos, sin gestión manual de morosidad." },
  { icon: "🎥", title: "Tu propio canal OTT", body: "Whitelabel completo, SVOD + TVOD, anti-piratería, ticket híbrido presencial + virtual." },
  { icon: "🛍️", title: "Bundles ticket + merch", body: "Un solo checkout, fulfillment con couriers, sync de inventario online + POS venue." },
  { icon: "🤝", title: "Networking + Expositores integrados", body: "App de meetings 1-a-1, pre-acreditación sin Excel, reportes de tráfico para sponsors." },
];

const industries = [
  { icon: "🎡", label: "Centros familiares", body: "Membresías OneClick para pases anuales + Tienda con bundles.", href: "/servicios/familiar" },
  { icon: "⚽", label: "Deportes", body: "Membresías para cuotas de socio + Tienda con merch oficial del club.", href: "/servicios/deportes" },
  { icon: "🎭", label: "Teatros", body: "Membresías de abonado de temporada + Streaming para replay de funciones.", href: "/servicios/teatros" },
  { icon: "🎪", label: "Festivales", body: "Tienda con bundles ticket + merch + Streaming pay-per-view post-show.", href: "/servicios/festivales" },
  { icon: "🎵", label: "Espectáculos", body: "Streaming SVOD + TVOD para shows internacionales + Tienda oficial.", href: "/servicios/espectaculo" },
  { icon: "💼", label: "Conferencias", body: "Netlink networking 1-a-1 + Streaming para asistentes remotos.", href: "/servicios/conferencias" },
  { icon: "🎪", label: "Ferias", body: "Expositores con stock propio + Netlink para matchmaking B2B.", href: "/servicios/ferias" },
];

const checklist = [
  "Activación modular — empezás por uno o por la suite",
  "Integración nativa con ticketing TP",
  "OneClick recurrente sin licencia extra",
  "Streaming con tu marca (whitelabel)",
  "Expositores + Netlink incluidos",
  "Onboarding en 4-6 semanas por módulo",
];

const modulosForm = ["Membresías", "Streaming", "Tienda", "Expositores", "Netlink"];

const faqs = [
  { q: "¿Puedo activar solo un módulo o tengo que tomar los 5?", a: "Activación <strong>modular</strong>. Empezás por el que necesitás hoy — Membresías, Streaming, Tienda, Expositores o Netlink — y sumás el resto cuando tu negocio lo pide. No hay paquete obligatorio." },
  { q: "¿Necesito ticketing Ticketplus para usar Gestión 360?", a: "No. Los módulos funcionan <strong>sin ticketing TP</strong>, pero se potencian con ticketing TP nativo: la credencial QR del socio es la misma que la entrada al show, el ticket híbrido presencial + virtual sale del mismo SKU, el bundle ticket + merch va en un solo checkout. Integrarlo es donde aparece el valor compuesto." },
  { q: "¿Cuánto cuesta cada módulo?", a: "<strong>Cargo por servicio sobre la transacción</strong> del módulo (membresía cobrada, ticket OTT vendido, merch facturado, acreditación procesada, reunión agendada). Sin licencia, sin mínimos, sin permanencia. Pagás cuando facturas." },
  { q: "¿Cómo se integra Streaming con mi ticketing?", a: "<strong>Ticket híbrido</strong>: un solo show, dos productos. Ticket presencial con QR de acceso al venue y ticket virtual con link de stream protegido por el mismo QR. Replay incluido 30-90 días post-evento. El fan elige formato; el productor vende los dos." },
  { q: "¿Quién es dueño de la data de membresías y clientes?", a: "<strong>El productor</strong>. Base de socios, historial de pagos, preferencias y comportamiento son del productor — exportables cuando quieras, sin contrato de permanencia. Si te vas, te llevás todo." },
];
---
<Site title="Servicios Ticketplus · Gestión 360 — Ecosistema más allá del ticket">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Ecosistema 360 · Más allá del ticket</p>
        <h1 class="biz-hero__title">La plataforma que opera tu negocio completo.</h1>
        <p class="biz-hero__lead">Cada módulo funciona solo o integrado con ticketing. Activa los que necesitas, cuando los necesitas.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Agendar demo →</a>
          <a href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" class="btn btn--ghost">Hablar con un especialista</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src={`${import.meta.env.BASE_URL}/scenes/hero-devices-v2.png`} alt="Ecosistema Gestión 360 Ticketplus — 5 módulos paralelos" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras que extienden su negocio con Ticketplus 360.</p>
      <div class="logos-cloud__grid">
        {["U. Católica 🇨🇱","Movistar Arena 🇨🇱","Endeavor 🇨🇱","Ñam Festival 🇨🇱","Audax Italiano 🇨🇱","Teatro UC 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE / TESIS -->
  <section class="bridge">
    <div class="container">
      <span class="bridge__eyebrow">12 años extendiendo eventos en LATAM</span>
      <h2 class="bridge__title">Cinco módulos. Una sola plataforma. Activas los que tu negocio necesita.</h2>
      <p class="bridge__lead">Cada módulo funciona solo o integrado con ticketing. Empezás por uno o por la suite completa.</p>
    </div>
  </section>

  <!-- MÓDULO 01 · MEMBRESÍAS Y SUSCRIPCIONES -->
  {(() => {
    const p = modulos[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}

          {p.footer && (
            <div class="biz-scene__module-footer">
              <a href={p.footer.href}>{p.footer.text}</a>
            </div>
          )}
        </div>
      </section>
    );
  })()}

  <!-- MÓDULO 02 · STREAMING / OTT -->
