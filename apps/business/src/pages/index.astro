  .spotlight__title, .spotlight__body { max-width: 880px; margin-left: auto; margin-right: auto; }
  .spotlight__eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 999px;
    margin-bottom: 22px;
    background: rgba(255,255,255,0.16);
