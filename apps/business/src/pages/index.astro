  .spotlight--dark .spotlight__title { color: #fff; }
  .spotlight__body {
    font-family: var(--font-body);
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 auto;
    max-width: 720px;
  }
  .spotlight--light .spotlight__body { color: var(--color-text-muted); }
