  .form-grid-tp { display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center; }

  /* ── Spotlights (Booster · Discovery · Extended) ──────── */
  .spotlight { padding: 100px 0; border-top: 1px solid var(--color-border); }
  .spotlight--brand { background: var(--gradient-brand); color: #fff; border-top: none; }
