  .pillar-overview-card { border:1px solid var(--color-border); border-radius:var(--radius-card); padding:36px 28px; display:flex; flex-direction:column; gap:14px; }
  .pillar-tag { display:inline-block; font-family:var(--font-heading); font-size:11px; font-weight:800; color:var(--color-primary); letter-spacing:0.15em; background:rgba(255,19,19,0.08); padding:4px 12px; border-radius:999px; align-self:flex-start; }
