  /* ANALYTICS mock */
  .mock-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 18px; }
  .mock-metric { padding: 12px; background: #fff; border: 1px solid rgba(10,10,10,0.06); border-radius: 8px; }
  .mock-metric__num { font-family: var(--font-heading); font-weight: 900; font-size: 1.05rem; letter-spacing: -0.02em; color: #0a0a0a; }
  .mock-metric__lbl { font-family: var(--font-body); font-size: 10px; color: var(--color-text-muted); margin-top: 2px; }
  .mock-chart {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 110px;
    padding: 12px;
    background: #fff;
    border: 1px solid rgba(10,10,10,0.06);
