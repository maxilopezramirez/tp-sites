  .feature-card__badge { display:inline-block; font-family:var(--font-heading); font-size:0.7rem; font-weight:700; color:var(--color-secondary); background:rgba(255,171,36,0.10); border:1px solid rgba(255,171,36,0.30); border-radius:4px; padding:3px 8px; letter-spacing:0.05em; text-transform:uppercase; align-self:flex-start; }

  .country-row-tp { display:grid; grid-template-columns:180px 1fr; gap:24px; align-items:center; padding:18px 0; border-top:1px solid var(--color-border); }
  .country-label-tp { display:flex; align-items:center; gap:10px; font-family:var(--font-heading); font-weight:700; font-size:0.95rem; }
