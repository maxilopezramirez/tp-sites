  /* ── Supporting scenes grid ────────────────────────────── */
  .biz-scene__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 20px;
  }
  .scene-card {
    grid-column: span 2;
    background: #fff;
    border: 1px solid rgba(10,10,10,0.08);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform .2s, box-shadow .2s, border-color .2s;
  }
  .biz-scene--dark .scene-card { background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.08); }
  .scene-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(0,0,0,0.08); border-color: rgba(10,10,10,0.18); }
  .biz-scene--dark .scene-card:hover { border-color: rgba(255,255,255,0.18); box-shadow: 0 14px 36px rgba(0,0,0,0.5); }
  .scene-card--wide { grid-column: span 3; }
  .biz-scene__grid--2 .scene-card,
  .biz-scene__grid--2 .scene-card--wide { grid-column: span 3; }
  .biz-scene__grid--3 .scene-card--wide { grid-column: span 2; }
  .biz-scene__grid--3 .scene-card { grid-column: span 2; }
  .biz-scene__grid--4 .scene-card--wide { grid-column: span 3; }
  .biz-scene__grid--4 .scene-card { grid-column: span 3; }

  .scene-card__stage {
    aspect-ratio: 16/9;
    position: relative;
    background: linear-gradient(135deg, rgba(255,19,19,0.10) 0%, rgba(255,171,36,0.10) 100%);
    overflow: hidden;
  }
  .scene-card__stage::before,
  .scene-card__stage::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(20px);
    opacity: 0.55;
  }
  .scene-card__stage::before {
    width: 60%; height: 80%;
    top: -10%; left: -10%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }
  .scene-card__stage::after {
    width: 50%; height: 60%;
    bottom: -10%; right: -10%;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }
  .biz-scene--dark .scene-card__stage {
    background: linear-gradient(135deg, rgba(255,19,19,0.18) 0%, rgba(255,171,36,0.18) 100%);
  }
  /* pilar-specific stage tints */
  .scene-card__stage--p0-0 { background: linear-gradient(135deg, #fff1e0 0%, #ffe0d4 100%); }
  .scene-card__stage--p0-1 { background: linear-gradient(135deg, #fde6e6 0%, #ffd7b8 100%); }
  .scene-card__stage--p0-2 { background: linear-gradient(135deg, #fff5cc 0%, #ffd7b8 100%); }
  .scene-card__stage--p1-0,
  .scene-card__stage--p1-1,
  .scene-card__stage--p1-2,
  .scene-card__stage--p1-3 { background: linear-gradient(135deg, #2a1414 0%, #0c0c0c 100%); }
  .scene-card__stage--p2-0 { background: linear-gradient(135deg, #fff 0%, #fff3c4 100%); }
  .scene-card__stage--p2-1 { background: linear-gradient(135deg, #fff0e8 0%, #fde6e6 100%); }
  .scene-card__stage--p2-2 { background: linear-gradient(135deg, #ffeede 0%, #fff5cc 100%); }
  .scene-card__stage--p2-3 { background: linear-gradient(135deg, #fde6e6 0%, #ffe2d0 100%); }
  .scene-card__stage--p3-0,
  .scene-card__stage--p3-1,
  .scene-card__stage--p3-2 { background: linear-gradient(135deg, #142020 0%, #0a0a0a 100%); }
  .scene-card__stage--p4-0 { background: linear-gradient(135deg, #fff1e0 0%, #ffd7b8 100%); }
  .scene-card__stage--p4-1 { background: linear-gradient(135deg, #fde6e6 0%, #fff5cc 100%); }
  .scene-card__stage--p4-2 { background: linear-gradient(135deg, #fff5cc 0%, #ffe0d4 100%); }
  .scene-card__stage--p4-3 { background: linear-gradient(135deg, #fff1e0 0%, #fde6e6 100%); }

  .scene-card__chip {
    position: absolute;
    z-index: 2;
