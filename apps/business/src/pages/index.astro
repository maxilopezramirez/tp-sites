  .spotlight--brand .spotlight-card { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.22); }
  .spotlight-card__chip {
    align-self: flex-start;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.14em;
