---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const heroImage = "https://images.unsplash.com/photo-1429962714451-bb934ecdc4ec?auto=format&fit=crop&w=2400&q=80";

const scale = [
  { value: "10.2M", label: "Tickets sold (2025)" },
  { value: "$269M", label: "Gross sales" },
  { value: "11", label: "Countries" },
  { value: "2,800", label: "Promoters & venues" },
  { value: "95%+", label: "Client retention" },
];

const thesis = [
  { n: "01", title: "Tailwinds.", body: "A $40B market growing at 16.6% CAGR — over four times the global rate. Six hundred seventy million people. Still underpenetrated." },
  { n: "02", title: "Moat.", body: "Core software stack built in-house since 2014. Eleven countries. Twelve years of multi-market data. 2,800+ partner relationships on our infrastructure every day." },
  { n: "03", title: "Scale & proof.", body: "$269M gross sales. Revenue +64% in 2025. EBITDA margin 37.3%. Q1 2026: revenue +41%, margin 44%. More than 95% retention." },
  { n: "04", title: "Category.", body: "The technology platform for Latin American live entertainment. We serve the underserved 95% the global incumbents do not reach. Bootstrapped twelve years. Profitable." },
  { n: "05", title: "Proprietary AI.", body: "Anti-fraud, dynamic pricing, demand forecasting — built in-house. No reliance on third-party core infrastructure. Every module compounds on the same codebase." },
];

const segments = [
  {
    id: "s-promoters",
    label: "Independent Promoters",
    who: "Event organizers running concerts, sports, theater and cultural events across Latin America.",
    capabilities: ["Event Ticketing", "Payments & Banking", "Data & Analytics", "Access Control", "On-Site Operations"],
    stats: [
      { v: "2,800+", l: "Active promoters & venues on the platform" },
      { v: "4%", l: "Maximum revenue concentration per client" },
    ],
  },
  {
    id: "s-federations",
    label: "National Federations",
    who: "Sports governing bodies and national federations managing large-scale event infrastructure.",
    capabilities: ["Event Ticketing", "Access Control", "Data & Analytics"],
    stats: [
      { v: "FIFA U-20", l: "World Cup Chile 2025 — same stack" },
      { v: "100→90,000", l: "Seats — one platform, any scale" },
    ],
  },
  {
    id: "s-festivals",
    label: "Festivals",
    who: "Multi-day live music and entertainment festivals requiring cashless, high-capacity operations.",
    capabilities: ["Event Ticketing", "Payments & Banking", "Access Control", "On-Site Operations"],
    stats: [
      { v: "90,000", l: "Tickets — Ed Sheeran, Argentina & Paraguay" },
      { v: "RFID/NFC", l: "Cashless wristbands for F&B and VIP" },
    ],
  },
  {
    id: "s-venues",
    label: "Venues",
    who: "Stadiums, arenas, theaters and cultural centers embedding the platform into daily operations.",
    capabilities: ["Event Ticketing", "Access Control", "On-Site Operations", "Data & Analytics"],
    stats: [
      { v: "99.9%", l: "Platform uptime — offline-capable" },
      { v: "3D", l: "Interactive seat-level layouts, real-time inventory" },
    ],
  },
  {
    id: "s-parks",
    label: "Parks & Attractions",
    who: "National parks, theme parks and tourist attractions running access control at any location.",
    capabilities: ["Event Ticketing", "Access Control", "Payments & Banking"],
    stats: [
      { v: "Rapa Nui", l: "Torres del Paine — same stack as national stadiums" },
      { v: "Offline", l: "Validation — no connectivity required" },
    ],
  },
];

const dataLayer = [
  { brand: "Stripe", asset: "Payment data", expansion: "Commerce intelligence" },
  { brand: "Toast", asset: "Restaurant ops", expansion: "Expanding within installed base" },
  { brand: "Shopify", asset: "Merchant data", expansion: "Financial services" },
  { brand: "Ticketplus", asset: "Live entertainment data", expansion: "De-risked expansion", own: true },
];
---
<Site title="Ticketplus · Investor Relations" current="home" description="The operating system for live entertainment across Latin America.">

  <!-- 1. HERO -->
  <header class="hero-ml">
    <div class="hero-ml__media" style={`background-image: url(${heroImage});`} aria-hidden="true"></div>
    <div class="hero-ml__scrim" aria-hidden="true"></div>
    <div class="hero-ml__inner">
      <h1 class="hero-ml__title">
        The operating system for live entertainment across Latin America.
      </h1>
      <p class="hero-ml__sub">
        Ticketing is the entry point. The long-term opportunity is the operating, transaction and data layer.
      </p>
      <div class="hero-ml__ctas">
        <a class="btn btn--primary" href={link("/about/")}>Our story</a>
        <a class="btn btn--ghost" href={link("/contact/")}>Contact IR</a>
      </div>
    </div>
  </header>

  <!-- 2. SCALE BAR -->
  <section class="scalebar">
    <div class="container">
      <ul class="scalebar__list">
        {scale.map((s) => (
          <li class="scalebar__item">
            <span class="scalebar__value">{s.value}</span>
            <span class="scalebar__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. FIVE REASONS -->
  <section class="highlights">
    <div class="container">
      <p class="section__eyebrow">Investment thesis</p>
      <h2 class="section__title">Five reasons <span class="accent">this matters.</span></h2>
      <ol class="hl-list">
        {thesis.map((t, i) => (
          <li class={`hl${i >= 3 ? " hl--amber" : ""}`}>
            <span class="hl__n">{t.n}</span>
            <div>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. AT THE CENTER OF THE LIVE ECONOMY -->
  <section class="ecosystem-tabs">
    <div class="container">
      <p class="section__eyebrow">The platform</p>
      <h2 class="section__title">Ticketplus Is at the Center of the <span class="accent">Live Economy.</span></h2>
      <p class="ecosystem-tabs__lead">2,800+ promoters, federations, festivals, venues and parks run on the same infrastructure — from a 100-seat theater to the FIFA U-20 World Cup.</p>

      <nav class="eco-nav" role="tablist">
        {segments.map((s, i) => (
          <button
            class={`eco-btn${i === 0 ? " is-active" : ""}`}
            data-target={s.id}
            role="tab"
          >{s.label}</button>
        ))}
      </nav>

      {segments.map((s, i) => (
        <div id={s.id} class="eco-panel" role="tabpanel" style={i !== 0 ? "display:none" : ""}>
          <div class="eco-panel__inner">
            <div class="eco-panel__left">
              <p class="eco-panel__who">{s.who}</p>
              <div class="eco-panel__caps">
                <p class="eco-panel__caps-label">Platform delivers</p>
                <ul class="eco-panel__caps-list">
                  {s.capabilities.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            </div>
            <div class="eco-panel__right">
              {s.stats.map((st) => (
                <div class="eco-panel__stat">
                  <span class="eco-panel__stat-value">{st.v}</span>
                  <span class="eco-panel__stat-label">{st.l}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. DATA LAYER -->
  <section class="thesis">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Competitive advantage · The data layer</p>
      <h2 class="section__title section__title--inv">We do not compete against ticketing companies. <span class="accent">We capture the data layer.</span></h2>
      <div class="thesis__grid">
        <div class="thesis__copy">
          <p>Over 10.2 million tickets a year across 11 jurisdictions, we capture the full data layer of regional live entertainment: who buys, what they buy, when, in which venue, with which payment method, at which price, with which behavioral pattern.</p>
          <p>That data composes — day by day, across 11 markets, 50+ payment methods, thousands of local commercial relationships. No global player can replicate it by acquisition. It is the asset, and it compounds.</p>
          <p>Ticketing is the first vertical. The verticals adjacent to the data layer — payments, BI, dynamic pricing, financial services for partners — are the long-term expansion thesis.</p>
        </div>
        <div class="thesis__table">
          <p class="thesis__table-title">A proven playbook</p>
          <table>
            <thead>
              <tr><th>Company</th><th>Data captured</th><th>Adjacent expansion</th></tr>
            </thead>
            <tbody>
              {dataLayer.map((row) => (
                <tr class={row.own ? "own" : ""}>
                  <td>{row.brand}</td>
                  <td>{row.asset}</td>
                  <td>{row.expansion}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="thesis__footnote">Business-model parallel only · not a valuation reference.</p>
        </div>
      </div>
      <div class="thesis__strip">
        <span><strong>100%</strong> Transaction visibility</span>
        <span><strong>11</strong> Country regulatory &amp; payments stack</span>
        <span><strong>12 years</strong> of multi-market operating data</span>
      </div>
    </div>
  </section>

  <!-- 6. CLOSING -->
  <section class="thesis" style="padding: 120px 0; border-top: 1px solid rgba(255,255,255,0.08);">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">The opportunity ahead</p>
      <h2 class="section__title section__title--inv">This is not a validation event.<br/>It is an <span class="accent">acceleration event.</span></h2>
      <p class="home-closing__lead">Nasdaq is the vehicle, not the goal. The goal is to build the operating, transaction and data infrastructure layer for live entertainment across Latin America.</p>
      <a class="btn btn--primary" href={link("/contact/")} style="margin-top: 8px; display: inline-flex;">Contact IR</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.eco-btn');
      var panels = document.querySelectorAll('.eco-panel');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.classList.remove('is-active'); });
          panels.forEach(function (p) { p.style.display = 'none'; });
          b.classList.add('is-active');
          var target = document.getElementById(b.dataset.target);
          if (target) target.style.display = 'block';
        });
      });
    })();
  </script>
</Site>

<style>
  /* Scale bar */
  .scalebar {
    background: var(--color-surface-elevated);
    padding: 56px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .scalebar__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap;
  }
  .scalebar__item {
    flex: 1 1 0; min-width: 140px;
    padding-right: 40px;
    margin-right: 40px;
    border-right: 1px solid var(--color-border);
  }
  .scalebar__item:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .scalebar__value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 44px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .scalebar__label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Hero sub + CTAs */
  .hero-ml__sub {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(255,255,255,0.78);
    max-width: 600px;
    margin: 16px 0 0;
  }
  .hero-ml__ctas {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  /* Ecosystem tabs */
  .ecosystem-tabs { background: var(--color-surface-elevated); }
  .ecosystem-tabs__lead {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin: 0 0 48px;
  }

  .eco-nav {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0;
    flex-wrap: wrap;
  }
  .eco-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 14px 20px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    letter-spacing: -0.01em;
    transition: color .15s ease, border-color .15s ease;
    white-space: nowrap;
  }
  .eco-btn:hover { color: var(--color-text-primary); }
  .eco-btn.is-active {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-primary);
  }

  .eco-panel__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 48px 0 0;
    align-items: start;
  }
  .eco-panel__who {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .eco-panel__caps-label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 14px;
  }
  .eco-panel__caps-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .eco-panel__caps-list li {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
    background: #ededed;
    color: var(--color-text-primary);
  }
  .eco-panel__right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    align-self: start;
  }
  .eco-panel__stat {
    padding: 28px 24px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .eco-panel__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(24px, 2.5vw, 36px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .eco-panel__stat-label {
    display: block;
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Home closing lead */
  .home-closing__lead {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255,255,255,0.78);
    max-width: 680px;
    margin: 24px 0 32px;
  }

  @media (max-width: 880px) {
    .eco-panel__inner { grid-template-columns: 1fr; gap: 40px; }
    .eco-panel__right { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 720px) {
    .scalebar__item { flex: 1 1 40%; border-right: none; margin-right: 0; padding-right: 0; }
    .scalebar__list { gap: 28px; }
    .eco-btn { font-size: 13px; padding: 12px 14px; }
  }
</style>
