---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const heroImage = "https://images.unsplash.com/photo-1429962714451-bb934ecdc4ec?auto=format&fit=crop&w=2400&q=80";

const scale = [
  { value: "10.2M", label: "Tickets sold (2025)" },
  { value: "$269M", label: "Gross sales" },
  { value: "11", label: "Countries" },
  { value: "2,800", label: "Promoters & venues" },
  { value: "95%+", label: "Client retention" },
];

const thesis = [
  {
    n: "01",
    concept: "Tailwinds.",
    title: "A $40B Market Growing at Four Times the Global Rate",
    body: "A $40B market growing at 16.6% CAGR — over four times the global rate. Six hundred seventy million people. Still underpenetrated.",
    chart: `<svg viewBox="0 0 640 160" width="100%" aria-hidden="true" style="max-width:560px;display:block;margin-top:24px;">
      <defs><linearGradient id="g1" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#f79802"/><stop offset="100%" stop-color="#ff1313"/></linearGradient></defs>
      <line x1="0" y1="140" x2="640" y2="140" stroke="#e5e5e5" stroke-width="1"/>
      <polyline points="0,120 160,100 320,72 480,40 600,18" fill="none" stroke="url(#g1)" stroke-width="3" stroke-linecap="round"/>
      <polyline points="0,128 160,126 320,124 480,122 600,121" fill="none" stroke="#d4d4d4" stroke-width="2" stroke-dasharray="5 4"/>
      <text x="0" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">2022</text>
      <text x="148" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">2024</text>
      <text x="308" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">2026</text>
      <text x="468" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">2028</text>
      <text x="578" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">2030</text>
      <text x="492" y="34" font-family="Montserrat,sans-serif" font-size="11" font-weight="700" fill="#ff1313">LATAM +16.6% CAGR</text>
      <text x="492" y="116" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3">Global +3.8% CAGR</text>
    </svg>
    <p style="font-family:var(--font-mono);font-size:11px;color:var(--color-gray-500);margin-top:8px;">Sources: PwC GE&M Outlook · Mordor Intelligence · Grand View Horizon.</p>`,
  },
  {
    n: "02",
    concept: "Moat.",
    title: "Twelve Years of Operational Infrastructure Capital Cannot Replicate",
    body: "Core software stack built in-house since 2014. Eleven countries. Twelve years of multi-market data. 2,800+ partner relationships on our infrastructure every day. 50+ operators in our conversion pipeline — relationships we already understand from inside the infrastructure.",
    chart: null,
  },
  {
    n: "03",
    concept: "Scale & proof.",
    title: "A Profitable Platform Already Operating at Scale",
    body: "$269M gross sales. Revenue +64% in 2025. EBITDA margin 37.3%. Q1 2026: revenue +41%, margin 44%. More than 95% retention.",
    chart: `<svg viewBox="0 0 560 160" width="100%" aria-hidden="true" style="max-width:560px;display:block;margin-top:24px;">
      <defs><linearGradient id="g2" x1="0" y1="1" x2="0" y2="0"><stop offset="0%" stop-color="#f79802"/><stop offset="100%" stop-color="#ff1313"/></linearGradient></defs>
      <line x1="0" y1="140" x2="560" y2="140" stroke="#e5e5e5" stroke-width="1"/>
      <rect x="40" y="100" width="60" height="40" rx="3" fill="#e5e5e5"/>
      <rect x="160" y="80" width="60" height="60" rx="3" fill="#d4d4d4"/>
      <rect x="280" y="40" width="60" height="100" rx="3" fill="url(#g2)"/>
      <rect x="400" y="20" width="60" height="120" rx="3" fill="url(#g2)" opacity="0.7"/>
      <text x="58" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">2023</text>
      <text x="178" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">2024</text>
      <text x="298" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">2025</text>
      <text x="418" y="158" font-family="Montserrat,sans-serif" font-size="11" fill="#a3a3a3" text-anchor="middle">Q1 '26</text>
      <text x="298" y="34" font-family="Montserrat,sans-serif" font-size="11" font-weight="700" fill="#ff1313" text-anchor="middle">+64%</text>
      <text x="418" y="14" font-family="Montserrat,sans-serif" font-size="11" font-weight="700" fill="#ff1313" text-anchor="middle">44% EBITDA</text>
    </svg>
    <p style="font-family:var(--font-mono);font-size:11px;color:var(--color-gray-500);margin-top:8px;">Source: Ticketplus audited IFRS financials (Baker Tilly, PCAOB). Q1 2026 preliminary.</p>`,
  },
  {
    n: "04",
    concept: "Category.",
    title: "The Technology Platform Serving the 95% Global Incumbents Do Not Reach",
    body: "The technology platform for Latin American live entertainment. We serve the underserved 95% the global incumbents do not reach. Bootstrapped twelve years. Profitable.",
    chart: null,
  },
  {
    n: "05",
    concept: "Proprietary AI.",
    title: "Proprietary AI — Built In-House, Compounding on Every Module",
    body: "Anti-fraud, dynamic pricing, demand forecasting — built in-house. No reliance on third-party core infrastructure. Every module compounds on the same codebase.",
    chart: null,
  },
];

const segments = [
  {
    id: "s-ticketing",
    label: "Event Ticketing",
    tags: "VIRTUAL QUEUE · 3D LAYOUTS · ELASTIC INFRA",
    body: "High-concurrency sales engine for massive demand. Fair-randomization virtual queues handle spikes from a 100-seat theater to a national stadium. 3D seat-level layouts, real-time inventory sync, anti-bot, dynamic pricing.",
    stats: [{ v: "10.2M", l: "Tickets issued in 2025" }, { v: "39,800", l: "Events orchestrated · 99.9% uptime" }],
  },
  {
    id: "s-payments",
    label: "Payments & Banking",
    tags: "ACQUIRERS · BNPL · DIGITAL WALLETS · CARDS",
    body: "50+ country-specific payment methods across LATAM. Regional and country-specific gateways, BNPL providers, international card networks, local debit and digital wallets. Each new market adds payment primitives to the same shared infrastructure.",
    stats: [{ v: "50+", l: "Country-specific payment methods" }, { v: "$269M", l: "Gross sales across 11 countries (2025)" }],
  },
  {
    id: "s-data",
    label: "Data & Analytics",
    tags: "REAL-TIME MANAGEMENT · BUSINESS INTELLIGENCE · AI",
    body: "Live operational data across markets and partners — multi-year visibility into every partner running on Ticketplus, in real time. AI embedded across customer-facing services and internal operations: anti-fraud, dynamic pricing, demand forecasting.",
    stats: [{ v: "100%", l: "Transaction visibility · 11 jurisdictions" }, { v: "12 yrs", l: "Multi-market operating data" }],
  },
  {
    id: "s-access",
    label: "Access Control",
    tags: "DYNAMIC QR · BIOMETRIC · RFID / NFC",
    body: "Multi-layer validation, frictionless entry. Real-time validation, anti-fraud, facial recognition for VIP, cashless wristbands for festivals. The same access engine that runs a stadium gate also runs a national park trailhead — offline-capable, fraud-resilient.",
    stats: [{ v: "99.9%", l: "Platform uptime · offline-capable validation" }, { v: "Rapa Nui", l: "Torres del Paine — same stack as national stadiums" }],
  },
  {
    id: "s-onsite",
    label: "On-Site Operations",
    tags: "KIOSKS · MOBILE POS · CASHLESS NFC",
    body: "Seamless box office and in-venue experience. Self-service pickup, roaming sales with inventory sync, NFC for F&B and VIP. 36 people on direct payroll — the platform sustains the monthly work of 2,000+ on-site operators in Chile alone.",
    stats: [{ v: "2,000+", l: "Monthly on-site operators orchestrated · CL" }, { v: "36", l: "People on direct payroll · AI-leveraged ops" }],
  },
];

const dataLayer = [
  { brand: "Stripe", color: "#635BFF", asset: "Payment data", expansion: "Commerce intelligence" },
  { brand: "Toast", color: "#FF4500", asset: "Restaurant ops", expansion: "Expanding within installed base" },
  { brand: "Shopify", color: "#96BF48", asset: "Merchant data", expansion: "Financial services" },
  { brand: "Ticketplus", color: null, asset: "Live entertainment data", expansion: "De-risked expansion", own: true },
];
---
<Site title="Ticketplus · Investor Relations" current="home" description="The operating system for live entertainment across Latin America.">

  <!-- 1. HERO -->
  <header class="hero-ml">
    <div class="hero-ml__media" style={`background-image: url(${heroImage});`} aria-hidden="true"></div>
    <div class="hero-ml__scrim" aria-hidden="true"></div>
    <div class="hero-ml__inner">
      <h1 class="hero-ml__title">
        The operating system for live entertainment across Latin America.
      </h1>
      <p class="hero-ml__sub">
        Ticketing is the entry point. The long-term opportunity is the operating, transaction and data layer.
      </p>
      <div class="hero-ml__ctas">
        <a class="btn btn--primary" href={link("/about/")}>Our story</a>
        <a class="btn btn--ghost" href={link("/contact/")}>Contact IR</a>
      </div>
    </div>
  </header>

  <!-- 2. SCALE BAR -->
  <section class="scalebar">
    <div class="container">
      <ul class="scalebar__list">
        {scale.map((s) => (
          <li class="scalebar__item">
            <span class="scalebar__value">{s.value}</span>
            <span class="scalebar__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. AT THE CENTER OF THE LIVE ECONOMY -->
  <section class="ecosystem-tabs">
    <div class="container">
      <p class="section__eyebrow">The platform</p>
      <h2 class="section__title">Ticketplus Is at the Center of the <span class="accent">Live Economy.</span></h2>
      <p class="ecosystem-tabs__lead">2,800+ promoters, federations, festivals, venues and parks run on the same infrastructure — from a 100-seat theater to the FIFA U-20 World Cup.</p>

      <nav class="eco-nav" role="tablist">
        {segments.map((s, i) => (
          <button
            class={`eco-btn${i === 0 ? " is-active" : ""}`}
            data-target={s.id}
            role="tab"
          >{s.label}</button>
        ))}
      </nav>

      {segments.map((s, i) => (
        <div id={s.id} class="eco-panel" role="tabpanel" style={i !== 0 ? "display:none" : ""}>
          <div class="eco-panel__inner">
            <div class="eco-panel__left">
              <p class="eco-panel__tags">{s.tags}</p>
              <p class="eco-panel__body">{s.body}</p>
            </div>
            <div class="eco-panel__right">
              {s.stats.map((st) => (
                <div class="eco-panel__stat">
                  <span class="eco-panel__stat-value">{st.v}</span>
                  <span class="eco-panel__stat-label">{st.l}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. FIVE REASONS — accordion -->
  <section class="thesis-acc">
    <div class="container">
      <p class="section__eyebrow">Investment thesis</p>
      <h2 class="section__title">Five reasons <span class="accent">this matters.</span></h2>
      <ol class="acc-list">
        {thesis.map((t, i) => (
          <li class={`acc-item${i === 0 ? " is-open" : ""}`}>
            <button class="acc-head" type="button">
              <span class="acc-head__left">
                <span class="acc-head__n">{t.n}</span>
                <span class="acc-head__title">{t.title}</span>
              </span>
              <svg class="acc-head__chev" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><polyline points="5,8 10,13 15,8"/></svg>
            </button>
            <div class="acc-body">
              <div class="acc-body__inner">
                <p class="acc-body__concept">{t.concept}</p>
                <p class="acc-body__text">{t.body}</p>
                {t.chart && <div set:html={t.chart}></div>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. DATA LAYER -->
  <section class="thesis">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Competitive advantage · The data layer</p>
      <h2 class="section__title section__title--inv">We do not compete against ticketing companies. <span class="accent">We capture the data layer.</span></h2>
      <div class="thesis__grid">
        <div class="thesis__copy">
          <p>Over 10.2 million tickets a year across 11 jurisdictions, we capture the full data layer of regional live entertainment: who buys, what they buy, when, in which venue, with which payment method, at which price, with which behavioral pattern.</p>
          <p>That data composes — day by day, across 11 markets, 50+ payment methods, thousands of local commercial relationships. No global player can replicate it by acquisition. It is the asset, and it compounds.</p>
          <p>Ticketing is the first vertical. The verticals adjacent to the data layer — payments, BI, dynamic pricing, financial services for partners — are the long-term expansion thesis.</p>
        </div>
        <div class="thesis__table">
          <p class="thesis__table-title">A proven playbook</p>
          <table>
            <thead>
              <tr><th>Company</th><th>Data captured</th><th>Adjacent expansion</th></tr>
            </thead>
            <tbody>
              {dataLayer.map((row) => (
                <tr class={row.own ? "own" : ""}>
                  <td>
                    {row.own
                      ? <span class="brand-badge brand-badge--tp">{row.brand}</span>
                      : <span class="brand-badge" style={`background:${row.color}18;color:${row.color};border-color:${row.color}40`}>{row.brand}</span>
                    }
                  </td>
                  <td>{row.asset}</td>
                  <td>{row.expansion}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="thesis__footnote">Business-model parallel only · not a valuation reference.</p>
        </div>
      </div>
      <div class="thesis__strip">
        <span><strong>100%</strong> Transaction visibility</span>
        <span><strong>11</strong> Country regulatory &amp; payments stack</span>
        <span><strong>12 years</strong> of multi-market operating data</span>
      </div>
    </div>
  </section>

  <!-- 6. CLOSING -->
  <section class="thesis" style="padding: 120px 0; border-top: 1px solid rgba(255,255,255,0.08);">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">The opportunity ahead</p>
      <h2 class="section__title section__title--inv">This is not a validation event.<br/>It is an <span class="accent">acceleration event.</span></h2>
      <p class="home-closing__lead">Nasdaq is the vehicle, not the goal. The goal is to build the operating, transaction and data infrastructure layer for live entertainment across Latin America.</p>
      <a class="btn btn--primary" href={link("/contact/")} style="margin-top: 8px; display: inline-flex;">Contact IR</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      document.querySelectorAll('.acc-head').forEach(function (h) {
        h.addEventListener('click', function () {
          var item = h.parentElement;
          var isOpen = item.classList.contains('is-open');
          document.querySelectorAll('.acc-item').forEach(function (i) { i.classList.remove('is-open'); });
          if (!isOpen) item.classList.add('is-open');
        });
      });

      var btns = document.querySelectorAll('.eco-btn');
      var panels = document.querySelectorAll('.eco-panel');
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          btns.forEach(function (x) { x.classList.remove('is-active'); });
          panels.forEach(function (p) { p.style.display = 'none'; });
          b.classList.add('is-active');
          var target = document.getElementById(b.dataset.target);
          if (target) target.style.display = 'block';
        });
      });
    })();
  </script>
</Site>

<style>
  /* Thesis accordion */
  .thesis-acc { background: var(--color-surface-elevated); }
  .acc-list {
    list-style: none; padding: 0; margin: 48px 0 0;
    border-top: 1px solid var(--color-border);
  }
  .acc-item { border-bottom: 1px solid var(--color-border); }
  .acc-head {
    width: 100%;
    background: none;
    border: none;
    padding: 28px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    text-align: left;
    gap: 16px;
  }
  .acc-head__left {
    display: flex;
    align-items: baseline;
    gap: 20px;
  }
  .acc-head__n {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  .acc-head__title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    line-height: 1.2;
  }
  .acc-head__chev {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform .2s ease;
  }
  .acc-item.is-open .acc-head__chev { transform: rotate(180deg); }
  .acc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }
  .acc-item.is-open .acc-body { grid-template-rows: 1fr; }
  .acc-body__inner {
    overflow: hidden;
    padding: 0 0 0 56px;
    transition: padding-bottom 0.28s ease;
  }
  .acc-item.is-open .acc-body__inner { padding-bottom: 32px; }
  .acc-body__concept {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-primary);
    margin: 0 0 12px;
  }
  .acc-body__text {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 720px;
  }

  /* Scale bar */
  .scalebar {
    background: var(--color-surface-elevated);
    padding: 56px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .scalebar__list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap;
  }
  .scalebar__item {
    flex: 1 1 0; min-width: 140px;
    padding-right: 40px;
    margin-right: 40px;
    border-right: 1px solid var(--color-border);
  }
  .scalebar__item:last-child { border-right: none; margin-right: 0; padding-right: 0; }
  .scalebar__value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 44px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .scalebar__label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Hero sub + CTAs */
  .hero-ml__sub {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.55;
    color: rgba(255,255,255,0.78);
    max-width: 600px;
    margin: 16px 0 0;
  }
  .hero-ml__ctas {
    display: flex;
    gap: 12px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  /* Ecosystem tabs */
  .ecosystem-tabs { background: var(--color-surface-elevated); }
  .ecosystem-tabs__lead {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin: 0 0 48px;
  }

  .eco-nav {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0;
    flex-wrap: wrap;
  }
  .eco-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    padding: 14px 20px;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    letter-spacing: -0.01em;
    transition: color .15s ease, border-color .15s ease;
    white-space: nowrap;
  }
  .eco-btn:hover { color: var(--color-text-primary); }
  .eco-btn.is-active {
    color: var(--color-text-primary);
    border-bottom-color: var(--color-primary);
  }

  .eco-panel__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 48px 0 0;
    align-items: start;
  }
  .eco-panel__tags {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 16px;
  }
  .eco-panel__body {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .eco-panel__right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
    align-self: start;
  }
  .eco-panel__stat {
    padding: 28px 24px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .eco-panel__stat-value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(24px, 2.5vw, 36px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .eco-panel__stat-label {
    display: block;
    margin-top: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Brand badges in data layer table */
  .brand-badge {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border-radius: 4px;
    border: 1px solid;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .brand-badge--tp {
    background: rgba(255,171,36,0.12);
    color: var(--color-secondary);
    border-color: rgba(255,171,36,0.4);
  }

  /* Home closing lead */
  .home-closing__lead {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255,255,255,0.78);
    max-width: 680px;
    margin: 24px 0 32px;
