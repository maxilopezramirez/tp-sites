---
import Site from "../layouts/Site.astro";

const kpis = [
  { value: "10.2M", label: "Tickets sold (2025)" },
  { value: "$269M", label: "Gross merchandise value" },
  { value: "$29.5M", label: "Net revenue (audited IFRS)" },
  { value: "37.3%", label: "EBITDA margin (2025)" },
  { value: "+64%", label: "Revenue YoY (2024 → 2025)" },
  { value: "11", label: "Countries" },
  { value: "2,800", label: "Promoters & venues" },
  { value: "95%+", label: "Client retention" },
];

const highlights = [
  {
    n: "01",
    title: "Large, underpenetrated market.",
    body: "~$40B LATAM live entertainment opportunity. Smart ticketing growing 16.6% CAGR — more than 4× the global rate of 3.8%.",
  },
  {
    n: "02",
    title: "Structural moat.",
    body: "Core software stack built in-house since 2014. Deployed across 11 countries, with 12 years of multi-market operating data and 2,800+ partner relationships.",
  },
  {
    n: "03",
    title: "Scale & proof.",
    body: "$269M GMV in 2025. Revenue +64% YoY. EBITDA margin expanded from 32.8% to 37.3%. Q1 2026 revenue +41% YoY. 95%+ retention.",
  },
  {
    n: "04",
    title: "Category creation.",
    body: "The technology platform for LATAM live entertainment. We serve the underserved 95% the global incumbents do not reach. Bootstrapped 12 years. Profitable.",
  },
  {
    n: "05",
    title: "Proprietary AI-driven stack.",
    body: "AI embedded across the customer-facing services and internal operations. Anti-fraud, dynamic pricing, demand forecasting. Built in-house with no reliance on third-party core infrastructure.",
  },
];

const dataLayerPlaybook = [
  { brand: "Stripe", asset: "Payment data", expansion: "Commerce intelligence" },
  { brand: "Toast", asset: "Restaurant ops", expansion: "Expanding within installed base" },
  { brand: "Shopify", asset: "Merchant data", expansion: "Financial services" },
  { brand: "Ticketplus", asset: "Live entertainment data", expansion: "De-risked expansion", own: true },
];

const platformModules = [
  {
    n: "01",
    title: "Event Ticketing",
    sub: "Virtual queue · 3D layouts · elastic infra",
    body: "High-concurrency sales engine for massive demand. Fair randomization, real-time tracking, seat-level visualization.",
  },
  {
    n: "02",
    title: "Payments & Banking",
    sub: "Acquirers · BNPL · digital wallets · cards",
    body: "50+ country-specific payment methods across Latin America. Leading regional and country-specific gateways, BNPL providers, international card networks and local debit.",
  },
  {
    n: "03",
    title: "Data & Analytics",
    sub: "Real-time event management · BI",
    body: "Live operational data across markets and partners. Multi-year P&L visibility into every partner running on our infrastructure.",
  },
  {
    n: "04",
    title: "Access Control",
    sub: "Dynamic QR · Biometric · RFID/NFC",
    body: "Multi-layer validation, frictionless entry. Real-time validation, anti-fraud, facial recognition for VIP, cashless wristbands for festivals.",
  },
  {
    n: "05",
    title: "On-Site Operations",
    sub: "Kiosks · Mobile POS · Cashless NFC",
    body: "Seamless box office and in-venue experience. Self-service pickup, roaming sales with inventory sync, NFC for F&B and VIP.",
  },
];

const competitors = [
  { name: "Ticketplus", us: true, latam: true, local: true, primary: true, partners: true, wl: true },
  { name: "Ticketmaster", latam: true, local: false, primary: true, partners: true, wl: false },
  { name: "Fever", latam: true, local: false, primary: true, partners: true, wl: false },
  { name: "SeatGeek", latam: false, local: false, primary: true, partners: true, wl: false },
  { name: "AudienceView", latam: false, local: false, primary: false, partners: false, wl: true },
  { name: "Vivenu", latam: false, local: false, primary: false, partners: false, wl: true },
  { name: "StubHub", latam: false, local: false, primary: false, partners: false, wl: false },
  { name: "VividSeats", latam: false, local: false, primary: false, partners: false, wl: false },
];

const sectors = [
  { name: "Sports", pct: 32 },
  { name: "Music", pct: 30 },
  { name: "Holiday Events", pct: 22 },
  { name: "Other", pct: 7 },
  { name: "Travel", pct: 5 },
  { name: "Theater & Arts", pct: 4 },
];

const founders = [
  {
    initials: "CC",
    name: "Chien-Fu Chen",
    role: "CEO & Co-Founder",
    lines: [
      "Architected the proprietary platform from day one.",
      "Built and scaled the in-house core stack across 11 markets.",
    ],
  },
  {
    initials: "JJ",
    name: "Joaquín Jadue",
    role: "CFO & Co-Founder",
    lines: [
      "Built financial controls and led expansion to 11 LatAm countries.",
      "PCAOB audit ready · 37.3% EBITDA margin built on financial discipline.",
    ],
  },
  {
    initials: "YD",
    name: "Yethro Dinamarca",
    role: "Chairman",
    lines: [
      "Sets long-term strategy and governance.",
      "Architected the path from Chile to NASDAQ.",
    ],
  },
];

const comparables = [
  { flag: "ARG", brand: "MercadoLibre", wedge: "E-commerce wedge", founded: 1999, ipo: 2007, years: 8 },
  { flag: "BRA", brand: "Nubank", wedge: "Financial services wedge", founded: 2013, ipo: 2021, years: 8 },
  { flag: "URU", brand: "DLocal", wedge: "Cross-border payments wedge", founded: 2016, ipo: 2021, years: 5 },
  { flag: "CHL", brand: "Ticketplus", wedge: "Live entertainment wedge", founded: 2014, ipo: 2026, years: 12, own: true },
];

const proceeds = [
  { pct: "40%", title: "Partnerships & International Expansion", body: "Strategic partnerships with operating ticketing companies in white-label markets, plus multi-year venue agreements. Targets in active dialogue; execution to follow IPO close." },
  { pct: "25%", title: "Platform Development", body: "Payment gateways, regulatory modules and equipment to support expansion across up to 14 additional markets (11 → 25). Variable spend, tied to expansion." },
  { pct: "20%", title: "Sales & Marketing", body: "Integration capital that converts partnerships into revenue (3–5 people per country, asset-light) plus WL pipeline CAC for Year 2-3 conversion targets." },
  { pct: "15%", title: "Working Capital & G.C.P.", body: "Public-company readiness (PCAOB, IR, D&O, governance) plus revolving promoter advances. Sub-12-month rotation cycle on operating advances." },
];
---
<Site title="Ticketplus · Investor Relations">
  <nav class="topnav">
    <div class="topnav__inner">
      <a href="#top" class="logo">ticketplus<span>+</span></a>
      <ul class="topnav__links">
        <li><a href="#thesis">Thesis</a></li>
        <li><a href="#market">Market</a></li>
        <li><a href="#model">Business model</a></li>
        <li><a href="#platform">Platform</a></li>
        <li><a href="#leadership">Leadership</a></li>
        <li><a href="#ipo">IPO</a></li>
      </ul>
      <span class="ticker">NASDAQ · ticker <strong>TP</strong> reserved · Q2 2026 target</span>
    </div>
  </nav>

  <header id="top" class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow">Investor Relations · Mayo 2026</p>
      <h1 class="hero__title">
        Infrastructure for the <span class="accent">Live Economy</span> of Latin America.
      </h1>
      <p class="hero__lead">
        Ticketplus is the operating system for community-scale live entertainment. We power 10.2 million tickets per year across 11 countries, on a proprietary technology platform built in-house since 2014 — bootstrapped, profitable, and aligned for the long term.
      </p>
      <ul class="hero__pills">
        <li><strong>$269M</strong> 2025 GMV</li>
        <li><strong>$29.5M</strong> 2025 Net revenue</li>
        <li><strong>37.3%</strong> EBITDA margin</li>
        <li><strong>95%+</strong> Client retention</li>
        <li><strong>11</strong> Countries</li>
      </ul>
      <div class="hero__cta">
        <a class="btn btn--primary" href="#thesis">Read the thesis</a>
        <a class="btn btn--ghost" href="#ipo">IPO process</a>
      </div>
    </div>
  </header>

  <section class="quicklinks">
    <div class="container quicklinks__grid">
      <a class="qcard" href="#highlights">
        <p class="qcard__eyebrow">Investor brief</p>
        <h3>Investment highlights</h3>
        <p class="qcard__body">Five reasons the long-term opportunity compounds.</p>
        <span class="qcard__cta">Read →</span>
      </a>
      <a class="qcard" href="#leadership">
        <p class="qcard__eyebrow">Letter from the founders</p>
        <h3>From Chile to NASDAQ</h3>
        <p class="qcard__body">Twelve years building infrastructure for the region.</p>
        <span class="qcard__cta">Read →</span>
      </a>
      <a class="qcard" href="#data-layer">
        <p class="qcard__eyebrow">Thesis</p>
        <h3>The data layer</h3>
        <p class="qcard__body">Why the asset is data, not tickets.</p>
        <span class="qcard__cta">Read →</span>
      </a>
    </div>
  </section>

  <section class="kpis" id="kpis">
    <div class="container">
      <p class="section__eyebrow">2025 at a glance</p>
      <h2 class="section__title">The scale behind the platform.</h2>
      <p class="section__lead">Audited figures under IFRS by Baker Tilly (PCAOB-registered). No single client represents more than 5% of the business — a level of diversification uncommon in LATAM tech of this scale.</p>
      <ul class="kpi-grid">
        {kpis.map((k) => (
          <li class="kpi">
            <span class="kpi__value">{k.value}</span>
            <span class="kpi__label">{k.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="highlights" id="highlights">
    <div class="container">
      <p class="section__eyebrow">Investment highlights</p>
      <h2 class="section__title">Why this. Why now.</h2>
      <ol class="hl-list">
        {highlights.map((h, i) => (
          <li class={`hl ${i >= 3 ? "hl--amber" : ""}`}>
            <span class="hl__n">{h.n}</span>
            <div>
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="thesis" id="thesis">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">The thesis</p>
      <h2 class="section__title section__title--inv">
        We do not compete against ticketing companies. <span class="accent">We capture the data layer.</span>
      </h2>
      <div class="thesis__grid">
        <div class="thesis__copy">
          <p>Ticketing is the entry point. The long-term opportunity is the transaction, data and operating layer around live entertainment in Latin America.</p>
          <p>Over 10.2 million tickets a year across 11 jurisdictions, we capture the full data layer of regional live entertainment: who buys, what they buy, when, in which venue, with which payment method, at which price, with which behavioral pattern.</p>
          <p>That data composes — day by day, across 11 markets, 50+ payment methods, thousands of local commercial relationships. No global player can replicate it by acquisition. It is the asset, and it compounds.</p>
        </div>
        <div class="thesis__table" id="data-layer">
          <p class="thesis__table-title">A proven playbook</p>
          <table>
            <thead>
              <tr><th>Company</th><th>Data captured</th><th>Adjacent expansion</th></tr>
            </thead>
            <tbody>
              {dataLayerPlaybook.map((row) => (
                <tr class={row.own ? "own" : ""}>
                  <td>{row.brand}</td>
                  <td>{row.asset}</td>
                  <td>{row.expansion}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="thesis__footnote">Business-model parallel only · not a valuation reference.</p>
        </div>
      </div>
      <div class="thesis__strip">
        <span><strong>100%</strong> Transaction visibility</span>
        <span><strong>11</strong> Country regulatory & payments stack</span>
        <span><strong>12 years</strong> of multi-market operating data</span>
      </div>
    </div>
  </section>

  <section class="market" id="market">
    <div class="container">
      <p class="section__eyebrow">Market opportunity</p>
      <h2 class="section__title">Latin America is growing. <span class="accent-red">Fast.</span></h2>
      <div class="market__cards">
        <article class="mcard">
          <p class="mcard__eyebrow">South American live events market</p>
          <p class="mcard__from">2022 · $27.7B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2028 · $45.5B</p>
          <p class="mcard__delta">+8.6% CAGR</p>
        </article>
        <article class="mcard mcard--amber">
          <p class="mcard__eyebrow">Smart ticketing LATAM</p>
          <p class="mcard__from">2024 · $1B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2030 · $2.5B</p>
          <p class="mcard__delta">+16.6% CAGR · 4× global</p>
        </article>
      </div>
      <ul class="market__bullets">
        <li><strong>670M+ population</strong> · median age low 30s · 85% urbanized · expanding middle class · 70% smartphone penetration growing +8% / yr.</li>
        <li><strong>{`<20%`} share</strong> of LATAM ticketing market held by top global leaders (excl. Mexico, Brazil), vs. {`>80%`} in US/EU — one of the few large markets where global incumbents have not consolidated.</li>
        <li><strong>Consolidation race underway.</strong> Live Nation acquired OCESA in Mexico (2025). CTS Eventim acquired Punto Ticket in Chile (2023). Credicorp acquired Joinnus in Peru (2025). The window to consolidate the underserved 95% is closing.</li>
      </ul>
      <p class="source">Sources: PwC GE&amp;M Outlook · Worldometer · Grand View Horizon · Mordor Intelligence.</p>
    </div>
  </section>

  <section class="model" id="model">
    <div class="container">
      <p class="section__eyebrow">Business model</p>
      <h2 class="section__title">Full Operation drives the business. <span class="accent">White-Label accelerates the pipeline.</span></h2>
      <div class="model__grid">
        <article class="model__card model__card--wl">
          <header>
            <h3>White-Label SaaS</h3>
            <span class="tag tag--amber">Accelerator</span>
          </header>
          <p class="model__sub">Partners adopt the platform under their own brand. Tech is ours, market access is theirs.</p>
          <ul class="model__stats">
            <li><strong>6%</strong><span>of 2025 revenue</span></li>
            <li><strong>1.6%</strong><span>take rate</span></li>
            <li><strong>$109M</strong><span>2025 GMV</span></li>
          </ul>
          <ul class="model__bullets">
            <li>Profitable, asset-light regional expansion.</li>
            <li>Full data visibility = M&amp;A pipeline.</li>
            <li>Operating data flows from day one.</li>
          </ul>
        </article>
        <article class="model__card model__card--fo">
          <header>
            <h3>Full Operation</h3>
            <span class="tag tag--red">Core</span>
          </header>
          <p class="model__sub">Full event management + advanced sales + marketing + on-site operations, end-to-end.</p>
          <ul class="model__stats">
            <li><strong>94%</strong><span>of 2025 revenue</span></li>
            <li><strong>17.3%</strong><span>take rate</span></li>
            <li><strong>$160M</strong><span>2025 GMV</span></li>
          </ul>
          <ul class="model__bullets">
            <li>High-profile events: concerts, sports, festivals.</li>
            <li>Full margin capture across the event lifecycle.</li>
            <li>Embedded support drives stickiness across 11 markets.</li>
          </ul>
        </article>
      </div>
      <p class="model__note">Both models operate on the same codebase in every market. Full Operation compounds on its own; White-Label conversions are optional upside.</p>
    </div>
  </section>

  <section class="flywheel" id="flywheel">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Partnership strategy</p>
      <h2 class="section__title section__title--inv">We operate our partners <span class="accent">for years</span> before we convert them.</h2>
      <ol class="fw">
        <li>
          <span class="fw__n">1</span>
          <p class="fw__phase">Land</p>
          <h3>Market entry via White-Label</h3>
          <p>Partner adopts the platform under their brand at a 1.6% take rate. Operating data flows from day one.</p>
        </li>
        <li>
          <span class="fw__n">2</span>
          <p class="fw__phase">Learn</p>
          <h3>Full business intelligence</h3>
          <p>Real-time sales, margins and growth trends. Multi-year evidence de-risks every conversion decision.</p>
        </li>
        <li>
          <span class="fw__n own">3</span>
          <p class="fw__phase">Convert</p>
          <h3>Full Operation conversion</h3>
          <p>Strategic conversion of top performers at 17.3% take rate, full revenue capture and minimal integration risk.</p>
        </li>
      </ol>
      <p class="fw__footer"><strong>50+ conversion targets in pipeline.</strong> 11 → 25 markets. We see every partner's real P&amp;L, churn and margins because they have run on our infrastructure for 2–5 years.</p>
    </div>
  </section>

  <section class="platform" id="platform">
    <div class="container">
      <p class="section__eyebrow">Platform &amp; moat</p>
      <h2 class="section__title">Best-in-class software. <span class="accent-red">Core platform built in-house.</span></h2>
      <div class="platform__grid">
        <aside class="moat">
          <h3>Why global players can&apos;t capture this market</h3>
          <ul>
            <li><strong>Regulation</strong> · 11 jurisdictions · fiscal compliance per market</li>
            <li><strong>Payment gateways</strong> · local acquirers, BNPL, wallets across 11 markets</li>
            <li><strong>Relationships</strong> · 2,800+ partners embedded in daily ops</li>
            <li><strong>Data</strong> · 12 yrs multi-market · no mono-country can match</li>
          </ul>
          <p class="moat__quote">"Built in-house with no reliance on third-party core infrastructure."</p>
        </aside>
        <ol class="modules">
          {platformModules.map((m) => (
            <li class="module">
              <span class="module__n">{m.n}</span>
              <div>
                <h4>{m.title}</h4>
                <p class="module__sub">{m.sub}</p>
                <p>{m.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="compete" id="compete">
    <div class="container">
      <p class="section__eyebrow">Competitive landscape</p>
      <h2 class="section__title">Competitive position in <span class="accent-red">Latin America.</span></h2>
      <p class="section__lead">Ticketplus combines what others split. Capabilities matrix based on publicly available information.</p>
      <div class="compete__wrap">
        <table class="compete__table">
          <thead>
            <tr>
              <th></th>
              <th>LATAM presence</th>
              <th>Local market focus</th>
              <th>Primary tickets</th>
              <th>Partners &amp; sponsoring</th>
              <th>White-label</th>
            </tr>
          </thead>
          <tbody>
            {competitors.map((c) => (
              <tr class={c.us ? "own" : ""}>
                <th scope="row">{c.name}</th>
                <td>{c.latam ? <span class="yes">✓</span> : <span class="no">×</span>}</td>
                <td>{c.local ? <span class="yes">✓</span> : <span class="no">×</span>}</td>
                <td>{c.primary ? <span class="yes">✓</span> : <span class="no">×</span>}</td>
                <td>{c.partners ? <span class="yes">✓</span> : <span class="no">×</span>}</td>
                <td>{c.wl ? <span class="yes">✓</span> : <span class="no">×</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="source">Illustrative comparison · categories simplified · not a comprehensive competitive analysis.</p>
    </div>
  </section>

  <section class="div" id="div">
    <div class="container">
      <p class="section__eyebrow">Diversification</p>
      <h2 class="section__title">Diversified across sectors. <span class="accent-red">Loved by our customers.</span></h2>
      <div class="div__grid">
        <div class="div__chart">
          <p class="div__chart-title">Sector mix · 2025 GMV</p>
          <ul class="bars">
            {sectors.map((s) => (
              <li>
                <span class="bars__label">{s.name}</span>
                <span class="bars__bar"><span class="bars__fill" style={`width:${s.pct * 2.5}%`}></span></span>
                <span class="bars__pct">{s.pct}%</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="nps">
          <div class="nps__card"><strong>+59</strong><span>NPS promoter</span></div>
          <div class="nps__card"><strong>+58</strong><span>NPS buyer</span></div>
          <div class="nps__card nps__card--amber"><strong>95%+</strong><span>Client retention</span></div>
          <p class="nps__note">Top-quartile NPS for live entertainment. No single category dominates · 11-country diversification · no material client concentration.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="leadership" id="leadership">
    <div class="container">
      <p class="section__eyebrow">Leadership &amp; alignment</p>
      <h2 class="section__title">Three founders. <span class="accent">Twelve years.</span></h2>
      <div class="founders">
        {founders.map((f) => (
          <article class="founder">
            <span class="founder__avatar">{f.initials}</span>
            <p class="founder__role">{f.role}</p>
            <h3>{f.name}</h3>
            <ul>
              {f.lines.map((l) => <li>{l}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <p class="leadership__strip">
        <strong>100% ownership pre-IPO</strong> held by founders, Chairman and key employees. The Chairman has never drawn salary or director fees; the founders have historically held compensation below market and plan to remain below market post-IPO, with long-term alignment through the Equity Incentive Plan.
      </p>

      <article class="letter">
        <p class="letter__eyebrow">A letter from the founders</p>
        <h3>From Chile to NASDAQ. Twelve years and counting.</h3>
        <p>Twelve years ago, two longtime friends from Chile wrote the first lines of code for what is now Ticketplus. Eight years ago, our Chairman joined to build the financial architecture and the path to capital markets. Today we serve 11 countries, 2,800 partners, 39,800 events per year and 10.2 million tickets processed annually — profitably, with our own technology built in-house.</p>
        <p>Before Ticketplus, our team had spent years building software products across industries. When live entertainment came knocking, we applied the same DNA: product strategy, operational thinking, and technology built in-house. Ticketplus was never an accident. It was muscle memory.</p>
        <p><strong>NASDAQ is not the goal. It is the vehicle.</strong> It is the table where leading Latin American technology platforms already sit. And now it is Chile&apos;s turn.</p>
        <p>The next ten years will not be about ticketing. They will be about becoming the operating system for live experiences across Latin America, and then beyond. The platform is the company. The vertical is the wedge. The horizon is open.</p>
        <p>We are aligned with our shareholders through long-term equity ownership. Pre-IPO ownership remains 100% with founders, Chairman and key employees. Our bet is the long-term value of what we build together.</p>
        <p class="letter__sign">Chien-Fu Chen · Joaquín Jadue · Yethro Dinamarca</p>
      </article>
    </div>
  </section>

  <section class="comparables">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Category</p>
      <h2 class="section__title section__title--inv">Same playbook. Different vertical. <span class="accent">Chile&apos;s chapter hasn&apos;t been written yet.</span></h2>
      <p class="comparables__lead">MercadoLibre, Nubank and DLocal each built the infrastructure layer on fragmented Latin American markets through a different vertical wedge. Bootstrapped longer than any of them, Ticketplus is the next chapter.</p>
      <ul class="comp-grid">
        {comparables.map((c) => (
          <li class={`comp ${c.own ? "comp--own" : ""}`}>
            <span class="comp__flag">{c.flag}</span>
            <h3>{c.brand}</h3>
            <p class="comp__wedge">{c.wedge}</p>
            <p class="comp__line">Founded {c.founded} → IPO {c.ipo}</p>
            <p class="comp__years">{c.years} years</p>
          </li>
        ))}
      </ul>
      <p class="comparables__footnote">Comparables shown for business-model parallel only · not for valuation reference. Subject to listing.</p>
    </div>
  </section>

