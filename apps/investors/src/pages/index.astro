---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const kpis = [
  { value: "10.2M", label: "Tickets sold (2025)" },
  { value: "$269M", label: "Gross merchandise value" },
  { value: "$29.5M", label: "Net revenue (audited IFRS)" },
  { value: "37.3%", label: "EBITDA margin (2025)" },
  { value: "+64%", label: "Revenue YoY (2024 → 2025)" },
  { value: "11", label: "Countries" },
  { value: "2,800", label: "Promoters & venues" },
  { value: "95%+", label: "Client retention" },
];

const cards = [
  { id: "thesis", href: link("/thesis/"), eyebrow: "Investment thesis", title: "Data is the asset.", body: "Why we are not a ticketing company. The same playbook Stripe, Toast and Shopify followed, applied to LATAM live entertainment.", accent: "yellow" },
  { id: "market", href: link("/market/"), eyebrow: "Market opportunity", title: "LATAM is growing 4× the world.", body: "$27.7B → $45.5B by 2028. Smart ticketing at 16.6% CAGR. 670M+ people. Underserved by global incumbents.", accent: "red" },
  { id: "business", href: link("/business/"), eyebrow: "Business model", title: "Two models, one platform.", body: "Full Operation is the engine. White-Label is the M&A pipeline. We operate partners for years before we convert them.", accent: "yellow" },
  { id: "platform", href: link("/platform/"), eyebrow: "Platform & moat", title: "12 years in-house.", body: "Five integrated modules: ticketing, payments, data, access, on-site. No reliance on third-party core infrastructure.", accent: "red" },
  { id: "leadership", href: link("/leadership/"), eyebrow: "Leadership", title: "Three founders. Twelve years.", body: "Bootstrapped, profitable, aligned through long-term equity. 100% pre-IPO ownership held by founders, Chairman and key employees.", accent: "yellow" },
  { id: "ipo", href: link("/ipo/"), eyebrow: "IPO process", title: "Ten institutions. One filter.", body: "NASDAQ ticker TP reserved. Roth, Bancroft, MDB underwriters. Bevilacqua, Lucosky Brookman counsel. Baker Tilly PCAOB audit.", accent: "red" },
];
---
<Site title="Ticketplus · Investor Relations" current="home" description="Infrastructure for the live economy of Latin America. NASDAQ ticker TP reserved, Q2 2026 target.">
  <header class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow">Investor Relations · Mayo 2026</p>
      <h1 class="hero__title">
        Infrastructure for the <span class="accent">Live Economy</span> of Latin America.
      </h1>
      <p class="hero__lead">
        Ticketplus is the operating system for community-scale live entertainment. We power 10.2 million tickets per year across 11 countries on a proprietary technology platform built in-house since 2014 — bootstrapped, profitable, and aligned for the long term.
      </p>
      <ul class="hero__pills">
        <li><strong>$269M</strong> 2025 GMV</li>
        <li><strong>$29.5M</strong> Net revenue</li>
        <li><strong>37.3%</strong> EBITDA margin</li>
        <li><strong>95%+</strong> Client retention</li>
        <li><strong>11</strong> Countries</li>
      </ul>
      <div class="hero__cta">
        <a class="btn btn--primary" href={link("/thesis/")}>Read the thesis</a>
        <a class="btn btn--ghost" href={link("/ipo/")}>IPO process</a>
      </div>
    </div>
  </header>

  <section class="kpis">
    <div class="container">
      <p class="section__eyebrow">2025 at a glance</p>
      <h2 class="section__title">The scale behind the platform.</h2>
      <p class="section__lead">Audited under IFRS by Baker Tilly (PCAOB-registered). No single client represents more than 5% of the business — a diversification level uncommon in LATAM tech of this scale.</p>
      <ul class="kpi-grid">
        {kpis.map((k) => (
          <li class="kpi">
            <span class="kpi__value">{k.value}</span>
            <span class="kpi__label">{k.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="quicklinks" style="padding: 100px 0;">
    <div class="container">
      <p class="section__eyebrow">Explore</p>
      <h2 class="section__title" style="margin-bottom: 48px;">Six entry points to the story.</h2>
      <div class="quicklinks__grid">
        {cards.map((c) => (
          <a class="qcard" href={c.href} style={`border-top: 4px solid var(--${c.accent === "yellow" ? "yellow" : "red"});`}>
            <p class="qcard__eyebrow">{c.eyebrow}</p>
            <h3>{c.title}</h3>
            <p class="qcard__body">{c.body}</p>
            <span class="qcard__cta">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Investor inquiries</h2>
      <p>For IR contact, F-1 access (subject to filing), or background briefings.</p>
      <a class="btn btn--dark" href={link("/contact/")}>Contact IR</a>
    </div>
  </section>
</Site>
