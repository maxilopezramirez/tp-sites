---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const heroImage = "https://images.unsplash.com/photo-1429962714451-bb934ecdc4ec?auto=format&fit=crop&w=2400&q=80";

const gradDefs = `<defs><linearGradient id="tpBrand" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#f79802"/><stop offset="100%" stop-color="#ff1313"/></linearGradient></defs>`;

const heroCards = [
  {
    title: "IR Briefing",
    cta: "May 2026 update",
    href: "#",
    icon: `<svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="url(#tpBrand)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${gradDefs}<rect x="10" y="6" width="28" height="36" rx="4"/><rect x="14" y="12" width="14" height="14" rx="2"/><path d="M14 32h20M14 37h12"/></svg>`,
  },
  {
    title: "Our Growth Story",
    cta: "Learn more",
    href: link("/about/"),
    icon: `<svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="url(#tpBrand)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${gradDefs}<rect x="6" y="30" width="6" height="12"/><rect x="16" y="22" width="6" height="20"/><rect x="26" y="14" width="6" height="28"/><rect x="36" y="8" width="6" height="34"/><circle cx="39" cy="6" r="2.5" fill="url(#tpBrand)" stroke="none"/></svg>`,
  },
  {
    title: "IPO Process",
    cta: "Roadmap & timeline",
    href: link("/ipo/"),
    icon: `<svg viewBox="0 0 48 48" width="44" height="44" fill="none" stroke="url(#tpBrand)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${gradDefs}<circle cx="24" cy="24" r="15"/><path d="M24 14v10l7 4"/><circle cx="24" cy="24" r="2" fill="url(#tpBrand)" stroke="none"/></svg>`,
  },
];

const kpis = [
  { value: "10.2M", label: "Tickets sold (2025)" },
  { value: "$269M", label: "Gross merchandise value" },
  { value: "$29.5M", label: "Net revenue (audited IFRS)" },
  { value: "37.3%", label: "EBITDA margin (2025)" },
  { value: "+64%", label: "Revenue YoY (2024 → 2025)" },
  { value: "11", label: "Countries" },
  { value: "2,800", label: "Promoters & venues" },
  { value: "95%+", label: "Client retention" },
];
---
<Site title="Ticketplus · Investor Relations" current="home" description="The leading live-entertainment infrastructure platform in Latin America. NASDAQ ticker TP reserved, Q2 2026 target.">
  <header class="hero-ml">
    <div class="hero-ml__media" style={`background-image: url(${heroImage});`} aria-hidden="true"></div>
    <div class="hero-ml__scrim" aria-hidden="true"></div>
    <div class="hero-ml__inner">
      <h1 class="hero-ml__title">
        The Leading Live-Entertainment<br/>
        Infrastructure Platform in<br/>
        Latin America
      </h1>
    </div>
  </header>

  <section class="hero-cards">
    <div class="container">
      <div class="hero-cards__grid">
        {heroCards.map((c) => (
          <a class="hcard" href={c.href}>
            <span class="hcard__icon" set:html={c.icon}></span>
            <h3 class="hcard__title">{c.title}</h3>
            <span class="hcard__cta">{c.cta} <span aria-hidden="true">›</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="ecosystem">
    <div class="container ecosystem__inner">
      <span class="ecosystem__bar" aria-hidden="true"></span>
      <h2 class="ecosystem__title">Our Ecosystem is Our Strength</h2>
      <div class="ecosystem__video" role="img" aria-label="Ecosystem video placeholder">
        <svg class="ecosystem__play" viewBox="0 0 96 96" width="96" height="96" aria-hidden="true">
          <circle cx="48" cy="48" r="46" fill="rgba(255,255,255,0.10)" stroke="rgba(255,255,255,0.6)" stroke-width="2"/>
          <path d="M40 32 L68 48 L40 64 Z" fill="rgba(255,255,255,0.85)"/>
        </svg>
        <span class="ecosystem__placeholder">Video placeholder · 16:9</span>
      </div>
    </div>
  </section>

  <section class="modlist-sec">
    <div class="container modlist-sec__inner">
      <span class="ecosystem__bar" aria-hidden="true"></span>
      <h2 class="ecosystem__title">Ticketplus Is at the Center of the Live Economy</h2>
      <ol class="modlist">
        <li class="modlist__item">
          <span class="modlist__num">01</span>
          <div class="modlist__title">
            <h3>Event Ticketing</h3>
            <p class="modlist__tags">VIRTUAL QUEUE · 3D LAYOUTS</p>
          </div>
          <p class="modlist__desc">High-concurrency sales engine for massive demand.</p>
        </li>
        <li class="modlist__item">
          <span class="modlist__num">02</span>
          <div class="modlist__title">
            <h3>Payments &amp; Banking</h3>
            <p class="modlist__tags">ACQUIRERS · BNPL · DIGITAL WALLETS · CARDS</p>
          </div>
          <p class="modlist__desc">50+ country-specific payment methods across LATAM.</p>
        </li>
        <li class="modlist__item">
          <span class="modlist__num">03</span>
          <div class="modlist__title">
            <h3>Data &amp; Analytics</h3>
            <p class="modlist__tags">REAL-TIME EVENT MANAGEMENT DATA · BUSINESS INTELLIGENCE</p>
          </div>
          <p class="modlist__desc">Live operational data across markets and partners. Detailed on slides ahead.</p>
        </li>
        <li class="modlist__item">
          <span class="modlist__num">04</span>
          <div class="modlist__title">
            <h3>Access Control</h3>
            <p class="modlist__tags">DYNAMIC QR · BIOMETRIC · RFID/NFC</p>
          </div>
          <p class="modlist__desc">Multi-layer validation, frictionless entry.</p>
        </li>
        <li class="modlist__item">
          <span class="modlist__num">05</span>
          <div class="modlist__title">
            <h3>On-Site Operations</h3>
            <p class="modlist__tags">KIOSKS · MOBILE POS · CASHLESS NFC</p>
          </div>
          <p class="modlist__desc">Seamless box office, in-venue experience.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="kpis">
    <div class="container">
      <p class="section__eyebrow">2025 at a glance</p>
      <h2 class="section__title">The scale behind the platform.</h2>
      <p class="section__lead">Audited under IFRS by Baker Tilly (PCAOB-registered). No single client represents more than 5% of the business — a diversification level uncommon in LATAM tech of this scale.</p>
      <ul class="kpi-grid">
        {kpis.map((k) => (
          <li class="kpi">
            <span class="kpi__value">{k.value}</span>
            <span class="kpi__label">{k.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="longview">
    <div class="container longview__inner">
      <span class="ecosystem__bar" aria-hidden="true"></span>
      <h2 class="ecosystem__title">Our Long-Term View in 5 Charts</h2>

      <div class="collapse is-open">
        <button class="collapse__head" type="button"><span>1 · LATAM Smart Ticketing Is Growing 4× the World</span><span class="chev" aria-hidden="true">⌃</span></button>
        <div class="collapse__body">
          <p>South American live entertainment is moving from <strong>$27.7B in 2022 to $45.5B by 2028</strong> — a +64% expansion in six years. Inside that, smart ticketing is growing at <strong>16.6% CAGR vs. 3.8% globally</strong>: more than 4× the world rate. The structural underpenetration of digital ticketing in LATAM is exactly the window Ticketplus is consolidating.</p>
          <div class="chart">
            <svg viewBox="0 0 720 280" width="100%" aria-hidden="true">
              <line x1="60" y1="240" x2="700" y2="240" stroke="#171717" stroke-width="1.5"/>
              <text x="60" y="265" font-family="Montserrat" font-size="13" fill="#171717">2019</text>
              <text x="200" y="265" font-family="Montserrat" font-size="13" fill="#171717">2022</text>
              <text x="380" y="265" font-family="Montserrat" font-size="13" fill="#171717">2025</text>
              <text x="560" y="265" font-family="Montserrat" font-size="13" fill="#171717">2028</text>
              <text x="685" y="265" font-family="Montserrat" font-size="13" fill="#171717">2030</text>
              <polyline points="60,180 200,160 380,120 560,80 685,60" fill="none" stroke="url(#lvGrad)" stroke-width="5" stroke-linecap="round"/>
              <polyline points="60,210 200,205 380,200 560,195 685,192" fill="none" stroke="#a3a3a3" stroke-width="3" stroke-dasharray="6 6"/>
              <defs><linearGradient id="lvGrad" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="#f79802"/><stop offset="100%" stop-color="#ff1313"/></linearGradient></defs>
              <circle cx="685" cy="60" r="6" fill="#ff1313"/>
              <text x="600" y="50" font-family="Montserrat" font-weight="700" font-size="14" fill="#ff1313">LATAM · +16.6% CAGR</text>
              <text x="540" y="185" font-family="Montserrat" font-size="13" fill="#525252">Global · +3.8% CAGR</text>
            </svg>
            <p class="chart__src">Sources: PwC GE&amp;M Outlook · Mordor Intelligence · Grand View Horizon.</p>
          </div>
        </div>
      </div>

      <div class="collapse is-open">
        <button class="collapse__head" type="button"><span>2 · Capturing the Data Layer of Live Entertainment</span><span class="chev" aria-hidden="true">⌃</span></button>
        <div class="collapse__body">
          <p>Stripe captured the payments data layer ($70B). Shopify captured merchant data ($100B). Toast captured restaurant ops data ($25B). The pattern is the same: <strong>capture the data layer first, monetize adjacent verticals second</strong> — payments, BI, dynamic pricing, financial services. Ticketplus is doing exactly this in LATAM live entertainment. The first vertical is ticketing; the long-term asset is the data layer that compounds over 11 jurisdictions and 50+ payment methods.</p>
          <div class="chart">
            <svg viewBox="0 0 720 220" width="100%" aria-hidden="true">
              <g font-family="Montserrat" font-size="13" fill="#171717">
                <text x="20" y="40">Shopify · merchant data</text>
                <rect x="220" y="22" width="450" height="24" rx="3" fill="#171717"/>
                <text x="680" y="40" font-weight="700">$100B</text>
                <text x="20" y="90">Stripe · payments data</text>
                <rect x="220" y="72" width="320" height="24" rx="3" fill="#404040"/>
                <text x="550" y="90" font-weight="700">$70B</text>
                <text x="20" y="140">Toast · restaurants data</text>
                <rect x="220" y="122" width="115" height="24" rx="3" fill="#525252"/>
                <text x="345" y="140" font-weight="700">$25B</text>
                <text x="20" y="190" font-weight="700">Ticketplus · live data</text>
                <rect x="220" y="172" width="80" height="24" rx="3" fill="url(#lvGrad)"/>
                <text x="310" y="190" font-weight="700" fill="#ff1313">Day 1 · IPO Q2 2026</text>
              </g>
            </svg>
            <p class="chart__src">Business-model parallel only · not a valuation reference. Source: public market data.</p>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="cta">
    <div class="container">
      <h2>Investor inquiries</h2>
      <p>For IR contact, F-1 access (subject to filing), or background briefings.</p>
      <a class="btn btn--dark" href={link("/contact/")}>Contact IR</a>
    </div>
  </section>

  <script is:inline>
    (function () {
      var tabs = document.querySelectorAll('.tabsec__btn');
      var panels = document.querySelectorAll('.tabsec__panel');
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.forEach(function (x) { x.classList.remove('is-active'); });
          panels.forEach(function (p) { p.classList.remove('is-active'); });
          t.classList.add('is-active');
          var target = document.getElementById(t.dataset.target);
          if (target) target.classList.add('is-active');
        });
      });
      document.querySelectorAll('.collapse__head').forEach(function (h) {
        h.addEventListener('click', function () {
          h.parentElement.classList.toggle('is-open');
        });
      });
    })();
  </script>
</Site>
