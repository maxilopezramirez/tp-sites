---
import Site from "../../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const glanceKpis = [
  { v: "10.2M", l: "Tickets sold (2025)" },
  { v: "$269M", l: "Gross sales" },
  { v: "11", l: "Countries" },
  { v: "95%+", l: "Client retention" },
];

const comparables = [
  { flag: "ARG", brand: "MercadoLibre", wedge: "E-commerce wedge", founded: 1999, ipo: 2007, years: 8 },
  { flag: "BRA", brand: "Nubank", wedge: "Financial services wedge", founded: 2013, ipo: 2021, years: 8 },
  { flag: "URU", brand: "DLocal", wedge: "Cross-border payments wedge", founded: 2016, ipo: 2021, years: 5 },
  { flag: "CHL", brand: "Ticketplus", wedge: "Live entertainment wedge", founded: 2014, ipo: 2026, years: 12, own: true },
];

const models = [
  {
    id: "m-wl",
    label: "White-Label SaaS",
    tag: "Accelerator",
    tagClass: "tag--amber",
    sub: "Partners adopt the platform under their own brand. Tech is ours, market access is theirs.",
    stats: [{ v: "1.6%", l: "take rate" }, { v: "6%", l: "of 2025 revenue" }, { v: "$109M", l: "2025 gross sales" }],
    bullets: ["Profitable, asset-light regional expansion.", "Full data visibility = M&A pipeline.", "Operating data flows from day one."],
  },
  {
    id: "m-fo",
    label: "Full Operation",
    tag: "Core",
    tagClass: "tag--red",
    sub: "Full event management + advanced sales + marketing + on-site operations, end-to-end.",
    stats: [{ v: "17.3%", l: "take rate" }, { v: "94%", l: "of 2025 revenue" }, { v: "$160M", l: "2025 gross sales" }],
    bullets: ["High-profile events: concerts, sports, festivals.", "Full margin capture across the event lifecycle.", "Embedded support drives stickiness across 11 markets."],
  },
];


const dataLayer = [
  { brand: "Stripe", asset: "Payment data", expansion: "Commerce intelligence" },
  { brand: "Toast", asset: "Restaurant ops", expansion: "Expanding within installed base" },
  { brand: "Shopify", asset: "Merchant data", expansion: "Financial services" },
  { brand: "Ticketplus", asset: "Live entertainment data", expansion: "De-risked expansion", own: true },
];
---
<Site title="About Ticketplus · Investor Relations" current="about">

  <!-- 1. HEADER + AT A GLANCE -->
  <header class="page-header">
    <div class="page-header__inner">
      <p class="page-header__eyebrow">About Ticketplus</p>
      <h1 class="page-header__title">Twelve years building the <span class="accent">operating system</span> for LATAM live entertainment.</h1>
      <p class="page-header__lead">Ticketing is the entry point. The long-term opportunity is the operating, transaction and data layer across Latin America.</p>
    </div>
  </header>

  <section class="glance">
    <div class="container">
      <div class="glance__grid">
        <ul class="glance__bullets">
          <li>Technology-first · vertically integrated · built fully in-house</li>
          <li>AI embedded across customer-facing services and internal operations</li>
          <li>11 countries · 30+ strategic cities · deepest LATAM footprint in the category</li>
          <li>Serving the underserved 95% the global incumbents do not reach</li>
          <li>Bootstrapped twelve years · profitable · no institutional equity raised</li>
          <li>No material concentration across categories, geographies or clients</li>
        </ul>
        <ul class="glance__kpis">
          {glanceKpis.map((k) => (
            <li>
              <span class="glance__kpi-value">{k.v}</span>
              <span class="glance__kpi-label">{k.l}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. THE OPPORTUNITY -->
  <section class="opportunity">
    <div class="container">
      <p class="section__eyebrow">Market opportunity</p>
      <h2 class="section__title">A $40B market, growing at <span class="accent-red">4× the global rate.</span></h2>
      <div class="market__cards">
        <article class="mcard">
          <p class="mcard__eyebrow">South American live events market</p>
          <p class="mcard__from">2022 · $27.7B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2028 · $45.5B</p>
          <p class="mcard__delta">+8.6% CAGR</p>
        </article>
        <article class="mcard mcard--amber">
          <p class="mcard__eyebrow">Smart ticketing LATAM</p>
          <p class="mcard__from">2024 · $1B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2030 · $2.5B</p>
          <p class="mcard__delta">+16.6% CAGR · 4× global</p>
        </article>
      </div>
      <ul class="market__bullets">
        <li><strong>&lt;20% share</strong> of LATAM ticketing held by global leaders (excl. Mexico, Brazil) vs. &gt;80% in US/EU. One of the few large markets where incumbents have not consolidated.</li>
        <li><strong>Consolidation race underway.</strong> Live Nation → OCESA (2025). CTS Eventim → Punto Ticket (2023). Credicorp → Joinnus (2025). The window to consolidate the underserved 95% is closing.</li>
      </ul>
      <p class="source">Sources: PwC GE&amp;M Outlook · Worldometer · Grand View Horizon · Mordor Intelligence.</p>

      <div class="opp__comps">
        <p class="section__eyebrow" style="margin-top: 64px;">Category parallel</p>
        <p class="opp__comps-lead">MercadoLibre, Nubank and DLocal each built the infrastructure layer on fragmented LATAM markets through a different vertical wedge. Bootstrapped longer than any of them, Ticketplus is the next chapter.</p>
        <ul class="comp-grid comp-grid--light">
          {comparables.map((c) => (
            <li class={`comp comp--inv${c.own ? " comp--own" : ""}`}>
              <span class="comp__flag">{c.flag}</span>
              <h3>{c.brand}</h3>
              <p class="comp__wedge">{c.wedge}</p>
              <p class="comp__line">Founded {c.founded} → IPO {c.ipo}</p>
              <p class="comp__years">{c.years} years</p>
            </li>
          ))}
        </ul>
        <p class="source">Business-model parallel only · not for valuation reference. Subject to listing.</p>
      </div>
    </div>
  </section>

  <!-- 3. THE MODEL -->
  <section class="model-about">
    <div class="container">
      <p class="section__eyebrow">Business model</p>
      <h2 class="section__title">Two models. <span class="accent">One platform.</span></h2>
      <p class="section__lead" style="margin-bottom: 40px;">Partners enter at White-Label and graduate to Full Operation when the data tells us they are ready. Not two businesses — one continuum.</p>

      <div class="model-cols">
        {models.map((m) => (
          <div class="model-col">
            <div class="model-col__header">
              <h3 class="model-col__title">{m.label}</h3>
              <span class={`tag ${m.tagClass}`}>{m.tag}</span>
            </div>
            <p class="model-panel__sub">{m.sub}</p>
            <ul class="model-panel__stats">
              {m.stats.map((s) => (
                <li>
                  <strong>{s.v}</strong>
                  <span>{s.l}</span>
                </li>
              ))}
            </ul>
            <ul class="model-panel__bullets">
              {m.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="flywheel-compact">
        <p class="flywheel-compact__label">How it works</p>
        <ol class="flywheel-compact__steps">
          <li><strong>Land</strong> — Partner adopts White-Label at 1.6% take rate. Operating data flows from day one.</li>
          <li><strong>Learn</strong> — Real-time sales, margins, growth trends. Multi-year intelligence before any conversion decision.</li>
          <li><strong>Convert</strong> — Top performers move to Full Operation at 17.3% take rate. <strong>50+ operators in pipeline today.</strong></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- 4. THE DATA LAYER (crescendo) -->
  <section id="thesis" class="thesis">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Competitive advantage · The data layer</p>
      <h2 class="section__title section__title--inv">We do not compete against ticketing companies. <span class="accent">We capture the data layer.</span></h2>
      <div class="thesis__grid">
        <div class="thesis__copy">
          <p>Over 10.2 million tickets a year across 11 jurisdictions, we capture the full data layer of regional live entertainment: who buys, what they buy, when, in which venue, with which payment method, at which price, with which behavioral pattern.</p>
          <p>That data composes — day by day, across 11 markets, 50+ payment methods, thousands of local commercial relationships. No global player can replicate it by acquisition. It is the asset, and it compounds.</p>
          <p>Ticketing is the first vertical. The verticals adjacent to the data layer — payments, BI, dynamic pricing, financial services for partners — are the long-term expansion thesis.</p>
          <p style="margin-top: 8px; font-style: italic; color: rgba(255,255,255,0.65); font-size: 15px;">"The company that owns the operating and transaction layer of an industry often becomes far more valuable than the entry product itself."</p>
        </div>
        <div class="thesis__table">
          <p class="thesis__table-title">A proven playbook</p>
          <table>
            <thead>
              <tr><th>Company</th><th>Data captured</th><th>Adjacent expansion</th></tr>
            </thead>
            <tbody>
              {dataLayer.map((row) => (
                <tr class={row.own ? "own" : ""}>
                  <td>{row.brand}</td>
                  <td>{row.asset}</td>
                  <td>{row.expansion}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="thesis__footnote">Business-model parallel only · not a valuation reference.</p>
        </div>
      </div>
      <div class="thesis__strip">
        <span><strong>100%</strong> Transaction visibility</span>
        <span><strong>11</strong> Country regulatory &amp; payments stack</span>
        <span><strong>12 years</strong> of multi-market operating data</span>
      </div>
    </div>
  </section>

  <!-- 6. CLOSING -->
  <section class="thesis" style="padding: 120px 0;">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">The thesis</p>
      <h2 class="section__title section__title--inv">Ticketplus is building the operating system for live entertainment across Latin America. <span class="accent">Nasdaq is the vehicle, not the goal.</span></h2>
      <p class="about-closing__lead">The goal is to build the operating, transaction and data infrastructure layer for live entertainment across Latin America. This is not a validation event. It is an acceleration event.</p>
      <a class="btn btn--primary" href={link("/contact/")} style="display: inline-flex;">Contact IR</a>
    </div>
  </section>

  <nav class="pagenav">
    <div class="container pagenav__inner">
      <a class="pagenav__side" href={link("/")}>
        <span class="pagenav__label">← Back</span>
        <span class="pagenav__title">Overview</span>
      </a>
      <a class="pagenav__side pagenav__side--next" href={link("/leadership/")}>
        <span class="pagenav__label">Next →</span>
        <span class="pagenav__title">Leadership</span>
      </a>
    </div>
  </nav>

</Site>

<style>
  /* At a glance */
  .glance { background: var(--color-surface-elevated); padding: 72px 0 96px; }
  .glance__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }
  .glance__bullets {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 0;
  }
  .glance__bullets li {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.55;
    padding: 14px 0;
    border-top: 1px solid var(--color-border);
  }
  .glance__bullets li:first-child { border-top: none; padding-top: 0; }
  .glance__kpis {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }
  .glance__kpis li {
    padding: 28px 24px;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .glance__kpi-value {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(32px, 3.5vw, 48px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-text-primary);
  }
  .glance__kpi-label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  /* Opportunity */
  .opportunity { background: var(--color-surface-elevated); }
  .opp__comps { border-top: 1px solid var(--color-border); padding-top: 64px; margin-top: 64px; }
  .opp__comps-lead {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    max-width: 720px;
    line-height: 1.6;
    margin: 0 0 32px;
  }
  .comp-grid--light .comp--inv {
    background: var(--color-gray-50);
    border: 1px solid var(--color-border);
  }
  .comp-grid--light .comp--inv h3 { color: var(--color-text-primary); }
  .comp-grid--light .comp--inv .comp__wedge { color: var(--color-text-muted); }
  .comp-grid--light .comp--inv .comp__line { color: var(--color-text-muted); }
  .comp-grid--light .comp--inv .comp__years { color: var(--color-text-primary); background: none; -webkit-text-fill-color: initial; }
  .comp-grid--light .comp--own {
    background: linear-gradient(180deg, rgba(255,171,36,0.07), rgba(255,19,19,0.03));
    border-color: rgba(255,171,36,0.4);
  }
  .comp-grid--light .comp--own h3 {
    background: var(--gradient-brand-text);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .comp-grid--light .comp--own .comp__years {
    background: var(--gradient-brand-text);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  /* Model two-column */
  .model-about { background: var(--color-surface-elevated); }
  .model-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--color-border);
    margin-top: 8px;
  }
  .model-col {
    padding: 40px 40px 40px 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .model-col:last-child {
    padding: 40px 0 40px 40px;
    border-left: 1px solid var(--color-border);
  }
  .model-col__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .model-col__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--color-text-primary);
  }
  .model-panel__sub {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .model-panel__stats {
    list-style: none; padding: 0; margin: 0;
    display: flex; gap: 32px; flex-wrap: wrap;
  }
  .model-panel__stats li { display: flex; flex-direction: column; gap: 2px; }
  .model-panel__stats strong {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--gradient-brand-text);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .model-panel__stats span {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .model-panel__bullets {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 12px;
    align-content: start;
    padding-top: 40px;
    border-left: 1px solid var(--color-border);
    padding-left: 48px;
  }
  .model-panel__bullets li {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.55;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border);
  }
  .model-panel__bullets li:last-child { border-bottom: none; padding-bottom: 0; }

  /* Flywheel compact */
  .flywheel-compact {
    margin-top: 48px;
    padding: 32px 36px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-gray-50);
  }
  .flywheel-compact__label {
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 20px;
  }
  .flywheel-compact__steps {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
  }
  .flywheel-compact__steps li {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
    padding-top: 14px;
    border-top: 2px solid var(--color-border);
  }
  .flywheel-compact__steps li strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }

  /* Position */
  .position__grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 32px;
    align-items: start;
    margin-top: 48px;
  }
  .moat--flat {
    background: var(--color-gray-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px;
    color: var(--color-text-primary);
  }
  .moat--flat h3 {
    margin: 0 0 20px;
    font-size: 18px;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .moat--flat h3::after { display: none; }
  .moat--flat ul {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 12px;
    font-size: 14px; line-height: 1.55;
    color: var(--color-text-muted);
  }
  .moat--flat li strong {
    font-family: var(--font-heading);
    color: var(--color-text-primary);
    display: inline;
    font-weight: 700;
    font-size: 13px;
  }
  .moat--flat .moat__quote {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Closing lead */
  .about-closing__lead {
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255,255,255,0.82);
    max-width: 760px;
    margin: 24px 0 40px;
  }

  @media (max-width: 1024px) {
    .position__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 880px) {
    .glance__grid { grid-template-columns: 1fr; gap: 40px; }
    .model-cols { grid-template-columns: 1fr; }
    .model-col { padding: 32px 0; border-left: none !important; }
    .model-col:first-child { border-bottom: 1px solid var(--color-border); }
    .flywheel-compact__steps { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
