---
import Site from "../../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const glanceLeft = [
  "Technology-first · vertically integrated · built fully in-house",
  "AI embedded across customer-facing services and internal operations",
  "11 countries · 30+ strategic cities · deepest LATAM footprint in the category",
  "Serving the underserved 95% the global incumbents do not reach",
  "Bootstrapped twelve years · profitable · financed through operations",
  "No material concentration across categories, geographies or clients",
];

const glanceKpis = [
  { v: "10.2M", l: "Tickets sold (2025)" },
  { v: "$269M", l: "Gross sales" },
  { v: "11", l: "Countries" },
  { v: "95%+", l: "Client retention" },
];

const comparables = [
  { flag: "ARG", brand: "MercadoLibre", wedge: "E-commerce wedge", founded: 1999, ipo: 2007, years: 8 },
  { flag: "BRA", brand: "Nubank", wedge: "Financial services wedge", founded: 2013, ipo: 2021, years: 8 },
  { flag: "URU", brand: "DLocal", wedge: "Cross-border payments wedge", founded: 2016, ipo: 2021, years: 5 },
  { flag: "CHL", brand: "Ticketplus", wedge: "Live entertainment wedge", founded: 2014, ipo: 2026, years: 12, own: true },
];

const models = [
  {
    label: "White-Label SaaS",
    tag: "Accelerator",
    tagClass: "tag--amber",
    sub: "Partners adopt the platform under their own brand. Tech is ours, market access is theirs.",
    stats: [{ v: "1.6%", l: "take rate" }, { v: "6%", l: "of 2025 revenue" }, { v: "$109M", l: "2025 gross sales" }],
    bullets: ["Asset-light market entry across 11 countries.", "Full data visibility from day one — operating data flows before capital is deployed.", "Every transaction builds the intelligence base for conversion."],
  },
  {
    label: "Full Operation",
    tag: "Core",
    tagClass: "tag--red",
    sub: "Full event management — advanced sales, marketing, data intelligence and on-site operations, end-to-end.",
    stats: [{ v: "17.3%", l: "take rate" }, { v: "94%", l: "of 2025 revenue" }, { v: "$160M", l: "2025 gross sales" }],
    bullets: ["High-profile events: concerts, sports, festivals.", "Full margin capture across the complete event lifecycle.", "Embedded support drives 95%+ retention across 11 markets."],
  },
];

const moatItems = [
  { label: "Regulation", body: "11 jurisdictions with different fiscal compliance systems. Built locally, not retrofitted globally." },
  { label: "Payments", body: "50+ local payment methods integrated across markets. Every new market adds primitives to the same shared infrastructure." },
  { label: "Relationships", body: "2,800+ partners embedded in daily operations. Not customers — operators who run their business on our platform." },
  { label: "Data", body: "12 years of operational and transaction data across multiple countries. Capital can compress many things. It cannot compress accumulated operational history." },
];
---
<Site title="About Ticketplus · Investor Relations" current="about">

  <!-- 1. HEADER + AT A GLANCE -->
  <header class="page-header">
    <div class="page-header__inner">
      <p class="page-header__eyebrow">About Ticketplus</p>
      <h1 class="page-header__title">Twelve years building the <span class="accent">operating system</span> for LATAM live entertainment.</h1>
      <p class="page-header__lead">Ticketing is the entry point. The long-term opportunity is the operating, transaction and data layer across Latin America.</p>
    </div>
  </header>

  <section class="glance">
    <div class="container">
      <div class="glance__grid">
        <ul class="glance__bullets">
          {glanceLeft.map((item) => <li>{item}</li>)}
        </ul>
        <ul class="glance__kpis">
          {glanceKpis.map((k) => (
            <li>
              <span class="glance__kpi-value">{k.v}</span>
              <span class="glance__kpi-label">{k.l}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. THE MARKET -->
  <section class="market">
    <div class="container">
      <p class="section__eyebrow">Market opportunity</p>
      <h2 class="section__title">A $40B market, growing at <span class="accent-red">4× the global rate.</span></h2>
      <div class="market__cards">
        <article class="mcard">
          <p class="mcard__eyebrow">South American live events market</p>
          <p class="mcard__from">2022 · $27.7B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2028 · $45.5B</p>
          <p class="mcard__delta">+8.6% CAGR</p>
        </article>
        <article class="mcard mcard--amber">
          <p class="mcard__eyebrow">Smart ticketing LATAM</p>
          <p class="mcard__from">2024 · $1B</p>
          <p class="mcard__arrow">→</p>
          <p class="mcard__to">2030 · $2.5B</p>
          <p class="mcard__delta">+16.6% CAGR · 4× global</p>
        </article>
      </div>
      <ul class="market__bullets">
        <li><strong>Structurally fragmented.</strong> Global ticketing leaders hold less than 20% market share across most of Latin America outside Mexico and Brazil, compared with more than 80% in the US and Europe.</li>
        <li><strong>Consolidation race underway.</strong> Live Nation → OCESA (2025). CTS Eventim → Punto Ticket (2023). Credicorp → Joinnus (2025). The window to consolidate the underserved 95% is closing.</li>
        <li><strong>Infrastructure gap.</strong> Most of the region has been underserved not just in ticketing — but in professional event infrastructure. Promoters need more than a ticketing page. They need technology that helps them sell more, operate better and manage events more efficiently.</li>
      </ul>
      <p class="source">Sources: PwC GE&amp;M Outlook · Worldometer · Grand View Horizon · Mordor Intelligence.</p>
    </div>
  </section>

  <section class="comparables">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Category</p>
      <h2 class="section__title section__title--inv">Same playbook. Different vertical. <span class="accent">Chile's chapter hasn't been written yet.</span></h2>
      <p class="comparables__lead">MercadoLibre, Nubank and DLocal each built the infrastructure layer on fragmented Latin American markets through a different vertical wedge. Bootstrapped longer than any of them, Ticketplus is the next chapter.</p>
      <ul class="comp-grid">
        {comparables.map((c) => (
          <li class={`comp${c.own ? " comp--own" : ""}`}>
            <span class="comp__flag">{c.flag}</span>
            <h3>{c.brand}</h3>
            <p class="comp__wedge">{c.wedge}</p>
            <p class="comp__line">Founded {c.founded} → IPO {c.ipo}</p>
            <p class="comp__years">{c.years} years</p>
          </li>
        ))}
      </ul>
      <p class="comparables__footnote">Business-model parallel only · not for valuation reference. Subject to listing.</p>
    </div>
  </section>

  <!-- 3. THE MODEL -->
  <section class="model-about">
    <div class="container">
      <p class="section__eyebrow">Business model</p>
      <h2 class="section__title">Two models. <span class="accent">One platform.</span></h2>
      <p class="section__lead" style="margin-bottom: 48px;">Full Operation is the core. White-Label is the accelerator. Not two businesses — one continuum where partners enter at 1.6% and graduate to 17.3% when the data tells us they are ready.</p>

      <div class="model-cols">
        {models.map((m) => (
          <div class="model-col">
            <div class="model-col__header">
              <h3 class="model-col__title">{m.label}</h3>
              <span class={`tag ${m.tagClass}`}>{m.tag}</span>
            </div>
            <p class="model-panel__sub">{m.sub}</p>
            <ul class="model-panel__stats">
              {m.stats.map((s) => (
                <li>
                  <strong>{s.v}</strong>
                  <span>{s.l}</span>
                </li>
              ))}
            </ul>
            <ul class="model-panel__bullets">
              {m.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <div class="flywheel-compact">
        <p class="flywheel-compact__label">How the conversion engine works · Land · Learn · Convert</p>
        <ol class="flywheel-compact__steps">
          <li><strong>Land</strong> — A regional operator adopts our infrastructure under its own brand at 1.6% take rate. Operating data starts flowing from day one.</li>
          <li><strong>Learn</strong> — Over multiple years, we build full business intelligence on the partner — real-time sales, margins, growth trends, execution quality. We are not buying relationships blindly. We are converting operating relationships we already understand deeply.</li>
          <li><strong>Convert</strong> — We move the strongest operators to Full Operation at 17.3% take rate. Integration risk is minimal because we have been inside their business for years. <strong>50+ operators in pipeline today.</strong></li>
        </ol>
        <p class="flywheel-compact__note">Other acquirers perform diligence from the outside. We perform it from inside the operating infrastructure itself.</p>
      </div>
    </div>
  </section>

  <!-- 4. THE MOAT -->
  <section class="moat-section">
    <div class="container">
      <p class="section__eyebrow">Moat &amp; geographic footprint</p>
      <h2 class="section__title">Why this position is <span class="accent-red">impossible to replicate quickly.</span></h2>
      <p class="section__lead">Eleven countries operating live. A roadmap toward twenty-five. Same platform. Same operating model. Same playbook. Every market added became another barrier a new entrant has to rebuild from zero.</p>
      <div class="moat-grid">
        {moatItems.map((m) => (
          <div class="moat-card">
            <h3 class="moat-card__label">{m.label}</h3>
            <p class="moat-card__body">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. THE PROOF -->
  <section class="proof">
    <div class="container">
      <p class="section__eyebrow">Diversification &amp; financials</p>
      <h2 class="section__title">Growing fast. <span class="accent">Growing profitably.</span></h2>

      <div class="proof__grid">
        <div class="proof__div">
          <p class="proof__sub-label">Three things about how this revenue is built</p>
          <ul class="proof__three">
            <li>
              <strong>No sector carries us.</strong>
              Sports 32% · Music 30% · Holiday Events 22% · Travel 5% · Theater 4% · Other 7%. If any one slowed down tomorrow, the business keeps running.
            </li>
            <li>
              <strong>No single customer carries us.</strong>
              Across 2,800 promoters and venues, no single client represents more than 4% of revenue.
            </li>
            <li>
              <strong>Our customers recommend us.</strong>
              On the Net Promoter Score scale from −100 to +100, both promoters and ticket buyers score us top-quartile for live entertainment. Retention above 95% reinforces that.
            </li>
          </ul>
        </div>

        <div class="proof__fin">
          <p class="proof__sub-label">Three years of audited financials + Q1 2026</p>
          <ul class="kpi-grid">
            <li class="kpi"><span class="kpi__value">$29.5M</span><span class="kpi__label">Net revenue (2025 audited)</span></li>
            <li class="kpi"><span class="kpi__value">+64%</span><span class="kpi__label">Revenue YoY (2024→2025)</span></li>
            <li class="kpi"><span class="kpi__value">37.3%</span><span class="kpi__label">EBITDA margin (2025)</span></li>
            <li class="kpi"><span class="kpi__value">44.6%</span><span class="kpi__label">EBITDA margin (Q1 2026 · weakest quarter)</span></li>
          </ul>
          <p class="proof__note">Revenue doubled 2023→2025. EBITDA grew 77%. In a single quarter of 2026, we delivered EBITDA close to what took a full year in 2023. Zero institutional equity raised in twelve years.</p>
          <p class="source" style="margin-top: 16px;">Audited under IFRS by Baker Tilly (PCAOB-registered). Q1 2026 preliminary.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. CLOSING -->
  <section class="thesis" style="padding: 120px 0;">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">The thesis</p>
      <h2 class="section__title section__title--inv">Ticketplus is building the operating system for live entertainment across Latin America. <span class="accent">Nasdaq is the vehicle, not the goal.</span></h2>
      <p class="about-closing__lead">The goal is to build the operating, transaction and data infrastructure layer for live entertainment across Latin America. This is not a validation event. It is an acceleration event.</p>
      <a class="btn btn--primary" href={link("/contact/")} style="display: inline-flex;">Contact IR</a>
    </div>
  </section>

  <nav class="pagenav">
    <div class="container pagenav__inner">
      <a class="pagenav__side" href={link("/")}>
        <span class="pagenav__label">← Back</span>
        <span class="pagenav__title">Overview</span>
      </a>
      <a class="pagenav__side pagenav__side--next" href={link("/leadership/")}>
        <span class="pagenav__label">Next →</span>
        <span class="pagenav__title">Leadership</span>
      </a>
    </div>
  </nav>
</Site>

<style>
  /* At a glance */
  .glance { background: var(--color-surface-elevated); padding: 72px 0 96px; }
  .glance__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .glance__bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .glance__bullets li {
    font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted);
    line-height: 1.55; padding: 14px 0; border-top: 1px solid var(--color-border);
  }
  .glance__bullets li:first-child { border-top: none; padding-top: 0; }
  .glance__kpis {
    list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border-top: 1px solid var(--color-border); border-left: 1px solid var(--color-border);
  }
  .glance__kpis li { padding: 28px 24px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .glance__kpi-value {
    display: block; font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(32px, 3.5vw, 48px); letter-spacing: -0.04em; line-height: 1; color: var(--color-text-primary);
  }
  .glance__kpi-label { display: block; margin-top: 6px; font-family: var(--font-body); font-size: 13px; color: var(--color-text-muted); line-height: 1.4; }

  /* Model */
  .model-about { background: var(--color-surface-elevated); }
  .model-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--color-border); margin-top: 8px; }
  .model-col { padding: 40px 40px 40px 0; display: flex; flex-direction: column; gap: 20px; }
  .model-col:last-child { padding: 40px 0 40px 40px; border-left: 1px solid var(--color-border); }
  .model-col__header { display: flex; align-items: center; justify-content: space-between; }
  .model-col__title { font-family: var(--font-heading); font-size: 20px; font-weight: 700; letter-spacing: -0.03em; margin: 0; color: var(--color-text-primary); }
  .model-panel__sub { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); line-height: 1.6; margin: 0; }
  .model-panel__stats { list-style: none; padding: 0; margin: 0; display: flex; gap: 28px; flex-wrap: wrap; }
  .model-panel__stats li { display: flex; flex-direction: column; gap: 2px; }
  .model-panel__stats strong {
    font-family: var(--font-heading); font-size: 26px; font-weight: 800; letter-spacing: -0.04em; line-height: 1;
    background: var(--gradient-brand-text); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
  }
  .model-panel__stats span { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); }
  .model-panel__bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .model-panel__bullets li { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); line-height: 1.55; padding-bottom: 10px; border-bottom: 1px solid var(--color-border); }
  .model-panel__bullets li:last-child { border-bottom: none; padding-bottom: 0; }

  /* Flywheel */
  .flywheel-compact { margin-top: 48px; padding: 36px 40px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-gray-50); }
  .flywheel-compact__label { font-family: var(--font-heading); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 24px; }
  .flywheel-compact__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .flywheel-compact__steps li { font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: var(--color-text-muted); padding-top: 16px; border-top: 2px solid var(--color-border); }
  .flywheel-compact__steps li strong { display: block; font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 8px; letter-spacing: -0.01em; }
  .flywheel-compact__note { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--color-border); font-family: var(--font-body); font-size: 14px; font-style: italic; color: var(--color-text-muted); line-height: 1.55; }

  /* Moat */
  .moat-section { background: var(--color-surface-elevated); }
  .moat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; margin-top: 48px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; }
  .moat-card { background: var(--color-surface-elevated); padding: 36px 32px; }
  .moat-card__label { font-family: var(--font-heading); font-size: 15px; font-weight: 700; letter-spacing: -0.01em; color: var(--color-text-primary); margin: 0 0 12px; }
  .moat-card__body { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  /* Proof */
  .proof { background: var(--color-surface-elevated); }
  .proof__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 48px; align-items: start; }
  .proof__sub-label { font-family: var(--font-heading); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 24px; }
  .proof__three { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .proof__three li { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); line-height: 1.6; padding: 18px 0; border-top: 1px solid var(--color-border); }
  .proof__three li:first-child { border-top: none; padding-top: 0; }
  .proof__three strong { font-family: var(--font-heading); color: var(--color-text-primary); font-size: 15px; font-weight: 700; display: block; margin-bottom: 4px; }
  .proof__note { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); line-height: 1.6; margin: 20px 0 0; }

  /* Closing */
  .about-closing__lead { font-family: var(--font-body); font-size: 18px; line-height: 1.65; color: rgba(255,255,255,0.82); max-width: 760px; margin: 24px 0 40px; }

  @media (max-width: 880px) {
    .glance__grid { grid-template-columns: 1fr; gap: 40px; }
    .model-cols { grid-template-columns: 1fr; }
    .model-col { padding: 32px 0; border-left: none !important; }
    .model-col:first-child { border-bottom: 1px solid var(--color-border); }
    .flywheel-compact__steps { grid-template-columns: 1fr; gap: 20px; }
    .moat-grid { grid-template-columns: 1fr; }
    .proof__grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
