---
import Site from "../../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;



const models = [
  {
    label: "White-Label SaaS",
    tag: "",
    tagClass: "",
    sub: "Partners adopt the platform under their own brand. Tech is ours, market access is theirs.",
    stats: [{ v: "1.6%", l: "take rate" }, { v: "6%", l: "of 2025 revenue" }, { v: "$109M", l: "2025 gross sales" }],
    bullets: ["Every transaction builds the intelligence base for conversion."],
  },
  {
    label: "Full Operation",
    tag: "",
    tagClass: "",
    sub: "Full event management — advanced sales, marketing, data intelligence and on-site operations, end-to-end.",
    stats: [{ v: "17.3%", l: "take rate" }, { v: "94%", l: "of 2025 revenue" }, { v: "$160M", l: "2025 gross sales" }],
    bullets: ["Full margin capture across the complete event lifecycle."],
  },
];

const moatItems = [
  { label: "Regulation", body: "11 jurisdictions with different fiscal compliance systems. Built locally, not retrofitted globally." },
  { label: "Payments", body: "50+ local payment methods integrated across markets. Every new market adds primitives to the same shared infrastructure." },
  { label: "Relationships", body: "2,800+ partners embedded in daily operations. Not customers — operators who run their business on our platform." },
  { label: "Data", body: "12 years of operational and transaction data across multiple countries. Capital can compress many things. It cannot compress accumulated operational history." },
];
---
<Site title="About Ticketplus · Investor Relations" current="about">

  <!-- 1. HEADER + AT A GLANCE -->
  <header class="hero-ml">
    <div class="hero-ml__media" style={`background-image: url('${base}/hero-about.jpg');`} aria-hidden="true"></div>
    <div class="hero-ml__scrim" aria-hidden="true"></div>
    <div class="hero-ml__inner">
      <h1 class="hero-ml__title">Twelve years building the infrastructure of the Latin American live economy.</h1>
      <p class="hero-ml__sub" style="max-width: 650px; text-align: left; margin-top: 32px;">We started with ticketing to earn our position in the market. We stayed to run the entire transaction layer for a $40B industry.</p>
      <a class="btn btn--ghost" href={link("/contact/")} style="margin-top: 32px; display: inline-flex;">Contact IR</a>
    </div>
  </header>

  <!-- 2. THE MODEL -->
  <section class="model-about">
    <div class="container">
      <p class="section__eyebrow">The model</p>
      <h2 class="section__title">Land, Learn, <span class="accent">Convert.</span></h2>
      <p class="section__lead" style="margin-bottom: 48px;">Others perform diligence from the outside. We perform it from inside the operation — years before converting a partner.</p>

      <div class="flywheel-cards">
        <ol class="flywheel-cards__grid">
          <li class="fw-card">
            <div class="fw-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 4v14M8 12l6 6 6-6"/>
                <path d="M4 22h20"/>
              </svg>
            </div>
            <span class="fw-card__phase">Land</span>
            <p class="fw-card__body">A regional operator adopts our infrastructure under its own brand at 1.6% take rate. Operating data starts flowing from day one.</p>
          </li>
          <li class="fw-card">
            <div class="fw-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="14" cy="14" r="10"/>
                <circle cx="14" cy="14" r="4"/>
                <line x1="14" y1="4" x2="14" y2="10"/>
                <line x1="14" y1="18" x2="14" y2="24"/>
                <line x1="4" y1="14" x2="10" y2="14"/>
                <line x1="18" y1="14" x2="24" y2="14"/>
              </svg>
            </div>
            <span class="fw-card__phase">Learn</span>
            <p class="fw-card__body">Over multiple years, we build full business intelligence on the partner — real-time sales, margins, growth trends, execution quality. We are not buying relationships blindly. We are converting operating relationships we already understand deeply.</p>
          </li>
          <li class="fw-card">
            <div class="fw-card__icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4,20 10,12 16,16 24,6"/>
                <polyline points="18,6 24,6 24,12"/>
              </svg>
            </div>
            <span class="fw-card__phase">Convert</span>
            <p class="fw-card__body">We move the strongest operators to Full Operation at 17.3% take rate. Integration risk is minimal because we have been inside their business for years.</p>
            <p class="fw-card__stat">50+ operators in pipeline today.</p>
          </li>
        </ol>
        <p class="flywheel-cards__note">Other acquirers perform diligence from the outside. We perform it from inside the operating infrastructure itself.</p>
      </div>

      <div class="model-cols-block">
        <h3 class="model-cols-label">From 1.6% to 17.3%.</h3>
        <div class="model-cols">
          {models.map((m, i) => (
            <div class={`model-col${i === 0 ? " model-col--dark" : " model-col--gradient"}`}>
              <div class="model-col__header">
                <h3 class="model-col__title">{m.label}</h3>
                {m.tag && <span class={`tag ${m.tagClass}`}>{m.tag}</span>}
              </div>
              <p class="model-panel__sub">{m.sub}</p>
              <ul class="model-panel__stats">
                {m.stats.map((s) => (
                  <li>
                    <strong>{s.v}</strong>
                    <span>{s.l}</span>
                  </li>
                ))}
              </ul>
              <ul class="model-panel__bullets">
                {m.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4. THE PROOF -->
  <section class="proof" style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <p class="section__eyebrow">Financials</p>
      <h2 class="section__title">Proven <span class="accent">at Scale.</span></h2>

      <div class="proof__grid">
        <div class="proof__div">
          <p class="proof__sub-label">Three things about how this revenue is built</p>
          <ul class="proof__three">
            <li>
              <strong>No sector carries us.</strong>
              Sports 32% · Music 30% · Holiday Events 22% · Travel 5% · Theater 4% · Other 7%. If any one slowed down tomorrow, the business keeps running.
            </li>
            <li>
              <strong>No single customer carries us.</strong>
              Across 2,800 promoters and venues, no single client represents more than 4% of revenue.
            </li>
            <li>
              <strong>Our customers recommend us.</strong>
              On the Net Promoter Score scale from −100 to +100, both promoters and ticket buyers score us top-quartile for live entertainment. Retention above 95% reinforces that.
            </li>
          </ul>
        </div>

        <div class="proof__fin">
          <p class="proof__sub-label">Three years of audited financials + Q1 2026</p>
          <ul class="kpi-grid">
            <li class="kpi"><span class="kpi__value">$29.5M</span><span class="kpi__label">Net revenue (2025 audited)</span></li>
            <li class="kpi"><span class="kpi__value">+64%</span><span class="kpi__label">Revenue YoY (2024→2025)</span></li>
            <li class="kpi"><span class="kpi__value">37.3%</span><span class="kpi__label">EBITDA margin (2025)</span></li>
            <li class="kpi"><span class="kpi__value">44.6%</span><span class="kpi__label">EBITDA margin (Q1 2026 · weakest quarter)</span></li>
          </ul>
          <p class="proof__note">Revenue doubled 2023→2025. EBITDA grew 77%. In a single quarter of 2026, we delivered EBITDA close to what took a full year in 2023. Zero institutional equity raised in twelve years.</p>
          <p class="source" style="margin-top: 16px;">Audited under IFRS by Baker Tilly (PCAOB-registered). Q1 2026 preliminary.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. MARKET & CATEGORY -->
  <section class="thesis" style="padding: 96px 0;">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">Market & category</p>
      <h2 class="section__title section__title--inv">A $40B market <span class="accent">waiting for its infrastructure layer.</span></h2>
      <div class="market__cards" style="margin-top: 48px;">
        <article class="mcard mcard--inv">
          <svg class="mcard__trend" viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="19" stroke="rgba(34,197,94,0.25)" stroke-width="1.5"/>
            <line x1="20" y1="28" x2="20" y2="12" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round"/>
            <polyline points="13,19 20,12 27,19" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="mcard__title">Live entertainment industry · LATAM</p>
          <p class="mcard__legend">Total market — concerts, sports, festivals, venues</p>
          <p class="mcard__from">2022 · $27.7B</p>

          <p class="mcard__to">2028 · $45.5B</p>
          <p class="mcard__delta">+8.6% CAGR</p>
        </article>
        <article class="mcard mcard--inv">
          <svg class="mcard__trend" viewBox="0 0 40 40" width="40" height="40" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="19" stroke="rgba(34,197,94,0.25)" stroke-width="1.5"/>
            <line x1="20" y1="28" x2="20" y2="12" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round"/>
            <polyline points="13,19 20,12 27,19" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="mcard__title">Ticketing technology layer · LATAM</p>
          <p class="mcard__legend">Software & infrastructure — Ticketplus's direct market</p>
          <p class="mcard__from">2024 · $1B</p>

          <p class="mcard__to">2030 · $2.5B</p>
          <p class="mcard__delta">+16.6% CAGR · 4× global</p>
        </article>
      </div>
      <p class="comparables__lead" style="margin-top: 48px;">Markets this large, growing this fast, with this little infrastructure — historically, that gap creates category leaders. When MercadoLibre listed in 2007, Latin American e-commerce was fragmented and underpenetrated. When Nubank IPO'd in 2021, Brazilian fintech was running on inadequate infrastructure. That is exactly where live entertainment in Latin America is today. The consolidation race is already underway: Live Nation acquired OCESA in 2025, CTS Eventim acquired Punto Ticket in 2023, Credicorp acquired Joinnus in 2025. The window to establish infrastructure dominance is closing.</p>
      <p class="comparables__footnote">Business-model parallel only · not for valuation reference. Subject to listing. Sources: PwC GE&amp;M Outlook · Worldometer · Grand View Horizon · Mordor Intelligence.</p>
    </div>
  </section>

  <section class="ir-contact">
    <div class="container">
      <h3 class="ir-contact__title">Any questions? Get in touch.</h3>
      <p class="ir-contact__sub">Get in touch with our investor relations team for more information.</p>
      <a class="btn btn--primary" href="mailto:ir@ticketplus.com">Contact us</a>
    </div>
  </section>

  <nav class="pagenav">
    <div class="container pagenav__inner">
      <a class="pagenav__side" href={link("/")}>
        <span class="pagenav__label">← Back</span>
        <span class="pagenav__title">Overview</span>
      </a>
      <a class="pagenav__side pagenav__side--next" href={link("/leadership/")}>
        <span class="pagenav__label">Next →</span>
        <span class="pagenav__title">Leadership</span>
      </a>
    </div>
  </nav>
</Site>

<style>
  /* Market card title */
  .mcard__title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin: 0 0 4px;
  }

  /* Market card legend */
  .mcard__legend {
    font-family: var(--font-body);
    font-size: 12px;
    color: #ffffff;
    margin: 4px 0 12px;
    line-height: 1.4;
  }

  /* Market inv card (on dark background) */
  .mcard--inv {
    background: rgba(255,255,255,0.06);
    border-color: rgba(255,255,255,0.12);
  }
  .mcard--inv .mcard__eyebrow { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); }
  .mcard--inv .mcard__from { color: rgba(255,255,255,0.6); }
  .mcard--inv .mcard__to { color: #fff; }
  .mcard--inv .mcard__delta { background: var(--gradient-brand); color: #fff; }
  .mcard--inv .mcard__arrow { -webkit-text-fill-color: initial; background: none; color: var(--color-secondary); }

  /* Market dark card */
  .mcard--dark {
    background: #000;
    border-color: var(--color-secondary);
    position: relative;
    overflow: hidden;
  }
  .mcard__trend {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
  }
  @media (min-width: 721px) {
    .mcard__trend {
      width: 72px;
      height: 72px;
    }
  }
  .mcard--dark .mcard__eyebrow { background: rgba(255,171,36,0.12); color: var(--color-secondary); }
  .mcard--dark .mcard__from { color: rgba(255,255,255,0.6); }
  .mcard--dark .mcard__to { color: #fff; }
  .mcard--dark .mcard__delta { background: var(--gradient-brand); color: #fff; }
  .mcard--dark .mcard__arrow { -webkit-text-fill-color: initial; background: none; color: var(--color-secondary); }

  /* Market facts 3-col */
  .market-facts {
    list-style: none; padding: 0; margin: 32px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .market-fact {
    background: var(--color-surface-elevated);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .market-fact__title {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0;
  }
  .market-fact__body {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Model cols block */
  .model-cols-block { margin-top: 64px; }
  .model-cols-label {
    font-family: var(--font-heading);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: 0 0 32px;
  }

  /* Flywheel cards */
  .flywheel-cards { margin-top: 48px; }
  .flywheel-cards__label {
    font-family: var(--font-heading);
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin: 0 0 32px;
    line-height: 1.15;
  }
  .flywheel-cards__grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .fw-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
  }
  .fw-card--highlight {
    background: #000;
    border-color: rgba(255,171,36,0.3);
  }
  .fw-card--highlight .fw-card__phase { color: var(--color-secondary); }
  .fw-card--highlight .fw-card__body { color: rgba(255,255,255,0.72); }
  .fw-card--highlight .fw-card__icon { color: var(--color-secondary); }
  .fw-card__icon { color: var(--color-text-primary); }
  .fw-card__phase {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }
  .fw-card__body {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0;
    flex: 1;
  }
  .fw-card__stat {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-border);
  }
  .flywheel-cards__note {
    margin-top: 20px;
    font-family: var(--font-body);
    font-size: 14px;
    font-style: italic;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* At a glance */
  .glance { background: var(--color-surface-elevated); padding: 72px 0 96px; }
  .glance__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .glance__bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .glance__bullets li {
    font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted);
    line-height: 1.55; padding: 14px 0; border-top: 1px solid var(--color-border);
  }
  .glance__bullets li:first-child { border-top: none; padding-top: 0; }
  .glance__kpis {
    list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr;
    gap: 0; border-top: 1px solid var(--color-border); border-left: 1px solid var(--color-border);
  }
  .glance__kpis li { padding: 28px 24px; border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .glance__kpi-value {
    display: block; font-family: var(--font-heading); font-weight: 800;
    font-size: clamp(32px, 3.5vw, 48px); letter-spacing: -0.04em; line-height: 1; color: var(--color-text-primary);
  }
  .glance__kpi-label { display: block; margin-top: 6px; font-family: var(--font-body); font-size: 13px; color: var(--color-text-muted); line-height: 1.4; }

  /* Model */
  .model-about { background: var(--color-surface-elevated); }
  .model-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 32px; }
  .model-col {
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    border-radius: var(--radius-card);
    border: 1px solid var(--color-border);
    background: var(--color-surface-elevated);
  }
  .model-col--dark {
    background: #000;
    border-color: rgba(255,255,255,0.12);
  }
  .model-col--dark .model-col__title { color: #fff; }
  .model-col--dark .model-panel__sub { color: rgba(255,255,255,0.9); }
  .model-col--dark .model-panel__stats span { color: rgba(255,255,255,0.5); }
  .model-col--dark .model-panel__bullets li {
    color: rgba(255,255,255,0.65);
    border-bottom-color: rgba(255,255,255,0.1);
  }
  .model-col--gradient {
    background: linear-gradient(135deg, #f79802, #ff1313);
    border-color: transparent;
  }
  .model-col--gradient .model-col__title { color: #fff; }
  .model-col--gradient .model-panel__sub { color: rgba(255,255,255,0.85); }
  .model-col--gradient .model-panel__stats strong { color: #fff; }
  .model-col--gradient .model-panel__stats span { color: rgba(255,255,255,0.75); }
  .model-col--gradient .model-panel__bullets li {
    color: rgba(255,255,255,0.85);
    border-bottom-color: rgba(255,255,255,0.25);
  }
  .model-col__header { display: flex; align-items: center; justify-content: space-between; }
  .model-col__title { font-family: var(--font-heading); font-size: 20px; font-weight: 700; letter-spacing: -0.03em; margin: 0; color: var(--color-text-primary); }
  .model-panel__sub { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); line-height: 1.6; margin: 0; }
  .model-panel__stats { list-style: none; padding: 0; margin: 0; display: flex; gap: 32px; flex-wrap: wrap; }
  .model-panel__stats li { display: flex; flex-direction: column; gap: 4px; }
  .model-panel__stats strong {
    font-family: var(--font-heading); font-size: clamp(32px, 3.5vw, 44px); font-weight: 800; letter-spacing: -0.04em; line-height: 1;
    color: var(--color-text-primary);
  }
  .model-col--dark .model-panel__stats strong { color: #ffffff; }
  .model-panel__stats span { font-family: var(--font-body); font-size: 12px; color: var(--color-text-muted); }
  .model-panel__bullets { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .model-panel__bullets li { font-family: var(--font-body); font-size: 14px; color: var(--color-text-muted); line-height: 1.55; padding-bottom: 10px; border-bottom: 1px solid var(--color-border); }
  .model-panel__bullets li:last-child { border-bottom: none; padding-bottom: 0; }

  /* Flywheel */
  .flywheel-compact { margin-top: 48px; padding: 36px 40px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-gray-50); }
  .flywheel-compact__label { font-family: var(--font-heading); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 24px; }
  .flywheel-compact__steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .flywheel-compact__steps li { font-family: var(--font-body); font-size: 14px; line-height: 1.6; color: var(--color-text-muted); padding-top: 16px; border-top: 2px solid var(--color-border); }
  .flywheel-compact__steps li strong { display: block; font-family: var(--font-heading); font-size: 15px; font-weight: 700; color: var(--color-text-primary); margin-bottom: 8px; letter-spacing: -0.01em; }
  .flywheel-compact__note { margin: 28px 0 0; padding-top: 20px; border-top: 1px solid var(--color-border); font-family: var(--font-body); font-size: 14px; font-style: italic; color: var(--color-text-muted); line-height: 1.55; }

  /* Moat */
  .moat-section { background: var(--color-surface-elevated); }
  .moat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2px; margin-top: 48px; background: var(--color-border); border: 1px solid var(--color-border); border-radius: var(--radius-card); overflow: hidden; }
  .moat-card { background: var(--color-surface-elevated); padding: 36px 32px; }
  .moat-card__label { font-family: var(--font-heading); font-size: 15px; font-weight: 700; letter-spacing: -0.01em; color: var(--color-text-primary); margin: 0 0 12px; }
  .moat-card__body { font-family: var(--font-body); font-size: 15px; color: var(--color-text-muted); line-height: 1.6; margin: 0; }

  /* Proof */
  .proof { background: var(--color-surface-elevated); }
  .proof__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-top: 48px; align-items: start; }
