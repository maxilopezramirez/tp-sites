---
import Site from "../../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p}`;

const modules = [
  {
    n: "01",
    title: "Event Ticketing",
    sub: "Virtual queue · 3D layouts · elastic infra",
    body: "High-concurrency sales engine for massive demand. Fair randomization, real-time tracking, seat-level visualization.",
  },
  {
    n: "02",
    title: "Payments & Banking",
    sub: "Acquirers · BNPL · digital wallets · cards",
    body: "50+ country-specific payment methods across Latin America. Leading regional and country-specific gateways, BNPL providers, international card networks and local debit.",
  },
  {
    n: "03",
    title: "Data & Analytics",
    sub: "Real-time event management · BI",
    body: "Live operational data across markets and partners. Multi-year P&L visibility into every partner running on our infrastructure.",
  },
  {
    n: "04",
    title: "Access Control",
    sub: "Dynamic QR · Biometric · RFID/NFC",
    body: "Multi-layer validation, frictionless entry. Real-time validation, anti-fraud, facial recognition for VIP, cashless wristbands for festivals.",
  },
  {
    n: "05",
    title: "On-Site Operations",
    sub: "Kiosks · Mobile POS · Cashless NFC",
    body: "Seamless box office and in-venue experience. Self-service pickup, roaming sales with inventory sync, NFC for F&B and VIP.",
  },
];
---
<Site title="Platform & Moat · Ticketplus" current="platform">
  <header class="page-header">
    <div class="page-header__inner">
      <p class="page-header__eyebrow">Platform &amp; moat</p>
      <h1 class="page-header__title">Best-in-class software. <span class="accent">Core platform built in-house.</span></h1>
      <p class="page-header__lead">An integrated entertainment ecosystem: five modules, twelve sub-features, AI embedded across the stack. No reliance on third-party core infrastructure.</p>
    </div>
  </header>

  <section class="platform">
    <div class="container">
      <p class="section__eyebrow">Platform &amp; moat</p>
      <h2 class="section__title">Why global players <span class="accent-red">can't capture this market.</span></h2>
      <div class="platform__grid">
        <aside class="moat">
          <h3>What blocks the incumbents</h3>
          <ul>
            <li><strong>Regulation</strong> · 11 jurisdictions · fiscal compliance per market</li>
            <li><strong>Payment gateways</strong> · local acquirers, BNPL, wallets across 11 markets</li>
            <li><strong>Relationships</strong> · 2,800+ partners embedded in daily ops</li>
            <li><strong>Data</strong> · 12 yrs multi-market · no mono-country can match</li>
          </ul>
          <p class="moat__quote">"Built in-house with no reliance on third-party core infrastructure."</p>
        </aside>
        <ol class="modules">
          {modules.map((m) => (
            <li class="module">
              <span class="module__n">{m.n}</span>
              <div>
                <h4>{m.title}</h4>
                <p class="module__sub">{m.sub}</p>
                <p>{m.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="thesis" style="padding: 90px 0;">
    <div class="container">
      <p class="section__eyebrow section__eyebrow--inv">AI &amp; technology</p>
      <h2 class="section__title section__title--inv">Twelve years in-house. <span class="accent">A compounding moat.</span></h2>
      <div class="thesis__grid">
        <div class="thesis__copy">
          <p>Every new module deepens stickiness on top of the same partner base. AI is embedded across the customer-facing services and internal operations — anti-fraud, dynamic pricing, demand forecasting.</p>
          <p>The platform is not a stitched assembly of third-party SaaS tools. It is one codebase, owned end-to-end, refined across 12 years of multi-market operation.</p>
        </div>
        <div class="thesis__copy">
          <p><strong style="color: var(--yellow);">The compounding advantage.</strong> Each new module adds value across thousands of partner relationships. Each new market adds payment methods, regulatory primitives and behavioral data to the same shared infrastructure.</p>
          <p>This is not a code-rewriting business. It is a code-extending business — which is why the platform can serve a 100-ticket-per-night theater and the FIFA U-20 World Cup on the same stack.</p>
        </div>
      </div>
    </div>
  </section>

  <nav class="pagenav">
    <div class="container pagenav__inner">
      <a class="pagenav__side" href={link("/business/")}>
        <span class="pagenav__label">← Previous</span>
        <span class="pagenav__title">Business model</span>
      </a>
      <a class="pagenav__side pagenav__side--next" href={link("/leadership/")}>
        <span class="pagenav__label">Next →</span>
        <span class="pagenav__title">Leadership</span>
      </a>
    </div>
  </nav>
</Site>
