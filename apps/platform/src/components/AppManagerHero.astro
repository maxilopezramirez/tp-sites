---
/*
  AppManagerHero — bloque hero reutilizable.
  Renderiza la feature "App Manager: tu evento en el bolsillo" con store buttons.
  Se puede colocar dentro de una sección biz-scene en home o en cualquier landing vertical.

  Props:
    isReverse — invierte image-text (default: false = image-left)
    dark      — variante para fondo dark (texto blanco). Default: false (light bg).
*/

interface Props {
  isReverse?: boolean;
  dark?: boolean;
}

const { isReverse = false, dark = false } = Astro.props;
---

<div class={`amh ${isReverse ? "is-reverse" : ""} ${dark ? "is-dark" : "is-light"}`}>
  <div class="amh__stage" aria-hidden="true" />
  <div class="amh__caption">
    <span class="amh__tag">01 · App Manager</span>
    <h3 class="amh__title">App Manager: tu evento en el bolsillo</h3>
    <p class="amh__body">Visualiza ventas en tiempo real, valida tickets y envía cortesías desde iOS y Android. Para el productor que necesita ver el drop sin abrir el laptop.</p>
    <div class="amh__stores">
      <a class="store-btn" href="https://apps.apple.com/us/app/ticketplus/id1618113622" target="_blank" rel="noopener noreferrer" aria-label="Descargar en App Store">
        <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        <span class="store-text">
          <span class="store-label">Descárgala en</span>
          <span class="store-name">App Store</span>
        </span>
      </a>
      <a class="store-btn" href="https://play.google.com/store/apps/details?hl=en&id=cl.ticketplus.all_in_one" target="_blank" rel="noopener noreferrer" aria-label="Descargar en Google Play">
        <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M3,20.5V3.5C3,2.91 3.34,2.39 3.84,2.15L13.69,12L3.84,21.85C3.34,21.6 3,21.09 3,20.5M16.81,15.12L6.05,21.34L14.54,12.85L16.81,15.12M20.16,10.81C20.5,11.08 20.75,11.5 20.75,12C20.75,12.5 20.53,12.9 20.18,13.18L17.89,14.5L15.39,12L17.89,9.5L20.16,10.81M6.05,2.66L16.81,8.88L14.54,11.15L6.05,2.66Z"/></svg>
        <span class="store-text">
          <span class="store-label">Descárgala en</span>
          <span class="store-name">Google Play</span>
        </span>
      </a>
    </div>
  </div>
</div>

<style>
  .amh {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 88px;
  }
  .amh.is-reverse { grid-template-columns: 0.85fr 1.15fr; }
  .amh.is-reverse .amh__stage { order: 2; }
  .amh.is-reverse .amh__caption { order: 1; }

  .amh__stage {
    aspect-ratio: 4/3;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    background: linear-gradient(135deg, rgba(255,19,19,0.10) 0%, rgba(255,171,36,0.10) 100%);
    border: 1px solid rgba(10,10,10,0.08);
  }
  .amh.is-dark .amh__stage { border-color: rgba(255,255,255,0.08); }
  .amh__stage::before,
  .amh__stage::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.55;
  }
  .amh__stage::before {
    width: 60%; height: 80%;
    top: -10%; left: -10%;
    background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);
  }
  .amh__stage::after {
    width: 50%; height: 60%;
    bottom: -10%; right: -10%;
    background: radial-gradient(circle, var(--color-secondary) 0%, transparent 70%);
  }

  .amh__tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
    margin-bottom: 14px;
  }

  .amh__title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
    margin: 0 0 16px;
  }
  .amh.is-light .amh__title { color: var(--color-text-primary); }
  .amh.is-dark .amh__title { color: #fff; }

  .amh__body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.65;
    margin: 0 0 16px;
  }
  .amh.is-light .amh__body { color: var(--color-text-muted); }
  .amh.is-dark .amh__body { color: rgba(255,255,255,0.72); }

  .amh__stores { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 20px; }
  .amh__stores .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    background: #000;
    color: #fff;
    border: 1px solid #000;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .amh.is-dark .amh__stores .store-btn { border-color: rgba(255,255,255,0.18); }
  .amh__stores .store-btn:hover { transform: translateY(-1px); border-color: var(--color-secondary); }
  .amh__stores .store-icon { width: 22px; height: 22px; flex-shrink: 0; }
  .amh__stores .store-text { display: flex; flex-direction: column; line-height: 1.1; }
  .amh__stores .store-label { font-family: var(--font-body); font-size: 9px; opacity: 0.75; letter-spacing: 0.04em; text-transform: uppercase; }
  .amh__stores .store-name { font-family: var(--font-heading); font-size: 14px; font-weight: 700; letter-spacing: -0.01em; }

  @media (max-width: 768px) {
    .amh, .amh.is-reverse { grid-template-columns: 1fr; gap: 32px; }
    .amh.is-reverse .amh__stage { order: initial; }
    .amh.is-reverse .amh__caption { order: initial; }
  }
</style>
