---
/*
  Mega menu header — portado de temp-servicios-web/src/components/navigation/HeaderMega.tsx
  Astro vanilla, sin dependencias extra.

  Estructura:
    - Header fijo, transparente por defecto, fondo blur en scroll/hover/mobile open
    - Triggers desktop con dropdown grid (hover-intent con delay)
    - Mobile: hamburger -> panel slide con accordion por capa
*/

interface MegaItem { label: string; href: string; description?: string; iconPath?: string }
interface MegaPanel { eyebrow?: string; items: MegaItem[]; columns?: number }

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');

const megaMenus: Record<string, MegaPanel> = {
  vertical: {
    eyebrow: 'Industrias',
    columns: 4,
    items: [
      // Música/disco (Fiestas)
      { iconPath: 'M9 18V5l12-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zm12-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0z', label: 'Fiestas', href: '/servicios/fiestas', description: 'Eventos nocturnos y open-air' },
      // Curtain/theater
      { iconPath: 'M4 4h16v3H4zM6 7v13M18 7v13M6 20c2.5-3 4-7 6-7s3.5 4 6 7', label: 'Teatros', href: '/servicios/teatros', description: 'Temporadas culturales' },
      // Ferris wheel (Familiar)
      { iconPath: 'M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16zM12 12v0M12 4v8M20 12h-8M12 20v-8M4 12h8M5.6 5.6l6.4 6.4M18.4 5.6L12 12M18.4 18.4L12 12M5.6 18.4L12 12', label: 'Familiar', href: '/servicios/familiar', description: 'Parques, circos y shows infantiles' },
      // Trophy (Deportes)
      { iconPath: 'M8 4h8v6a4 4 0 0 1-8 0V4zM6 6H4v2a3 3 0 0 0 3 3M18 6h2v2a3 3 0 0 1-3 3M10 14h4M9 21h6M12 14v7', label: 'Deportes', href: '/servicios/deportes', description: 'Clubes y federaciones' },
      // Microphone (Espectáculo)
      { iconPath: 'M12 3a3 3 0 0 0-3 3v6a3 3 0 1 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3M8 21h8', label: 'Espectáculo', href: '/servicios/espectaculo', description: 'Recitales, stand-up, ópera' },
      // Booth/stand (Ferias)
      { iconPath: 'M4 7h16v3H4zM5 10v11h14V10M9 21v-6h6v6', label: 'Ferias', href: '/servicios/ferias', description: 'Expos multi-día y B2B' },
      // Tent (Festivales)
      { iconPath: 'M3 21l9-16 9 16H3zM12 5v16M8.5 13L6 17M15.5 13L18 17', label: 'Festivales', href: '/servicios/festivales', description: 'Drops masivos y multi-stage' },
      // Briefcase (Conferencias)
      { iconPath: 'M3 7h18v13H3zM8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18', label: 'Conferencias', href: '/servicios/conferencias', description: 'Congresos B2B y corporativos' },
    ],
  },
  modulo: {
    eyebrow: 'Soluciones',
    columns: 4,
    items: [
      // QR code (Onsite)
      { iconPath: 'M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM18 14h3M14 18h3M18 18v3', label: 'Onsite', href: '/servicios/onsite', description: 'Validación, staff, box office' },
      // POS terminal
      { iconPath: 'M4 3h16v18H4zM4 7h16M8 11h8M8 15h5', label: 'POS y Tótem', href: '/servicios/pos-y-totem', description: 'Venta en venue con offline real' },
      // Shopping cart (Marketplace)
      { iconPath: 'M3 5h2l2.4 12H19M7 17a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z', label: 'Marketplace', href: '/servicios/marketplace', description: 'Vender más sin agencia' },
      // Sync/cycle (Gestión 360)
      { iconPath: 'M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5', label: 'Gestión 360', href: '/servicios/360', description: 'Memberships, streaming, tienda y más' },
      // Bar chart (Data analytics)
      { iconPath: 'M3 3v18h18M7 14v4M11 10v8M15 7v11M19 4v14', label: 'Data analytics', href: '/servicios/data-analytics', description: 'Real-time desde el celular' },
      // Shield (Trust & service)
      { iconPath: 'M12 2l8 3v7c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V5l8-3zM9 12l2 2 4-4', label: 'Trust & service', href: '/servicios/trust-service', description: 'SLA firmado y AM dedicado' },
      // Trending up (Booster)
      { iconPath: 'M3 17l6-6 4 4 8-8M14 7h7v7', label: 'Booster', href: '/booster', description: 'Agencia gestionada incluida' },
    ],
  },
};

type TriggerDef = { key: string; label: string };
const triggers: TriggerDef[] = [
  { key: 'vertical', label: 'Industrias' },
  { key: 'modulo', label: 'Soluciones' },
];
---

<header class="mm-header" id="mm-header" data-state="transparent">
  <div class="mm-inner">
    <a href={`${base}/`} class="mm-logo" aria-label="TicketPlus — Home">
      <img src={`${base}/wordmark-white.png`} alt="TicketPlus" />
    </a>

    <nav class="mm-nav" aria-label="Main navigation">
      {triggers.map((t) => (
        <button
          type="button"
          class="mm-trigger"
          data-menu-key={t.key}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>{t.label}</span>
          <svg class="mm-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      ))}
    </nav>

    <div class="mm-actions">
      <a href="#contact" class="mm-cta">Hablar con ventas</a>
    </div>

    <button
      type="button"
      class="mm-burger"
      id="mm-burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mm-mobile"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  {/* Desktop mega panels */}
  <div class="mm-panels" id="mm-panels">
    {Object.entries(megaMenus).map(([key, panel]) => (
      <div class="mm-panel" data-panel-key={key} aria-hidden="true">
        <div class="mm-panel__inner">
          {panel.eyebrow && <p class="mm-panel__eyebrow">{panel.eyebrow}</p>}
          <div class={`mm-items mm-items--cols-${panel.columns ?? 4}`}>
            {panel.items.map((item) => (
              <a href={`${base}${item.href}`} class="mm-item">
                {item.iconPath && (
                  <span class="mm-item__icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d={item.iconPath} />
                    </svg>
                  </span>
                )}
                <span class="mm-item__text">
                  <span class="mm-item__label">{item.label}</span>
                  {item.description && (
                    <span class="mm-item__desc">{item.description}</span>
                  )}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>

  {/* Mobile slide menu */}
  <div class="mm-mobile" id="mm-mobile" aria-hidden="true">
    <div class="mm-mobile__inner">
      {Object.entries(megaMenus).map(([key, panel]) => (
        <div class="mm-acc" data-acc-key={key}>
          <button
            type="button"
            class="mm-acc__head"
            aria-expanded="false"
            aria-controls={`mm-acc-body-${key}`}
          >
            <span>{triggers.find((t) => t.key === key)?.label ?? key}</span>
            <svg class="mm-acc__chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id={`mm-acc-body-${key}`} class="mm-acc__body">
            <div class="mm-acc__group">
              {panel.items.map((item) => (
                <a href={`${base}${item.href}`} class="mm-acc__link">
                  {item.iconPath && (
                    <span class="mm-acc__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d={item.iconPath} />
                      </svg>
                    </span>
                  )}
                  <span class="mm-acc__text">
                    <span>{item.label}</span>
                    {item.description && <em>{item.description}</em>}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}

      <div class="mm-mobile__cta">
        <a href="#contact" class="mm-cta mm-cta--block">Hablar con ventas</a>
      </div>
    </div>
  </div>
</header>

<style>
  :global(body) { margin: 0; }

  .mm-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background: transparent;
    transition: background-color .25s ease, backdrop-filter .25s ease, border-color .25s ease;
  }
  .mm-header[data-state='solid'] {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }

  .mm-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .mm-logo {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .mm-logo img {
    height: 24px;
    width: auto;
    display: block;
  }

  /* Desktop nav */
  .mm-nav {
    display: none;
    align-items: center;
    gap: 4px;
  }

  .mm-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 9999px;
    border: 0;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: color .15s ease, background-color .15s ease;
  }
  .mm-trigger:hover,
  .mm-trigger[aria-expanded='true'] {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
  }
  .mm-chevron {
    transition: transform .2s ease;
  }
  .mm-trigger[aria-expanded='true'] .mm-chevron {
    transform: rotate(180deg);
  }

  .mm-actions {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .mm-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 9px 20px;
    border-radius: 9999px;
    background: linear-gradient(178deg, #f79802, #ff1313);
    color: #fff;
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 24px rgba(255, 19, 19, 0.25);
    transition: filter .2s ease, transform .15s ease;
    white-space: nowrap;
  }
  .mm-cta:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }
  .mm-cta--block {
    display: flex;
    width: 100%;
    padding: 12px 20px;
  }

  /* Hamburger */
  .mm-burger {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    gap: 5px;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    border-radius: 6px;
  }
  .mm-burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: #fff;
    border-radius: 9999px;
    transition: transform .3s ease, opacity .3s ease;
    transform-origin: center;
  }
  .mm-burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mm-burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .mm-burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mega panels */
  .mm-panels {
    position: absolute;
    left: 0; right: 0;
    top: 100%;
    pointer-events: none;
  }
  .mm-panel {
    position: absolute;
    left: 0; right: 0;
    top: 0;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity .15s ease-in, transform .15s ease-in;
    pointer-events: none;
  }
  .mm-panel[aria-hidden='false'] {
    opacity: 1;
    transform: translateY(0);
    transition: opacity .2s ease-out, transform .2s ease-out;
    pointer-events: auto;
  }
  .mm-panel__inner {
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .mm-panel__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 28px 24px 32px;
  }
  .mm-panel__eyebrow {
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ffab24;
    margin: 0 0 18px;
  }
  .mm-items {
    display: grid;
    gap: 8px 12px;
  }
  .mm-items--cols-2 { grid-template-columns: repeat(2, 1fr); }
  .mm-items--cols-3 { grid-template-columns: repeat(3, 1fr); }
  .mm-items--cols-4 { grid-template-columns: repeat(4, 1fr); }

  .mm-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: transparent;
    text-decoration: none;
    transition: background-color .15s ease, border-color .15s ease, transform .15s ease;
  }
  .mm-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 171, 36, 0.25);
    transform: translateY(-1px);
  }
  .mm-item__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 171, 36, 0.10);
    border: 1px solid rgba(255, 171, 36, 0.22);
    border-radius: 9px;
    color: var(--color-secondary, #ffab24);
  }
  .mm-item__icon svg { width: 18px; height: 18px; }
  .mm-item:hover .mm-item__icon {
    background: rgba(255, 171, 36, 0.18);
    border-color: rgba(255, 171, 36, 0.40);
  }
  .mm-item__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mm-item__label {
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    line-height: 1.2;
  }
  .mm-item__desc {
    font-family: var(--font-body, "Poppins", system-ui, sans-serif);
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.35;
  }

  @media (max-width: 1024px) {
    .mm-items--cols-4 { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 820px) {
    .mm-items--cols-4, .mm-items--cols-3 { grid-template-columns: repeat(2, 1fr); }
  }

  /* Mobile panel */
  .mm-mobile {
    position: absolute;
    left: 0; right: 0;
    top: 64px;
    background: rgba(0, 0, 0, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
  }
  .mm-mobile[aria-hidden='false'] {
    max-height: 75vh;
    overflow-y: auto;
  }
  .mm-mobile__inner {
    padding: 12px 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mm-acc { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .mm-acc__head {
    width: 100%;
    background: transparent;
    border: 0;
    padding: 14px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgba(255, 255, 255, 0.85);
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color .15s ease, color .15s ease;
  }
  .mm-acc__head:hover { color: #fff; background: rgba(255, 255, 255, 0.05); }
  .mm-acc__chev { transition: transform .2s ease; }
  .mm-acc__head[aria-expanded='true'] .mm-acc__chev { transform: rotate(180deg); }
  .mm-acc__head[aria-expanded='true'] { color: #fff; }

  .mm-acc__body {
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
  }
  .mm-acc.is-open .mm-acc__body { max-height: 1200px; }

  .mm-acc__group { padding: 4px 12px 12px; }
  .mm-acc__title {
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffab24;
    margin: 6px 0 6px;
  }
  .mm-acc__link {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    text-decoration: none;
    color: rgba(255, 255, 255, 0.75);
    font-family: var(--font-heading, "Montserrat", system-ui, sans-serif);
    font-size: 14px;
    transition: color .15s ease;
  }
  .mm-acc__link:hover { color: #fff; }
  .mm-acc__icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 171, 36, 0.10);
    border: 1px solid rgba(255, 171, 36, 0.22);
    border-radius: 7px;
    color: var(--color-secondary, #ffab24);
  }
  .mm-acc__icon svg { width: 16px; height: 16px; }
  .mm-acc__text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .mm-acc__link em {
    display: block;
    font-style: normal;
    font-family: var(--font-body, "Poppins", system-ui, sans-serif);
    font-size: 12px;
    margin-top: 2px;
    color: rgba(255, 255, 255, 0.4);
  }

  .mm-mobile__cta {
    margin-top: 12px;
    padding: 12px 4px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Responsive */
  @media (min-width: 768px) {
    .mm-nav { display: inline-flex; }
    .mm-actions { display: inline-flex; }
    .mm-burger { display: none; }
    .mm-mobile { display: none; }
  }

  @media (max-width: 767px) {
    .mm-panels { display: none; }
  }
</style>

<script>
  (function () {
    const header = document.getElementById('mm-header');
    if (!header) return;

    const burger = header.querySelector<HTMLButtonElement>('#mm-burger');
    const mobile = header.querySelector<HTMLElement>('#mm-mobile');
    const panelsRoot = header.querySelector<HTMLElement>('#mm-panels');
    const triggers = Array.from(
      header.querySelectorAll<HTMLButtonElement>('.mm-trigger')
    );
    const panels = Array.from(
      header.querySelectorAll<HTMLElement>('.mm-panel')
    );

    let activeKey: string | null = null;
    let closeTimer: number | null = null;
    let scrolled = false;
    let mobileOpen = false;

    function updateState() {
      const solid = scrolled || activeKey !== null || mobileOpen;
      header.dataset.state = solid ? 'solid' : 'transparent';
    }

    function showPanel(key: string | null) {
      activeKey = key;
      panels.forEach((p) => {
        const match = p.dataset.panelKey === key;
        p.setAttribute('aria-hidden', match ? 'false' : 'true');
      });
      triggers.forEach((t) => {
        const match = t.dataset.menuKey === key;
        t.setAttribute('aria-expanded', match ? 'true' : 'false');
      });
      updateState();
    }

    function clearCloseTimer() {
      if (closeTimer !== null) {
        window.clearTimeout(closeTimer);
        closeTimer = null;
      }
    }
    function scheduleClose() {
      clearCloseTimer();
      closeTimer = window.setTimeout(() => {
        showPanel(null);
      }, 150);
    }

    triggers.forEach((trigger) => {
      const key = trigger.dataset.menuKey;
      if (!key) return;
      trigger.addEventListener('mouseenter', () => {
        clearCloseTimer();
        showPanel(key);
      });
      trigger.addEventListener('mouseleave', scheduleClose);
      trigger.addEventListener('focus', () => {
        clearCloseTimer();
        showPanel(key);
      });
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        if (activeKey === key) {
          showPanel(null);
        } else {
          clearCloseTimer();
          showPanel(key);
        }
      });
    });

    // Plain links in nav: hovering them should close panels
    header.querySelectorAll<HTMLAnchorElement>('.mm-nav a').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        clearCloseTimer();
        showPanel(null);
      });
    });

    // Keep panel open while hovering it
    if (panelsRoot) {
      panelsRoot.addEventListener('mouseenter', clearCloseTimer);
      panelsRoot.addEventListener('mouseleave', scheduleClose);
    }

    // Close on outside click / escape
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) {
        showPanel(null);
        if (mobileOpen) toggleMobile(false);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        showPanel(null);
        if (mobileOpen) toggleMobile(false);
      }
    });

    // Scroll state
    const onScroll = () => {
      scrolled = window.scrollY > 20;
      updateState();
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Mobile menu toggle
    function toggleMobile(force?: boolean) {
      mobileOpen = typeof force === 'boolean' ? force : !mobileOpen;
      if (burger) burger.setAttribute('aria-expanded', mobileOpen ? 'true' : 'false');
      if (burger) burger.setAttribute('aria-label', mobileOpen ? 'Cerrar menú' : 'Abrir menú');
      if (mobile) mobile.setAttribute('aria-hidden', mobileOpen ? 'false' : 'true');
      document.body.style.overflow = mobileOpen ? 'hidden' : '';
      updateState();
    }
    burger?.addEventListener('click', () => toggleMobile());

    // Accordion (mobile)
    header.querySelectorAll<HTMLElement>('.mm-acc').forEach((acc) => {
      const head = acc.querySelector<HTMLButtonElement>('.mm-acc__head');
      if (!head) return;
      head.addEventListener('click', () => {
        const open = acc.classList.toggle('is-open');
        head.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });

    // Close mobile menu when a link is tapped
    header.querySelectorAll<HTMLAnchorElement>('.mm-mobile a').forEach((link) => {
      link.addEventListener('click', () => toggleMobile(false));
    });
  })();
</script>
