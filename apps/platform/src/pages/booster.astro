---
import Site from "../layouts/Site.astro";

// 2 paths según estado del productor
const paths = [
  {
    icon: "🆕",
    label: "Nuevo productor",
    question: "¿Aún no publicas tu evento?",
    body: "Te ayudamos a publicar primero en Ticketplus, y después activamos Booster sobre tu evento ya publicado.",
    cta: "Publicar mi evento",
    href: "#contacto",
  },
  {
    icon: "⚡",
    label: "Evento activo",
    question: "¿Ya tienes un evento en Ticketplus?",
    body: "Activación inmediata. Sin contrato extra, sin trámites. Nuestro equipo lanza campañas en menos de 24 horas hábiles.",
    cta: "Activar Booster",
    href: "#contacto",
  },
];

// 3 fases de Booster
const fases = [
  {
    n: "01", tag: "FASE 01 · PLANIFICAMOS", dark: false, id: "planificamos",
    title: "Buscas un equipo que entienda tu evento, no una agencia genérica.",
    lead: "Encuentras planificación por segmento con estrategia y canales específicos. Definimos la estrategia y los canales ideales para tu evento.",
    features: [
      { n: "01", title: "🎵 Conciertos y festivales", body: "Maximiza la venta durante el periodo activo de tu evento.", badge: null },
      { n: "02", title: "🔄 Eventos recurrentes", body: "Optimiza tu estrategia a lo largo de múltiples eventos publicados.", badge: null },
      { n: "03", title: "📈 Escalar resultados", body: "Ya vendes con TP y quieres un equipo especializado para crecer más.", badge: "Activación automática +10% crecimiento" },
    ],
  },
  {
    n: "02", tag: "FASE 02 · EJECUTAMOS", dark: true, id: "ejecutamos",
    title: "Buscas que alguien lance las campañas mientras vos producís.",
    lead: "Encuentras 5 canales integrados + workflow de optimización continua. Lanzamos y gestionamos tus campañas en todos los canales.",
    features: [
      { n: "01", title: "✉️ Email Marketing", body: "Mide conversiones directas desde tus campañas de email.", badge: null },
      { n: "02", title: "🖼️ Banners en Home Ticketplus", body: "Trackea el impacto de tu visibilidad en la plataforma.", badge: null },
      { n: "03", title: "🔍 Google Ads", body: "Conecta tus campañas de búsqueda con ventas reales.", badge: null },
      { n: "04", title: "📱 Meta Ads", body: "Atribuye conversiones desde Facebook e Instagram con precisión.", badge: null },
      { n: "05", title: "🔗 Acciones digitales externas", body: "Integra cualquier acción digital externa a tu ecosistema de medición.", badge: null },
    ],
  },
  {
    n: "03", tag: "FASE 03 · OPTIMIZAMOS", dark: false, id: "optimizamos",
    title: "Buscas saber qué canal vende y qué canal quema.",
    lead: "Encuentras un sistema de análisis con tracking + comparativa + reportes en tiempo real. Ajustamos en tiempo real para maximizar tu retorno.",
    features: [
      { n: "01", title: "Atribución end-to-end del click al ticket", body: "Rastreamos de dónde viene cada venta — sabés cuánto vendió cada canal.", badge: null },
      { n: "02", title: "Comparativa de campañas", body: "Identificamos cuáles funcionan mejor entre todos los canales activos.", badge: null },
      { n: "03", title: "Monitoreo en tiempo real", body: "Ajustamos la estrategia mientras tu evento está en venta, no después.", badge: null },
      { n: "04", title: "Reportes visuales y comprensibles", body: "Listos para equipos y directivos, sin complejidad innecesaria.", badge: "Listos para directivos" },
    ],
  },
];

const overview = [
  { tag: "01 · Planificamos", title: "Definimos estrategia y canales ideales para tu evento según segmento (concierto / recurrente / escalar).", href: "#planificamos" },
  { tag: "02 · Ejecutamos", title: "Lanzamos y gestionamos campañas en Meta, Google, TikTok, email y banners en el home TP.", href: "#ejecutamos" },
  { tag: "03 · Optimizamos", title: "Ajustamos en tiempo real con la data de venta real para maximizar el retorno.", href: "#optimizamos" },
];

// Casos de éxito reales con cifras
const cases = [
  { label: "Tianfu - La Reina 2025-2026", delta: "+41%", text: "aumento", revenue: "$41.189.500 ingresos adicionales" },
  { label: "Wonder Park Maipú 2026", delta: "+24%", text: "aumento", revenue: "$3.393.000 ingresos adicionales" },
  { label: "Family Summer La Florida", delta: "+21%", text: "aumento", revenue: "$3.204.100 ingresos adicionales" },
];

const whyCards = [
  { icon: "💰", title: "Gratis sin honorarios de agencia", body: "Modelo alineado a venta de entradas, no a fee de gestión." },
  { icon: "🎯", title: "Tú defines la pauta, nosotros gestionamos", body: "Vos controlás el presupuesto, nosotros optimizamos." },
  { icon: "📊", title: "Atribución end-to-end nativa", body: "Click al ticket vendido, con data de venta real (no estimada)." },
  { icon: "📈", title: "+25% en ventas promedio", body: "Proof point agregado, casos individuales hasta +41%." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "Booster con atribución al ticket en drops masivos.", href: "/servicios/festivales" },
  { icon: "🎵", label: "Espectáculos internacionales", body: "Booster con multi-moneda CLP+USD y atribución por preventa.", href: "/servicios/espectaculo" },
  { icon: "🎭", label: "Teatros", body: "Booster para promoción de funciones no-abono y obras debut.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Deportes", body: "Booster para venta de partidos puntuales (clásicos, finales).", href: "/servicios/deportes" },
  { icon: "🎡", label: "Centros familiares", body: "Booster para llenar cada función, no solo el estreno.", href: "/servicios/familiar" },
  { icon: "🎉", label: "Fiestas", body: "Booster con atribución al ticket vendido.", href: "/servicios/fiestas" },
  { icon: "💼", label: "Congresos", body: "Booster con segmentación por categoría (C-level, sponsor, prensa).", href: "/servicios/conferencias" },
];

const checklist = [
  "Sin honorarios de gestión — alineado a venta de entradas",
  "Tú defines el presupuesto en pauta",
  "Atribución end-to-end al ticket vendido",
  "5 canales integrados (Meta + Google + email + banners + externos)",
  "Optimización en tiempo real durante el periodo de venta",
  "Reportes claros para equipos y directivos",
];

const faqs = [
  { q: "¿Booster es realmente gratis?", a: "Sí. No cobramos honorarios de gestión por las campañas. Tú solo pagás el presupuesto de pauta directamente en cada plataforma (Meta, Google, etc.). Nosotros operamos sin fee adicional, sin licencia, sin contrato extra." },
  { q: "¿Cómo funciona el modelo de ingresos?", a: "Nuestro modelo está alineado a la venta de entradas. Cuando tu evento vende más, Ticketplus también crece (cargo por servicio sobre cada ticket vendido). No nos compensa cobrar fee de gestión — <strong>nos compensa que vendas más</strong>." },
  { q: "¿Necesito ser cliente de Ticketplus?", a: "Sí. Booster está disponible exclusivamente para clientes Full Operation (ticketplus.com). Si operás con Whitelabel propio, Booster no está incluido en los planes actuales." },
  { q: "¿Qué canales puedo medir?", a: "5 canales integrados: Email Marketing, Banners en Home Ticketplus, Google Ads, Meta Ads y acciones digitales externas. Atribución end-to-end del click al ticket vendido en todos." },
  { q: "¿Tengo que firmar contrato adicional?", a: "No. Booster es parte de tu plan Full Operation. Sin contrato extra, sin trámites, sin mínimos. La activación es inmediata si ya tenés evento publicado." },
  { q: "¿Necesito tener un evento publicado?", a: "Sí — Booster opera campañas para eventos activos. Si aún no publicaste, te ayudamos a publicar primero (path \"Nuevo productor\") y después activamos Booster." },
  { q: "¿Qué pasa si mi evento es pequeño?", a: "Booster funciona desde eventos de cualquier tamaño. Para eventos pequeños recomendamos foco en 1-2 canales (típicamente Meta + Google) en vez de los 5. El equipo te asesora según presupuesto y segmento." },
  { q: "¿Cuánto presupuesto en pauta necesito?", a: "Depende del segmento, aforo y plazo del evento. Como referencia: festivales masivos parten desde $5M CLP en pauta, conciertos medianos desde $2M, recurrentes desde $500K mensuales. El equipo arma la cotización con tu evento específico." },
  { q: "¿Cómo gana dinero Ticketplus si el servicio es gratuito?", a: "Booster forma parte del ecosistema Full Operation. Cuando tu evento vende más entradas, Ticketplus crece con el cargo por servicio sobre cada ticket. El modelo está alineado: <strong>nosotros operamos performance gratis porque tu venta es nuestra venta</strong>." },
];
---
<Site title="Booster · Marketing performance para eventos — Sin honorarios de agencia">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Booster · Marketing performance para eventos</p>
        <h1 class="biz-hero__title">La tecnología que opera tu marketing, sin honorarios de agencia.</h1>
        <p class="biz-hero__lead">Tú defines la pauta, nuestro equipo gestiona las campañas en Meta, Google, TikTok, email y banners. Nuestros clientes venden en promedio +25% más. Sin fees adicionales, sin licencia, sin contrato extra — alineados a venta de entradas.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Activar Booster →</a>
          <a href="#planificamos" class="btn btn--ghost">Cómo funciona</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <div class="biz-hero__placeholder" aria-hidden="true">
          <div class="biz-hero__placeholder-glow"></div>
          <div class="biz-hero__placeholder-grid">
            <div class="ph-tile ph-tile--big">
              <span class="ph-label">Ventas promedio</span>
              <span class="ph-value">+25%</span>
              <span class="ph-delta">vs. baseline sin Booster</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Canales</span>
              <span class="ph-value">5</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Fees</span>
              <span class="ph-value">$0</span>
            </div>
            <div class="ph-tile ph-tile--wide">
              <span class="ph-label">Pauta redistribuida en tiempo real</span>
              <div class="ph-bars">
                <span style="height:38%"></span>
                <span style="height:58%"></span>
                <span style="height:44%"></span>
                <span style="height:78%"></span>
                <span style="height:62%"></span>
                <span style="height:94%"></span>
                <span style="height:72%"></span>
                <span style="height:88%"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- PATHS SUB-BLOCK (pieza única) -->
  <section class="paths-block" id="paths">
    <div class="paths-block__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="paths-block__head">
        <span class="paths-block__eyebrow">¿Cuál es tu situación?</span>
        <h2 class="paths-block__title">Elige el camino que te corresponde para activar Booster.</h2>
      </div>
      <div class="paths-block__grid">
        {paths.map(p => (
          <a class="path-card" href={p.href}>
            <span class="path-card__icon" aria-hidden="true">{p.icon}</span>
            <h3 class="path-card__label">{p.label}</h3>
            <p class="path-card__question">{p.question}</p>
            <p class="path-card__body">{p.body}</p>
            <span class="path-card__cta">{p.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- AVISO FULL OPERATION (banner warning) -->
  <section class="fullop-notice" aria-label="Aviso de disponibilidad Full Operation">
    <div class="container">
      <div class="fullop-notice__card">
        <span class="fullop-notice__icon" aria-hidden="true">⚠️</span>
        <div class="fullop-notice__text">
          <h3 class="fullop-notice__title">Disponible exclusivamente para clientes Full Operation (ticketplus.com).</h3>
          <p class="fullop-notice__body">Si operas con tu propia marca (Whitelabel), Booster no está incluido en los planes actuales.</p>
        </div>
        <a href="#" class="fullop-notice__cta">Ver planes Whitelabel →</a>
      </div>
    </div>
  </section>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras que activaron Booster y crecieron sus ventas.</p>
      <div class="logos-cloud__grid">
        {["Tianfu La Reina 🇨🇱","Wonder Park Maipú 🇨🇱","Family Summer La Florida 🇨🇱","Movistar Arena 🇨🇱","Ñam Festival 🇨🇱","Lollapalooza 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE / TESIS -->
  <section class="bridge">
    <div class="container">
      <span class="bridge__eyebrow">Marketing performance dentro de Ticketplus</span>
      <h2 class="bridge__title">No es agencia. No es herramienta. Es tu equipo de marketing incluido.</h2>
      <p class="bridge__sub">Tú defines el presupuesto en pauta. Nosotros operamos las campañas con tu data de venta en tiempo real.</p>
    </div>
  </section>

  <!-- OVERVIEW DE LAS 3 FASES -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Booster opera tu marketing en 3 fases.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Cada una con un equipo dedicado.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver fase →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- SPOTLIGHT #1 · Modelo de negocio -->
  <section class="spotlight spotlight--brand" id="modelo">
    <div class="container">
      <span class="spotlight__eyebrow">Gratis · Sin honorarios de agencia · Único en el mercado</span>
      <h2 class="spotlight__title">Buscas vender más sin pagar agencia. Encuentras un modelo alineado a venta de entradas.</h2>
      <p class="spotlight__body">Booster forma parte del ecosistema Ticketplus. No cobramos honorarios de agencia por gestionar tus campañas. Nuestro modelo de negocio está alineado a la venta de entradas — cuando tu evento vende más, nosotros también crecemos contigo. Sin fee de servicio, sin contrato extra, sin mínimos de pauta.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Sin fee de gestión</h4>
          <p class="spotlight-card__text">No cobramos honorarios de agencia. Tu pauta va 100% a la plataforma de medios, no a una factura de servicio.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Alineado a venta de entradas</h4>
          <p class="spotlight-card__text">Nuestro modelo crece cuando vos vendés más. No nos compensa cobrar fee — nos compensa que vendas.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Sin mínimos de pauta</h4>
          <p class="spotlight-card__text">Eventos de cualquier tamaño. Sin contrato extra, sin trámites, sin permanencia obligatoria.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FASE 01 · PLANIFICAMOS -->
  {(() => {
    const p = fases[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- FASE 02 · EJECUTAMOS -->
  {(() => {
    const p = fases[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- FASE 03 · OPTIMIZAMOS -->
  {(() => {
    const p = fases[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #2 · Casos de éxito con cifras -->
  <section class="spotlight spotlight--dark" id="casos">
    <div class="container">
      <span class="spotlight__eyebrow">Impacto comprobado · +25% en ventas promedio</span>
      <h2 class="spotlight__title">Buscas saber qué pasa cuando activás Booster. Encuentras casos reales con cifras específicas — no promedios genéricos.</h2>
      <div class="cases-grid">
        {cases.map((c) => (
          <article class="case-stat">
            <span class="case-stat__label">{c.label}</span>
            <span class="case-stat__delta">{c.delta}</span>
            <span class="case-stat__text">{c.text}</span>
            <span class="case-stat__revenue">{c.revenue}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">Mientras producís el evento, Booster vende más entradas.</h2>
        <p class="tp-promise__body">Vos definís el presupuesto en pauta el lunes. El martes nuestro equipo lanza campañas en Meta, Google y TikTok. El miércoles los datos de venta entran al sistema. El jueves redistribuimos el presupuesto al canal que está vendiendo. El sábado del evento ya sabés exactamente de dónde vino cada ticket. <strong>Eso es Booster.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo con tu KAM</span>
            </span>
