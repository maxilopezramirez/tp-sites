---
import Site from "../layouts/Site.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const pillars = [
  {
    n: "01",
    tag: "MARCA",
    title: "Tu marca, tu dominio, tu app.",
    lead: "El cliente final nunca ve Ticketplus.",
    features: [
      {
        n: "01",
        title: "Dominio propio + checkout white-label end-to-end",
        body: "Tu dominio (tumarca.com o tickets.tumarca.com), certificado SSL gestionado, emails transaccionales desde tu dominio (DKIM/SPF). Checkout, tickets PDF, confirmaciones y reminders 100% bajo tu identidad visual. El cliente final nunca ve la marca Ticketplus.",
        badge: "Diferenciador clave vs Full Op",
      },
      {
        n: "02",
        title: "App iOS + Android publicada bajo tu cuenta",
        body: "App nativa publicada en App Store y Google Play bajo tu cuenta de desarrollador. Branding completo: ícono, splash, paleta, tipografías. Push notifications desde tu marca, deep linking a eventos y wallet integrado (Apple Wallet + Google Wallet).",
        badge: null,
      },
    ],
  },
  {
    n: "02",
    tag: "ECONOMÍA",
    title: "El dinero pasa por tu cuenta. La data, también.",
    lead: "A diferencia de Full Op, la recaudación va directa a tu cuenta — Ticketplus cobra una fee SaaS, no se queda con el float.",
    features: [
      {
        n: "01",
        title: "Liquidación directa a tu cuenta",
        body: "Stripe Connect con cuenta propia: el comprador paga y el dinero entra a tu cuenta bancaria, no a la de Ticketplus. Liquidación automática en 48-72h. Sin float retenido, sin cuentas escrow opacas.",
        badge: "Diferenciador clave vs Full Op",
      },
      {
        n: "02",
        title: "Modelo SaaS predecible",
        body: "Fee mensual SaaS + fee por ticket vendido (transparente, sin sorpresas), en lugar de % sobre revenue total. Operación previsible para tu CFO: presupuestas el costo de plataforma, no compartes ingreso del evento.",
        badge: null,
      },
      {
        n: "03",
        title: "Tu data es tuya — exportable cuando quieras",
        body: "Acceso completo a la base de compradores con consentimiento, exportable en JSON o CSV vía API o panel. Sin contratos de permanencia. Si decides irte, te llevas tus eventos, tus compradores, tu histórico transaccional.",
        badge: "Cero permanencia obligatoria",
      },
      {
        n: "04",
        title: "Multi-currency real — CLP y USD como eventos separados",
        body: "Vende en CLP en Chile y en USD para audiencia internacional, sin conversiones implícitas. Cada moneda se opera con su propia liquidación, su propia contabilidad y su propia conciliación bancaria. Sin spreads ocultos.",
        badge: null,
      },
    ],
  },
  {
    n: "03",
    tag: "ESCALA",
    title: "De 1K a 1M tickets/año en la misma plataforma.",
    lead: "El stack no cambia cuando creces. La misma API que opera un teatro de 200 butacas operó FIFA U-20 con +320K tickets en un día.",
    features: [
      {
        n: "01",
        title: "Compliance multi-país nativo",
        body: "Facturación electrónica integrada por país, sin contratar contadores locales: SII en Chile, AFIP en Argentina vía Facturante + GoSocket, DIAN en Colombia vía Siigo, DNCP en Paraguay. Cada operación se factura en la jurisdicción correcta automáticamente.",
        badge: "CL · AR · CO · PY",
      },
      {
        n: "02",
        title: "Hardware compatible — usa lo que ya tienes",
        body: "Compatibilidad nativa con impresoras Zebra, Honeywell, Verifone, Bixolon y Boca. Si tu venue ya tiene infraestructura, la reutilizas. POS, tótems, lectores QR y validadores funcionan con tu plataforma WL.",
        badge: null,
      },
      {
        n: "03",
        title: "Misma arquitectura 1K a 1M tickets/año",
        body: "El stack que opera un teatro de 200 butacas es el mismo que operó FIFA U-20 con +320K tickets en un día. No hay re-arquitectura cuando creces, no cambias de plan ni migras de base de datos.",
        badge: "99.9% uptime",
      },
    ],
  },
];

const whyCards = [
  { n: "01", title: "Plataforma probada", body: "FIFA U-20, +320K tickets/día, 99.9% uptime. 12 años iterando sobre el mismo core. Cada caso límite ya lo vivimos." },
  { n: "02", title: "Compliance multi-país", body: "SII Chile, AFIP Argentina, DIAN Colombia, DNCP Paraguay — facturación electrónica nativa. No contratas contadores locales." },
  { n: "03", title: "Cero re-arquitectura", body: "Mismo stack para 1K o 1M tickets/año. No migras de base de datos cuando creces. Tu equipo de ingeniería sigue trabajando." },
  { n: "04", title: "Migration in / out", body: "Onboarding acompañado en menos de 4 semanas. Si decides irte, te llevas tu data y tus compradores. Cero permanencia obligatoria." },
];

const industries = [
  { icon: "🎪", title: "Productoras grandes", body: "Vas a construir plataforma propia o cambiar de proveedor. Quieres tu marca front-end y operación probada atrás." },
  { icon: "🏟️", title: "Venues / Arenas", body: "Ya tienes ticketing in-house pero pesa mantenerlo. Quieres conservar tu marca y delegar la infraestructura." },
  { icon: "🌐", title: "Ticketeras regionales", body: "Operas en un país o ciudad con marca consolidada. Necesitas core SaaS sin perder identidad ni clientes." },
  { icon: "⚽", title: "Equipos de fútbol", body: "Boletería propia, abonos socios, partido a partido, acreditación prensa — bajo tu marca de club." },
];

const clients = [
  { flag: "🇦🇷", name: "Livepass", desc: "Entre las ticketeras más grandes de Argentina.", url: "livepass.com.ar" },
  { flag: "🇦🇷", name: "Autoentrada", desc: "Entre las ticketeras más grandes de Argentina.", url: "ventas.autoentrada.com" },
  { flag: "🇵🇾", name: "Ticketea", desc: "La principal ticketera de Paraguay.", url: "ticketea.com.py" },
  { flag: "🇲🇽", name: "La Maraka", desc: "Líder en entretenimiento en México.", url: "tickets.lamaraka.com.mx" },
  { flag: "🇲🇽", name: "Startickets", desc: "Tecnología de venta de entradas en México.", url: "startickets.com.mx" },
  { flag: "🇨🇱", name: "Pases Parques", desc: "Todos los parques nacionales de Chile se venden aquí.", url: "tickets.pasesparques.cl" },
];

const payments = [
  { flag: "🇨🇱", country: "Chile", pills: ["Webpay", "MACH Pay", "GetnetWeb", "Compraqui", "Multicaja", "Fintoc", "Bamboo", "Dpago"] },
  { flag: "🇦🇷", country: "Argentina", pills: ["MercadoPago", "Decidir"] },
  { flag: "🇨🇴", country: "Colombia", pills: ["Wompi", "Nequi", "Payvalida", "Paymentez"] },
  { flag: "🇲🇽", country: "México", pills: ["Nuvei", "Openpay"] },
  { flag: "🇧🇷", country: "Brasil", pills: ["PagSeguro", "PicPay", "PayPal"] },
  { flag: "🇵🇪", country: "Perú", pills: ["Izipay", "PagoEfectivo", "Niubiz"] },
  { flag: "🇵🇾", country: "Paraguay", pills: ["Bancard", "Pagopar", "BancardQR"] },
  { flag: "🇺🇾", country: "Uruguay", pills: ["MercadoPago"] },
  { flag: "🌎", country: "Multi-país", pills: ["Dlocal", "MercadoPago", "PayPal", "Stripe", "PayRetailers"] },
];

const faqs = [
  { q: "¿Puedo migrar mi data desde otra plataforma WL?", a: "Sí. Tenemos pipelines de migración acompañada desde plataformas WL comunes (Palco4, Vivenu, Tessitura, Eventbrite Pro, sistemas propios). El proceso típico toma 2 a 4 semanas con ingeniería TP dedicada y un Account Manager asignado." },
  { q: "¿Cuánto cuesta? ¿Es revenue share o SaaS fee?", a: "Es modelo SaaS — fee mensual fija de plataforma + fee transparente por ticket vendido. No tomamos % sobre el revenue total del evento, a diferencia del modelo Full Op. La fee se calcula según volumen anual esperado, módulos activados y tier de soporte. Cotización personalizada con TCO estimado a 5 años en menos de 24h." },
  { q: "¿Hay sandbox antes de contratar?", a: "Sí. Tienes acceso sandbox completo sin tarjeta de crédito desde el día 1 de la conversación comercial. Puedes probar el API, simular ventas, integrar contra tu propio frontend, y validar el flujo end-to-end antes de firmar contrato." },
  { q: "¿Qué pasa con mi facturación en cada país donde opero?", a: "Compliance multi-país nativo en los 4 mercados donde operamos hoy: SII Chile (boleta y factura electrónica), AFIP Argentina vía Facturante + GoSocket, DIAN Colombia vía Siigo, DNCP Paraguay. Cada operación se factura en la jurisdicción correcta automáticamente." },
  { q: "¿Quién es dueño de los datos? ¿Qué pasa si me voy?", a: "Los datos son tuyos. Tienes acceso a exportar la base completa de compradores, histórico transaccional y reportes en JSON o CSV vía API o panel — en cualquier momento. Si decides cerrar el contrato, te asistimos en la migración. Cero permanencia obligatoria." },
  { q: "¿En qué se diferencia de Full Operation de Ticketplus?", a: "En Full Operation, el comprador final ve la marca Ticketplus y la recaudación pasa por nuestra cuenta antes de liquidarse. En Whitelabel, el comprador final ve tu marca, el checkout vive en tu dominio, y la recaudación va directa a tu cuenta. Full Op es ideal para productoras que quieren foco en su evento; WL es para quienes quieren ser dueños de la plataforma." },
];
---
<Site title="Ticketplus Platform · Whitelabel SaaS para LATAM">

  <!-- NAV -->
  <nav class="topnav is-solid" id="topnav">
    <div class="topnav__inner">
      <a href="/" class="logo">ticketplus<b style="color:var(--color-secondary)">+</b></a>
      <ul class="topnav__links">
        <li><a href="#pilares">Plataforma</a></li>
        <li><a href="#por-que">Por qué WL</a></li>
        <li><a href="#industrias">Para quién</a></li>
      </ul>
      <a href="#contacto" class="btn btn--primary">Solicitar demo</a>
    </div>
  </nav>

  <!-- HERO -->
  <header class="page-header" style="padding: 180px 0 120px; min-height: 60vh; display: flex; align-items: center;">
    <div class="page-header__inner" style="max-width: 1280px;">
      <p class="page-header__eyebrow">Whitelabel SaaS · Plataforma de ticketing</p>
      <h1 class="page-header__title">Tu marca. Tu dominio.<br/><span class="accent">Tu data.</span></h1>
      <p class="page-header__lead">Ticketplus opera bajo el capó — tú operas la relación con el cliente. La plataforma de ticketing whitelabel que escala con tu marca, no con la nuestra.</p>
      <div style="display:flex; gap:12px; margin-top:40px; flex-wrap:wrap;">
        <a href="#contacto" class="btn btn--primary">Solicitar demo →</a>
        <a href="#pilares" class="btn btn--ghost">Ver la plataforma</a>
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Operan con Ticketplus Whitelabel</p>
      <div class="logos-cloud__grid">
        {["Livepass 🇦🇷", "Autoentrada 🇦🇷", "Ticketea 🇵🇾", "La Maraka 🇲🇽", "Startickets 🇲🇽", "Pases Parques 🇨🇱", "Teatro UC 🇨🇱", "Audax Italiano 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE -->
  <section style="background:#fff; padding: 96px 0 72px; text-align:center;">
    <div class="container">
      <p class="section__eyebrow" style="color:var(--color-primary);">SaaS B2B · 12 años iterando</p>
      <h2 class="section__title" style="max-width: 900px; margin: 0 auto;">El SaaS de ticketing que escala con tu marca, no con la nuestra.</h2>
    </div>
  </section>

  <!-- 3 PILARES OVERVIEW -->
  <section style="background:#fff; padding: 0 0 120px;" id="pilares">
    <div class="container">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
        {pillars.map(p => (
          <div style="border:1px solid var(--color-border); border-radius:var(--radius-card); padding:36px 28px; display:flex; flex-direction:column; gap:14px;">
            <span style="display:inline-block; font-family:var(--font-heading); font-size:11px; font-weight:800; color:var(--color-primary); letter-spacing:0.15em; background:rgba(255,19,19,0.08); padding:4px 12px; border-radius:999px; align-self:flex-start;">{p.n} · {p.tag}</span>
            <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:800; letter-spacing:-0.02em; margin:0;">{p.title}</h3>
            <p style="font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:1.6; flex:1; margin:0;">{p.lead}</p>
            <a href={`#pilar-${p.n}`} style="font-family:var(--font-heading); font-size:0.85rem; font-weight:700; color:var(--color-primary); text-decoration:none;">Ver detalle ↓</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DEEP DIVES: cada pilar con cards -->
  {pillars.map((p, pi) => (
    <section id={`pilar-${p.n}`} style={`padding: 120px 0; background: ${pi % 2 === 1 ? '#000000' : '#ffffff'}; color: ${pi % 2 === 1 ? '#fff' : 'inherit'};`}>
      <div class="container">
        <p class="section__eyebrow" style={`color: ${pi % 2 === 1 ? 'var(--color-secondary)' : 'var(--color-secondary)'};`}>{p.n} · {p.tag}</p>
        <h2 class="section__title" style={pi % 2 === 1 ? 'color:#fff;' : ''}>{p.title}</h2>
        <p class="section__lead" style={`max-width:640px; margin-bottom:56px; color: ${pi % 2 === 1 ? 'rgba(255,255,255,0.70)' : 'var(--color-text-muted)'};`}>{p.lead}</p>

        <div style={`display:grid; grid-template-columns:repeat(${p.features.length <= 2 ? 2 : p.features.length <= 3 ? 3 : 2}, 1fr); gap:2px; background:${pi % 2 === 1 ? 'rgba(255,255,255,0.08)' : 'var(--color-border)'}; border-radius:var(--radius-card); overflow:hidden;`}>
          {p.features.map(f => (
            <div style={`background:${pi % 2 === 1 ? '#111111' : '#ffffff'}; padding:40px 36px; display:flex; flex-direction:column; gap:16px;`}>
              <span style={`font-family:var(--font-heading); font-weight:900; font-size:56px; line-height:1; letter-spacing:-0.04em; background:var(--gradient-brand-text); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; color:transparent;`}>{f.n}</span>
              <h3 style={`font-family:var(--font-heading); font-size:1.2rem; font-weight:700; letter-spacing:-0.02em; margin:0; color:${pi % 2 === 1 ? '#fff' : 'var(--color-text-primary)'};`}>{f.title}</h3>
              <p style={`font-family:var(--font-body); font-size:0.9rem; line-height:1.65; margin:0; color:${pi % 2 === 1 ? 'rgba(255,255,255,0.62)' : 'var(--color-text-muted)'};`}>{f.body}</p>
              {f.badge && (
                <span style="display:inline-block; font-family:var(--font-heading); font-size:0.7rem; font-weight:700; color:var(--color-secondary); background:rgba(255,171,36,0.10); border:1px solid rgba(255,171,36,0.30); border-radius:4px; padding:3px 8px; letter-spacing:0.05em; text-transform:uppercase; align-self:flex-start;">{f.badge}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- WHY TICKETPLUS -->
  <section style="background:#000; color:#fff; padding:120px 0;" id="por-que">
    <div class="container">
      <div style="text-align:center; max-width:680px; margin:0 auto 56px;">
        <p class="section__eyebrow section__eyebrow--inv">Por qué Whitelabel Ticketplus</p>
        <h2 class="section__title section__title--inv">Build vs buy ya no es la pregunta correcta.</h2>
        <p style="font-family:var(--font-body); font-size:1.05rem; color:rgba(255,255,255,0.65); line-height:1.6;">La pregunta es: ¿cuánto cuesta mantener tu plataforma propia los próximos 5 años vs operar bajo una probada que escala contigo?</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
        {whyCards.map(c => (
          <div style="background:#141414; border:1px solid rgba(255,255,255,0.08); border-radius:14px; padding:32px 26px;">
            <span style="font-family:var(--font-heading); font-weight:900; font-size:48px; line-height:1; letter-spacing:-0.04em; background:var(--gradient-brand-text); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; color:transparent; display:block; margin-bottom:16px;">{c.n}</span>
            <h3 style="font-family:var(--font-heading); font-size:1.1rem; font-weight:700; color:#fff; margin:0 0 10px; letter-spacing:-0.01em;">{c.title}</h3>
            <p style="font-family:var(--font-body); font-size:0.9rem; color:rgba(255,255,255,0.60); line-height:1.6; margin:0;">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="industrias">
    <div class="container">
      <div style="text-align:center; max-width:640px; margin:0 auto 56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Para quién es Whitelabel</p>
        <h2 class="section__title">¿Esto es para ti?</h2>
        <p class="section__lead" style="color:var(--color-text-muted); max-width:540px; margin:0 auto;">Whitelabel es una decisión de plataforma, no de evento. Estos perfiles ya tomaron esa decisión.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:16px;">
        {industries.map(i => (
          <a href="#contacto" style="background:#fff; border:1px solid var(--color-border); border-radius:12px; padding:28px 24px; text-decoration:none; color:inherit; display:flex; flex-direction:column; gap:10px; transition:transform .2s, box-shadow .2s;">
            <span style="font-size:28px;">{i.icon}</span>
            <h4 style="font-family:var(--font-heading); font-size:1.05rem; font-weight:700; letter-spacing:-0.01em; margin:0;">{i.title}</h4>
            <p style="font-family:var(--font-body); font-size:0.87rem; color:var(--color-text-muted); line-height:1.5; margin:0;">{i.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ECOSYSTEM / WL CLIENTS -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Ecosistema de productores, venues y marcas que operan con nuestra <span class="accent">tecnología Whitelabel</span></h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
        {clients.map(c => (
          <a href={`https://${c.url}`} target="_blank" rel="noopener" style="background:#fff; border:1px solid var(--color-border); border-radius:12px; padding:24px; text-decoration:none; color:inherit; display:flex; flex-direction:column; gap:10px;">
            <span style="font-size:1.4rem;">{c.flag}</span>
            <div style="height:100px; background:var(--color-gray-100); border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--color-gray-500); font-size:12px; font-family:var(--font-mono);">{c.url}</div>
            <h4 style="font-family:var(--font-heading); font-size:1.05rem; font-weight:700; letter-spacing:-0.01em; margin:0;">{c.name}</h4>
            <p style="font-family:var(--font-body); font-size:0.87rem; color:var(--color-text-muted); margin:0;">{c.desc}</p>
            <span style="font-family:var(--font-heading); font-size:0.8rem; font-weight:700; color:var(--color-primary);">{c.url} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PAGOS LATAM -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="pagos">
    <div class="container">
      <p class="section__eyebrow" style="color:var(--color-secondary);">Pagos</p>
      <h2 class="section__title">Ecosistema de pagos<br/>hecho para LATAM</h2>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin:48px 0;">
        {[
          { t: "Recaudación directa", b: "El dinero va a tu cuenta bancaria. Sin pasar por Ticketplus, sin retenciones. Tú operas, tú cobras." },
          { t: "Multi-país desde un panel", b: "Vende en Chile, Argentina, México o España sin crear cuentas separadas. Un solo backoffice, múltiples mercados." },
          { t: "Monedas y regulaciones locales", b: "Impuestos, monedas y regulaciones ya están configurados. Tú solo eliges los países donde quieres operar." },
        ].map(c => (
          <div style="background:#fff; border:1px solid var(--color-border); border-radius:12px; padding:28px;">
            <h4 style="font-family:var(--font-heading); font-size:1.05rem; font-weight:700; letter-spacing:-0.01em; margin:0 0 10px;">{c.t}</h4>
            <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); line-height:1.55; margin:0;">{c.b}</p>
          </div>
        ))}
      </div>
      {payments.map(row => (
        <div style="display:grid; grid-template-columns:180px 1fr; gap:24px; align-items:center; padding:18px 0; border-top:1px solid var(--color-border);">
          <div style="display:flex; align-items:center; gap:10px; font-family:var(--font-heading); font-weight:700; font-size:0.95rem;">
            <span style="font-size:1.4rem;">{row.flag}</span> {row.country}
          </div>
          <div style="display:flex; flex-wrap:wrap; gap:8px;">
            {row.pills.map(p => (
              <span style="display:inline-block; font-family:var(--font-body); font-size:0.78rem; font-weight:600; background:#fff; border:1px solid var(--color-border); color:var(--color-text-primary); padding:5px 12px; border-radius:999px;">{p}</span>
            ))}
          </div>
        </div>
      ))}
      <div style="margin-top:56px; background:#000; color:#fff; border-radius:var(--radius-card); padding:48px 32px; text-align:center;">
        <div style="font-family:var(--font-heading); font-weight:900; font-size:clamp(3rem,6vw,5rem); letter-spacing:-0.04em; line-height:1;">50+</div>
        <div style="font-family:var(--font-body); font-size:1rem; font-weight:500; margin-top:10px; opacity:0.92;">pasarelas de pago integradas en LATAM y Europa</div>
      </div>
    </div>
  </section>

  <!-- FORM SECTION -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:80px; align-items:center;">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu plataforma</p>
