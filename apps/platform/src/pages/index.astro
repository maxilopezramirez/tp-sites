---
import Site from "../layouts/Site.astro";
import PaymentsSection from "../components/PaymentsSection.astro";

// ─── Logos cloud (clientes WL en vivo y tech proof) ───
const wlLogos = [
  { name: "Livepass", flag: "🇦🇷", tech: false },
  { name: "Autoentrada", flag: "🇦🇷", tech: false },
  { name: "Ticketea", flag: "🇵🇾", tech: false },
  { name: "La Maraka", flag: "🇲🇽", tech: false },
  { name: "Startickets", flag: "🇲🇽", tech: false },
  { name: "Pases Parques", flag: "🇨🇱", tech: false },
  { name: "FIFA U-20", flag: "🇨🇱", tech: true },
  { name: "AFA", flag: "🇦🇷", tech: true },
];

// ─── Platform capabilities (4 ejes consolidados) ───
const capabilities = [
  {
    title: "Marca",
    body: "Dominio propio, app con tu marca, checkout end-to-end. El cliente siempre ve tu marca.",
    iconPath: "M12 2L3 7v6c0 5 3.8 9.4 9 10 5.2-.6 9-5 9-10V7l-9-5z",
  },
  {
    title: "Economía",
    body: "Recaudación directa a tu cuenta, SaaS predecible sin take-rate, data exportable.",
    iconPath: "M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6",
  },
  {
    title: "Escala",
    body: "Multi-país, multi-currency, compliance nativo en 4 jurisdicciones. 1K a 1M tickets/año mismo stack.",
    iconPath: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20",
  },
  {
    title: "API disponible",
    body: "REST, webhooks y SDKs. Sandbox sin tarjeta. Headless si quieres construir tu propio frontend.",
    iconPath: "M16 18l6-6-6-6M8 6l-6 6 6 6",
  },
];

// ─── Deep dive narrative blocks ───
const deepDive = [
  {
    eyebrow: "Marca",
    title: "El cliente siempre ve tu marca.",
    body: "Tu dominio (tumarca.com), tu identidad visual, tu checkout. Ticketplus opera la infraestructura debajo. Sin co-branding, sin \"powered by\".",
    visual: "browser",
    reverse: false,
    features: [
      {
        n: "01",
        title: "Dominio propio y checkout white-label end-to-end",
        body: "Tu dominio (tumarca.com o tickets.tumarca.com), certificado SSL gestionado, emails transaccionales desde tu dominio (DKIM/SPF). Checkout, tickets PDF, confirmaciones y reminders 100% bajo tu identidad visual. El cliente siempre ve tu marca.",
        badge: "Diferenciador clave vs Full Op",
      },
      {
        n: "02",
        title: "App iOS y Android publicada bajo tu cuenta",
        body: "App nativa publicada en App Store y Google Play bajo tu cuenta de desarrollador. Branding completo: ícono, splash, paleta, tipografías. Push notifications desde tu marca, deep linking a eventos y wallet integrado (Apple Wallet y Google Wallet).",
        badge: null,
      },
      {
        n: "03",
        title: "Tu data es tuya: exportable cuando quieras",
        body: "Acceso completo a la base de compradores con consentimiento, exportable en JSON o CSV vía API o panel. Sin contratos de permanencia. Si decides irte, te llevas tus eventos, tus compradores, tu histórico transaccional. La data no se queda secuestrada.",
        badge: "Cero permanencia obligatoria",
      },
    ],
  },
  {
    eyebrow: "Economía",
    title: "El dinero va a tu cuenta, no a terceros.",
    body: "Stripe Connect con cuenta propia. Comprador paga, dinero entra a tu cuenta bancaria, no a la de Ticketplus. Liquidación automática 48-72h. Sin float retenido, sin escrow opaco.",
    visual: "warm",
    reverse: true,
    features: [
      {
        n: "01",
        title: "Recaudación directa a tu cuenta",
        body: "Stripe Connect con cuenta propia. Liquidación 48-72h post-evento. Sin float retenido, sin cuentas escrow opacas. El comprador paga, el dinero entra a tu cuenta bancaria.",
        badge: null,
      },
      {
        n: "02",
        title: "Modelo SaaS predecible",
        body: "Fee mensual SaaS y fee por ticket vendido (transparente, sin sorpresas), en lugar de % sobre revenue total. Operación previsible para tu CFO: presupuestas el costo de plataforma, no compartes ingreso del evento.",
        badge: "Sin take rate",
      },
      {
        n: "03",
        title: "11 países, 11 monedas locales integradas",
        body: "Operamos en 11 países con sus medios de pago locales integrados, cada uno con su propia liquidación y compliance fiscal nativo.",
        badge: null,
        chips: [
          { flag: "🇨🇱", country: "Chile", currency: "CLP" },
          { flag: "🇦🇷", country: "Argentina", currency: "ARS" },
          { flag: "🇺🇾", country: "Uruguay", currency: "UYU" },
          { flag: "🇵🇾", country: "Paraguay", currency: "PYG" },
          { flag: "🇧🇷", country: "Brasil", currency: "BRL" },
          { flag: "🇨🇴", country: "Colombia", currency: "COP" },
          { flag: "🇲🇽", country: "México", currency: "MXN" },
          { flag: "🇵🇪", country: "Perú", currency: "PEN" },
          { flag: "🇧🇴", country: "Bolivia", currency: "BOB" },
          { flag: "🇪🇸", country: "España", currency: "EUR" },
          { flag: "🇩🇴", country: "Rep. Dominicana", currency: "DOP" },
        ],
      },
    ],
  },
  {
    eyebrow: "Escala",
    title: "Una plataforma internacional, lista para cada mercado.",
    body: "Infraestructura diseñada para operar en múltiples países simultáneamente, con la fiscalidad, las monedas y los medios de pago locales resueltos por defecto. Lanzá en un mercado nuevo sin contadores locales, sin re-arquitectura, sin migración.",
    visual: "flags",
    reverse: false,
    features: [
      {
        n: "01",
        title: "Infraestructura de alta demanda",
        body: "El stack que opera un teatro de 200 butacas es el mismo que operó FIFA U-20 con +320K tickets en un día. No hay re-arquitectura cuando creces, no cambias de plan ni migras de base de datos. La plataforma escala, tu equipo no se queda atrás.",
        badge: "99.9% uptime",
      },
    ],
  },
  {
    eyebrow: "Hardware",
    title: "Compatible con el hardware que ya tenés.",
    body: "Si tu venue ya tiene infraestructura instalada, la reutilizamos. Si arrancás de cero, te damos la lista de hardware certificado por nivel de operación. Cero lock-in de proveedor.",
    visual: "warm",
    reverse: true,
    features: [
      {
        n: "01",
        title: "Hardware compatible · usa lo que ya tienes",
        body: "Compatibilidad nativa con impresoras Zebra, Honeywell, Verifone, Bixolon y Boca. Si tu venue ya tiene infraestructura, la reutilizas. Si arrancas de cero, te damos la lista de hardware certificado por nivel de operación. POS, tótems, lectores QR y validadores funcionan con tu plataforma WL.",
        badge: null,
      },
    ],
  },
];

// ─── Ecosistema clientes WL en vivo (6 plataformas) ───
const wlClients = [
  {
    name: "Livepass",
    flag: "🇦🇷",
    desc: "Entre las ticketeras más grandes de Argentina.",
    href: "https://livepass.com.ar",
  },
  {
    name: "Autoentrada",
    flag: "🇦🇷",
    desc: "Entre las ticketeras más grandes de Argentina.",
    href: "https://ventas.autoentrada.com",
  },
  {
    name: "Ticketea",
    flag: "🇵🇾",
    desc: "La principal ticketera de Paraguay.",
    href: "https://ticketea.com.py",
  },
  {
    name: "La Maraka",
    flag: "🇲🇽",
    desc: "Líder en entretenimiento en México.",
    href: "https://tickets.lamaraka.com.mx",
  },
  {
    name: "Startickets",
    flag: "🇲🇽",
    desc: "Tecnología de venta de entradas en México.",
    href: "https://startickets.com.mx",
  },
  {
    name: "Pases Parques",
    flag: "🇨🇱",
    desc: "Todos los parques nacionales de Chile se venden aquí.",
    href: "https://tickets.pasesparques.cl",
  },
];

// ─── Why TP cards ───
const whyCards = [
  { icon: "🛡️", title: "Plataforma probada", body: "FIFA U-20, +320K tickets/día, 99.9% uptime, 12 años iterando." },
  { icon: "🌎", title: "Compliance multi-país", body: "SII Chile, AFIP Argentina, DIAN Colombia, DNCP Paraguay nativos." },
  { icon: "📐", title: "Cero re-arquitectura", body: "Mismo stack 1K a 1M tickets/año. No migras de base de datos cuando creces." },
  { icon: "🔓", title: "Migration in / out", body: "Onboarding <4 semanas. Si decides irte, te llevas tu data. Cero permanencia." },
];

// ─── Para quién es WL (buyer-type segmentation) ───
const audience = [
  { icon: "🎪", title: "Productoras grandes", body: "Vas a construir plataforma propia o cambiar de proveedor. Quieres tu marca front-end y operación probada atrás." },
  { icon: "🏟️", title: "Venues / Arenas", body: "Ya tienes ticketing in-house pero pesa mantenerlo. Quieres conservar tu marca y delegar la infraestructura." },
  { icon: "🌐", title: "Ticketeras regionales", body: "Operas en un país o ciudad con marca consolidada. Necesitas core SaaS sin perder identidad ni clientes." },
  { icon: "⚽", title: "Equipos de fútbol", body: "Boletería propia, abonos socios, partido a partido, acreditación prensa, bajo tu marca de club." },
];

// ─── Cross-link comparativas ───
const compareLinks = [
  { label: "vs Palco4", href: "#" },
  { label: "vs Vivenu", href: "#" },
  { label: "vs Audience View", href: "#" },
  { label: "vs Build in-house", href: "#" },
];

// ─── FAQ reordenado por peso de objeción ───
const faqs = [
  {
    q: "¿Cuánto cuesta? ¿Es revenue share o SaaS fee?",
    a: "<strong>SaaS fee mensual y fee por ticket vendido</strong>: transparente, sin sorpresas, sin take rate sobre revenue. Tu CFO presupuesta el costo de plataforma como cualquier otro SaaS B2B (Stripe, AWS, Datadog). Cotización personalizada en menos de 24 horas hábiles.",
  },
  {
    q: "¿En qué se diferencia de Ticketplus Full Operation?",
    a: "Marca, dominio y cuenta propia. En Full Op el checkout vive en ticketplus.cl y la recaudación pasa por TP. En WL, el checkout vive en tu dominio y la recaudación va directa a tu cuenta. Full Op es para productores que quieren delegar TODO; WL es para empresas que quieren control de plataforma manteniendo su marca y data. <em>Booster (motor de marketing gestionado) sólo está disponible en Full Operation.</em>",
  },
  {
    q: "¿Quién es dueño de los datos? ¿Qué pasa si me voy?",
    a: "Vos. Los datos son tuyos, exportables en JSON / CSV / API cuando quieras. Si decides migrar a otro proveedor, te ayudamos a salir limpio: sin penalidades, sin cláusulas escondidas, sin bloqueo de cuenta. Ticketplus opera por valor entregado, no por lock-in.",
  },
  {
    q: "¿Hay sandbox antes de contratar?",
    a: "Sí, <strong>sandbox sin tarjeta desde el día 1</strong>. Tu equipo técnico prueba la plataforma, configura un evento de prueba, simula transacciones. Sin compromiso, sin trámites previos.",
  },
  {
    q: "¿Qué pasa con mi facturación en cada país?",
    a: "Compliance nativo en 4 mercados (Chile, Argentina, Colombia, Paraguay). Cada operación se factura en la jurisdicción correcta automáticamente. Para mercados fuera de los 4, agendamos discovery técnico antes de firmar: no comprometemos lo que no podemos cumplir.",
  },
  {
    q: "¿Puedo migrar mi data desde otra plataforma WL?",
    a: "Sí. Pipelines de migración acompañados desde Palco4, Vivenu, Tessitura, Eventbrite Pro y plataformas propias. Importamos compradores, transacciones, configuración de mapas. Operamos en paralelo durante la migración para no interrumpir ventas.",
  },
];

// ─── Hero grid placeholders (12 UI cards) ───
const heroGrid = Array.from({ length: 12 }, (_, i) => i);
---
<Site title="Ticketplus Whitelabel · El software de ticketing que pone tu marca al centro">

  <!-- ═══ 1. HERO ═══ -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Whitelabel SaaS · Plataforma de ticketing</p>
        <h1 class="biz-hero__title">El software de ticketing que pone <span class="accent">tu marca al centro.</span></h1>
        <p class="biz-hero__lead">La plataforma más flexible para ticketing en LATAM. Tu marca al centro: Ticketplus opera la infraestructura debajo. Control total sobre el front-end, la operación y la data.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Solicitar demo y sandbox →</a>
        </div>
      </div>
    </div>
  </header>

  <!-- ═══ 2. LOGOS CLOUD con auto-rotation ═══ -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Plataformas en vivo y proof tecnológico</p>
      <div class="logos-marquee">
        <div class="logos-marquee__track">
          {[...wlLogos, ...wlLogos].map(l => (
            <div class={`logo-tile-dark${l.tech ? ' logo-tile-dark--tech' : ''}`}>
              <span class="logo-tile-dark__name">{l.name} {l.flag}</span>
              {l.tech && <span class="logo-tile-dark__tag">operado con tecnología Ticketplus</span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 4. PLATFORM CAPABILITIES — 4 ejes ═══ -->
  <section class="capabilities" id="capabilities">
    <div class="container">
      <header class="capabilities__header">
        <span class="capabilities__eyebrow">Platform capabilities</span>
        <h2 class="capabilities__title">Tu negocio. En el centro.</h2>
        <p class="capabilities__lead">Cuatro ejes que cubren la decisión de plataforma de extremo a extremo.</p>
      </header>
      <div class="capabilities__grid">
        {capabilities.map(c => (
          <article class="capability-card">
            <span class="capability-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={c.iconPath} />
              </svg>
            </span>
            <h3 class="capability-card__title">{c.title}</h3>
            <p class="capability-card__body">{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 5. CAPAS · biz-scene style ═══ -->
  {deepDive.map((b, ci) => (
    <section class={`biz-scene ${ci % 2 === 0 ? 'biz-scene--light' : 'biz-scene--dark'}`} id={b.eyebrow.toLowerCase()}>
      <div class="container">
        <header class="biz-scene__header">
          <span class="biz-scene__eyebrow">{`0${ci + 1}`} · {b.eyebrow.toUpperCase()}</span>
          <h2 class="biz-scene__title">{b.title}</h2>
          <p class="biz-scene__lead">{b.body}</p>
        </header>
        <div class="biz-scene__rows">
          {b.features.map((f, fi) => (
            <article class={`scene-row ${fi % 2 === 1 ? 'scene-row--reverse' : ''}`}>
              <div class={`scene-row__stage scene-card__stage--p${ci}-${fi}`} aria-hidden="true">
                <span class="scene-card__chip">{f.n}</span>
              </div>
              <div class="scene-row__body">
                <h4 class="scene-row__title">{f.title}</h4>
                <p class="scene-row__text">{f.body}</p>
                {f.chips && (
                  <ul class="scene-row__chips">
                    {f.chips.map(c => (
                      <li class="scene-row__chip">
                        <span class="scene-row__chip-flag" aria-hidden="true">{c.flag}</span>
                        <span class="scene-row__chip-country">{c.country}</span>
                        <span class="scene-row__chip-sep" aria-hidden="true">·</span>
                        <span class="scene-row__chip-currency">{c.currency}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- ═══ 6. HEADLESS / API-FIRST DEDICADO ═══ -->
  <section class="api-section">
    <div class="container">
      <div class="api-section__grid">
        <div class="api-section__content">
          <span class="api-section__eyebrow">Para el equipo técnico</span>
          <h2 class="api-section__title">API disponible, headless ticketing.</h2>
          <p class="api-section__body">REST API documentada con OpenAPI 3.0. Webhooks en tiempo real. SDKs Node.js. Sandbox sin tarjeta desde el día 1. Construye tu propio frontend, integra con tu stack, modifica el flujo de checkout: todo desde API.</p>
          <div class="api-section__ctas">
            <a href="#" class="btn btn--primary">Ver docs API →</a>
            <a href="#contacto" class="btn btn--ghost">Sandbox sin tarjeta →</a>
          </div>
        </div>
        <div class="api-section__code-wrap" aria-hidden="true">
          <div class="api-section__code-chrome">
            <span class="api-section__code-dot"></span>
            <span class="api-section__code-dot"></span>
            <span class="api-section__code-dot"></span>
            <span class="api-section__code-file">POST /v1/events</span>
          </div>
          <pre class="api-section__code"><code><span class="tok-cmd">curl</span> -X POST https://api.ticketplus.com/v1/events \
  -H <span class="tok-str">"Authorization: Bearer $TOKEN"</span> \
  -H <span class="tok-str">"Content-Type: application/json"</span> \
  -d <span class="tok-str">'&#123;
    "name": "Mi evento",
    "venue_id": "venue_abc123",
    "tickets": [
      &#123; "tier": "vip", "price": 25000 &#125;
    ]
  &#125;'</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 7. EQUIPO · CUENTA CON EL EQUIPO ═══ -->
  <section class="equipo" id="equipo">
    <div class="container">
      <header class="equipo__header">
        <span class="equipo__eyebrow">05 · CUENTA CON EL EQUIPO</span>
        <h2 class="equipo__title">Soporte técnico dedicado</h2>
        <p class="equipo__lead">Buscas soporte 24/7. Si algo falla en el drop, hablas con quien hizo el código, no con un L1.</p>
      </header>

      <div class="equipo__hero">
        <div class="equipo__stage" aria-hidden="true" />
        <div class="equipo__caption">
          <span class="equipo__caption-tag">01 · Soporte 24/7</span>
          <h3 class="equipo__caption-title">Canal de comunicación directo</h3>
          <p class="equipo__caption-body">Account manager dedicado por evento desde el primer día. WhatsApp directo pre-asignado 72h antes del drop. Soporte 24/7 con personas reales en español, cobertura fin de semana.</p>
          <span class="equipo__badge">Único en el mercado</span>
          <div class="equipo__cta">
            <a class="equipo__wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
              <svg class="equipo__wsp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              <span class="equipo__wsp-text">
                <span class="equipo__wsp-label">Escríbenos por</span>
                <span class="equipo__wsp-name">WhatsApp</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 8. PAGOS LATAM ═══ -->
  <PaymentsSection title="Profundidad regional.<br/>Integraciones locales desde el día 0." id="pagos">
    <div class="tp-payments__value-card">
      <h3 class="tp-payments__value-title">Pasarelas locales</h3>
      <p class="tp-payments__value-desc">Webpay, MercadoPago, Wompi, Bancard, Izipay y +40 más. Sin redirect, sin friction.</p>
    </div>
    <div class="tp-payments__value-card">
      <h3 class="tp-payments__value-title">Multi-país desde un panel</h3>
      <p class="tp-payments__value-desc">CL, AR, BR, CO, MX, PE, PY, UY, BO, ES, RD: un solo backoffice multi-país.</p>
    </div>
    <div class="tp-payments__value-card">
      <h3 class="tp-payments__value-title">Compliance regional</h3>
      <p class="tp-payments__value-desc">Impuestos, monedas, refunds, todo configurado por país. Tú eliges dónde operar.</p>
    </div>
  </PaymentsSection>

  <!-- ═══ 9. ECOSISTEMA DE CLIENTES WL ═══ -->
  <section class="wl-clients" id="clientes-wl">
    <div class="container">
      <header class="wl-clients__header">
        <span class="wl-clients__eyebrow">Plataforma probada en LATAM</span>
        <h2 class="wl-clients__title">Un ecosistema de productores, venues y marcas líderes que apuestan por nuestra tecnología SaaS / White Label.</h2>
      </header>
      <div class="wl-clients__grid">
        {wlClients.map(c => (
          <a class="wl-client-card" href={c.href} target="_blank" rel="noopener noreferrer">
            <div class="wl-client-card__head">
              <span class="wl-client-card__flag" aria-hidden="true">{c.flag}</span>
            </div>
            <h3 class="wl-client-card__name">{c.name}</h3>
            <p class="wl-client-card__desc">{c.desc}</p>
