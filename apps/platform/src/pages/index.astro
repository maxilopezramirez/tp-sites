  .deep-dive__visual--browser::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 36px;
    background: rgba(10,10,10,0.04);
    border-bottom: 1px solid rgba(10,10,10,0.06);
  }
  .deep-dive__visual--browser::after {
    content: '';
    position: absolute; top: 13px; left: 16px;
    width: 36px; height: 10px;
    background-image: radial-gradient(circle at 5px 5px, #ff5f57 4px, transparent 4px),
                      radial-gradient(circle at 17px 5px, #febc2e 4px, transparent 4px),
                      radial-gradient(circle at 29px 5px, #28c840 4px, transparent 4px);
