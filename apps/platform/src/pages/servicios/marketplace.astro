---
import Site from "../../layouts/Site.astro";
import BoosterPromo from "../../components/BoosterPromo.astro";

// 3 PALANCAS funcionales del funnel comercial: Captar / Convertir / Distribuir
const palancas = [
  {
    n: "01", tag: "PALANCA 01 · CAPTAR DEMANDA", dark: false, id: "captar",
    title: "Buscas que te encuentren sin pagar agencia.",
    lead: "Encuentras Discovery app + Booster + atribución del click al ticket. El fan no te busca a ti, te encuentras con él.",
    heroCount: 0,
    features: [
      { n: "01", title: "Atribución end-to-end del click al ticket", body: "GA4 + SEMrush + Meta Pixel + TikTok Pixel + GTM nativos. Cada peso de medios trackeado hasta el ticket vendido.", badge: "End-to-end attribution" },
      { n: "02", title: "Audience analytics propias del productor", body: "Demografía, intereses, lookalikes. La data vuelve al productor, no se queda en el silo de la agencia. Cero permanencia, exportable cuando quieras.", badge: null },
    ],
  },
  {
    n: "02", tag: "PALANCA 02 · CONVERTIR EL CARRITO", dark: true, id: "convertir",
    title: "Buscas que el fan que llega al sitio cierre.",
    lead: "Encuentras recommendation engine + email nativo + checkout >78%. El fan llega al sitio. Ahora hay que cerrar.",
    heroCount: 0,
    features: [
      { n: "01", title: "Recommendation engine en checkout", body: "Smart Showcase, cross-sell automático entre eventos del mismo organizador. Aumenta ticket promedio sin fricción.", badge: null },
      { n: "02", title: "Smart Email Marketing nativo", body: "65% apertura promedio. Sin servicio externo de mailing. Segmentación automática por comportamiento + tipo de evento + frecuencia.", badge: "65% tasa de apertura" },
      { n: "03", title: "Emails y SMS automáticos", body: "Recordatorios 24h/48h pre-evento, recuperación de carrito abandonado, reintentos de pago automáticos.", badge: null },
      { n: "04", title: "Checkout optimizado", body: "Conversion rate >78%, multi-currency CLP+USD, Apple Pay + Google Pay express, card saving, carrito persistente.", badge: ">78% conversion" },
    ],
  },
  {
    n: "03", tag: "PALANCA 03 · DISTRIBUIR VÍA RED PROPIA", dark: false, id: "distribuir",
    title: "Buscas que el ticket no termine en el primer comprador.",
    lead: "Encuentras secondary market + referrals + wallet + loyalty. El ticket no termina en el primer comprador.",
    heroCount: 0,
    features: [
      { n: "01", title: "Secondary market / re-venta dentro del ecosistema", body: "El revenue de la reventa vuelve al productor, no a una reventa externa.", badge: null },
      { n: "02", title: "Seller referrals con tracking individual", body: "Códigos por influencer, sponsor o partner. Widgets embebibles. Atribución end-to-end al ticket vendido.", badge: null },
      { n: "03", title: "Wallet de puntos con cross-benefits", body: "Puntos acumulables en eventos, gastables en F&B, merch o tickets futuros.", badge: null },
      { n: "04", title: "Loyalty programs y promociones automatizadas", body: "Smart Promotions con reglas propias, 2x1, cortesías con compra, clubes de fans.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · Captar", title: "Discovery en marketplace TP + Booster gestionado en Meta, Google y TikTok.", href: "#captar" },
  { tag: "02 · Convertir", title: "Recommendation engine + email nativo (65% apertura) + checkout >78% conversion.", href: "#convertir" },
  { tag: "03 · Distribuir", title: "Secondary market + seller referrals + wallet de puntos + loyalty.", href: "#distribuir" },
];

const whyCards = [
  { icon: "📈", title: "Booster gestionado incluido", body: "Operamos Meta + Google + TikTok sin costo extra." },
  { icon: "🔍", title: "Discovery en marketplace TP", body: "Tu evento aparece junto a otros sin canibalizar tu sitio." },
  { icon: "📊", title: "Atribución end-to-end", body: "La data vuelve al productor, no se queda en el silo de la agencia." },
  { icon: "💰", title: "Checkout >78% conversion", body: "Multi-currency, Apple Pay + Google Pay, carrito persistente." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "Booster con atribución al ticket en drops masivos, Discovery para descubrir el evento.", href: "/servicios/festivales" },
  { icon: "🎭", label: "Teatros", body: "Email automation para renovación de abonos, cross-sell entre obras de la temporada.", href: "/servicios/teatros" },
  { icon: "⚽", label: "Deportes", body: "Loyalty programs para socios, cross-benefits entre cuotas + entradas + merch.", href: "/servicios/deportes" },
  { icon: "💼", label: "Congresos", body: "Smart Email Marketing para audiencia C-level, referrals con sponsors.", href: "/servicios/conferencias" },
  { icon: "🎡", label: "Centros familiares", body: "Loyalty + wallet de puntos para familias recurrentes, retargeting de no-asistentes.", href: "/servicios/familiar" },
  { icon: "🎵", label: "Espectáculos", body: "Booster con multi-moneda CLP+USD para shows internacionales, atribución por preventa (fan club / banco / general).", href: "/servicios/espectaculo" },
];

const checklist = [
  "Booster gestionado incluido: sin costo extra",
  "Atribución end-to-end click al ticket",
  "Discovery app en marketplace TP",
  "Email marketing nativo (apertura 65%)",
  "Checkout >78% conversion rate",
  "Audience analytics propias del productor",
];

const faqs = [
  { q: "¿Booster tiene costo aparte?", a: "No. Booster está incluido en el cargo por servicio: sin costo de agencia, sin fee adicional. Tú defines el presupuesto de medios; nuestro equipo opera Meta, Google y TikTok. <strong>Único en el mercado</strong>: ninguna ticketera ofrece esto incluido." },
  { q: "¿Si vendo en mi sitio, también aparezco en el marketplace TP?", a: "Sí. Open architecture: vendes desde tu sitio Y publicas en el marketplace TP, ambos sobre el mismo inventario. Sin canibalización (los datos lo confirman). Si prefieres solo tu sitio con whitelabel completo, también funciona: el marketplace es opcional." },
  { q: "¿Quién es dueño de la data de los compradores?", a: "El productor. Audience analytics propias, exportables cuando quieras, sin contrato de permanencia. La data no se queda en el silo de Ticketplus ni de una agencia externa. Es tu base, vos decidís qué hacer con ella." },
  { q: "¿Cuál es la tasa de apertura del email nativo?", a: "65% en promedio, contra el ~20% típico de la industria. La razón: segmentación automática por comportamiento (qué compró antes, qué eventos vio sin comprar) + envío en horarios optimizados por base de datos. Sin servicio externo de mailing." },
  { q: "¿Cómo funcionan los referrals con influencers o sponsors?", a: "Cada influencer / sponsor recibe su código único + widget embebible para su sitio o redes. Cada ticket vendido por su código queda atribuido: sabes exactamente cuánto vendió cada partner. Liquidación automática si hay split por comisión." },
];
---
<Site title="Servicios Ticketplus · Marketplace · Vender más sin contratar agencia">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Marketplace · Vender más</p>
        <h1 class="biz-hero__title">La tecnología que vende tu evento, sin contratar agencia.</h1>
        <p class="biz-hero__lead">Discovery app en el marketplace Ticketplus, recommendation engine en checkout, email marketing nativo, Booster gestionado, secondary market, referrals y wallet de puntos. Cada canal mide ROAS por evento.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar Marketplace →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src="/scenes/hero-devices-v2.png" alt="Marketplace Ticketplus · Booster, Discovery, Checkout" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras que venden más con Ticketplus Marketplace.</p>
      <div class="logos-cloud__grid">
        {["FIFA U-20 🇨🇱","AFA 🇦🇷","Movistar Arena 🇨🇱","Lollapalooza 🇨🇱","Ñam Festival 🇨🇱","DG Medios 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LAS 3 PALANCAS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu funnel vive en tres palancas.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las activas según lo que tu venta necesite.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PALANCA 01 · CAPTAR DEMANDA -->
  {(() => {
    const p = palancas[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #1 · Booster gestionado -->
  <section class="booster-section" id="booster">
    <div class="container">
      <BoosterPromo variant="dark" />
    </div>
  </section>

  <!-- SPOTLIGHT ELEVADO #2 · Discovery app + marketplace TP -->
  <section class="spotlight spotlight--dark" id="discovery">
    <div class="container">
      <span class="spotlight__eyebrow">Único · Open architecture</span>
      <h2 class="spotlight__title">Buscas tráfico orgánico sin canibalizar tu sitio. Encuentras un marketplace que suma exposición, no la reemplaza.</h2>
      <p class="spotlight__body">Tu evento aparece junto a otros eventos en el marketplace Ticketplus. El fan descubre tu evento mientras navega por otros del mismo género o ciudad. Dos canales (tu sitio propio + marketplace TP) sobre un solo inventario centralizado. Open architecture: vendes desde tu web Y publicas en TP. Si prefieres solo tu sitio (whitelabel completo), también funciona.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Dos canales, un inventario</h4>
          <p class="spotlight-card__text">Tu sitio propio + marketplace TP comparten el mismo stock centralizado. Sin doble carga, sin desfases de inventario, sin overbooking entre canales.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Sin canibalización</h4>
          <p class="spotlight-card__text">Los datos lo confirman: el tráfico del marketplace TP suma, no resta, al de tu sitio propio. El fan descubre eventos que no buscaba activamente.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Whitelabel opcional</h4>
          <p class="spotlight-card__text">Si prefieres vender solo desde tu sitio con whitelabel completo, también funciona. El marketplace TP es opcional, no obligatorio. Open architecture real.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PALANCA 02 · CONVERTIR EL CARRITO -->
  {(() => {
    const p = palancas[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- PALANCA 03 · DISTRIBUIR VÍA RED PROPIA -->
  {(() => {
    const p = palancas[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">Tu próxima venta no depende de la agencia.</h2>
        <p class="tp-promise__body">Lunes 10am, tu evento está en preventa y vendiendo lento. Llamas. Nuestro equipo Booster ajusta creatives, audiencias y budget en el día. El lunes a la tarde el ROAS ya cambió. <strong>Eso es Ticketplus.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="/servicios/trust-service">Conocer Trust & service →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUÉ TICKETPLUS MARKETPLACE -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus Marketplace</span>
        <h2 class="why-tp__title">Lo que recibe tu venta al elegir Ticketplus.</h2>
        <p class="why-tp__lead">Booster + Discovery + Email + Checkout + Loyalty en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar Marketplace →</a>
      </div>
    </div>
  </section>

  <!-- CASOS POR INDUSTRIA (cross-link inverso a verticales) -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Casos por industria</span>
        <h2 class="verticals__title">Marketplace + Booster por tipo de evento.</h2>
        <p class="why-tp__lead">La capability comercial se aplica a cada vertical con sus particularidades.</p>
      </div>
      <div class="verticals__grid verticals__grid--rich">
        {industries.map((v) => (
          <a class="verticals__card verticals__card--link" href={v.href}>
            <div class="verticals__icon">{v.icon}</div>
            <div class="verticals__text">
              <h3 class="verticals__label">{v.label}</h3>
              <p class="verticals__body">{v.body}</p>
            </div>
            <span class="verticals__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de cómo vendes más</p>
          <h2 class="section__title">Buscas cotizar Marketplace + Booster + Loyalty. Encuentras un plan según volumen, tipo de evento y mix de canales.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar Marketplace</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Productora","text","Nombre de tu productora"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:20px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Eventos por año</label>
            <select style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;">
              <option>1-5</option>
              <option>5-20</option>
              <option>20-50</option>
              <option>+50</option>
            </select>
          </div>
          <button style="width:100%; background:var(--gradient-brand); color:#fff; padding:14px; border:none; border-radius:var(--radius-button); font-family:var(--font-heading); font-weight:700; font-size:15px; cursor:pointer;">Cotizar Marketplace →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#fff; padding:120px 0; border-top:1px solid var(--color-border);" id="faq">
    <div class="container" style="max-width:820px;">
      <div style="text-align:center; margin-bottom:56px;">
        <p class="section__eyebrow" style="color:var(--color-primary);">Preguntas frecuentes</p>
        <h2 class="section__title">Preguntas frecuentes.</h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq-item" open={i === 0}>
          <summary class="faq-item__head">
            <span>{f.q}</span><span class="chev" aria-hidden="true">+</span>
          </summary>
          <div class="faq-item__body">
            <p set:html={f.a} />
