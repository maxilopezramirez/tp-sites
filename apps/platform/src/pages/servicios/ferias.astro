---
import Site from "../../layouts/Site.astro";

// 3 momentos del ciclo de la feria (registro / operación / networking)
const moments = [
  {
    n: "01", tag: "EL REGISTRO", dark: false, id: "registro",
    title: "Buscas evitar la fila eterna del día uno.",
    lead: "Encuentras pre-acreditación online + badge térmico en segundos. 10.000 personas el primer día, expositores con stand a las 9am, prensa que llega tarde.",
    heroCount: 1,
    features: [
      { n: "01", title: "Pre-acreditación online con badge en segundos", body: "Impresora térmica integrada, badge en menos de 5 segundos. Cero fila de 40 min el día uno.", badge: "vs Eventbrite check-in básico", captionTag: "Badge en segundos" },
      { n: "02", title: "Forms de registro dinámicos por categoría", body: "Visitante, comprador pro, prensa, expositor. Cada categoría con sus campos, su QR y sus accesos.", badge: null, newGroup: true },
      { n: "03", title: "Cortesías masivas para sponsors y prensa", body: "QR único por persona, tracking de quién accedió y cuándo, reenvío de credencial en 1 clic.", badge: null },
    ],
  },
  {
    n: "02", tag: "LA FERIA EN OPERACIÓN", dark: true, id: "operacion",
    title: "Buscas que la feria multi-día corra sola.",
    lead: "Encuentras multi-puerta + POS + dashboard en vivo. Tu feria abre 4 días, con 8 puertas, 200 stands, 3 barras y un food court.",
    heroCount: 1,
    features: [
      { n: "01", title: "Multi-día con pase configurable", body: "Día suelto o pase 4 días con descuento. Combos por categoría de visitante.", badge: null, captionTag: "Pase multi-día" },
      { n: "02", title: "Control de acceso multi-puerta con sync", body: "8 puertas operando en paralelo con sync en tiempo real. Anti-doble ingreso, validación offline con auto-sync.", badge: "Multi-puerta con sync", newGroup: true },
      { n: "03", title: "POS y tótem autoatención para barras y food courts", body: "Inventario en tiempo real entre canales, modo offline con cierre automático, cashless NFC en pulsera o credencial.", badge: null },
      { n: "04", title: "Dashboard de aforo y tráfico en vivo", body: "Aforo por puerta, por día, por sector. Sabés ocupación de cada zona en tiempo real.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL NETWORKING", dark: false, id: "networking",
    title: "Buscas que el expositor renueve el próximo año.",
    lead: "Encuentras captura de leads + reportes de ROI por stand. Una feria sin networking es una expo de stands sin propósito.",
    heroCount: 0,
    features: [
      { n: "01", title: "Captura de leads por expositor", body: "Escaneo de badge → nombre + empresa + email + intereses → CRM del expositor. Cada conversación se convierte en lead calificado.", badge: null },
      { n: "02", title: "Reportes de tráfico por stand para sponsors", body: "Visitantes, leads, tiempo en stand, perfil de visitante. ROI medible para que el expositor renueve el próximo año.", badge: "ROI medible por stand" },
      { n: "03", title: "Liquidación, settlements y soporte 24/7", body: "Stripe Connect con split por expositor, SII configurado, account manager dedicado el día del evento.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · El registro", title: "Acreditación pro en segundos para visitantes, expositores y prensa.", href: "#registro" },
  { tag: "02 · La feria en operación", title: "Multi-día, multi-puerta, multi-stand con POS y tótems en barras.", href: "#operacion" },
  { tag: "03 · El networking", title: "Netlink app + reportes de tráfico por stand + ROI medible para sponsor.", href: "#networking" },
];

const whyCards = [
  { icon: "🪪", title: "Badge en segundos", body: "Pre-acreditación online + impresión térmica. Cero fila de 40 min el día uno." },
  { icon: "🏪", title: "Exhibitor management", body: "Stands gestionan su propio staff sin pasar por la productora." },
  { icon: "🤝", title: "Netlink + ROI", body: "App de networking 1-a-1 y reporte de tráfico por stand." },
  { icon: "💰", title: "Sin costos ocultos", body: "Tecnología, staff, impresoras de badge, soporte: todo incluido en el cargo." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Impresoras de badge incluidas",
  "Netlink networking app sin costo extra",
  "Exhibitor management para stands",
  "Capacitación a equipo de stand y operaciones",
  "Onboarding completo en 4-6 semanas",
  "Account manager dedicado el día del evento",
];

const faqs = [
  { q: "¿Cómo evito que se forme una fila de 40 minutos el día uno con 10.000 personas en 2 horas?", a: "Pre-acreditación online + impresoras térmicas en puerta. La gran mayoría llega con su QR y solo retira el badge físico (5 segundos). Solo los que olvidaron registrarse pasan por mostrador. Probado en ferias con +10K visitantes en el peak." },
  { q: "¿Realmente puedo manejar 200 stands sin Excel a la productora?", a: "Sí. Exhibitor management. Cada stand tiene su login, sube su staff por Excel y emite sus credenciales con tu marca. Tú configuras cuántas credenciales puede emitir cada stand según su contrato. La productora deja de ser secretaria de los expositores." },
  { q: "¿Cómo coordino 8 puertas con sync entre todas?", a: "Cada puerta opera con app de validación QR conectada al mismo backend. Sync en tiempo real, anti-doble ingreso entre puertas, modo offline con auto-sync al reconectar. Aforo en vivo desde el dashboard." },
  { q: "¿Vale la pena POS + tótem para ferias gastronómicas?", a: "Honestamente, depende del tamaño. Para ferias con +5.000 visitantes y +3 barras paralelas: sí, reduce filas y aumenta consumo promedio 18-25%. Para ferias <2.000 visitantes con 1-2 barras: POS móvil basta, el tótem no compensa el costo de instalación." },
  { q: "¿Qué le entrego al expositor para que renueve el próximo año?", a: "Reporte ROI por stand: visitantes que pasaron por su zona, leads capturados, tiempo promedio en stand, perfil demográfico de su tráfico. El expositor recibe la cifra concreta para justificar a su gerencia la renovación del próximo año." },
];
---
<Site title="Servicios Ticketplus · Ferias y expos · Tecnología del registro al networking">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Ferias y expos</p>
        <h1 class="biz-hero__title">La tecnología que opera tu feria, del registro al networking.</h1>
        <p class="biz-hero__lead">Para ferias gastronómicas, cerveza, diseño, libros y expos multi-día. Acreditación pro en segundos, exhibitor management, control multi-puerta, Netlink networking app y POS + tótem en barras y food courts.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi feria →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src="/verticals/vertical-ferias.jpg" alt="Feria operada con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Ferias y expos que operan con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Ñam Festival 🇨🇱","Feria del Libro 🇨🇱","FIDAE 🇨🇱","FILSA 🇨🇱","Expo Gastronómica 🇨🇱","Vinifera 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu feria vive tres frentes.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las herramientas se activan según los necesites.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · EL REGISTRO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #1 · Exhibitor management -->
  <section class="spotlight spotlight--brand" id="exhibitor">
    <div class="container">
      <span class="spotlight__eyebrow">Único · Sin Excel a la productora</span>
      <h2 class="spotlight__title">Buscas que los 200 stands dejen de mandarte Excel. Encuentras un panel donde cada expositor genera sus propias credenciales.</h2>
      <p class="spotlight__body">Cada stand recibe su login, sube su staff por Excel y emite sus credenciales con tu marca. Configuras cuántas credenciales puede emitir cada stand según su contrato. Sub-stands de marcas representadas con permisos delegados. La productora deja de ser secretaria de los expositores.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Login por stand</h4>
          <p class="spotlight-card__text">Cada expositor con su acceso independiente. Sube staff, edita roles, emite credenciales sin pasar por la productora.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Credenciales con tu marca</h4>
          <p class="spotlight-card__text">Badge térmico con identidad de la feria. El expositor opera dentro de tu marca, no de la suya.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Permisos delegados a sub-stands</h4>
          <p class="spotlight-card__text">Marcas representadas con sub-cuentas y cupos configurables. Jerarquía clara, control granular.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 02 · LA FERIA EN OPERACIÓN -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- MOMENTO 03 · EL NETWORKING -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #2 · Netlink networking app -->
  <section class="spotlight spotlight--dark" id="netlink">
    <div class="container">
      <span class="spotlight__eyebrow">Único en CL · App nativa</span>
      <h2 class="spotlight__title">Buscas que la feria deje de ser solo recorrido de stands. Encuentras una plataforma de negocios.</h2>
      <p class="spotlight__body">App móvil donde visitantes y expositores se encuentran, agendan reuniones 1-a-1 con franjas horarias, chatean en privado, intercambian contacto. Útil para ferias B2B y expos sectoriales. La feria se convierte en plataforma de negocios, no en evento de un día.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Reuniones 1-a-1 con agenda</h4>
          <p class="spotlight-card__text">Franjas horarias configurables, confirmación bidireccional, recordatorios push. El networking deja de ser azar de pasillo.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Chat privado entre asistentes</h4>
          <p class="spotlight-card__text">Mensajería directa entre visitantes y expositores, sin compartir email ni teléfono. Conversaciones que continúan post-feria.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Matchmaking comercial</h4>
          <p class="spotlight-card__text">Recomendaciones de contactos relevantes según intereses, industria y objetivo declarado. La app conecta a quien sí importa.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">El primer día no estás solo.</h2>
        <p class="tp-promise__body">Jueves 11am, 8 puertas con fila, impresoras de badge trabadas, expositores reclamando staff. Llamas. Nosotros respondemos. Si hace falta, vamos a la feria. <strong>Eso es Ticketplus.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="#contacto">Conocer plan con soporte presencial →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu feria al elegir Ticketplus.</h2>
        <p class="why-tp__lead">Acreditación + exhibitor management + networking + POS en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi feria →</a>
      </div>
    </div>
  </section>

  <!-- VERTICALES -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Verticales</span>
        <h2 class="verticals__title">Funciona para tu tipo de evento.</h2>
      </div>
      <div class="verticals__grid">
        {verticals.map((v) => (
          <article class="verticals__card">
            <div class="verticals__icon">{v.icon}</div>
            <h3 class="verticals__label">{v.label}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu próxima feria</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu tipo de feria, duración y volumen de expositores.</h2>
