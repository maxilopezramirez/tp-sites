---
import Site from "../../layouts/Site.astro";

// 3 caras del Trust: Compromisos / Operación / Salida limpia
const caras = [
  {
    n: "01", tag: "CARA 01 · COMPROMISOS", dark: false, id: "compromisos",
    title: "Buscas garantías firmadas, no slides.",
    lead: "Encuentras SLA con penalidades + alta disponibilidad + innovación sin saltos de precio. Lo que está en el contrato, no en la página de \"cómo trabajamos\". Penalidades reales si fallamos.",
    features: [
      { n: "01", title: "Infraestructura de alta disponibilidad", body: "Multi-zona, replicación en caliente, auto-scaling probado en drops de +320K tickets.", badge: null },
      { n: "02", title: "Innovación continua, sin saltos de precio", body: "Nuevos features en tu plan, sin \"tarifa nueva\", roadmap público trimestral.", badge: null },
      { n: "03", title: "Compromiso de continuidad", body: "+12 años operando, 11 países, sin pivots, sin \"rebrand a partir de junio\".", badge: "+12 años · 11 países" },
    ],
  },
  {
    n: "02", tag: "CARA 02 · OPERACIÓN", dark: true, id: "operacion",
    title: "Buscas que cuando llamás atienda una persona.",
    lead: "Encuentras AM dedicado por nombre + soporte 24/7 humano + staff en sala. Sin \"tu ticket es importante para nosotros, será atendido en 48 a 72h\".",
    features: [
      { n: "01", title: "Soporte 24/7 con humanos", body: "WhatsApp, email, teléfono, escalamiento directo a ingeniería.", badge: "vs Eventbrite chatbot" },
      { n: "02", title: "Account manager dedicado por cliente", body: "Persona con nombre, response time <2h, briefings pre-evento, conoce tu calendario.", badge: null },
      { n: "03", title: "Staff Ticketplus en terreno el día del evento", body: "Validación, POS, acreditación, monitoreo, briefing 30min antes, reporte post-evento 24h.", badge: null },
    ],
  },
  {
    n: "03", tag: "CARA 03 · SALIDA LIMPIA", dark: false, id: "salida",
    title: "Buscas no quedar atado al proveedor.",
    lead: "Encuentras data portable + migración limpia hacia afuera + cero permanencia. Si algún día decides migrar a otro proveedor, nosotros mismos te ayudamos a salir.",
    features: [
      { n: "01", title: "Portabilidad total de tu data", body: "JSON, CSV, SQL dump, API con OAuth. Compradores + transacciones + asistentes + configuración.", badge: null },
      { n: "02", title: "Migration support · entrada", body: "Te llevamos desde Welcu, Passline, Eventbrite, Excel o sistema propio en 2-4 semanas.", badge: null },
      { n: "03", title: "Sin contrato de permanencia", body: "Cobramos por venta, si dejas de vender no pagas. Sin mínimos mensuales, sin licencias anuales.", badge: "Sin permanencia obligatoria" },
    ],
  },
];

const overview = [
  { tag: "01 · Compromisos", title: "Garantías firmadas, no marketing. SLA con penalidades económicas reales.", href: "#compromisos" },
  { tag: "02 · Operación", title: "Personas reales, no chatbots. AM con tu WhatsApp + soporte 24/7 humano.", href: "#operacion" },
  { tag: "03 · Salida limpia", title: "Sin permanencia obligatoria. Tu data es tuya, migración hacia adentro y hacia afuera.", href: "#salida" },
];

const slaOptions = [
  { icon: "🚨", label: "Que se caiga el sitio el día del drop" },
  { icon: "📞", label: "No tener a quién llamar un sábado 9pm" },
  { icon: "🔒", label: "Quedar atado sin poder migrar" },
  { icon: "🤖", label: "Soporte chatbot que no resuelve" },
  { icon: "📅", label: "Continuidad del servicio largo plazo" },
];

const whyCards = [
  { icon: "📜", title: "SLA por contrato", body: "99.95% uptime en horarios críticos con penalidad económica automática." },
  { icon: "📞", title: "AM con tu WhatsApp", body: "Persona dedicada, response <2h, conoce tu calendario, equipo e historial." },
  { icon: "🚪", title: "Salida sin candado", body: "Data exportable en JSON / CSV / API. Te ayudamos a migrar si decides cambiar." },
  { icon: "📅", title: "+12 años operando", body: "11 países, eventos de +320K tickets, ciclos económicos completos." },
];

const industries = [
  { icon: "🎪", label: "Festivales", body: "SLA con war room para drops masivos + ingenieros TP asignados durante el lanzamiento.", href: "/servicios/festivales" },
  { icon: "🎵", label: "Espectáculos internacionales", body: "SLA con penalidades para on-sales de 50K en 5 min + AM 24/7 multi-moneda.", href: "/servicios/espectaculo" },
  { icon: "⚽", label: "Deportes", body: "AM dedicado durante toda la temporada + continuidad +12 años para federaciones / ligas.", href: "/servicios/deportes" },
  { icon: "🎭", label: "Teatros", body: "AM por temporada cultural + migration support entrada desde Welcu / Eventbrite.", href: "/servicios/teatros" },
  { icon: "💼", label: "Congresos / Corporativos", body: "SLA firmado + portabilidad de data corporate (legal / compliance).", href: "/servicios/conferencias" },
  { icon: "🎡", label: "Centros familiares", body: "Soporte 24/7 con cobertura fin de semana (80% de eventos son sábado / domingo).", href: "/servicios/familiar" },
  { icon: "🎪", label: "Ferias", body: "Migration support entrada desde sistema propio o Excel + capacitación a equipo de stand.", href: "/servicios/ferias" },
];

const checklist = [
  "SLA con penalidades económicas reales",
  "AM dedicado por cuenta: persona con nombre",
  "Soporte 24/7 humano por WhatsApp / email / teléfono",
  "Migración entrada y salida sin penalidad",
  "Data exportable en JSON / CSV / SQL / API",
  "Sin contrato de permanencia obligatoria",
];

const faqs = [
  { q: "¿Cuál es el SLA y qué pasa si no lo cumplen?", a: "99.95% uptime en horarios críticos (drops, días de evento). Si bajamos del SLA, <strong>crédito o devolución automática</strong> del cargo por servicio del mes en cuestión. Medido por monitor externo, no auto-reportado." },
  { q: "¿El soporte 24/7 es humano o chatbot?", a: "Humano, sin excepciones. WhatsApp, email, teléfono. Escalamiento directo a ingeniería si el caso lo requiere. Ningún ticket queda colgado \"será atendido en 48-72h\"." },
  { q: "¿Qué pasa si quiero migrar a otro proveedor en 2 años?", a: "Te ayudamos a salir limpio. Te entregamos tu data ordenada en el formato que pidas (JSON, CSV, SQL, API). <strong>Sin penalidades, sin cláusulas escondidas, sin bloqueo de cuenta.</strong> Lo hicimos antes." },
  { q: "¿Hay contrato de permanencia o mínimos mensuales?", a: "No. Cobramos por venta: si no vendes, no pagas. Sin licencias anuales, sin mínimos. La permanencia se gana con valor entregado, no con contrato leonino." },
  { q: "¿Quién es el account manager y cómo lo contacto?", a: "Asignación nominal post-contrato: recibes el nombre y WhatsApp directo del AM. Response time garantizado <2h. Briefings pre-evento, conoce tu calendario, equipo e historial." },
];
---
<Site title="Servicios Ticketplus · Trust & Service · SLA firmado, AM dedicado, salida sin candado">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Trust & Service · Garantías Ticketplus</p>
        <h1 class="biz-hero__title">La tecnología que firma garantías, no slides.</h1>
        <p class="biz-hero__lead">SLA de uptime con penalidades económicas, account manager dedicado por nombre, soporte 24/7 humano y migration support entrada y salida sin candado. Compromisos por contrato, no por slide.</p>
        <div class="biz-hero__ctas">
          <a href="#sla-block" class="btn btn--primary">Ver mi SLA específico →</a>
          <a href="#compromisos" class="btn btn--ghost">Ver compromisos</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <div class="biz-hero__placeholder" aria-hidden="true">
          <div class="biz-hero__placeholder-glow"></div>
          <div class="biz-hero__placeholder-grid">
            <div class="ph-tile ph-tile--big">
              <span class="ph-label">Uptime garantizado</span>
              <span class="ph-value">99.95%</span>
              <span class="ph-delta">SLA por contrato</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Response AM</span>
              <span class="ph-value">&lt;2h</span>
            </div>
            <div class="ph-tile">
              <span class="ph-label">Continuidad</span>
              <span class="ph-value">+12a</span>
            </div>
            <div class="ph-tile ph-tile--wide">
              <span class="ph-label">Compromisos firmados</span>
              <div class="ph-bars">
                <span style="height:88%"></span>
                <span style="height:92%"></span>
                <span style="height:76%"></span>
                <span style="height:96%"></span>
                <span style="height:84%"></span>
                <span style="height:90%"></span>
                <span style="height:82%"></span>
                <span style="height:94%"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- SLA SUB-BLOCK (único de esta página) -->
  <section class="demo-block" id="sla-block">
    <div class="demo-block__glow" aria-hidden="true"></div>
    <div class="container">
      <div class="demo-block__head">
        <span class="demo-block__eyebrow">SLA + AM dedicado en 24h</span>
        <h2 class="demo-block__title">Te enviamos el documento de SLA con tus condiciones específicas.</h2>
        <p class="demo-block__sub">¿Qué te preocupa más?</p>
      </div>
      <div class="demo-block__grid">
        {slaOptions.map(opt => (
          <a class="demo-chip" href="#contacto">
            <span class="demo-chip__icon">{opt.icon}</span>
            <span class="demo-chip__label">{opt.label}</span>
          </a>
        ))}
      </div>
      <div class="demo-block__cta">
        <a href="#contacto" class="btn btn--primary">Quiero mi SLA →</a>
      </div>
    </div>
  </section>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productores con SLA activo con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["FIFA U-20 🇨🇱","AFA 🇦🇷","Movistar Arena 🇨🇱","Teatro UC 🇨🇱","CONAF 🇨🇱","U. Católica 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- BRIDGE / TESIS (excepción mantenida del wireframe) -->
  <section class="bridge">
    <div class="container">
      <span class="bridge__eyebrow">+12 años firmando garantías en LATAM</span>
      <h2 class="bridge__title">El proveedor no es el contrato. Es lo que pasa cuando algo falla.</h2>
      <p class="bridge__sub">Migrar de plataforma da miedo. Por eso firmamos garantías que los demás solo prometen.</p>
    </div>
  </section>

  <!-- OVERVIEW DE LAS 3 CARAS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">La relación con tu proveedor vive en 3 caras.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Cada una cubre una preocupación distinta.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver cara →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CARA 01 · COMPROMISOS -->
  {(() => {
    const p = caras[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #1 · SLA con penalidades económicas reales -->
  <section class="spotlight spotlight--brand" id="sla">
    <div class="container">
      <span class="spotlight__eyebrow">Único · vs Welcu / Eventbrite / Passline (SLA aspiracionales sin enforcement)</span>
      <h2 class="spotlight__title">Buscas un SLA con penalidades reales, no una promesa en slide. Encuentras crédito o devolución automática si bajamos del uptime garantizado.</h2>
      <p class="spotlight__body">Uptime garantizado del 99.95% en horarios críticos (drops, días de evento). Si bajamos del SLA, hay penalidad económica automática expresada como crédito o devolución de cargo por servicio. Reporte mensual del uptime medido por monitor externo, no auto-reportado. Cláusula en contrato, no slide de venta.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">99.95% uptime garantizado</h4>
          <p class="spotlight-card__text">Uptime garantizado en horarios críticos: drops, días de evento, on-sales masivos. La ventana donde el sitio no se puede caer.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Penalidad económica automática</h4>
          <p class="spotlight-card__text">Si bajamos del SLA, crédito o devolución automática del cargo por servicio del mes. No hay que reclamar, se aplica solo.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Monitor externo, no auto-reportado</h4>
          <p class="spotlight-card__text">El uptime lo mide un monitor externo independiente, no nosotros mismos. Reporte mensual auditable. Cláusula en contrato, no slide.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- CARA 02 · OPERACIÓN -->
  {(() => {
    const p = caras[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- CARA 03 · SALIDA LIMPIA -->
  {(() => {
    const p = caras[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT ELEVADO #2 · Migration support salida sin candado -->
  <section class="spotlight spotlight--dark" id="migration-out">
    <div class="container">
      <span class="spotlight__eyebrow">Único LATAM</span>
      <h2 class="spotlight__title">Buscas saber que si algún día te vas, podés irte limpio. Encuentras un partner que te ayuda a salir sin penalidades.</h2>
      <p class="spotlight__body">Si algún día decides migrar a otro proveedor, te entregamos tu data ordenada en el formato que pidas. Sin penalidades, sin cláusulas escondidas, sin "te bloqueamos la cuenta hasta pagar X". Lo hicimos antes, lo hacemos limpio. Ticketplus opera por valor entregado, no por contrato leonino.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Cero penalidades de salida</h4>
          <p class="spotlight-card__text">Sin cláusulas escondidas, sin bloqueo de cuenta, sin "te cobramos X por irte". Si decidís migrar, te vas sin costo extra.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Data ordenada en formato que pidas</h4>
          <p class="spotlight-card__text">JSON, CSV, SQL dump, API con OAuth. Compradores, transacciones, asistentes y configuración. Tu data es tuya, completa y limpia.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Lo hicimos antes, lo hacemos limpio</h4>
          <p class="spotlight-card__text">No es promesa de marketing. Ya ayudamos a clientes a salir hacia otros proveedores. Ticketplus opera por valor entregado, no por contrato leonino.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">Sábado 8pm tu sitio falla. Llamas. Atendemos.</h2>
        <p class="tp-promise__body">Si hace falta, vamos al venue en persona. El SLA está firmado, el AM tiene tu WhatsApp, ingeniería tiene tu evento pre-cargado y el equipo en sala ya está briefeado. <strong>Eso es Trust & Service.</strong></p>
        <p class="tp-promise__signature">Firma con un proveedor que firma de vuelta.</p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="#contacto">Ver plan con soporte presencial →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUÉ TICKETPLUS TRUST -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus Trust</span>
        <h2 class="why-tp__title">Lo que firmas cuando contratas Ticketplus.</h2>
        <p class="why-tp__lead">Compromisos medibles, ejecutables y exigibles. Sin letra chica que te bloquea cuando más necesitas respuesta.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Pedir mi SLA específico →</a>
      </div>
    </div>
  </section>

  <!-- CASOS POR INDUSTRIA -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Casos por industria</span>
