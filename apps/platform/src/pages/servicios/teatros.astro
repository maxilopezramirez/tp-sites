---
import Site from "../../layouts/Site.astro";
import AppManagerHero from "../../components/AppManagerHero.astro";

// 3 momentos del ciclo del teatro (planificación / temporada / cierre)
const moments = [
  {
    n: "01", tag: "PLANIFICACIÓN", dark: false, id: "planificacion",
    title: "Buscas armar tu cartelera.",
    lead: "Encuentras los pasos para llegar al on-sale con todo listo.",
    heroCount: 1,
    features: [
      { n: "01", title: "Gestión de temporadas", body: "Obras, horarios, salas, compañías. Configura toda la temporada en una vista única.", badge: null, captionTag: "Cartelera" },
      { n: "02", title: "Pricing por función, sector y obra", body: "Precios distintos por función, sector y obra. Promociones por día, descuentos por horario.", badge: null, newGroup: true },
      { n: "03", title: "Configuración de abonos, bundles y pase de temporada", body: "Define abonos de temporada, bundles por categoría y pases multi-evento. Reglas claras de canje y caducidad.", badge: null },
    ],
  },
  {
    n: "02", tag: "TEMPORADA DE FUNCIONES", dark: true, id: "temporada",
    title: "Buscas vender la temporada.",
    lead: "Encuentras abono y función individual en el mismo flujo. La temporada se vende como mezcla: abonados que toman su butaca para todo el año + público que compra función a función.",
    heroCount: 1,
    features: [
      { n: "01", title: "Venta online: abonos + función individual en un mismo carrito", body: "El abonado paga su temporada y el comprador casual su entrada en un solo flujo de checkout.", badge: "Mismo inventario", captionTag: "Checkout unificado" },
      { n: "02", title: "Promo codes por obra y cross-sell entre obras", body: "Códigos únicos por obra, sponsor o medio. Cross-sell automático: el que compró una obra recibe el bundle de la siguiente.", badge: null, newGroup: true },
      { n: "03", title: "Validación en puerta y reportería en tiempo real", body: "App iOS + Android con validación QR <2s. Modo offline con auto-sync. Reportes de ocupación por función en vivo.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL CIERRE", dark: false, id: "cierre",
    title: "Buscas cerrar con la compañía.",
    lead: "Encuentras reportes listos para enviar firmados. Cada función tiene su cierre con la compañía. Cada temporada con el director artístico. Cada año con la junta.",
    heroCount: 0,
    features: [
      { n: "01", title: "Reporte de cierre por obra y por función", body: "Resumen automático con asistentes, ingresos, ocupación y cortesías. Listo para firmar y enviar a la compañía.", badge: null },
      { n: "02", title: "Settlements automáticos 48-72h + Stripe Connect", body: "Split automático teatro / compañía residente vía Stripe Connect. Liquidación 48-72h post-función.", badge: "Split automático" },
      { n: "03", title: "Dashboard de ocupación por temporada", body: "Curva de ocupación obra a obra, día de la semana y horario. Data para programar la próxima temporada.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · Planificación", title: "Arma la cartelera antes de abrir la venta.", href: "#planificacion" },
  { tag: "02 · Temporada de funciones", title: "Abonos, función a función y boletería en vivo.", href: "#temporada" },
  { tag: "03 · Cierre", title: "Reportes con la compañía, SII y cierre de ciclo.", href: "#cierre" },
];

const whyCards = [
  { icon: "🎭", title: "Interactive seat maps propios", body: "Modelamos tu sala una vez, butacas configurables por obra." },
  { icon: "🎟️", title: "Boletería híbrida", body: "Taquilla física y web sobre el mismo inventario." },
  { icon: "📑", title: "Reportes listos", body: "Cierre con compañía en minutos, no días." },
  { icon: "💰", title: "Sin costos ocultos", body: "Tecnología, staff y soporte incluido en el cargo por servicio." },
];

const verticals = [
  { icon: "🎪", label: "Festivales y conciertos" },
  { icon: "🎭", label: "Teatro y cultural" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Migración de abonados de tu plataforma actual",
  "Interactive seat maps modelados sin costo extra",
  "Capacitación a equipo de boletería",
  "Onboarding completo en 4-6 semanas",
  "Soporte 24/7 con account manager dedicado",
  "Sin contratos de permanencia",
];

const faqs = [
  { q: "¿Puedo migrar a mitad de temporada sin perder abonados?", a: "Sí. Migración asistida: importamos tu base de abonados, mapas de butacas y reglas de canje. Operamos en paralelo durante el cambio para no interrumpir la temporada en curso." },
  { q: "¿Cómo manejo cortesías de prensa y sponsors sin armar caos?", a: "Cortesías por lista, código único o invitación nominativa. Tracking de quién accedió y a qué función. Reportes separados de cortesía vs venta para cierre con compañía." },
  { q: "¿Tienen boletería física para venta presencial?", a: "Sí. POS, tótems con Interactive seat map, búsqueda por butaca o por nombre del comprador. Stock sincronizado con el sitio web en tiempo real." },
  { q: "¿Cómo hago el split de ingresos con la compañía residente?", a: "Stripe Connect: configuras el % de split por obra o por función. Liquidamos automáticamente a cada cuenta 48-72h después. Sin reconciliación manual." },
  { q: "¿Puedo manejar butaca asignada Y aforo libre en la misma sala?", a: "Sí. Configurás sectores con butaca asignada (platea, palcos) y sectores con aforo libre (galería de pie). Mismo mapa de venta, distinto modo de validación." },
];
---
<Site title="Servicios Ticketplus · Teatros — Operación completa para tu temporada cultural">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Teatros y temporadas culturales</p>
        <h1 class="biz-hero__title">La tecnología que opera tu temporada, función tras función.</h1>
        <p class="biz-hero__lead">Interactive seat maps, abonos multi-evento, boletería híbrida real (taquilla física + web sobre el mismo inventario) y reportes listos para enviar firmados.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi teatro →</a>
          <a href="#planificacion" class="btn btn--ghost">Ver capacidades</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src="/verticals/vertical-teatros.jpg" alt="Teatro operando una temporada con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Teatros y salas que operan con Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Teatro UC 🇨🇱","GAM 🇨🇱","Teatro Regional Rancagua 🇨🇱","Teatro Municipal Las Condes 🇨🇱","Aula Magna USACH 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu teatro vive en tres tiempos.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las herramientas se activan según los necesites.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · PLANIFICACIÓN -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT · Interactive Seat Maps propios -->
  <section class="spotlight spotlight--brand" id="seat-maps">
    <div class="container">
      <span class="spotlight__eyebrow">Único en Ticketplus</span>
      <h2 class="spotlight__title">Buscas un mapa de butacas. Encuentras una sala modelada una vez y reconfigurable para cada función de la temporada.</h2>
      <p class="spotlight__body">La misma butaca puede tener precio distinto por obra o estar bloqueada en funciones con escenografía especial. Modelado sin costo. Reutilizable obra tras obra.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Modelado sin costo</h4>
          <p class="spotlight-card__text">Modelamos tu sala completa (platea, palcos, galería) sin cargo extra en el onboarding. La inversión la pagamos nosotros.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Reconfigurable por obra</h4>
          <p class="spotlight-card__text">La misma butaca puede tener precio distinto por obra de la temporada. Sin duplicar mapas ni rehacer el setup.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Bloqueos por función</h4>
          <p class="spotlight-card__text">Bloquea filas por escenografía especial, técnica o accesibilidad. Reglas por función, no por sala completa.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 02 · TEMPORADA DE FUNCIONES -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT · Boletería híbrida real -->
  <section class="spotlight spotlight--dark" id="boleteria">
    <div class="container">
      <span class="spotlight__eyebrow">vs Welcu solo online</span>
      <h2 class="spotlight__title">Buscas vender online. Encuentras taquilla física + web sobre el mismo inventario.</h2>
      <p class="spotlight__body">La señora que llega 30 min antes a la boletería compra sobre el mismo inventario que el sitio web. POS, tótems con Interactive seat map, búsqueda por butaca o nombre. Cero butaca duplicada entre canales.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Mismo inventario</h4>
          <p class="spotlight-card__text">Cada butaca vendida en taquilla desaparece del web en tiempo real. Cero overbooking entre canales.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">POS + tótems con seat map</h4>
          <p class="spotlight-card__text">Los tótems muestran el Interactive seat map para que el público elija butaca presencialmente, igual que en el web.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Búsqueda por butaca o nombre</h4>
          <p class="spotlight-card__text">El boletero busca por sector, butaca o nombre del comprador. Reasignaciones y reimpresiones en segundos.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">La noche de estreno no estás solo.</h2>
        <p class="tp-promise__body">Sábado 8pm, sala llena, boletería congestionada con prensa que llegó tarde. Llamas. Nosotros respondemos. Si hace falta, vamos al teatro. <strong>Eso es Ticketplus.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="#contacto">Conocer plan con soporte presencial →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MOMENTO 03 · EL CIERRE -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          <AppManagerHero />

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu teatro al cambiarse a Ticketplus.</h2>
        <p class="why-tp__lead">No vendemos software. Operamos tu temporada completa con un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi teatro →</a>
      </div>
    </div>
  </section>

  <!-- VERTICALES (único de teatros) -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Verticales</span>
        <h2 class="verticals__title">Funciona para tu tipo de evento.</h2>
        <p class="verticals__lead">Configuración pre-armada por vertical, con casos de éxito documentados. Útil para centros culturales multi-disciplina que también operan conciertos, stand-up o presentaciones.</p>
      </div>
      <div class="verticals__grid">
        {verticals.map((v) => (
          <article class="verticals__card">
            <div class="verticals__icon">{v.icon}</div>
            <h3 class="verticals__label">{v.label}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu teatro</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu sala, cartelera y volumen de temporada.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
