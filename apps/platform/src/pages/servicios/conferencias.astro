---
import Site from "../../layouts/Site.astro";

// 3 momentos del ciclo del congreso (registro / evento / ROI)
const moments = [
  {
    n: "01", tag: "EL REGISTRO", dark: false, id: "registro",
    title: "Buscas registrar C-level, sponsors, prensa y ponentes con flows distintos.",
    lead: "Encuentras forms dinámicos + acreditación profesional + multi-moneda. Tu congreso registra ejecutivos C-level, sponsors, prensa especializada y staff. Cada uno con su flow, su badge y sus permisos.",
    heroCount: 0,
    features: [
      { n: "01", title: "Formularios de registro dinámicos por categoría", body: "Forms condicionales que cambian según la categoría seleccionada. Validación por RUT empresa, dominio corporativo o credencial de medio.", badge: "Forms condicionales · único en CL" },
      { n: "02", title: "Multi-moneda CLP + USD para ponentes internacionales", body: "Stripe Connect nativo. Cobro en CLP al fan local, en USD al asistente internacional, liquidación al ponente en USD a su cuenta extranjera. Compliance Banco Central Chile resuelto.", badge: null },
      { n: "03", title: "Exhibitor management para sponsors", body: "Panel propio por sponsor, credenciales con la marca del congreso, permisos delegados por paquete gold/silver/bronze.", badge: null },
    ],
  },
  {
    n: "02", tag: "EL DÍA DEL EVENTO", dark: true, id: "evento",
    title: "Buscas que el congreso sea plataforma de negocios, no auditorio de PowerPoint.",
    lead: "Encuentras Netlink + check-in por sesión + dashboards configurables. El cliente corporativo paga por el contenido, pero vuelve el próximo año por el networking.",
    heroCount: 0,
    features: [
      { n: "01", title: "Check-in QR por sesión", body: "Certificación de asistencia con QR único por sesión. Créditos de capacitación, engagement por charla, NPS opcional por sesión.", badge: null },
      { n: "02", title: "Dashboards configurables para el cliente", body: "White-label opcional con la marca del cliente (cámara, asociación gremial, corporativo). El sponsor ve su ROI con su logo, no el de la productora.", badge: "White-label opcional" },
      { n: "03", title: "Captura de leads por sponsor", body: "Escaneo de badge → nombre + empresa + email + intereses → CRM HubSpot / Salesforce / Pipedrive con opt-in. Cada conversación queda en el CRM del sponsor.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL ROI POST-EVENTO", dark: false, id: "roi",
    title: "Buscas justificar el presupuesto del próximo congreso.",
    lead: "Encuentras reportes por sponsor + engagement por sesión + liquidación 48-72h. El gerente comercial necesita números para defender el presupuesto del próximo año.",
    heroCount: 0,
    features: [
      { n: "01", title: "ROI por sponsor con cifras concretas", body: "Leads capturados, meetings 1-a-1 confirmados, tiempo en stand, perfil del visitante. El sponsor gold recibe el reporte que justifica renovar el próximo año.", badge: "Reporte por sponsor" },
      { n: "02", title: "Engagement por sesión y por ponente", body: "Asistencia, permanencia, NPS por sesión opcional. Identificas qué charlas convocaron y cuáles no: data para programar el próximo año.", badge: null },
      { n: "03", title: "Liquidación 48-72h y facturación SII", body: "Stripe Connect con split por sponsor o ponente. Facturación electrónica SII configurada. Cero reconciliación manual.", badge: null },
      { n: "04", title: "Soporte 24/7 con account manager dedicado", body: "Mismo equipo que operó el evento, disponible para post-mortem y planificación del próximo año.", badge: "vs Eventbrite chatbot" },
    ],
  },
];

const overview = [
  { tag: "01 · El registro", title: "Forms dinámicos por categoría + acreditación profesional con foto.", href: "#registro" },
  { tag: "02 · El día del evento", title: "Netlink networking 1-a-1 + check-in por sesión + dashboards white-label.", href: "#evento" },
  { tag: "03 · El ROI post-evento", title: "Reportes por sponsor + engagement por sesión + liquidación 48-72h.", href: "#roi" },
];

const whyCards = [
  { icon: "🪪", title: "Acreditación profesional", body: "Foto + QR + credencial impresa con cordón por categoría." },
  { icon: "🤝", title: "Netlink B2B", body: "App de meetings 1-a-1 que convierte tu congreso en plataforma de negocios real." },
  { icon: "📊", title: "ROI medible", body: "Reportes por sponsor, por sesión, por sala. Renovación con datos concretos." },
  { icon: "💰", title: "Sin costos ocultos", body: "Acreditación + Netlink + dashboards + soporte incluidos en el cargo." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Forms dinámicos por categoría sin licencia extra",
  "Netlink networking app incluido",
  "Dashboards white-label para tus sponsors",
  "Multi-moneda CLP + USD para ponentes internacionales",
  "Acreditación profesional con foto + cordón",
  "Onboarding completo en 4-8 semanas",
];

const faqs = [
  { q: "¿Cómo manejo tarifas distintas por categoría (socio, no socio, prensa, sponsor, C-level)?", a: "Forms condicionales. Cada categoría con sus campos, su tarifa y sus validaciones. Validación automática por RUT empresa para socios de la cámara, dominio corporativo para empresas adheridas, credencial de medio para prensa." },
  { q: "¿Puedo mostrar el dashboard con la marca de mi cliente, no la mía?", a: "Sí. Dashboard white-label opcional con el logo y colores del cliente (cámara, asociación gremial, corporativo). El sponsor ve su ROI con su marca, no con la de la productora." },
  { q: "¿Netlink funciona si mi audiencia es C-level que no instala apps?", a: "Sí. Es web-app: se abre desde el navegador del celular sin descarga del store. Clave para C-level que no instala apps random. Adopción típica: 60-80% de asistentes lo activan. Si necesitas más, hay versión nativa iOS/Android opcional." },
  { q: "¿Pueden cobrar en USD a un ponente internacional?", a: "Sí. Multi-moneda nativa. El asistente internacional paga en USD, el local en CLP. La liquidación al ponente internacional va en USD a su cuenta extranjera vía Stripe Connect. Compliance Banco Central resuelto." },
  { q: "¿Qué reporte le entrego al sponsor gold para que renueve?", a: "Reporte ROI por sponsor: leads capturados con datos completos, meetings 1-a-1 confirmados (vía Netlink), tiempo promedio en stand, perfil demográfico del tráfico, NPS si lo activaste. El sponsor recibe el documento que justifica internamente el presupuesto del próximo año." },
];
---
<Site title="Servicios Ticketplus · Congresos y eventos corporativos · Tecnología del registro al ROI">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Congresos y eventos corporativos</p>
        <h1 class="biz-hero__title">La tecnología que opera tu congreso, del registro al ROI.</h1>
        <p class="biz-hero__lead">Para summits, congresos B2B, seminarios y eventos corporativos. Forms dinámicos por categoría, acreditación con foto + cordón, Netlink networking 1-a-1, dashboards white-label para sponsors y multi-moneda CLP+USD.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi congreso →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src="/verticals/vertical-conferencias.jpg" alt="Congreso operado con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Congresos y empresas que confían en Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Endeavor 🇨🇱","ICARE 🇨🇱","CChC 🇨🇱","SOFOFA 🇨🇱","Cámara Comercio 🇨🇱","Singularity University 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu congreso vive tres frentes.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las herramientas se activan según los necesites.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · EL REGISTRO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #1 · Acreditación profesional con flow condicional -->
  <section class="spotlight spotlight--brand" id="acreditacion">
    <div class="container">
      <span class="spotlight__eyebrow">Único en CL · Forms condicionales + foto + cordón</span>
      <h2 class="spotlight__title">Buscas que cada categoría tenga su flow correcto. Encuentras forms que cambian según la categoría + acreditación impresa en segundos.</h2>
      <p class="spotlight__body">El asistente elige su categoría, el sistema le muestra los campos obligatorios y la tarifa. Si elige "ponente", aparecen bio + foto + sesión asignada. Llega al evento, escanea su QR y la impresora térmica le entrega credencial con foto + nombre + empresa + cargo + categoría visible en menos de 5 segundos. Cordón con color por categoría (azul C-level, naranja sponsor, verde general).</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Forms condicionales por categoría</h4>
          <p class="spotlight-card__text">El form se adapta al perfil seleccionado: C-level, ponente, sponsor, prensa o general. Campos obligatorios, tarifa y validaciones cambian en vivo.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Impresión térmica &lt;5s con foto</h4>
          <p class="spotlight-card__text">Llega, escanea su QR y retira credencial con foto + nombre + empresa + cargo + categoría en menos de 5 segundos. Cero fila en check-in profesional.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Cordón color por categoría</h4>
          <p class="spotlight-card__text">Azul C-level, naranja sponsor, verde general. Identificación visual inmediata para staff, sponsors y networking en pasillo.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 02 · EL DÍA DEL EVENTO -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #2 · Netlink networking app 1-a-1 -->
  <section class="spotlight spotlight--dark" id="netlink">
    <div class="container">
      <span class="spotlight__eyebrow">Único en CL · Web-app sin descarga del store</span>
      <h2 class="spotlight__title">Buscas que el C-level cierre reuniones reales en tu congreso. Encuentras una app de meetings 1-a-1 que se abre desde el celular sin instalar.</h2>
      <p class="spotlight__body">Los asistentes se encuentran por industria, cargo o interés. Agendan meetings 1-a-1 en franjas predefinidas (15-30 min), chatean en privado, intercambian contacto con un tap. Web-app, no descarga del store: clave porque el C-level no instala apps random. Adopción típica reportada: 60-80% de asistentes activan Netlink. El C-level cierra 4-6 reuniones reales en el día y mide ROI personal del evento.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Web-app sin descarga</h4>
          <p class="spotlight-card__text">Se abre desde el navegador del celular. Cero fricción de App Store o Play Store. Clave para C-level que no instala apps random.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Meetings 1-a-1 con agenda</h4>
          <p class="spotlight-card__text">Franjas de 15-30 min, confirmación bidireccional, chat privado, intercambio de contacto con un tap. Networking estructurado y medible.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">60-80% adopción típica</h4>
          <p class="spotlight-card__text">Adopción reportada en congresos B2B donde Netlink fue activado. El C-level cierra 4-6 reuniones reales en el día y mide ROI personal del evento.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 03 · EL ROI POST-EVENTO -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">La mañana del congreso no estás solo.</h2>
        <p class="tp-promise__body">Martes 8am, 600 ejecutivos llegando, fila en check-in, impresora de badge atascada. Llamas. Nosotros respondemos. Si hace falta, vamos al hotel. <strong>Eso es Ticketplus.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="#contacto">Conocer plan con soporte presencial →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu congreso al elegir Ticketplus.</h2>
        <p class="why-tp__lead">Acreditación + Netlink + reportería ROI + multi-moneda en una sola plataforma. Un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi congreso →</a>
      </div>
    </div>
  </section>

  <!-- VERTICALES -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Verticales</span>
        <h2 class="verticals__title">Funciona para tu tipo de evento.</h2>
      </div>
      <div class="verticals__grid">
        {verticals.map((v) => (
          <article class="verticals__card">
            <div class="verticals__icon">{v.icon}</div>
            <h3 class="verticals__label">{v.label}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu próximo congreso</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu congreso, audiencia y sponsors.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
          <ul style="list-style:none; padding:0; font-family:var(--font-body); font-size:0.95rem; color:var(--color-text-muted); line-height:2.2;">
            {checklist.map(item => (
              <li><span style="color:#1a8a3a; font-weight:700;">✓</span> {item}</li>
            ))}
          </ul>
        </div>
        <div style="background:#fff; border:1px solid var(--color-border); padding:40px; border-radius:var(--radius-card); box-shadow:var(--shadow-elevated);">
          <h3 style="font-family:var(--font-heading); font-size:1.4rem; font-weight:700; margin:0 0 6px; letter-spacing:-0.02em;">Cotizar para mi congreso</h3>
          <p style="font-family:var(--font-body); font-size:0.9rem; color:var(--color-text-muted); margin:0 0 28px;">Respondemos en menos de 24 horas hábiles.</p>
          {[["Nombre","text","Tu nombre"],["Email corporativo","email","tu@empresa.com"],["Organización","text","Nombre de tu organización"]].map(([label,type,placeholder]) => (
            <div style="margin-bottom:14px;">
              <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">{label}</label>
              <input type={type} placeholder={placeholder} style="width:100%; border:1px solid var(--color-border); background:#fff; color:var(--color-text-primary); padding:12px 14px; border-radius:8px; font-size:14px; font-family:inherit;" />
            </div>
          ))}
          <div style="margin-bottom:14px;">
            <label style="display:block; font-family:var(--font-heading); font-size:12px; font-weight:600; color:var(--color-text-muted); margin-bottom:6px;">Tipo de evento</label>
