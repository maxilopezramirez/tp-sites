---
import Site from "../../layouts/Site.astro";

// 3 momentos del ciclo del show (anuncio / noche del show / día siguiente)
const moments = [
  {
    n: "01", tag: "EL ANUNCIO", dark: false, id: "anuncio",
    title: "Buscas vender el on-sale sin que el sitio se caiga.",
    lead: "Encuentras cola virtual + war room + multi-tier preventas. El día del on-sale de un artista internacional, 80.000 personas entran al sitio en 5 minutos.",
    heroCount: 1,
    features: [
      { n: "01", title: "Booster gestionado por equipo Ticketplus", body: "Campañas Meta, Google y TikTok operadas por nosotros con atribución end-to-end al ticket vendido. ROAS medido por canal.", badge: null, captionTag: "Booster gestionado" },
      { n: "02", title: "Preventas exclusivas y multi-tier", body: "Fan club, banco, Visa, general × early bird, golden circle, VIP meet&greet. Cada segmento con su ventana, su código y su atribución.", badge: "Máxima sofisticación multi-tier", newGroup: true },
    ],
  },
  {
    n: "02", tag: "LA NOCHE DEL SHOW", dark: true, id: "noche",
    title: "Buscas que el día del show no haya margen de error.",
    lead: "Encuentras el venue operado con staff TP en sala. Fila en puerta, validación trabada o butaca duplicada son problemas que no pueden pasar con artista internacional.",
    heroCount: 1,
    features: [
      { n: "01", title: "Mapa de localidades del venue", body: "Movistar Arena, Caupolicán, Teatro Caupolicán con butaca, fila, sector y vista desde el asiento. Reutilizable show a show.", badge: "vs Eventbrite mapa básico", captionTag: "Mapa de localidades" },
      { n: "02", title: "Validación rápida con respaldo offline", body: "App QR <2s con modo offline, sync al reconectar, multi-acceso coordinado entre puertas.", badge: null, newGroup: true },
      { n: "03", title: "Staff Ticketplus en sala", body: "Operadores TP capacitados manejando puerta, validación y boletería de última hora.", badge: "vs Welcu/Passline solo software" },
      { n: "04", title: "Cortesías para prensa, sponsors y backstage", body: "Credenciales con QR + foto + categoría, pulseras VIP físicas, tracking en vivo de quién accedió a qué área.", badge: null },
    ],
  },
  {
    n: "03", tag: "EL DÍA SIGUIENTE", dark: false, id: "dia-siguiente",
    title: "Buscas cerrar el show y abrir el próximo.",
    lead: "Encuentras liquidación, ROAS por canal y base para la próxima gira. Liquidación al artista internacional, ROAS por canal, base de datos para la próxima gira.",
    heroCount: 0,
    features: [
      { n: "01", title: "Liquidación con artista en USD o CLP", body: "Stripe Connect, reporte por sector, firmado para artista o management.", badge: null },
      { n: "02", title: "Atribución multi-canal end-to-end", body: "ROAS por campaña, CAC por canal, integración con GA4 + SEMrush.", badge: null },
      { n: "03", title: "Base de datos para la próxima gira", body: "CRM + lookalikes en Meta con histórico de edad, género, ciudad y género musical.", badge: null },
      { n: "04", title: "Soporte 24/7 con account manager dedicado", body: "Mismo equipo que operó el show, disponible para post-mortem y planificación de la próxima fecha.", badge: null },
    ],
  },
];

const overview = [
  { tag: "01 · El anuncio", title: "El on-sale dispara la preventa y el sitio aguanta el pico.", href: "#anuncio" },
  { tag: "02 · La noche del show", title: "Mapa de localidades, validación rápida y staff TP en sala.", href: "#noche" },
  { tag: "03 · El día siguiente", title: "Liquidación al artista, ROAS por canal y base para la próxima gira.", href: "#dia-siguiente" },
];

const whyCards = [
  { icon: "⚡", title: "Drops sin caídas", body: "+320K tickets vendidos en un día sin un solo error." },
  { icon: "💵", title: "Multi-moneda CLP+USD", body: "Artista internacional con tarifa en USD. Cobro en CLP, liquidación en USD." },
  { icon: "🛟", title: "Staff en terreno", body: "Operadores TP en sala el día del show." },
  { icon: "📈", title: "Booster incluido", body: "Campañas Meta + Google operadas por nosotros sin costo extra." },
];

const verticals = [
  { icon: "🎪", label: "Festivales" },
  { icon: "🎭", label: "Teatro" },
  { icon: "⚽", label: "Deportes" },
  { icon: "💼", label: "Conferencias" },
  { icon: "🎡", label: "Parques" },
  { icon: "🏟️", label: "Recintos y arenas" },
];

const checklist = [
  "Alta demanda con war room incluido",
  "Multi-moneda CLP + USD nativo",
  "Booster gestionado en el cargo por servicio",
  "Onboarding completo en 1-3 semanas",
  "Staff Ticketplus en sala el día del show",
  "Liquidación al artista 48-72h post-evento",
];

const faqs = [
  { q: "¿Cómo manejan multi-moneda CLP/USD para artista internacional?", a: "Stripe Connect nativo. Cobramos al fan en CLP (al tipo de cambio del día) o en USD si lo elige. Liquidamos al artista en USD a su cuenta extranjera, sin abrir banco local por cada show. Compliance Banco Central resuelto." },
  { q: "¿80.000 personas en 5 minutos — el sitio aguanta?", a: "Sí. Probado en +320K tickets vendidos en un solo día (AFA Eliminatorias). Infraestructura dedicada por evento, simulación de carga 72h antes del on-sale, war room con ingenieros TP durante el drop. SLA con penalidades económicas — no es promesa, es contrato." },
  { q: "¿Cuándo y cómo va el staff Ticketplus en el venue?", a: "Día del show, operadores TP en sala manejando puerta, validación y boletería de última hora. Coordinación previa con tu equipo de producción. Cantidad de staff según aforo y complejidad del venue." },
  { q: "¿Puedo correr preventas multi-tier (fan club + banco + Visa + general)?", a: "Sí. Cada segmento con su ventana, su código y su atribución. Reglas claras de prioridad: fan club abre primero, después banco, después Visa, después general. Cada uno ve solo lo que le corresponde." },
  { q: "¿Qué pasa si el artista cancela y hay que devolver masivamente?", a: "Reembolso masivo automático: con un click activamos el flujo de devolución, todos los compradores reciben notificación y el reembolso se procesa en 7-10 días hábiles. Reportes de seguimiento para la productora y el management del artista." },
];
---
<Site title="Servicios Ticketplus · Espectáculos en vivo — Tecnología para tu show de la preventa al aplauso final">

  <!-- HERO -->
  <header class="biz-hero">
    <div class="container">
      <div class="biz-hero__content">
        <p class="biz-hero__eyebrow">Servicios Ticketplus · Espectáculos en vivo</p>
        <h1 class="biz-hero__title">La tecnología que opera tu show, desde el anuncio hasta el aplauso final.</h1>
        <p class="biz-hero__lead">Para recitales, conciertos, stand-up, danza, ópera y shows internacionales. Alta demanda con war room, mapa de localidades, multi-moneda CLP+USD y staff TP en sala.</p>
        <div class="biz-hero__ctas">
          <a href="#contacto" class="btn btn--primary">Cotizar para mi show →</a>
        </div>
      </div>
      <div class="biz-hero__visual">
        <img src="/verticals/vertical-espectaculo.jpg" alt="Show en vivo operado con Ticketplus" class="biz-hero__devices" />
      </div>
    </div>
  </header>

  <!-- LOGOS CLOUD -->
  <section class="logos-cloud">
    <div class="container">
      <p class="logos-cloud__label">Productoras de espectáculos que confían en Ticketplus.</p>
      <div class="logos-cloud__grid">
        {["Movistar Arena 🇨🇱","DG Medios 🇨🇱","Lotus 🇨🇱","T4F 🇨🇱","Bizarro 🇨🇱","Caupolicán 🇨🇱"].map(l => (
          <div class="logo-tile-dark">{l}</div>
        ))}
      </div>
    </div>
  </section>

  <!-- OVERVIEW DE LOS 3 MOMENTOS -->
  <section class="biz-promises">
    <div class="container">
      <div style="text-align:center; max-width:760px; margin:0 auto 56px;">
        <h2 class="section__title">Tu show vive tres momentos.</h2>
        <p class="section__lead" style="color:var(--color-text-muted);">Las herramientas se activan según lo necesites.</p>
      </div>
      <div class="biz-promises__grid">
        {overview.map((o) => (
          <a class="promise-card" href={o.href}>
            <span class="promise-card__num">{o.tag}</span>
            <h3 class="promise-card__title">{o.title}</h3>
            <span class="promise-card__link">Ver capacidades →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- MOMENTO 01 · EL ANUNCIO -->
  {(() => {
    const p = moments[0];
    const pi = 0;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--showpage" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- SPOTLIGHT #1 · Alta demanda con war room -->
  <section class="spotlight spotlight--brand" id="war-room">
    <div class="container">
      <span class="spotlight__eyebrow">Único en LATAM · +320K tickets en un día</span>
      <h2 class="spotlight__title">Buscas que el sitio aguante el on-sale del artista internacional. Encuentras war room con ingenieros TP dedicados durante el drop.</h2>
      <p class="spotlight__body">Cola virtual con posición visible, anti-bot adaptativo, infraestructura dedicada por evento, simulación de carga 72h antes del on-sale. SLA con penalidades económicas — no soporte L1 genérico.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Cola virtual + anti-bot</h4>
          <p class="spotlight-card__text">Posición visible en cola, anti-bot adaptativo que distingue fan real de scalper automatizado.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Infra dedicada por evento</h4>
          <p class="spotlight-card__text">Cada drop crítico corre sobre infraestructura dedicada con capacidad provisionada según volumen esperado.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Simulación de carga 72h pre-drop</h4>
          <p class="spotlight-card__text">Stress test del flujo completo con volúmenes simulados 72h antes del on-sale. Ajustes en frío, no en producción.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- SPOTLIGHT #2 · Multi-moneda CLP + USD nativo -->
  <section class="spotlight spotlight--dark" id="multi-moneda">
    <div class="container">
      <span class="spotlight__eyebrow">Único en CL · Multi-moneda Stripe Connect</span>
      <h2 class="spotlight__title">Buscas cobrar en CLP y liquidar al artista en USD. Encuentras una moneda nativa, no un workaround.</h2>
      <p class="spotlight__body">El ticket se vende en CLP al tipo de cambio del día (o en USD directo si el comprador lo elige). Liquidación al artista en USD vía Stripe Connect a su cuenta extranjera. Sin abrir cuenta bancaria por cada artista. Compliance Banco Central Chile resuelto.</p>
      <div class="spotlight__cards">
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Cobro CLP, liquidación USD</h4>
          <p class="spotlight-card__text">El fan paga en pesos; el artista cobra en dólares. Conversión gestionada al tipo de cambio del día.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Stripe Connect a cuenta extranjera</h4>
          <p class="spotlight-card__text">Liquidación directa a la cuenta del artista o management en el exterior. Sin abrir banco local por show.</p>
        </article>
        <article class="spotlight-card">
          <h4 class="spotlight-card__title">Compliance Banco Central CL</h4>
          <p class="spotlight-card__text">Reportes y flujo cambiario alineados con la normativa local. Sin gestiones manuales por evento.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- MOMENTO 02 · LA NOCHE DEL SHOW -->
  {(() => {
    const p = moments[1];
    const pi = 1;
    const heroCount = p.heroCount ?? 0;
    const isHero = (fi) => fi < heroCount;

    const groups = [];
    let currentGrid = [];
    let heroIdx = 0;
    p.features.forEach((f, fi) => {
      if (isHero(fi)) {
        if (currentGrid.length) { groups.push({ type: "grid", features: currentGrid }); currentGrid = []; }
        groups.push({ type: "hero", feature: f, heroIdx });
        heroIdx++;
      } else if (f.newGroup && currentGrid.length) {
        groups.push({ type: "grid", features: currentGrid });
        currentGrid = [f];
      } else {
        currentGrid.push(f);
      }
    });
    if (currentGrid.length) groups.push({ type: "grid", features: currentGrid });

    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--dark biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            if (g.type === "hero") {
              const isReverse = ((pi % 2) + g.heroIdx) % 2 === 1;
              return (
                <div class={`biz-scene__hero ${isReverse ? "is-reverse" : ""}`}>
                  <div class="scene-stage scene-stage--venue" aria-hidden="true" />
                  <div class="biz-scene__caption">
                    <span class="biz-scene__caption-tag">{g.feature.n} · {g.feature.captionTag || "Capacidad destacada"}</span>
                    <h3 class="biz-scene__caption-title">{g.feature.title}</h3>
                    <p class="biz-scene__caption-body">{g.feature.body}</p>
                    {g.feature.badge && <span class="biz-scene__badge">{g.feature.badge}</span>}
                  </div>
                </div>
              );
            }
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- PROMESA TICKETPLUS -->
  <section class="tp-promise">
    <div class="tp-promise__glow"></div>
    <div class="container">
      <div class="tp-promise__block">
        <span class="tp-promise__eyebrow">Promesa Ticketplus</span>
        <h2 class="tp-promise__title">La noche del show no estás solo.</h2>
        <p class="tp-promise__body">Sábado 9pm, sala llena, artista en camerino, puerta colapsada. Llamas. Nosotros respondemos. Si hace falta, vamos al venue. <strong>Eso es Ticketplus.</strong></p>
        <div class="tp-promise__ctas">
          <a class="store-btn store-btn--wsp" href="https://wa.me/56000000000" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            <span class="store-text">
              <span class="store-label">Escríbenos por</span>
              <span class="store-name">WhatsApp directo</span>
            </span>
          </a>
          <a class="tp-promise__ghost" href="#contacto">Conocer plan con soporte presencial →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- MOMENTO 03 · EL DÍA SIGUIENTE -->
  {(() => {
    const p = moments[2];
    const pi = 2;
    const groups = [{ type: "grid", features: p.features }];
    let gridSeen = 0;
    return (
      <section class={`biz-scene biz-scene--light biz-scene--p${pi}`} id={p.id}>
        <div class="container">
          <header class="biz-scene__header">
            <span class="biz-scene__eyebrow">{p.n} · {p.tag}</span>
            <h2 class="biz-scene__title">{p.title}</h2>
            {p.lead && <p class="biz-scene__lead">{p.lead}</p>}
          </header>

          {groups.map((g) => {
            const gIdx = gridSeen;
            gridSeen++;
            return (
              <div class={`biz-scene__grid biz-scene__grid--${g.features.length}`}>
                {g.features.map((f, fi) => (
                  <article class="scene-card">
                    <div class={`scene-card__stage scene-card__stage--p${pi}-${fi + gIdx * 10}`} aria-hidden="true">
                      <span class="scene-card__chip">{f.n}</span>
                    </div>
                    <div class="scene-card__body">
                      <h4 class="scene-card__title">{f.title}</h4>
                      <p class="scene-card__text">{f.body}</p>
                      {f.badge && <span class="biz-scene__badge">{f.badge}</span>}
                    </div>
                  </article>
                ))}
              </div>
            );
          })}
        </div>
      </section>
    );
  })()}

  <!-- POR QUÉ TICKETPLUS -->
  <section class="why-tp">
    <div class="container">
      <div class="why-tp__header">
        <span class="why-tp__eyebrow">Por qué Ticketplus</span>
        <h2 class="why-tp__title">Lo que recibe tu productora al elegir Ticketplus.</h2>
        <p class="why-tp__lead">No vendemos software. Operamos tu show end-to-end con un solo responsable.</p>
      </div>
      <div class="why-tp__grid">
        {whyCards.map((w) => (
          <article class="why-tp__card">
            <div class="why-tp__icon">{w.icon}</div>
            <h3 class="why-tp__card-title">{w.title}</h3>
            <p class="why-tp__card-body">{w.body}</p>
          </article>
        ))}
      </div>
      <div class="why-tp__cta">
        <a href="#contacto" class="btn btn--primary">Cotizar para mi show →</a>
      </div>
    </div>
  </section>

  <!-- VERTICALES -->
  <section class="verticals">
    <div class="container">
      <div class="verticals__header">
        <span class="verticals__eyebrow">Verticales</span>
        <h2 class="verticals__title">Funciona para tu tipo de evento.</h2>
      </div>
      <div class="verticals__grid">
        {verticals.map((v) => (
          <article class="verticals__card">
            <div class="verticals__icon">{v.icon}</div>
            <h3 class="verticals__label">{v.label}</h3>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section style="background:#fafafa; padding:120px 0; border-top:1px solid var(--color-border);" id="contacto">
    <div class="container">
      <div class="form-grid-tp">
        <div>
          <p class="section__eyebrow" style="color:var(--color-secondary);">Hablemos de tu próximo show</p>
          <h2 class="section__title">Buscas cotizar. Encuentras un plan armado con tu show, venue, artista y volumen esperado.</h2>
          <p class="section__lead" style="color:var(--color-text-muted); margin-bottom:28px;">Cotización en menos de 24 horas hábiles.</p>
