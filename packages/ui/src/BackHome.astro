---
const isProd = import.meta.env.PROD;
const href = isProd ? "/tp-sites/" : "http://localhost:4320/";
---
<a class="tp-back" href={href} aria-label="Volver al home">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M19 12H5" />
    <path d="M12 19l-7-7 7-7" />
  </svg>
  <span>Back</span>
</a>

<style>
  .tp-back {
    position: fixed;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px 8px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--tp-border, #e8e8e8);
    color: var(--tp-ink, #0a0a0a);
    font: 600 13px/1 var(--tp-font, "Inter", system-ui, sans-serif);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    z-index: 1000;
    transition: transform 120ms ease, box-shadow 120ms ease;
  }
  .tp-back:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .tp-back:active { transform: translateY(0); }
</style>
